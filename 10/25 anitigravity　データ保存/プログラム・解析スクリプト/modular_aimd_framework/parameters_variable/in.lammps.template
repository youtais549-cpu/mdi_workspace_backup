# ==============================================================================
# LAMMPS MDI 入力スクリプト・テンプレート
# 【ユーザー編集対象: 計算モードの切り替え】
# ==============================================================================
units metal
boundary p p p
atom_style atomic
atom_modify map yes

# 1. 構造データの読み込み
# スラブ計算時は slab_model.data、バルク計算時は bulk_model.data を指定
read_data structure.data

# 2. 原子質量設定 (ASE の英名アルファベット昇順: Type 1=C, Type 2=Si)
mass 1 12.011
mass 2 28.085

# 3. MDI 連成設定 (Quantum ESPRESSO を QM エンジンとして接続)
fix 1 all mdi/qm elements C Si

# 4. 出力設定
thermo 1
dump 1 all custom 1 dump.lammpstrj id type x y z
dump_modify 1 append yes

# ==============================================================================
# 【計算モードの選択】(A または B のどちらか一方を有効化)
# ==============================================================================

# ------------------------------------------------------------------------------
# モード (A): 表面構造緩和 (minimize) - 表面破壊エネルギー評価用 (デフォルト)
# ------------------------------------------------------------------------------
# 力の閾値 1.0e-3 eV/Å 以下になるまで共役勾配法(CG)でエネルギー最小化
minimize 0.0 1.0e-3 100 1000

# ------------------------------------------------------------------------------
# モード (B): 有限温度第一原理MD (AIMD, 300K)
# ------------------------------------------------------------------------------
# ※ モード (B) を使う場合は、上の minimize をコメントアウトし、下記を有効化:
# velocity all create 300.0 12345
# fix 2 all nve
# timestep 0.001
# run 50

undump 1
