# ==============================================================================
# 2H-SiC {10-10} 72原子スラブモデル (真空層 各10Å)
# 有限温度第一原理分子動力学 (AIMD: NVT アンサンブル @ 300K) 入力スクリプト
# ==============================================================================
# 単位系: metal (距離: Å, 時間: ps, エネルギー: eV, 温度: K, 質量: g/mol)
units metal
boundary p p p
atom_style atomic
atom_modify map yes

# ------------------------------------------------------------------------------
# 1. 初期構造の読み込み (72原子スラブ, 真空各10Å, 合計 Lz = 23.55Å)
# ------------------------------------------------------------------------------
# (A) 推奨: 0Kで構造緩和済みの安定構造からスタート (熱爆発・非物理的結合切断を防止)
read_data slab_10-10_relaxed.data

# (B) 理想切断直後 (未緩和) からの熱緩和を見たい場合は上記をコメントアウトし、下記を使用:
# read_data slab_10-10_unrelaxed.data

# 原子質量設定 (Type 1: C = 12.011, Type 2: Si = 28.085)
mass 1 12.011
mass 2 28.085

# ------------------------------------------------------------------------------
# 2. MDI 通信設定 (Quantum ESPRESSO GPU を第一原理 QM エンジンとして連成)
# ------------------------------------------------------------------------------
fix 1 all mdi/qm elements C Si

# ------------------------------------------------------------------------------
# 3. 初期熱運動速度の付与 (Maxwell-Boltzmann 分布)
# ------------------------------------------------------------------------------
# 300K の熱速度を生成。乱数シード: 87654
# mom yes : 系全体の並進運動量をゼロ化 (スラブ全体の等速移動・宇宙船ドリフトを防止)
# rot yes : 全角運動量をゼロ化
# dist gaussian : ガウス分布 (マクスウェル・ボルツマン分布)
velocity all create 300.0 87654 mom yes rot yes dist gaussian

# ------------------------------------------------------------------------------
# 4. 運動方程式の数値積分 & サーモスタット設定 (NVT アンサンブル)
# ------------------------------------------------------------------------------
# タイムステップ: 0.001 ps = 1.0 fs
# (SiC の最高光学フォノン周期 ~30 fs に対し、1 fs で十分安定に数値積分可能)
timestep 0.001

# Nosé-Hoover サーモスタット (NVT):
# 開始温度 300.0 K, 終了温度 300.0 K
# Tdamp = 0.1 ps (100 fs = 100 * dt, LAMMPS推奨の温度緩和時間)
fix 2 all nvt temp 300.0 300.0 0.1

# スラブ特有の重心ドリフト防止 (極めて重要):
# 熱振動の微小な非対称性でスラブ全体が真空層内を z 方向に移動するのを防ぐため、
# 50ステップごとに全並進運動量をゼロに再センタリングします。
fix 3 all momentum 50 linear 1 1 1

# ------------------------------------------------------------------------------
# 5. 出力設定 & ログ記録
# ------------------------------------------------------------------------------
# 毎ステップの熱力学量 (温度, ポテンシャルE, 運動E, 全E, 圧力) を出力
thermo_style custom step temp epair emol ke pe etotal press
thermo 1

# Winmostar / OVITO 可視化用のアニメーション・軌跡ダンプ
# (座標 x,y,z、速度 vx,vy,vz、第一原理力 fx,fy,fz を記録)
dump 1 all custom 1 dump.lammpstrj id type x y z vx vy vz fx fy fz
dump_modify 1 append yes

# ------------------------------------------------------------------------------
# 6. AIMD 実行
# ------------------------------------------------------------------------------
# タイムステップ数: 1000 step = 1000 fs = 1.0 ps
# [構成の内訳]
#   - Step 1 〜 500   (0.5 ps): 熱平衡化フェーズ (Equilibration: 300K に系を馴染ませる)
#   - Step 501 〜 1000 (0.5 ps): サンプリングフェーズ (Production: 表面熱振動・熱平均構造の追跡)
#
# ※ 計算コストの目安 (Tesla T4 GPU):
#   - 1 step 約 20 秒 × 1000 steps ≈ 約 5.5 時間 (Colab 1セッション内で安全に完了可能)
#   - ※ 予備テストとして短時間で回したい場合は run 200 (約 1 時間) に変更可能
run 1000

undump 1
