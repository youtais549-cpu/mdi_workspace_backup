&CONTROL
   calculation      = 'scf'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './tmp'
   disk_io          = 'minimal'
   pseudo_dir       = './'
/
&SYSTEM
   ecutwfc          = 40.0
   ecutrho          = 320.0
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gaussian'
   ntyp             = 2
   nat              = 72
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-05
   mixing_mode      = 'local-TF'
   mixing_beta      = 0.3
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
