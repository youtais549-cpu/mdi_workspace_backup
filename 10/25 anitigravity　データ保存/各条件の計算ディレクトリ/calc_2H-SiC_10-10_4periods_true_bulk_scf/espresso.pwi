&CONTROL
    calculation = 'scf'
    restart_mode = 'from_scratch'
    prefix = 'sic'
    pseudo_dir = './'
    outdir = './tmp'
    tprnfor = .true.
    tstress = .true.
/
&SYSTEM
    ibrav = 0
    nat = 144
    ntyp = 2
    ecutwfc = 40.0
    ecutrho = 320.0
    occupations = 'smearing'
    smearing = 'gaussian'
    degauss = 0.01
/
&ELECTRONS
    conv_thr = 1.0d-5
    mixing_beta = 0.3
    mixing_mode = 'local-TF'
    electron_maxstep = 200
/
