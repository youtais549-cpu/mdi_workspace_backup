# ==============================================================================
# 2H-SiC {10-10} 72原子スラブモデル (真空層 各2.5Å, 合計真空5.0Å)
# 第一原理構造緩和計算 (MDI: LAMMPS + Quantum ESPRESSO GPU)
# ==============================================================================
units metal
boundary p p p
atom_style atomic
atom_modify map yes

# 1. 初期構造の読み込み (4層, 真空各2.5Å, 合計 Lz = 8.552Å)
read_data 2H-SiC_10-10_slab_3x3x2_vac2.5A.data
Reading data file ...
  orthogonal box = (0 0 0) to (9.228 15.144 8.5520364)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  72 atoms
  read_data CPU = 0.001 seconds

# 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)
mass 1 12.011
mass 2 28.085

# 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)
fix 1 all mdi/qm elements C Si

# 3. 出力設定
thermo 1
dump 1 all custom 1 dump.lammpstrj id type x y z
dump_modify 1 append yes

# ------------------------------------------------------------------------------
# 4. 表面構造緩和 (minimize) - 表面破壊エネルギー評価用の力極小化 (0 K)
# ------------------------------------------------------------------------------
# 力の閾値 1.0e-3 eV/Å 以下になるまで共役勾配法(CG)でエネルギー最小化
minimize 0.0 1.0e-3 100 1000
