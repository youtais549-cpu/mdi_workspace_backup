# 2H-SiC {10-10} 3x3x2 スラブモデル (72原子) 計算入力スクリプト
units metal
boundary p p p
atom_style atomic
atom_modify map yes

# 1. 初期構造の読み込み (3x3x2, 72原子)
# (A) スラブモデル (4層, 真空各10Å)
read_data 2H-SiC_10-10_slab_3x3x2_vac5A.data
# (B) バルク基準モデル (真空なし) を計算する場合は上記をコメントアウトし、下記を有効化:
# read_data 2H-SiC_10-10_bulk_3x3x2_72atoms.data

# 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)
mass 1 12.011
mass 2 28.085

# 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)
fix 1 all mdi/qm elements C Si

# 3. 出力設定
thermo 1
dump 1 all custom 1 dump.lammpstrj id type x y z
dump_modify 1 append yes

# -------------------------------------------------------------
# 【計算モードの選択】
# (A) 表面構造緩和 (minimize) - 表面破壊エネルギー評価用の力極小化
# -------------------------------------------------------------
# 力の閾値 1.0e-3 eV/Å 以下になるまで共役勾配法(CG)でエネルギー最小化
minimize 0.0 1.0e-3 100 1000

# -------------------------------------------------------------
# (B) 有限温度第一原理MD (AIMD, 300K) を行う場合は上記をコメントアウトし、
#     下記を有効にしてください:
# -------------------------------------------------------------
# velocity all create 300.0 12345
# fix 2 all nve
# timestep 0.001
# run 20
# -------------------------------------------------------------

undump 1
