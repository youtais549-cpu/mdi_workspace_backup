{"step_index":100,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:25Z","content":"Created At: 2026-11-05T14:36:25+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-170 of 170\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: スラブモデルおよびバルクモデル自動生成ツール\n4: 【ユーザー実行コマンド】\n5: python3 generate_models.py\n6: \n7: model_settings.py と dft_settings.py を読み込み、\n8: 任意の結晶面・周期数・真空層厚さに応じたスラブ・バルクモデル構造ファイル(.data, .cif, .xyz)\n9: および表面積評価メタデータを自動生成します。\n10: \"\"\"\n11: import os\n12: import sys\n13: import json\n14: import numpy as np\n15: from ase import Atoms\n16: import ase.io\n17: from ase.io.lammpsdata import write_lammps_data\n18: \n19: # 設定ファイルの読み込み\n20: sys.path.append(os.path.dirname(os.path.abspath(__file__)))\n21: import model_settings as ms\n22: import dft_settings as ds\n23: \n24: def build_2h_sic_10_10(n_periods, supercell_xy, vacuum):\n25:     \"\"\"\n26:     2H-SiC {10-10} 非極性 m面のスラブおよびバルクモデルを生成\n27:     \"\"\"\n28:     a = ms.LATTICE_A\n29:     c = ms.LATTICE_C\n30:     u = ms.U_PARAM\n31:     nx, ny = supercell_xy\n32:     \n33:     # {10-10} 面に垂直な方向の1周期厚さ d_{10-10} = sqrt(3)*a/2 * 2 = sqrt(3)*a\n34:     d_10_10 = np.sqrt(3) * a\n35:     \n36:     # 直交基本セル (1周期 = 2層, 4原子: 2 Si, 2 C)\n37:     # x: [11-20], y: [0001] (c軸), z: [10-10] (へき開面法線)\n38:     # 粗結合面 (dz = 1.776Å) で切断し、上面・下面を完全等価(非極性)にする\n39:     dense_dz = d_10_10 / 6.0    # ~0.888 Å\n40:     sparse_dz = d_10_10 / 3.0   # ~1.776 Å\n41:     \n42:     unit_positions = []\n43:     unit_symbols = []\n44:     \n45:     # 周期数 n_periods 分だけ z 方向に積層\n46:     for p in range(n_periods):\n47:         base_z = p * (dense_dz + sparse_dz)\n48:         # Layer 1 (z = base_z + dense_dz)\n49:         z1 = base_z + dense_dz\n50:         unit_positions.append([0.0, 0.0, z1])\n51:         unit_symbols.append('Si')\n52:         unit\n<truncated 4111 bytes>\nulk_{ms.CLEAVAGE_PLANE}_{n_atoms}atoms\")\n132:     \n133:     # スラブファイルの出力\n134:     ase.io.write(f\"{prefix_slab}.cif\", slab)\n135:     ase.io.write(f\"{prefix_slab}.xyz\", slab)\n136:     write_lammps_data(f\"{prefix_slab}.data\", slab, atom_style='atomic', masses=True)\n137:     \n138:     # バルクファイルの出力\n139:     ase.io.write(f\"{prefix_bulk}.cif\", bulk)\n140:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk)\n141:     write_lammps_data(f\"{prefix_bulk}.data\", bulk, atom_style='atomic', masses=True)\n142:     \n143:     # メタデータ JSON の出力 (calc_surface_energy.py で自動参照)\n144:     meta = {\n145:         'cleavage_plane': ms.CLEAVAGE_PLANE,\n146:         'n_periods': ms.N_PERIODS,\n147:         'n_layers': ms.N_PERIODS * 2,\n148:         'natoms': n_atoms,\n149:         'vacuum_thickness_angstrom': ms.VACUUM_THICKNESS,\n150:         'supercell_xy': list(ms.SUPERCELL_XY),\n151:         'cell_slab': [float(slab.cell[0,0]), float(slab.cell[1,1]), float(slab.cell[2,2])],\n152:         'cell_bulk': [float(bulk.cell[0,0]), float(bulk.cell[1,1]), float(bulk.cell[2,2])],\n153:         'area_A_angstrom2': float(area_A),\n154:         'total_area_2A_angstrom2': float(area_2A),\n155:         'unit_conversion_eV_A2_to_J_m2': conv_factor,\n156:         'effective_denominator': float(area_2A / conv_factor),\n157:         'slab_data_file': os.path.basename(f\"{prefix_slab}.data\"),\n158:         'bulk_data_file': os.path.basename(f\"{prefix_bulk}.data\")\n159:     }\n160:     meta_path = os.path.join(out_dir, \"fracture_metadata.json\")\n161:     with open(meta_path, \"w\", encoding=\"utf-8\") as f:\n162:         json.dump(meta, f, indent=4)\n163:         \n164:     print(f\"✅ モデルファイルおよびメタデータを生成しました:\")\n165:     print(f\"  - スラブ: {os.path.basename(prefix_slab)}.[data|cif|xyz]\")\n166:     print(f\"  - バルク: {os.path.basename(prefix_bulk)}.[data|cif|xyz]\")\n167:     print(f\"  - メタデータ: fracture_metadata.json\")\n168: \n169: if __name__ == \"__main__\":\n170:     main()","truncated_fields":["content"]}
{"step_index":101,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:26Z","content":"Created At: 2026-11-05T14:36:26+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-42 of 42\n1: \"\"\"\n2: 第一原理電子状態計算 (DFT / Quantum ESPRESSO) のパラメータ設定ファイル\n3: 【ユーザー編集対象 (必要な場合のみ)】\n4: 通常はデフォルト設定のままで高精度かつ安定に収束します。\n5: カットオフエネルギーの収束性テストや k点メッシュの変更を行う場合はここを編集します。\n6: \"\"\"\n7: \n8: DFT_CONFIG = {\n9:     # 波動関数カットオフエネルギー (Ry)\n10:     # 推奨値: 40.0 Ry (PAW擬ポテンシャル下で結合エネルギーが十分収束)\n11:     'ecutwfc': 40.0,\n12: \n13:     # 電荷密度カットオフエネルギー (Ry)\n14:     # 推奨値: 320.0 Ry (PAWでは通常 ecutwfc の 8〜10倍を設定)\n15:     'ecutrho': 320.0,\n16: \n17:     # SCF電子状態収束閾値 (Ry)\n18:     # 推奨値: 1.0e-5 (力・エネルギーの精度として十分)\n19:     'conv_thr': 1.0e-5,\n20: \n21:     # k点サンプリング\n22:     # None: Γ点のみ (K_POINTS gamma)\n23:     # スーパーセル (3x3以上, 9Å以上) では逆格子空間が狭いため None (Γ点) で十分収束します。\n24:     # 単位胞や小さめのセルの場合は (2, 2, 1) などのタプルを指定可能\n25:     'kpts': None,\n26: \n27:     # 電子占有・スメアリング設定\n28:     'occupations': 'smearing',\n29:     'smearing': 'gaussian',\n30:     'degauss': 0.01,  # Ry\n31: \n32:     # 電子密度ミキシング設定 (SCF収束の安定化)\n33:     'mixing_beta': 0.3,\n34:     'mixing_mode': 'local-TF',  # 表面スラブ特有の電荷振動を抑える局所Thomas-Fermi法\n35:     'electron_maxstep': 200,\n36: \n37:     # 擬ポテンシャルファイル名\n38:     'pseudopotentials': {\n39:         'Si': 'Si.upf',\n40:         'C': 'C.upf'\n41:     }\n42: }"}
{"step_index":102,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:26Z","content":"Created At: 2026-11-05T14:36:26+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-32 of 32\n1: \"\"\"\n2: スラブモデルおよびバルク基準モデルの幾何学的パラメータ設定ファイル\n3: 【ユーザー編集対象】\n4: 条件を変更する際は、このファイルの数値を変更してください。\n5: \"\"\"\n6: \n7: # 1. 亀裂を入れる結晶面 (へき開面)\n8: # 選択肢: '10-10' (非極性 m面, 推奨), '11-20' (非極性 a面), '0001' (極性 c面)\n9: CLEAVAGE_PLANE = '10-10'\n10: \n11: # 2. 周期数 (厚み方向のユニットリピート数)\n12: # '10-10' の場合: 1周期 = 2層 (原子密な二重層と疎な層の1組)\n13: # N_PERIODS = 2 -> 4層 (72原子)\n14: # N_PERIODS = 3 -> 6層 (108原子)\n15: # N_PERIODS = 4 -> 8層 (144原子)\n16: # N_PERIODS = 6 -> 12層 (216原子)\n17: N_PERIODS = 6\n18: \n19: # 3. 面内スーパーセルの倍率 (Nx, Ny)\n20: # Nx: 破面内の水平方向倍率\n21: # Ny: 破面内の垂直方向倍率\n22: SUPERCELL_XY = (3, 3)\n23: \n24: # 4. 真空層の厚さ (Å)\n25: # スラブの上面・下面の先にそれぞれ挿入する真空の厚さ\n26: # 5.0 Å (上下合わせて 10.0 Å: 真空層収束性テスト用)\n27: VACUUM_THICKNESS = 5.0\n28: \n29: # 5. 材料定数 (2H-SiC)\n30: LATTICE_A = 3.076  # Å (a軸格子定数)\n31: LATTICE_C = 5.048  # Å (c軸格子定数)\n32: U_PARAM = 0.375    # 内部パラメータ u"}
{"step_index":103,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:26Z","content":"Created At: 2026-11-05T14:36:26+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-117 of 117\n1: &CONTROL\n2: