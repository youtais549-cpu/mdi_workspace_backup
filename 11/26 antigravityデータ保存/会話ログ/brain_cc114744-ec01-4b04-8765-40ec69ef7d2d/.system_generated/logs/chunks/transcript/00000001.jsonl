{"step_index":87,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:01Z","content":"Created At: 2026-11-05T14:36:01+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-42 of 42\n1: # 2H-SiC {10-10} 3x3x2 スラブモデル (72原子) 計算入力スクリプト\n2: units metal\n3: boundary p p p\n4: atom_style atomic\n5: atom_modify map yes\n6: \n7: # 1. 初期構造の読み込み (3x3x2, 72原子)\n8: # (A) スラブモデル (4層, 真空各10Å)\n9: read_data 2H-SiC_10-10_slab_3x3x2_vac5A.data\n10: # (B) バルク基準モデル (真空なし) を計算する場合は上記をコメントアウトし、下記を有効化:\n11: # read_data 2H-SiC_10-10_bulk_3x3x2_72atoms.data\n12: \n13: # 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)\n14: mass 1 12.011\n15: mass 2 28.085\n16: \n17: # 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)\n18: fix 1 all mdi/qm elements C Si\n19: \n20: # 3. 出力設定\n21: thermo 1\n22: dump 1 all custom 1 dump.lammpstrj id type x y z\n23: dump_modify 1 append yes\n24: \n25: # -------------------------------------------------------------\n26: # 【計算モードの選択】\n27: # (A) 表面構造緩和 (minimize) - 表面破壊エネルギー評価用の力極小化\n28: # -------------------------------------------------------------\n29: # 力の閾値 1.0e-3 eV/Å 以下になるまで共役勾配法(CG)でエネルギー最小化\n30: minimize 0.0 1.0e-3 100 1000\n31: \n32: # -------------------------------------------------------------\n33: # (B) 有限温度第一原理MD (AIMD, 300K) を行う場合は上記をコメントアウトし、\n34: #     下記を有効にしてください:\n35: # -------------------------------------------------------------\n36: # velocity all create 300.0 12345\n37: # fix 2 all nve\n38: # timestep 0.001\n39: # run 20\n40: # -------------------------------------------------------------\n41: \n42: undump 1"}
{"step_index":88,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:01Z","content":"Created At: 2026-11-05T14:36:01+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-268 of 268\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: T4 GPU 対応 Quantum ESPRESSO MDI エンジン\n4: LAMMPS (DRIVER) から MDI 経由で座標を受信し、GPU版 pw.x で SCF 計算を行い、力とエネルギーを返信する。\n5: \"\"\"\n6: import sys\n7: import os\n8: import glob\n9: import time\n10: import numpy as np\n11: import mdi\n12: from ase import Atoms\n13: from ase.calculators.espresso import Espresso, EspressoProfile\n14: import ase.parallel\n15: ase.parallel.world = ase.parallel.DummyMPI()\n16: \n17: ELEMENTS = [\n18:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n19:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n20:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n21:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n22:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n23:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n24:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n25:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n26:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n27:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n28:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n29:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n30: ]\n31: atomic_number_to_symbol = {i+1: symbol for i, symbol in enumerate(ELEMENTS)}\n32: type_to_symbol = {1: 'C', 2: 'Si'}\n33: \n34: exitflag = False\n35: qm_natoms = 0\n36: qm_elements = None\n37: qm_coords = None\n38: box = np.zeros(9, dtype=np.float64)\n39: flag_box = False\n40: \n41: qm_pe = 0.0\n42: qm_forces = None\n43: last_evaluated_coords = None\n44: \n45: def log(msg):\n46:     print(f\"[QE-MDI GPU Engine] {msg}\", flush=True)\n47: \n48: def error(txt):\n49:     log(f\"ERROR: {txt}\")\n50:     sys.exit(1)\n51: \n52: def find_nvhpc_and_pw():\n53:     \"\"\"NVHPCライブラリパスおよびGPU版pw.xバイナリの自動検出\"\"\"\n54:\n<truncated 6409 bytes>\nd from driver.\")\n216:         exitflag = True\n217:     elif command == \">NATOMS\":\n218:         receive_qm_natoms(mdicomm)\n219:     elif command == \">CELL\":\n220:         receive_box(mdicomm)\n221:     elif command == \">ELEMENTS\":\n222:         receive_qm_elements(mdicomm)\n223:     elif command == \">TYPES\":\n224:         receive_qm_types(mdicomm)\n225:     elif command == \">COORDS\":\n226:         receive_qm_coords(mdicomm)\n227:     elif command in [\"<ENERGY\", \"<PE\"]:\n228:         evaluate()\n229:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n230:         if ierr: error(\"MDI: <ENERGY send failed\")\n231:     elif command == \"<FORCES\":\n232:         evaluate()\n233:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n234:         if ierr: error(\"MDI: <FORCES send failed\")\n235:     else:\n236:         error(f\"Unrecognized MDI command: {command}\")\n237:     return 0\n238: \n239: if __name__ == \"__main__\":\n240:     args = sys.argv\n241:     mdi_option = \"\"\n242:     iarg = 1\n243:     while iarg < len(args):\n244:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n245:             if iarg + 1 < len(args):\n246:                 mdi_option = args[iarg + 1]\n247:                 break\n248:         iarg += 1\n249: \n250:     if not mdi_option:\n251:         error(\"Missing -mdi argument on command line\")\n252: \n253:     log(f\"Initializing MDI Engine with options: {mdi_option}\")\n254:     mdi.MDI_Init(mdi_option)\n255:     \n256:     mdi.MDI_Register_Node(\"@DEFAULT\")\n257:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n258:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n259: \n260:     log(\"Waiting for MDI driver connection...\")\n261:     mdicomm = mdi.MDI_Accept_Communicator()\n262:     log(\"Connected to MDI driver! Entering communication loop...\")\n263: \n264:     while not exitflag:\n265:         command = mdi.MDI_Recv_Command(mdicomm)\n266:         execute_command(command, mdicomm, None)\n267:         \n268:     log(\"MDI Engine execution terminated cleanly.\")","truncated_fields":["content"]}
{"step_index":89,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:02Z","content":"Created At: 2026-11-05T14:36:02+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-35 of 35\n1: #!/bin/bash\n2: # run_colab_gpu.sh\n3: # Colab上で T4 GPU を用いて LAMMPS + QE MDI結合計算を実行するスクリプト\n4: \n5: rm -rf tmp qe.out qe_mdi.pwo qe_mdi.pwi dump.lammpstrj qe_engine.log nohup.out\n6: \n7: echo \"==========================================\"\n8: echo \" Starting LAMMPS + QE MDI Simulation (GPU)\"\n9: echo \" Model: 2H-SiC {10-10} Slab (72 atoms)\"\n10: echo \"==========================================\"\n11: \n12: # OpenMPI / 環境変数の最適化\n13: export OMPI_ALLOW_RUN_AS_ROOT=1\n14: export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1\n15: \n16: # 1. LAMMPS を MDI DRIVER としてバックグラウンド起動\n17: echo \"1. Starting LAMMPS MDI driver...\"\n18: /content/bin/lmp -mdi \"-role DRIVER -name LAMMPS -method TCP -port 8021\" -in in.lammps > lmp.log 2>&1 &\n19: LMP_PID=$!\n20: \n21: sleep 1\n22: \n23: # 2. Python QE MDI Engine (GPU) を起動\n24: echo \"2. Starting Python QE MDI engine (T4 GPU)...\"\n25: python3 qe_mdi_engine_gpu.py -mdi \"-role ENGINE -name QE -method TCP -port 8021 -hostname localhost\" > qe_engine.log 2>&1\n26: \n27: # 3. 完了待機\n28: wait $LMP_PID\n29: \n30: echo \"==========================================\"\n31: echo \" Calculation Completed Successfully!\"\n32: echo \" Converting trajectory to XYZ format...\"\n33: python3 make_xyz.py dump.lammpstrj md_animation.xyz 2>/dev/null || true\n34: echo \" Done!\"\n35: echo \"==========================================\""}
{"step_index":90,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:02Z","content":"Created At: 2026-11-05T14:36:02+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-79 of 79\n1: #!/bin/bash\n2: # ==============================================================================\n3: # master_run_gpu.sh\n4: # 2H-SiC {10-10} スラブモデル (真空層 5.0Å, 72原子)\n5: # T4 GPU 構造緩和計算 起動 & Google Drive 自動同期スクリプト\n6: # ==============================================================================\n7: \n8: WORK_DIR=\"/content/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n9: BACKUP_DIR=\"/content/drive/MyDrive/MD_backup/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n10: \n11: echo \"1. Python パッケージの確認...\"\n12: pip install --quiet ase pymdi\n13: \n14: echo \"2. NVHPC 環境の確認...\"\n15: NVHPC_HOME=/opt/nvidia/hpc_sdk/Linux_x86_64/24.7\n16: if [ ! -d \"$NVHPC_HOME\" ]; then\n17:     echo \"NVHPC SDK をインストールしています...\"\n18:     echo \"deb [trusted=yes] https://developer.download.nvidia.com/hpc-sdk/ubuntu/amd64 /\" | sudo tee /etc/apt/sources.list.d/nvhpc.list\n19:     sudo apt-get update -y\n20:     sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nvhpc-24-7\n21: fi\n22: \n23: echo \"3. バイナリの配置...\"\n24: mkdir -p /content/bin\n25: if [ -f /content/drive/MyDrive/mdi_binaries/lmp ]; then\n26:     cp /content/drive/MyDrive/mdi_binaries/lmp /content/bin/\n27: fi\n28: if [ -f /content/drive/MyDrive/mdi_binaries/pw.x.real ]; then\n29:     cp /content/drive/MyDrive/mdi_binaries/pw.x.real /content/bin/\n30: fi\n31: \n32: # pw.x ラッパー\n33: cat << 'WRAPPER_EOF' > /content/bin/pw.x\n34: #!/bin/bash\n35: NVHPC_HOME=/opt/nvidia/hpc_sdk/Linux_x86_64/24.7\n36: rm -f $NVHPC_HOME/cuda/12.2 2>/dev/null || true\n37: ln -sf 12.5 $NVHPC_HOME/cuda/12.2 2>/dev/null || true\n38: export PATH=$NVHPC_HOME/compilers/bin:$NVHPC_HOME/comm_libs/mpi/bin:$NVHPC_HOME/cuda/bin:$PATH\n39: export LD_LIBRARY_PATH=$NVHPC_HOME/compilers/lib:$NVHPC_HOME/math_libs/lib64:$NVHPC_HOME/cuda/lib64:$NVHPC_HOME/comm_libs/mpi/lib:$LD_LIBRARY_PATH\n40: HPCX_INIT=$(find /opt/nvidia/hpc_sdk/Linux_x86_64 -name \"hpcx-init.sh\" 2>/dev/null | sort -V | tail -n 1)\n41: if [ -n \"$HPCX_INIT\" ] && [ -f \"$HPCX_INIT\" ]; then\n42:     source \"$HPCX_INIT\"\n43:     hpcx_load\n44: fi\n45: export OMPI_ALLOW_RUN_AS_ROOT=1\n46: export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1\n47: exec mpirun --allow-run-as-root -np 1 /content/bin/pw.x.real \"$@\"\n48: WRAPPER_EOF\n49: \n50: chmod +x /content/bin/* 2>/dev/null || true\n51: \n52: echo \"4. GPU 状態の確認...\"\n53: nvidia-smi\n54: \n55: echo \"5. 計算のバックグラウンド開始...\"\n56: cd \"$WORK_DIR\"\n57: nohup bash run_colab_gpu.sh > nohup.out 2>&1 &\n58: CALC_PID=$!\n59: \n60: echo \"6. Google Drive への自動バックアップ設定 (5分間隔)...\"\n61: mkdir -p \"$BACKUP_DIR\"\n62: nohup bash -c '\n63: WORK_DIR=\"/content/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n64: BACKUP_DIR=\"/content/drive/MyDrive/MD_backup/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n65: mkdir -p \"$BACKUP_DIR\"\n66: while true; do\n67:     cp \"$WORK_DIR\"/*.lammpstrj \"$BACKUP_DIR/\" 2>/dev/null || true\n68:     cp \"$WORK_DIR\"/*.xyz \"$BACKUP_DIR/\" 2>/dev/null || true\n69:     cp \"$WORK_DIR\"/*.log \"$BACKUP_DIR/\" 2>/dev/null || true\n70:     cp \"$WORK_DIR\"/*.pwo \"$BACKUP_DIR/\" 2>/dev/null || true\n71:     cp \"$WORK_DIR\"/*.pwi \"$BACKUP_DIR/\" 2>/dev/null || true\n72:     cp \"$WORK_DIR\"/nohup.out \"$BACKUP_DIR/\" 2>/dev/null || true\n73:     sleep 300\n74: done' > backup.log 2>&1 &\n75: \n76: echo \"🚀 真空層 5.0Å スラブモデルの第一原理構造緩和計算がスタートしました！\"\n77: echo \"ログ確認: tail -f $WORK_DIR/nohup.out\"\n78: echo \"QEログ確認: tail -f $WORK_DIR/espresso.pwo\"\n79: echo \"LAMMPSログ確認: tail -f $WORK_DIR/log.lammps\""}
{"step_index":91,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:03Z","content":"Created At: 2026-11-05T14:36:03+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-43 of 43\n1: # ==============================================================================\n2: # 2H-SiC {10-10} 72原子スラブモデル (2周期, 真空層 2.5Å, 合計真空5.0Å)\n3: # 第一原理構造緩和計算 【最適化収束条件版・2回目再検証】\n4: # ==============================================================================\n5: # 【設計思想と収束閾値の物理的根拠】\n6: # 1. DFT (Quantum ESPRESSO) の SCF 収束閾値 conv_thr = 1.0e-5 Ry において、\n7: #    Hellmann-Feynman 力の数値ノイズ限界 (フロア) は ~0.0002 Ry/au (≈ 0.0051 eV/Å)。\n8: # 2. 従来の ftol = 1.0e-3 eV/Å (0.0010 eV/Å) はノイズ限界の 5〜8 倍厳しく、\n9: #    統計的に永遠に満たされず計算が停止しなかった。\n10: # 3. 本設定では、ftol = 1.0e-2 eV/Å (0.010 eV/Å ≈ 0.0004 Ry/au) に最適化し、\n11: #    物理的な構造緩和完了時点で自然に自動正常終了させる。\n12: # 4. さらに etol = 1.0e-6 を併用し、エネルギー底打ちによる安全停止を二重化。\n13: # ==============================================================================\n14: \n15: units metal\n16: boundary p p p\n17: atom_style atomic\n18: atom_modify map yes\n19: \n20: # 1. 初期構造の読み込み (モデル構築は以前と完全に同一の72原子, 真空2.5Å)\n21: read_data 2H-SiC_10-10_slab_3x3x2_vac2.5A.data\n22: \n23: # 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)\n24: mass 1 12.011\n25: mass 2 28.085\n26: \n27: # 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)\n28: fix 1 all mdi/qm elements C Si\n29: \n30: # 3. 出力設定\n31: thermo 1\n32: dump 1 all custom 1 dump.lammpstrj id type x y z\n33: dump_modify 1 append yes\n34: \n35: # 4. 表面構造緩和 (minimize)\n36: # 構文: minimize etol ftol maxiter maxeval\n37: # - etol: 1.0e-6 (相対エネルギー差 <= 10^-6 で収束)\n38: # - ftol: 1.0e-2 eV/Å (最大作用力 <= 0.01 eV/Å で収束、DFTノイズ限界直上)\n39: # - maxiter: 100 (最大CG反復ステップ数)\n40: # - maxeval: 150 (最大力評価回数)\n41: minimize 1.0e-6 1.0e-2 100 150\n42: \n43: undump 1"}
