i.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n378:         if ierr:\n379:             error(\"MDI: <ENERGY send failed\")\n380:     elif command == \"<FORCES\":\n381:         evaluate()\n382:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n383:         if ierr:\n384:             error(\"MDI: <FORCES send failed\")\n385:     else:\n386:         error(f\"Unrecognized MDI command: {command}\")\n387:     return 0\n388: \n389: \n390: if __name__ == \"__main__\":\n391:     configure_rtx5080_environment()\n392: \n393:     args = sys.argv\n394:     mdi_option = \"\"\n395:     iarg = 1\n396:     while iarg < len(args):\n397:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n398:             if iarg + 1 < len(args):\n399:                 mdi_option = args[iarg + 1]\n400:                 break\n401:         iarg += 1\n402: \n403:     if not mdi_option:\n404:         error(\"Missing -mdi argument on command line\")\n405: \n406:     log(f\"Initializing MDI Engine (RTX 5080 / Ultra 9 285K) with options: {mdi_option}\")\n407:     log(query_rtx5080_status())\n408:     mdi.MDI_Init(mdi_option)\n409: \n410:     mdi.MDI_Register_Node(\"@DEFAULT\")\n411:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n412:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n413: \n414:     log(\"Waiting for MDI driver connection...\")\n415:     mdicomm = mdi.MDI_Accept_Communicator()\n416:     log(\"Connected to MDI driver! Entering communication loop...\")\n417: \n418:     while not exitflag:\n419:         command = mdi.MDI_Recv_Command(mdicomm)\n420:         execute_command(command, mdicomm, None)\n421: \n422:     # 全ステップ履歴があれば espresso.pwo に統合して auto_generate_progression_graphs.py が全点読めるようにする\n423:     if os.path.exists(\"espresso_all_steps.pwo\"):\n424:         shutil.copyfile(\"espresso_all_steps.pwo\", \"espresso.pwo\")\n425: \n426:     log(\"MDI Engine execution terminated cleanly.\")\n427: ","truncated_fields":["content"]}
