es.append(e_val)\n52:                 step_idx += 1\n53: \n54:     # 2.\n<truncated 6449 bytes>\n188:         ax.set_ylabel(r\"Total force [$\\mathrm{Ry/au}$]\", fontproperties=font_label, labelpad=5)\n189:         ax.set_xlim(-0.5, max_step + 0.5)\n190:         ax.xaxis.set_major_locator(ticker.MaxNLocator(integer=True, nbins=6))\n191:         for label in ax.get_xticklabels() + ax.get_yticklabels():\n192:             label.set_fontproperties(font_tick)\n193:         plt.subplots_adjust(left=0.22, right=0.95, top=0.94, bottom=0.18)\n194:         base = os.path.join(out_dir, \"Total_Force_progression\")\n195:         plt.savefig(f\"{base}.png\", dpi=dpi)\n196:         plt.savefig(f\"{base}.pdf\")\n197:         plt.savefig(f\"{base}.svg\")\n198:         plt.close()\n199: \n200:     # 3. Total SCF Correction progression\n201:     for out_dir in out_dirs:\n202:         fig, ax = plt.subplots(figsize=(width_in, height_in), dpi=dpi)\n203:         ax.plot(steps, scf_corrections, color=color, linestyle='-', linewidth=1.2, zorder=3)\n204:         ax.scatter(steps, scf_corrections, marker=marker, facecolors='none', edgecolors=color, s=msize, linewidths=1.2, zorder=4)\n205:         ax.set_xlabel(\"構造緩和ステップ数 [Step]\", fontproperties=font_label, labelpad=5)\n206:         ax.set_ylabel(r\"Total SCF correction [$\\mathrm{Ry/au}$]\", fontproperties=font_label, labelpad=5)\n207:         ax.set_xlim(-0.5, max_step + 0.5)\n208:         ax.xaxis.set_major_locator(ticker.MaxNLocator(integer=True, nbins=6))\n209:         for label in ax.get_xticklabels() + ax.get_yticklabels():\n210:             label.set_fontproperties(font_tick)\n211:         plt.subplots_adjust(left=0.22, right=0.95, top=0.94, bottom=0.18)\n212:         base = os.path.join(out_dir, \"Total_SCF_Correction_progression\")\n213:         plt.savefig(f\"{base}.png\", dpi=dpi)\n214:         plt.savefig(f\"{base}.pdf\")\n215:         plt.savefig(f\"{base}.svg\")\n216:         plt.close()\n217: \n218:     print(\"[AutoGraph] 