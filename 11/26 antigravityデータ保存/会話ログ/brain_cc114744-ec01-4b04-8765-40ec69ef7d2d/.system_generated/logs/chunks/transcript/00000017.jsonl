# Winmostar / OVITO 可視化用のアニメーション・軌跡ダンプ\n63: # (座標 x,y,z、速度 vx,vy,vz、第一原理力 fx,fy,fz を記録)\n64: dump 1 all custom 1 dump.lammpstrj id type x y z vx vy vz fx fy fz\n65: dump_modify 1 append yes\n66: \n67: # ------------------------------------------------------------------------------\n68: # 6. AIMD 実行\n69: # ------------------------------------------------------------------------------\n70: # タイムステップ数: 1000 step = 1000 fs = 1.0 ps\n71: # [構成の内訳]\n72: #   - Step 1 〜 500   (0.5 ps): 熱平衡化フェーズ (Equilibration: 300K に系を馴染ませる)\n73: #   - Step 501 〜 1000 (0.5 ps): サンプリングフェーズ (Production: 表面熱振動・熱平均構造の追跡)\n74: #\n75: # ※ 計算コストの目安 (Tesla T4 GPU):\n76: #   - 1 step 約 20 秒 × 1000 steps ≈ 約 5.5 時間 (Colab 1セッション内で安全に完了可能)\n77: #   - ※ 予備テストとして短時間で回したい場合は run 200 (約 1 時間) に変更可能\n78: run 1000\n79: \n80: undump 1","truncated_fields":["content"]}
