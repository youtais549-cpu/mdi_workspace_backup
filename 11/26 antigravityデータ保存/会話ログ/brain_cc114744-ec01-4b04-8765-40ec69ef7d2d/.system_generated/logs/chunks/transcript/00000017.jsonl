= qm_natoms\n215:     qm_elements = np.empty(n, dtype=np.int32)\n216:     qm_coords = np.empty((n, 3), dtype=np.float64)\n217:     qm_forces = np.empty((n, 3), dtype=np.float64)\n218:     last_evaluated_coords = None\n219: \n220: ","truncated_fields":["content"]}
