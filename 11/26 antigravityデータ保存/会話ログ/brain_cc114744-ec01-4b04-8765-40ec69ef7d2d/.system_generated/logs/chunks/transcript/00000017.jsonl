{"step_index":1079,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:19:35Z","content":"Created At: 2026-11-13T14:19:35+09:00\nCompleted At: 2026-11-13T14:19:35+09:00\nCreated At: 2026-11-13T14:19:35+09:00\nCompleted At: 2026-11-13T14:19:35+09:00\nShowing lines 160-230 of 268\n160:         cell_matrix_bohr = box.reshape(3, 3)\n161:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n162:     else:\n163:         cell_matrix_angstrom = np.eye(3) * 10.0\n164: \n165:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n166:     \n167:     pw_bin, _ = find_nvhpc_and_pw()\n168:     \n169:     pseudopotentials = {'Si': 'Si.upf', 'C': 'C.upf'}\n170:     input_data = {\n171:         'control': {\n172:             'calculation': 'scf',\n173:             'pseudo_dir': './',\n174:             'outdir': './tmp',\n175:             'tprnfor': True,\n176:             'tstress': True,\n177:             'disk_io': 'minimal'\n178:         },\n179:         'system': {\n180:             'ecutwfc': 40.0,\n181:             'ecutrho': 320.0,\n182:             'occupations': 'smearing',\n183:             'smearing': 'gaussian',\n184:             'degauss': 0.01\n185:         },\n186:         'electrons': {\n187:             'conv_thr': 1.0e-5,\n188:             'mixing_beta': 0.3,\n189:             'mixing_mode': 'local-TF',\n190:             'electron_maxstep': 200\n191:         }\n192:     }\n193: \n194:     command_str = f\"{pw_bin} -ndiag 1\"\n195:     log(f\"--- Running GPU SCF calculation with QE ({len(atoms)} atoms) ---\")\n196:     \n197:     t0 = time.time()\n198:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n199:     calc = Espresso(profile=profile, pseudopotentials=pseudopotentials, input_data=input_data, kpts=None)\n200:     atoms.calc = calc\n201:     \n202:     pe_ev = atoms.get_potential_energy()\n203:     forces_ev_angstrom = atoms.get_forces()\n204:     elapsed = time.time() - t0\n205:     \n206:     qm_pe = pe_ev * ev_to_hartree\n207:     qm_forces = forces_ev_angstrom * force_conv\n208:     \n209:     log(f\"--- Step Done in {elapsed:.2f}s! Total Energy: {pe_ev:.4f} eV ({qm_pe:.6f} Hartree) ---\")\n210:     last_evaluated_coords = np.copy(qm_coords)\n211: \n212: def execute_command(command, mdicomm, object_ptr):\n213:     global exitflag\n214:     if command == \"EXIT\":\n215:         log(\"Received EXIT command from driver.\")\n216:         exitflag = True\n217:     elif command == \">NATOMS\":\n218:         receive_qm_natoms(mdicomm)\n219:     elif command == \">CELL\":\n220:         receive_box(mdicomm)\n221:     elif command == \">ELEMENTS\":\n222:         receive_qm_elements(mdicomm)\n223:     elif command == \">TYPES\":\n224:         receive_qm_types(mdicomm)\n225:     elif command == \">COORDS\":\n226:         receive_qm_coords(mdicomm)\n227:     elif command in [\"<ENERGY\", \"<PE\"]:\n228:         evaluate()\n229:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n230:         if ierr: error(\"MDI: <ENERGY send failed\")"}
