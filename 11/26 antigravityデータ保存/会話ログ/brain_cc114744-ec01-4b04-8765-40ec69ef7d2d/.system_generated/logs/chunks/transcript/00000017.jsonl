{"step_index":1077,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:19:31Z","content":"Created At: 2026-11-13T14:19:31+09:00\nCompleted At: 2026-11-13T14:19:31+09:00\nCreated At: 2026-11-13T14:19:31+09:00\nCompleted At: 2026-11-13T14:19:31+09:00\nShowing lines 80-160 of 268\n80:     ld_path_str = \":\".join(all_libs)\n81:     \n82:     # 2. pw.x バイナリの検索\n83:     candidates = [\n84:         \"/content/bin/pw.x.gpu\",\n85:         \"/content/bin/pw.x.serial\",\n86:         \"/content/q-e/build_gpu_serial/bin/pw.x\",\n87:         \"/content/q-e/build/bin/pw.x\",\n88:         \"/content/bin/pw.x\",\n89:         \"/content/drive/MyDrive/mdi_binaries/pw.x\",\n90:         \"pw.x\"\n91:     ]\n92:     pw_bin = None\n93:     for cand in candidates:\n94:         if os.path.exists(cand) and os.access(cand, os.X_OK):\n95:             pw_bin = cand\n96:             break\n97:     if not pw_bin:\n98:         pw_bin = \"/content/bin/pw.x\"\n99:     log(f\"Using Quantum ESPRESSO binary: {pw_bin}\")\n100:     \n101:     return pw_bin, ld_path_str\n102: \n103: def allocate_qm():\n104:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n105:     n = qm_natoms\n106:     qm_elements = np.empty(n, dtype=np.int32)\n107:     qm_coords = np.empty((n, 3), dtype=np.float64)\n108:     qm_forces = np.empty((n, 3), dtype=np.float64)\n109:     last_evaluated_coords = None\n110: \n111: def receive_qm_natoms(mdicomm):\n112:     global qm_natoms\n113:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n114:     log(f\"Received >NATOMS: {qm_natoms}\")\n115:     allocate_qm()\n116: \n117: def receive_box(mdicomm):\n118:     global flag_box\n119:     flag_box = True\n120:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n121:     if ierr: error(\"MDI: >CELL reception failed\")\n122: \n123: def receive_qm_coords(mdicomm):\n124:     if not qm_natoms: error(\"Cannot receive >COORDS if # atoms = 0\")\n125:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n126:     if ierr: error(\"MDI: >COORDS reception failed\")\n127: \n128: def receive_qm_elements(mdicomm):\n129:     if not qm_natoms: error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n130:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n131:     if ierr: error(\"MDI: >ELEMENTS reception failed\")\n132: \n133: def receive_qm_types(mdicomm):\n134:     if not qm_natoms: error(\"Cannot receive >TYPES if # atoms = 0\")\n135:     types = np.empty(qm_natoms, dtype=np.int32)\n136:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n137:     if ierr: error(\"MDI: >TYPES reception failed\")\n138:     for i, t in enumerate(types):\n139:         sym = type_to_symbol.get(int(t), 'Si')\n140:         qm_elements[i] = ELEMENTS.index(sym) + 1\n141: \n142: def evaluate():\n143:     global qm_pe, qm_forces, last_evaluated_coords\n144:     \n145:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n146:         error(\"System atoms, elements, or coordinates not fully specified\")\n147: \n148:     # 座標キャッシュ: 同一ステップでの重複計算を防止\n149:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n150:         return\n151: \n152:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n153:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n154:     force_conv = ev_to_hartree * bohr_to_angstrom\n155: \n156:     coords_angstrom = qm_coords * bohr_to_angstrom\n157:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n158:     \n159:     if flag_box and np.linalg.norm(box) > 1e-6:\n160:         cell_matrix_bohr = box.reshape(3, 3)"}
