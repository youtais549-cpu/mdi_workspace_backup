{"step_index":1073,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:19:24Z","content":"Created At: 2026-11-13T14:19:24+09:00\nCompleted At: 2026-11-13T14:19:24+09:00\nCreated At: 2026-11-13T14:19:24+09:00\nCompleted At: 2026-11-13T14:19:24+09:00\nShowing lines 1-52 of 52\n1: #!/bin/bash\n2: # ==============================================================================\n3: # run_aimd_nvt_gpu.sh\n4: # 2H-SiC {10-10} 72原子スラブ (真空層各10Å)\n5: # 300K NVT 第一原理分子動力学 (AIMD) MDI 起動スクリプト (Colab T4 GPU 用)\n6: # ==============================================================================\n7: \n8: set -e\n9: PORT=8025\n10: DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n11: cd \"$DIR\"\n12: \n13: echo \"========================================================================\"\n14: echo \"  2H-SiC {10-10} 300K NVT AIMD (LAMMPS + Quantum ESPRESSO GPU via MDI)\"\n15: echo \"========================================================================\"\n16: echo \"Workdir: $DIR\"\n17: echo \"Port:    $PORT\"\n18: \n19: # 既存プロセスの安全停止\n20: pkill -f qe_mdi_engine_gpu.py || true\n21: killall -9 pw.x lmp pw.x.real 2>/dev/null || true\n22: sleep 1\n23: \n24: # 1. LAMMPS (Driver) 起動\n25: echo \"[1/3] Starting LAMMPS driver (NVT @ 300K)...\"\n26: /content/bin/lmp -mdi \"-role DRIVER -name LAMMPS -method TCP -port ${PORT}\" -in in.lammps > log.lammps 2>&1 &\n27: PID_LMP=$!\n28: \n29: sleep 2\n30: \n31: # 2. QE MDI Engine (GPU) 起動\n32: echo \"[2/3] Starting QE MDI GPU Engine...\"\n33: python3 qe_mdi_engine_gpu.py -mdi \"-role ENGINE -name QE -method TCP -port ${PORT} -hostname localhost\" > qe_engine.log 2>&1 &\n34: PID_QE=$!\n35: \n36: echo \"Processes started: LAMMPS (PID: $PID_LMP), QE Engine (PID: $PID_QE)\"\n37: echo \"Waiting for AIMD simulation to complete...\"\n38: \n39: # 終了待機\n40: wait $PID_LMP\n41: echo \"[3/3] LAMMPS completed. Waiting for QE engine to finalize...\"\n42: wait $PID_QE 2>/dev/null || true\n43: \n44: # Winmostar 用 XYZ アニメーション生成\n45: if [ -f \"dump.lammpstrj\" ]; then\n46:     echo \"Converting dump.lammpstrj to Winmostar animation XYZ...\"\n47:     python3 make_xyz.py dump.lammpstrj md_nvt_animation.xyz || true\n48: fi\n49: \n50: echo \"========================================================================\"\n51: echo \"  300K NVT AIMD Simulation Completed Successfully!\"\n52: echo \"========================================================================\""}
