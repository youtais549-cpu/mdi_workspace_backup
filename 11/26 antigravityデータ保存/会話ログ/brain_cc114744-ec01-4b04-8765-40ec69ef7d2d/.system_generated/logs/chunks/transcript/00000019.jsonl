ottom surface (Layer 1): z < 4.0\\n# Top surface (Layer 16): z > 21.5\\nbot_mask = z0 < 4.0\\ntop_mask = z0 > 21.5\\nsurf_mask = bot_mask | top_mask\\n\\n# 1. Final frame (step 100) analysis\\nfinal_pos = frames[-1][1][:, 2:5]\\ndr_final = final_pos - init_pos\\ndx_final = dr_final[:, 0]\\ndy_final = dr_final[:, 1]\\ndz_final = dr_final[:, 2]\\ndist_final = np.linalg.norm(dr_final, axis=1)\\n\\nprint('\\\\n=== [Step 100 (Final) Displacement Statistics] ===')\\nprint(f'All 288 atoms:')\\nprint(f'  Max 3D displacement |dr|: {dist_final.max():.4f} A (Atom {atom_ids[dist_final.argmax()]}, Type {\\\\\\\"Si\\\\\\\" if types[dist_final.argmax()]==2 else \\\\\\\"C\\\\\\\"})')\\nprint(f'  Mean 3D displacement: {dist_final.mean():.4f} A')\\nprint(f'  Max |dz|: {np.abs(dz_final).max():.4f} A (Atom {atom_ids[np.abs(dz_final).argmax()]})')\\n\n<truncated 2338 bytes>","WaitMsBeforeAsync":"5000","toolSummary":"\"Compute detailed displacement metrics from dump.lammpstrj\""}}],"truncated_fields":["tool_calls"]}
