{"step_index":1218,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-17T03:34:51Z","content":"Created At: 2026-11-17T12:34:51+09:00\nCompleted At: 2026-11-17T12:34:51+09:00\nCreated At: 2026-11-17T12:34:51+09:00\nCompleted At: 2026-11-17T12:34:51+09:00\nShowing lines 1-60 of 60\n1: import sys\n2: import os\n3: \n4: def dump_to_xyz(dump_file, xyz_file):\n5:     if not os.path.exists(dump_file):\n6:         print(f\"Error: {dump_file} not found\")\n7:         return\n8: \n9:     type_to_elem = {1: 'C', 2: 'Si'}\n10: \n11:     with open(dump_file, 'r') as fin, open(xyz_file, 'w') as fout:\n12:         lines = fin.readlines()\n13:         i = 0\n14:         n_frames = 0\n15:         while i < len(lines):\n16:             line = lines[i].strip()\n17:             if line == \"ITEM: TIMESTEP\":\n18:                 step = lines[i+1].strip()\n19:                 i += 2\n20:             elif line == \"ITEM: NUMBER OF ATOMS\":\n21:                 natoms = int(lines[i+1].strip())\n22:                 i += 2\n23:             elif line.startswith(\"ITEM: BOX BOUNDS\"):\n24:                 i += 4\n25:             elif line.startswith(\"ITEM: ATOMS\"):\n26:                 cols = line.split()[2:]\n27:                 id_idx = cols.index(\"id\")\n28:                 type_idx = cols.index(\"type\")\n29:                 x_idx = cols.index(\"x\")\n30:                 y_idx = cols.index(\"y\")\n31:                 z_idx = cols.index(\"z\")\n32: \n33:                 atoms_data = []\n34:                 for _ in range(natoms):\n35:                     i += 1\n36:                     parts = lines[i].split()\n37:                     aid = int(parts[id_idx])\n38:                     atype = int(parts[type_idx])\n39:                     x = float(parts[x_idx])\n40:                     y = float(parts[y_idx])\n41:                     z = float(parts[z_idx])\n42:                     elem = type_to_elem.get(atype, 'X')\n43:                     atoms_data.append((aid, elem, x, y, z))\n44: \n45:                 atoms_data.sort(key=lambda a: a[0])\n46: \n47:                 fout.write(f\"{natoms}\\n\")\n48:                 fout.write(f\"Lattice=\\\"\\\" Properties=species:S:1:pos:R:3 Time={step}\\n\")\n49:                 for a in atoms_data:\n50:                     fout.write(f\"{a[1]:2s} {a[2]:12.6f} {a[3]:12.6f} {a[4]:12.6f}\\n\")\n51:                 n_frames += 1\n52:                 i += 1\n53:             else:\n54:                 i += 1\n55:     print(f\"Converted {n_frames} frames to {xyz_file}\")\n56: \n57: if __name__ == \"__main__\":\n58:     src = sys.argv[1] if len(sys.argv) > 1 else \"dump.lammpstrj\"\n59:     dst = sys.argv[2] if len(sys.argv) > 2 else \"md_animation.xyz\"\n60:     dump_to_xyz(src, dst)"}
