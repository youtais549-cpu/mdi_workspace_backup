t(parts[4])])\\n        data.sort(key=lambda x: x[0])\\n        frames[step] = np.array(data)\\n        i += 9 + natoms\\n    else:\\n        i += 1\\n\\ninit = frames[0]\\ntypes = init[:, 1].astype(int)\\nz0 = init[:, 4]\\n\\n# Top surface (Layer 16): z0 > 22.0 (9 Si atoms, 9 C atoms)\\ntop_mask = z0 > 22.0\\ntop_si = top_mask & (types == 2)\\ntop_c = top_mask & (types == 1)\\n\\n# Bottom surface (Layer 1): z0 < 3.5 (9 Si atoms, 9 C atoms)\\nbot_mask = z0 < 3.5\\nbot_si = bot_mask & (types == 2)\\nbot_c = bot_mask & (types == 1)\\n\\nprint(f'{\\\\\\\"Step\\\\\\\":>4} | {\\\\\\\"Top_C_z\\\\\\\":>9} | {\\\\\\\"Top_Si_z\\\\\\\":>9} | {\\\\\\\"Top_Buckle(C-Si)\\\\\\\":>17} | {\\\\\\\"Bot_C_z\\\\\\\":>9} | {\\\\\\\"Bot_Si_z\\\\\\\":>9} | {\\\\\\\"Bot_Buckle(Si-C)\\\\\\\":>17} | {\\\\\\\"Gap(A)\\\\\\\":>8}')\\nprint('-'*105)\\nfor s in [0, 5, 10, 19, 27, 40, 50, 55, 70, 85, 100]:\\n    arr = frames[s]\\n    z = arr[:, 4]\\n    tc = z[top_c].mean()\\n    tsi = z[top_si].mean()\\n    t_buckle = tc - tsi # In top surface, C is higher than Si (C points outward, Si sinks inward)\\n    \\n    bc = z[bot_c].mean()\\n    bsi = z[bot_si].mean()\\n    b_buckle = bsi - bc # In bottom surface, z decreases outward. Si sinks inward (+z), C stays outward (-z), so (Si_z - C_z) > 0\\n    \\n    gap = (z.min() + 25.5354013) - z.max()\\n    print(f'{s:4d} | {tc:9.4f} | {tsi:9.4f} | {t_buckle:+17.4f} | {bc:9.4f} | {bsi:9.4f} | {b_buckle:+17.4f} | {gap:8.4f}')\\n\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Analyze surface buckling dynamics across key steps\""}}]}
