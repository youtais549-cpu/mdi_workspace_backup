etDir | Select-Object Name, Length\n37: \"\"\"\n38: \n39: enc = base64.b64encode(ps_script.encode(\"utf-16le\")).decode(\"ascii\")\n40: res = subprocess.run(\n41:     [\"/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe\", \"-NoProfile\", \"-EncodedCommand\", enc],\n42:     capture_output=True,\n43:     timeout=120,\n44: )\n45: print(res.stdout.decode(\"cp932\", errors=\"replace\"))\n46: if res.stderr:\n47:     print(\"STDERR:\", res.stderr.decode(\"cp932\", errors=\"replace\"))\n48: "}
