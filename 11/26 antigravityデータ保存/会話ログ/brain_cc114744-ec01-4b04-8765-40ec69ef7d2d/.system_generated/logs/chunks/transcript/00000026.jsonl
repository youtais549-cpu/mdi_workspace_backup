{"step_index":1547,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-24T02:39:34Z","content":"Created At: 2026-11-24T11:39:34+09:00\nCompleted At: 2026-11-24T11:39:34+09:00\nCreated At: 2026-11-24T11:39:34+09:00\nCompleted At: 2026-11-24T11:39:34+09:00\nShowing lines 1-91 of 91\n1: #!/bin/bash\n2: # ==============================================================================\n3: # setup_local_rtx5080_env.sh\n4: # 新PC (Core Ultra 9 285K / RAM 64GB / RTX 5080 16GB / Windows 11 Pro WSL2) 用\n5: # root権限 (sudo) 不要の高速セットアップスクリプト\n6: # ==============================================================================\n7: set -e\n8: \n9: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n10: WORKSPACE_DIR=\"$(dirname \"$SCRIPT_DIR\")\"\n11: ENV_PREFIX=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n12: MAMBA_ROOT=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/micromamba\"\n13: MAMBA_BIN=\"$MAMBA_ROOT/bin/micromamba\"\n14: LOCAL_BIN=\"$SCRIPT_DIR/bin\"\n15: mkdir -p \"$MAMBA_ROOT/bin\" \"$LOCAL_BIN\"\n16: \n17: echo \"============================================================\"\n18: echo \" Step 1: Micromamba パッケージマネージャの確認 (sudo 不要)\"\n19: echo \"============================================================\"\n20: if [ ! -x \"$MAMBA_BIN\" ]; then\n21:     curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj -C \"$MAMBA_ROOT/bin\" --strip-components=1 bin/micromamba\n22:     chmod +x \"$MAMBA_BIN\"\n23: fi\n24: echo \"✅ Micromamba ready: $MAMBA_BIN\"\n25: \n26: echo \"============================================================\"\n27: echo \" Step 2: Quantum ESPRESSO (pw.x) & Python 3.11 & CMake の高速導入\"\n28: echo \"============================================================\"\n29: if [ ! -x \"$ENV_PREFIX/bin/pw.x\" ]; then\n30:     rm -rf \"$ENV_PREFIX\"\n31:     \"$MAMBA_BIN\" create -y -p \"$ENV_PREFIX\" -c conda-forge \\\n32:         python=3.11 pip cmake qe\n33: else\n34:     echo \"✅ Quantum ESPRESSO ($ENV_PREFIX/bin/pw.x) already installed.\"\n35: fi\n36: \n37: export PATH=\"$LOCAL_BIN:$ENV_PREFIX/bin:$PATH\"\n38: export LD_LIBRARY_PATH=\"$ENV_PREFIX/lib:${LD_\n<truncated 567 bytes>\nNew Roman) 配置\"\n48: echo \"============================================================\"\n49: for f in \"$WORKSPACE_DIR/msmincho.ttc\" \"$WORKSPACE_DIR/times.ttf\" \"$WORKSPACE_DIR/環境設定・フォント/msmincho.ttc\" \"$WORKSPACE_DIR/環境設定・フォント/times.ttf\"; do\n50:     if [ -f \"$f\" ]; then\n51:         cp \"$f\" \"$SCRIPT_DIR/\" 2>/dev/null || true\n52:     fi\n53: done\n54: echo \"✅ Fonts copied to calculation directory.\"\n55: \n56: echo \"============================================================\"\n57: echo \" Step 5: LAMMPS (PKG_MDI=ON) の 24スレッド高速ビルド (Core Ultra 9 285K)\"\n58: echo \"============================================================\"\n59: if [ ! -x \"$LOCAL_BIN/lmp\" ]; then\n60:     BUILD_ROOT=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/lammps_mdi_build\"\n61:     mkdir -p \"$BUILD_ROOT\"\n62:     if [ ! -d \"$BUILD_ROOT/lammps\" ]; then\n63:         git clone --depth 1 -b release https://github.com/lammps/lammps.git \"$BUILD_ROOT/lammps\"\n64:     fi\n65:     rm -rf \"$BUILD_ROOT/lammps/build\"\n66:     mkdir -p \"$BUILD_ROOT/lammps/build\"\n67:     cd \"$BUILD_ROOT/lammps/build\"\n68:     \"$ENV_PREFIX/bin/cmake\" ../cmake \\\n69:         -DCMAKE_C_COMPILER=/usr/bin/gcc \\\n70:         -DCMAKE_CXX_COMPILER=/usr/bin/g++ \\\n71:         -DCMAKE_BUILD_TYPE=Release \\\n72:         -DBUILD_MPI=OFF \\\n73:         -DBUILD_OMP=ON \\\n74:         -DPKG_MDI=ON \\\n75:         -DPKG_MANYBODY=ON\n76:     \"$ENV_PREFIX/bin/cmake\" --build . -j 24\n77:     cp lmp \"$LOCAL_BIN/lmp\"\n78:     cp lmp \"$ENV_PREFIX/bin/lmp\"\n79:     echo \"✅ LAMMPS (PKG_MDI=ON) built and installed to $LOCAL_BIN/lmp\"\n80: else\n81:     echo \"✅ LAMMPS ($LOCAL_BIN/lmp) already built.\"\n82: fi\n83: \n84: ln -sf \"$ENV_PREFIX/bin/pw.x\" \"$LOCAL_BIN/pw.x\"\n85: \n86: echo \"============================================================\"\n87: echo \" 🎉 セットアップ完了！\"\n88: echo \"  - Python : $(which python3)\"\n89: echo \"  - pw.x   : $(which pw.x)\"\n90: echo \"  - lmp    : $(which lmp)\"\n91: echo \"============================================================\"","truncated_fields":["content"]}
