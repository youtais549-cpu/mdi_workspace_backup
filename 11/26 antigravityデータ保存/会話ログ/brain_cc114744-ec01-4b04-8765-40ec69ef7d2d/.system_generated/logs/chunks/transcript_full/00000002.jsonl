{"step_index":100,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:25Z","content":"Created At: 2026-11-05T14:36:25+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-170 of 170\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: スラブモデルおよびバルクモデル自動生成ツール\n4: 【ユーザー実行コマンド】\n5: python3 generate_models.py\n6: \n7: model_settings.py と dft_settings.py を読み込み、\n8: 任意の結晶面・周期数・真空層厚さに応じたスラブ・バルクモデル構造ファイル(.data, .cif, .xyz)\n9: および表面積評価メタデータを自動生成します。\n10: \"\"\"\n11: import os\n12: import sys\n13: import json\n14: import numpy as np\n15: from ase import Atoms\n16: import ase.io\n17: from ase.io.lammpsdata import write_lammps_data\n18: \n19: # 設定ファイルの読み込み\n20: sys.path.append(os.path.dirname(os.path.abspath(__file__)))\n21: import model_settings as ms\n22: import dft_settings as ds\n23: \n24: def build_2h_sic_10_10(n_periods, supercell_xy, vacuum):\n25:     \"\"\"\n26:     2H-SiC {10-10} 非極性 m面のスラブおよびバルクモデルを生成\n27:     \"\"\"\n28:     a = ms.LATTICE_A\n29:     c = ms.LATTICE_C\n30:     u = ms.U_PARAM\n31:     nx, ny = supercell_xy\n32:     \n33:     # {10-10} 面に垂直な方向の1周期厚さ d_{10-10} = sqrt(3)*a/2 * 2 = sqrt(3)*a\n34:     d_10_10 = np.sqrt(3) * a\n35:     \n36:     # 直交基本セル (1周期 = 2層, 4原子: 2 Si, 2 C)\n37:     # x: [11-20], y: [0001] (c軸), z: [10-10] (へき開面法線)\n38:     # 粗結合面 (dz = 1.776Å) で切断し、上面・下面を完全等価(非極性)にする\n39:     dense_dz = d_10_10 / 6.0    # ~0.888 Å\n40:     sparse_dz = d_10_10 / 3.0   # ~1.776 Å\n41:     \n42:     unit_positions = []\n43:     unit_symbols = []\n44:     \n45:     # 周期数 n_periods 分だけ z 方向に積層\n46:     for p in range(n_periods):\n47:         base_z = p * (dense_dz + sparse_dz)\n48:         # Layer 1 (z = base_z + dense_dz)\n49:         z1 = base_z + dense_dz\n50:         unit_positions.append([0.0, 0.0, z1])\n51:         unit_symbols.append('Si')\n52:         unit_positions.append([0.5 * a, 0.5 * c, z1])\n53:         unit_symbols.append('C')\n54:         \n55:         # Layer 2 (z = base_z + dense_dz + sparse_dz)\n56:         z2 = z1 + sparse_dz\n57:         unit_positions.append([0.5 * a, 0.0, z2])\n58:         unit_symbols.append('Si')\n59:         unit_positions.append([0.0, 0.5 * c, z2])\n60:         unit_symbols.append('C')\n61:         \n62:     unit_positions = np.array(unit_positions)\n63:     slab_thickness = unit_positions[:, 2].max() - unit_positions[:, 2].min()\n64:     \n65:     # --- 1. スラブモデルの構築 (真空層あり) ---\n66:     cell_slab = [a * nx, c * ny, slab_thickness + 2.0 * vacuum]\n67:     pos_slab = []\n68:     sym_slab = []\n69:     \n70:     for ix in range(nx):\n71:         for iy in range(ny):\n72:             for i in range(len(unit_positions)):\n73:                 x = (unit_positions[i, 0] + ix * a) % cell_slab[0]\n74:                 y = (unit_positions[i, 1] + iy * c) % cell_slab[1]\n75:                 z = unit_positions[i, 2] - unit_positions[:, 2].min() + vacuum\n76:                 pos_slab.append([x, y, z])\n77:                 sym_slab.append(unit_symbols[i])\n78:                 \n79:     slab_atoms = Atoms(symbols=sym_slab, positions=pos_slab, cell=cell_slab, pbc=[True, True, True])\n80:     \n81:     # --- 2. バルク基準モデルの構築 (真空層なし, 同一原子数) ---\n82:     cell_bulk = [a * nx, c * ny, n_periods * d_10_10]\n83:     pos_bulk = []\n84:     sym_bulk = []\n85:     for ix in range(nx):\n86:         for iy in range(ny):\n87:             for i in range(len(unit_positions)):\n88:                 x = (unit_positions[i, 0] + ix * a) % cell_bulk[0]\n89:                 y = (unit_positions[i, 1] + iy * c) % cell_bulk[1]\n90:                 z = unit_positions[i, 2] % cell_bulk[2]\n91:                 pos_bulk.append([x, y, z])\n92:                 sym_bulk.append(unit_symbols[i])\n93:                 \n94:     bulk_atoms = Atoms(symbols=sym_bulk, positions=pos_bulk, cell=cell_bulk, pbc=[True, True, True])\n95:     \n96:     # 破面断面積 A の算出\n97:     area_A = (a * nx) * (c * ny)\n98:     \n99:     return slab_atoms, bulk_atoms, area_A\n100: \n101: def main():\n102:     print(\"==================================================\")\n103:     print(\" 表面破壊エネルギー用 モデル自動生成ツール\")\n104:     print(\"==================================================\")\n105:     print(f\"結晶面: {ms.CLEAVAGE_PLANE}\")\n106:     print(f\"周期数: {ms.N_PERIODS} 周期 ({ms.N_PERIODS * 2} 層)\")\n107:     print(f\"面内サイズ: {ms.SUPERCELL_XY[0]} x {ms.SUPERCELL_XY[1]}\")\n108:     print(f\"真空層厚さ: {ms.VACUUM_THICKNESS} Å (上下各 {ms.VACUUM_THICKNESS} Å)\")\n109:     \n110:     if ms.CLEAVAGE_PLANE == '10-10':\n111:         slab, bulk, area_A = build_2h_sic_10_10(ms.N_PERIODS, ms.SUPERCELL_XY, ms.VACUUM_THICKNESS)\n112:     else:\n113:         raise NotImplementedError(f\"結晶面 '{ms.CLEAVAGE_PLANE}' のジェネレーターは準備中です。'10-10' を指定してください。\")\n114:         \n115:     n_atoms = len(slab)\n116:     area_2A = 2.0 * area_A\n117:     conv_factor = 16.021766\n118:     \n119:     print(\"--------------------------------------------------\")\n120:     print(f\"総原子数 (スラブ & バルク共通): {n_atoms} 原子\")\n121:     print(f\"スラブセル寸法: Lx={slab.cell[0,0]:.4f}Å, Ly={slab.cell[1,1]:.4f}Å, Lz={slab.cell[2,2]:.4f}Å\")\n122:     print(f\"バルクセル寸法: Lx={bulk.cell[0,0]:.4f}Å, Ly={bulk.cell[1,1]:.4f}Å, Lz={bulk.cell[2,2]:.4f}Å\")\n123:     print(f\"破面断面積 A   : {area_A:.4f} Å²\")\n124:     print(f\"全破面表面積 2A: {area_2A:.4f} Å²\")\n125:     print(f\"換算式: γ [J/m²] = (E_slab - E_bulk) / {area_2A:.4f} * {conv_factor:.6f}\")\n126:     print(f\"                 = ΔE / {area_2A / conv_factor:.4f}\")\n127:     print(\"--------------------------------------------------\")\n128:     \n129:     out_dir = os.path.dirname(os.path.abspath(__file__))\n130:     prefix_slab = os.path.join(out_dir, f\"slab_{ms.CLEAVAGE_PLANE}_{n_atoms}atoms\")\n131:     prefix_bulk = os.path.join(out_dir, f\"bulk_{ms.CLEAVAGE_PLANE}_{n_atoms}atoms\")\n132:     \n133:     # スラブファイルの出力\n134:     ase.io.write(f\"{prefix_slab}.cif\", slab)\n135:     ase.io.write(f\"{prefix_slab}.xyz\", slab)\n136:     write_lammps_data(f\"{prefix_slab}.data\", slab, atom_style='atomic', masses=True)\n137:     \n138:     # バルクファイルの出力\n139:     ase.io.write(f\"{prefix_bulk}.cif\", bulk)\n140:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk)\n141:     write_lammps_data(f\"{prefix_bulk}.data\", bulk, atom_style='atomic', masses=True)\n142:     \n143:     # メタデータ JSON の出力 (calc_surface_energy.py で自動参照)\n144:     meta = {\n145:         'cleavage_plane': ms.CLEAVAGE_PLANE,\n146:         'n_periods': ms.N_PERIODS,\n147:         'n_layers': ms.N_PERIODS * 2,\n148:         'natoms': n_atoms,\n149:         'vacuum_thickness_angstrom': ms.VACUUM_THICKNESS,\n150:         'supercell_xy': list(ms.SUPERCELL_XY),\n151:         'cell_slab': [float(slab.cell[0,0]), float(slab.cell[1,1]), float(slab.cell[2,2])],\n152:         'cell_bulk': [float(bulk.cell[0,0]), float(bulk.cell[1,1]), float(bulk.cell[2,2])],\n153:         'area_A_angstrom2': float(area_A),\n154:         'total_area_2A_angstrom2': float(area_2A),\n155:         'unit_conversion_eV_A2_to_J_m2': conv_factor,\n156:         'effective_denominator': float(area_2A / conv_factor),\n157:         'slab_data_file': os.path.basename(f\"{prefix_slab}.data\"),\n158:         'bulk_data_file': os.path.basename(f\"{prefix_bulk}.data\")\n159:     }\n160:     meta_path = os.path.join(out_dir, \"fracture_metadata.json\")\n161:     with open(meta_path, \"w\", encoding=\"utf-8\") as f:\n162:         json.dump(meta, f, indent=4)\n163:         \n164:     print(f\"✅ モデルファイルおよびメタデータを生成しました:\")\n165:     print(f\"  - スラブ: {os.path.basename(prefix_slab)}.[data|cif|xyz]\")\n166:     print(f\"  - バルク: {os.path.basename(prefix_bulk)}.[data|cif|xyz]\")\n167:     print(f\"  - メタデータ: fracture_metadata.json\")\n168: \n169: if __name__ == \"__main__\":\n170:     main()"}
{"step_index":101,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:26Z","content":"Created At: 2026-11-05T14:36:26+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-42 of 42\n1: \"\"\"\n2: 第一原理電子状態計算 (DFT / Quantum ESPRESSO) のパラメータ設定ファイル\n3: 【ユーザー編集対象 (必要な場合のみ)】\n4: 通常はデフォルト設定のままで高精度かつ安定に収束します。\n5: カットオフエネルギーの収束性テストや k点メッシュの変更を行う場合はここを編集します。\n6: \"\"\"\n7: \n8: DFT_CONFIG = {\n9:     # 波動関数カットオフエネルギー (Ry)\n10:     # 推奨値: 40.0 Ry (PAW擬ポテンシャル下で結合エネルギーが十分収束)\n11:     'ecutwfc': 40.0,\n12: \n13:     # 電荷密度カットオフエネルギー (Ry)\n14:     # 推奨値: 320.0 Ry (PAWでは通常 ecutwfc の 8〜10倍を設定)\n15:     'ecutrho': 320.0,\n16: \n17:     # SCF電子状態収束閾値 (Ry)\n18:     # 推奨値: 1.0e-5 (力・エネルギーの精度として十分)\n19:     'conv_thr': 1.0e-5,\n20: \n21:     # k点サンプリング\n22:     # None: Γ点のみ (K_POINTS gamma)\n23:     # スーパーセル (3x3以上, 9Å以上) では逆格子空間が狭いため None (Γ点) で十分収束します。\n24:     # 単位胞や小さめのセルの場合は (2, 2, 1) などのタプルを指定可能\n25:     'kpts': None,\n26: \n27:     # 電子占有・スメアリング設定\n28:     'occupations': 'smearing',\n29:     'smearing': 'gaussian',\n30:     'degauss': 0.01,  # Ry\n31: \n32:     # 電子密度ミキシング設定 (SCF収束の安定化)\n33:     'mixing_beta': 0.3,\n34:     'mixing_mode': 'local-TF',  # 表面スラブ特有の電荷振動を抑える局所Thomas-Fermi法\n35:     'electron_maxstep': 200,\n36: \n37:     # 擬ポテンシャルファイル名\n38:     'pseudopotentials': {\n39:         'Si': 'Si.upf',\n40:         'C': 'C.upf'\n41:     }\n42: }"}
{"step_index":102,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:26Z","content":"Created At: 2026-11-05T14:36:26+09:00\nCompleted At: 2026-11-05T14:36:26+09:00\nShowing lines 1-32 of 32\n1: \"\"\"\n2: スラブモデルおよびバルク基準モデルの幾何学的パラメータ設定ファイル\n3: 【ユーザー編集対象】\n4: 条件を変更する際は、このファイルの数値を変更してください。\n5: \"\"\"\n6: \n7: # 1. 亀裂を入れる結晶面 (へき開面)\n8: # 選択肢: '10-10' (非極性 m面, 推奨), '11-20' (非極性 a面), '0001' (極性 c面)\n9: CLEAVAGE_PLANE = '10-10'\n10: \n11: # 2. 周期数 (厚み方向のユニットリピート数)\n12: # '10-10' の場合: 1周期 = 2層 (原子密な二重層と疎な層の1組)\n13: # N_PERIODS = 2 -> 4層 (72原子)\n14: # N_PERIODS = 3 -> 6層 (108原子)\n15: # N_PERIODS = 4 -> 8層 (144原子)\n16: # N_PERIODS = 6 -> 12層 (216原子)\n17: N_PERIODS = 6\n18: \n19: # 3. 面内スーパーセルの倍率 (Nx, Ny)\n20: # Nx: 破面内の水平方向倍率\n21: # Ny: 破面内の垂直方向倍率\n22: SUPERCELL_XY = (3, 3)\n23: \n24: # 4. 真空層の厚さ (Å)\n25: # スラブの上面・下面の先にそれぞれ挿入する真空の厚さ\n26: # 5.0 Å (上下合わせて 10.0 Å: 真空層収束性テスト用)\n27: VACUUM_THICKNESS = 5.0\n28: \n29: # 5. 材料定数 (2H-SiC)\n30: LATTICE_A = 3.076  # Å (a軸格子定数)\n31: LATTICE_C = 5.048  # Å (c軸格子定数)\n32: U_PARAM = 0.375    # 内部パラメータ u"}
