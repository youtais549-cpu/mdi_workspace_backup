{"step_index":87,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:01Z","content":"Created At: 2026-11-05T14:36:01+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-42 of 42\n1: # 2H-SiC {10-10} 3x3x2 スラブモデル (72原子) 計算入力スクリプト\n2: units metal\n3: boundary p p p\n4: atom_style atomic\n5: atom_modify map yes\n6: \n7: # 1. 初期構造の読み込み (3x3x2, 72原子)\n8: # (A) スラブモデル (4層, 真空各10Å)\n9: read_data 2H-SiC_10-10_slab_3x3x2_vac5A.data\n10: # (B) バルク基準モデル (真空なし) を計算する場合は上記をコメントアウトし、下記を有効化:\n11: # read_data 2H-SiC_10-10_bulk_3x3x2_72atoms.data\n12: \n13: # 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)\n14: mass 1 12.011\n15: mass 2 28.085\n16: \n17: # 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)\n18: fix 1 all mdi/qm elements C Si\n19: \n20: # 3. 出力設定\n21: thermo 1\n22: dump 1 all custom 1 dump.lammpstrj id type x y z\n23: dump_modify 1 append yes\n24: \n25: # -------------------------------------------------------------\n26: # 【計算モードの選択】\n27: # (A) 表面構造緩和 (minimize) - 表面破壊エネルギー評価用の力極小化\n28: # -------------------------------------------------------------\n29: # 力の閾値 1.0e-3 eV/Å 以下になるまで共役勾配法(CG)でエネルギー最小化\n30: minimize 0.0 1.0e-3 100 1000\n31: \n32: # -------------------------------------------------------------\n33: # (B) 有限温度第一原理MD (AIMD, 300K) を行う場合は上記をコメントアウトし、\n34: #     下記を有効にしてください:\n35: # -------------------------------------------------------------\n36: # velocity all create 300.0 12345\n37: # fix 2 all nve\n38: # timestep 0.001\n39: # run 20\n40: # -------------------------------------------------------------\n41: \n42: undump 1"}
{"step_index":88,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:01Z","content":"Created At: 2026-11-05T14:36:01+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-268 of 268\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: T4 GPU 対応 Quantum ESPRESSO MDI エンジン\n4: LAMMPS (DRIVER) から MDI 経由で座標を受信し、GPU版 pw.x で SCF 計算を行い、力とエネルギーを返信する。\n5: \"\"\"\n6: import sys\n7: import os\n8: import glob\n9: import time\n10: import numpy as np\n11: import mdi\n12: from ase import Atoms\n13: from ase.calculators.espresso import Espresso, EspressoProfile\n14: import ase.parallel\n15: ase.parallel.world = ase.parallel.DummyMPI()\n16: \n17: ELEMENTS = [\n18:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n19:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n20:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n21:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n22:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n23:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n24:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n25:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n26:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n27:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n28:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n29:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n30: ]\n31: atomic_number_to_symbol = {i+1: symbol for i, symbol in enumerate(ELEMENTS)}\n32: type_to_symbol = {1: 'C', 2: 'Si'}\n33: \n34: exitflag = False\n35: qm_natoms = 0\n36: qm_elements = None\n37: qm_coords = None\n38: box = np.zeros(9, dtype=np.float64)\n39: flag_box = False\n40: \n41: qm_pe = 0.0\n42: qm_forces = None\n43: last_evaluated_coords = None\n44: \n45: def log(msg):\n46:     print(f\"[QE-MDI GPU Engine] {msg}\", flush=True)\n47: \n48: def error(txt):\n49:     log(f\"ERROR: {txt}\")\n50:     sys.exit(1)\n51: \n52: def find_nvhpc_and_pw():\n53:     \"\"\"NVHPCライブラリパスおよびGPU版pw.xバイナリの自動検出\"\"\"\n54:     # 1. NVHPCパスの検索\n55:     nvhpc_roots = glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\")\n56:     nvhpc_libs = []\n57:     if nvhpc_roots:\n58:         # 最新バージョンを優先\n59:         nvhpc_roots.sort(reverse=True)\n60:         root = nvhpc_roots[0]\n61:         nvhpc_libs = [\n62:             f\"{root}/compilers/lib\",\n63:             f\"{root}/math_libs/lib64\",\n64:             f\"{root}/cuda/lib64\",\n65:             f\"{root}/comm_libs/mpi/lib\"\n66:         ]\n67:         # 追加のcomm_libs/hpcxパス\n68:         hpcx_libs = glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\")\n69:         nvhpc_libs.extend(hpcx_libs)\n70:         log(f\"Detected NVHPC SDK at: {root}\")\n71:     \n72:     cuda_libs = [\n73:         \"/usr/local/cuda/lib64\",\n74:         \"/usr/lib64-nvidia\",\n75:         \"/usr/local/nvidia/lib\",\n76:         \"/usr/local/nvidia/lib64\",\n77:         \"/usr/lib/x86_64-linux-gnu\"\n78:     ]\n79:     all_libs = [p for p in (nvhpc_libs + cuda_libs) if os.path.exists(p)]\n80:     ld_path_str = \":\".join(all_libs)\n81:     \n82:     # 2. pw.x バイナリの検索\n83:     candidates = [\n84:         \"/content/bin/pw.x.gpu\",\n85:         \"/content/bin/pw.x.serial\",\n86:         \"/content/q-e/build_gpu_serial/bin/pw.x\",\n87:         \"/content/q-e/build/bin/pw.x\",\n88:         \"/content/bin/pw.x\",\n89:         \"/content/drive/MyDrive/mdi_binaries/pw.x\",\n90:         \"pw.x\"\n91:     ]\n92:     pw_bin = None\n93:     for cand in candidates:\n94:         if os.path.exists(cand) and os.access(cand, os.X_OK):\n95:             pw_bin = cand\n96:             break\n97:     if not pw_bin:\n98:         pw_bin = \"/content/bin/pw.x\"\n99:     log(f\"Using Quantum ESPRESSO binary: {pw_bin}\")\n100:     \n101:     return pw_bin, ld_path_str\n102: \n103: def allocate_qm():\n104:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n105:     n = qm_natoms\n106:     qm_elements = np.empty(n, dtype=np.int32)\n107:     qm_coords = np.empty((n, 3), dtype=np.float64)\n108:     qm_forces = np.empty((n, 3), dtype=np.float64)\n109:     last_evaluated_coords = None\n110: \n111: def receive_qm_natoms(mdicomm):\n112:     global qm_natoms\n113:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n114:     log(f\"Received >NATOMS: {qm_natoms}\")\n115:     allocate_qm()\n116: \n117: def receive_box(mdicomm):\n118:     global flag_box\n119:     flag_box = True\n120:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n121:     if ierr: error(\"MDI: >CELL reception failed\")\n122: \n123: def receive_qm_coords(mdicomm):\n124:     if not qm_natoms: error(\"Cannot receive >COORDS if # atoms = 0\")\n125:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n126:     if ierr: error(\"MDI: >COORDS reception failed\")\n127: \n128: def receive_qm_elements(mdicomm):\n129:     if not qm_natoms: error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n130:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n131:     if ierr: error(\"MDI: >ELEMENTS reception failed\")\n132: \n133: def receive_qm_types(mdicomm):\n134:     if not qm_natoms: error(\"Cannot receive >TYPES if # atoms = 0\")\n135:     types = np.empty(qm_natoms, dtype=np.int32)\n136:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n137:     if ierr: error(\"MDI: >TYPES reception failed\")\n138:     for i, t in enumerate(types):\n139:         sym = type_to_symbol.get(int(t), 'Si')\n140:         qm_elements[i] = ELEMENTS.index(sym) + 1\n141: \n142: def evaluate():\n143:     global qm_pe, qm_forces, last_evaluated_coords\n144:     \n145:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n146:         error(\"System atoms, elements, or coordinates not fully specified\")\n147: \n148:     # 座標キャッシュ: 同一ステップでの重複計算を防止\n149:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n150:         return\n151: \n152:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n153:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n154:     force_conv = ev_to_hartree * bohr_to_angstrom\n155: \n156:     coords_angstrom = qm_coords * bohr_to_angstrom\n157:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n158:     \n159:     if flag_box and np.linalg.norm(box) > 1e-6:\n160:         cell_matrix_bohr = box.reshape(3, 3)\n161:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n162:     else:\n163:         cell_matrix_angstrom = np.eye(3) * 10.0\n164: \n165:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n166:     \n167:     pw_bin, _ = find_nvhpc_and_pw()\n168:     \n169:     pseudopotentials = {'Si': 'Si.upf', 'C': 'C.upf'}\n170:     input_data = {\n171:         'control': {\n172:             'calculation': 'scf',\n173:             'pseudo_dir': './',\n174:             'outdir': './tmp',\n175:             'tprnfor': True,\n176:             'tstress': True,\n177:             'disk_io': 'minimal'\n178:         },\n179:         'system': {\n180:             'ecutwfc': 40.0,\n181:             'ecutrho': 320.0,\n182:             'occupations': 'smearing',\n183:             'smearing': 'gaussian',\n184:             'degauss': 0.01\n185:         },\n186:         'electrons': {\n187:             'conv_thr': 1.0e-5,\n188:             'mixing_beta': 0.3,\n189:             'mixing_mode': 'local-TF',\n190:             'electron_maxstep': 200\n191:         }\n192:     }\n193: \n194:     command_str = f\"{pw_bin} -ndiag 1\"\n195:     log(f\"--- Running GPU SCF calculation with QE ({len(atoms)} atoms) ---\")\n196:     \n197:     t0 = time.time()\n198:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n199:     calc = Espresso(profile=profile, pseudopotentials=pseudopotentials, input_data=input_data, kpts=None)\n200:     atoms.calc = calc\n201:     \n202:     pe_ev = atoms.get_potential_energy()\n203:     forces_ev_angstrom = atoms.get_forces()\n204:     elapsed = time.time() - t0\n205:     \n206:     qm_pe = pe_ev * ev_to_hartree\n207:     qm_forces = forces_ev_angstrom * force_conv\n208:     \n209:     log(f\"--- Step Done in {elapsed:.2f}s! Total Energy: {pe_ev:.4f} eV ({qm_pe:.6f} Hartree) ---\")\n210:     last_evaluated_coords = np.copy(qm_coords)\n211: \n212: def execute_command(command, mdicomm, object_ptr):\n213:     global exitflag\n214:     if command == \"EXIT\":\n215:         log(\"Received EXIT command from driver.\")\n216:         exitflag = True\n217:     elif command == \">NATOMS\":\n218:         receive_qm_natoms(mdicomm)\n219:     elif command == \">CELL\":\n220:         receive_box(mdicomm)\n221:     elif command == \">ELEMENTS\":\n222:         receive_qm_elements(mdicomm)\n223:     elif command == \">TYPES\":\n224:         receive_qm_types(mdicomm)\n225:     elif command == \">COORDS\":\n226:         receive_qm_coords(mdicomm)\n227:     elif command in [\"<ENERGY\", \"<PE\"]:\n228:         evaluate()\n229:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n230:         if ierr: error(\"MDI: <ENERGY send failed\")\n231:     elif command == \"<FORCES\":\n232:         evaluate()\n233:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n234:         if ierr: error(\"MDI: <FORCES send failed\")\n235:     else:\n236:         error(f\"Unrecognized MDI command: {command}\")\n237:     return 0\n238: \n239: if __name__ == \"__main__\":\n240:     args = sys.argv\n241:     mdi_option = \"\"\n242:     iarg = 1\n243:     while iarg < len(args):\n244:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n245:             if iarg + 1 < len(args):\n246:                 mdi_option = args[iarg + 1]\n247:                 break\n248:         iarg += 1\n249: \n250:     if not mdi_option:\n251:         error(\"Missing -mdi argument on command line\")\n252: \n253:     log(f\"Initializing MDI Engine with options: {mdi_option}\")\n254:     mdi.MDI_Init(mdi_option)\n255:     \n256:     mdi.MDI_Register_Node(\"@DEFAULT\")\n257:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n258:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n259: \n260:     log(\"Waiting for MDI driver connection...\")\n261:     mdicomm = mdi.MDI_Accept_Communicator()\n262:     log(\"Connected to MDI driver! Entering communication loop...\")\n263: \n264:     while not exitflag:\n265:         command = mdi.MDI_Recv_Command(mdicomm)\n266:         execute_command(command, mdicomm, None)\n267:         \n268:     log(\"MDI Engine execution terminated cleanly.\")"}
{"step_index":89,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:02Z","content":"Created At: 2026-11-05T14:36:02+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-35 of 35\n1: #!/bin/bash\n2: # run_colab_gpu.sh\n3: # Colab上で T4 GPU を用いて LAMMPS + QE MDI結合計算を実行するスクリプト\n4: \n5: rm -rf tmp qe.out qe_mdi.pwo qe_mdi.pwi dump.lammpstrj qe_engine.log nohup.out\n6: \n7: echo \"==========================================\"\n8: echo \" Starting LAMMPS + QE MDI Simulation (GPU)\"\n9: echo \" Model: 2H-SiC {10-10} Slab (72 atoms)\"\n10: echo \"==========================================\"\n11: \n12: # OpenMPI / 環境変数の最適化\n13: export OMPI_ALLOW_RUN_AS_ROOT=1\n14: export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1\n15: \n16: # 1. LAMMPS を MDI DRIVER としてバックグラウンド起動\n17: echo \"1. Starting LAMMPS MDI driver...\"\n18: /content/bin/lmp -mdi \"-role DRIVER -name LAMMPS -method TCP -port 8021\" -in in.lammps > lmp.log 2>&1 &\n19: LMP_PID=$!\n20: \n21: sleep 1\n22: \n23: # 2. Python QE MDI Engine (GPU) を起動\n24: echo \"2. Starting Python QE MDI engine (T4 GPU)...\"\n25: python3 qe_mdi_engine_gpu.py -mdi \"-role ENGINE -name QE -method TCP -port 8021 -hostname localhost\" > qe_engine.log 2>&1\n26: \n27: # 3. 完了待機\n28: wait $LMP_PID\n29: \n30: echo \"==========================================\"\n31: echo \" Calculation Completed Successfully!\"\n32: echo \" Converting trajectory to XYZ format...\"\n33: python3 make_xyz.py dump.lammpstrj md_animation.xyz 2>/dev/null || true\n34: echo \" Done!\"\n35: echo \"==========================================\""}
{"step_index":90,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:02Z","content":"Created At: 2026-11-05T14:36:02+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-79 of 79\n1: #!/bin/bash\n2: # ==============================================================================\n3: # master_run_gpu.sh\n4: # 2H-SiC {10-10} スラブモデル (真空層 5.0Å, 72原子)\n5: # T4 GPU 構造緩和計算 起動 & Google Drive 自動同期スクリプト\n6: # ==============================================================================\n7: \n8: WORK_DIR=\"/content/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n9: BACKUP_DIR=\"/content/drive/MyDrive/MD_backup/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n10: \n11: echo \"1. Python パッケージの確認...\"\n12: pip install --quiet ase pymdi\n13: \n14: echo \"2. NVHPC 環境の確認...\"\n15: NVHPC_HOME=/opt/nvidia/hpc_sdk/Linux_x86_64/24.7\n16: if [ ! -d \"$NVHPC_HOME\" ]; then\n17:     echo \"NVHPC SDK をインストールしています...\"\n18:     echo \"deb [trusted=yes] https://developer.download.nvidia.com/hpc-sdk/ubuntu/amd64 /\" | sudo tee /etc/apt/sources.list.d/nvhpc.list\n19:     sudo apt-get update -y\n20:     sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nvhpc-24-7\n21: fi\n22: \n23: echo \"3. バイナリの配置...\"\n24: mkdir -p /content/bin\n25: if [ -f /content/drive/MyDrive/mdi_binaries/lmp ]; then\n26:     cp /content/drive/MyDrive/mdi_binaries/lmp /content/bin/\n27: fi\n28: if [ -f /content/drive/MyDrive/mdi_binaries/pw.x.real ]; then\n29:     cp /content/drive/MyDrive/mdi_binaries/pw.x.real /content/bin/\n30: fi\n31: \n32: # pw.x ラッパー\n33: cat << 'WRAPPER_EOF' > /content/bin/pw.x\n34: #!/bin/bash\n35: NVHPC_HOME=/opt/nvidia/hpc_sdk/Linux_x86_64/24.7\n36: rm -f $NVHPC_HOME/cuda/12.2 2>/dev/null || true\n37: ln -sf 12.5 $NVHPC_HOME/cuda/12.2 2>/dev/null || true\n38: export PATH=$NVHPC_HOME/compilers/bin:$NVHPC_HOME/comm_libs/mpi/bin:$NVHPC_HOME/cuda/bin:$PATH\n39: export LD_LIBRARY_PATH=$NVHPC_HOME/compilers/lib:$NVHPC_HOME/math_libs/lib64:$NVHPC_HOME/cuda/lib64:$NVHPC_HOME/comm_libs/mpi/lib:$LD_LIBRARY_PATH\n40: HPCX_INIT=$(find /opt/nvidia/hpc_sdk/Linux_x86_64 -name \"hpcx-init.sh\" 2>/dev/null | sort -V | tail -n 1)\n41: if [ -n \"$HPCX_INIT\" ] && [ -f \"$HPCX_INIT\" ]; then\n42:     source \"$HPCX_INIT\"\n43:     hpcx_load\n44: fi\n45: export OMPI_ALLOW_RUN_AS_ROOT=1\n46: export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1\n47: exec mpirun --allow-run-as-root -np 1 /content/bin/pw.x.real \"$@\"\n48: WRAPPER_EOF\n49: \n50: chmod +x /content/bin/* 2>/dev/null || true\n51: \n52: echo \"4. GPU 状態の確認...\"\n53: nvidia-smi\n54: \n55: echo \"5. 計算のバックグラウンド開始...\"\n56: cd \"$WORK_DIR\"\n57: nohup bash run_colab_gpu.sh > nohup.out 2>&1 &\n58: CALC_PID=$!\n59: \n60: echo \"6. Google Drive への自動バックアップ設定 (5分間隔)...\"\n61: mkdir -p \"$BACKUP_DIR\"\n62: nohup bash -c '\n63: WORK_DIR=\"/content/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n64: BACKUP_DIR=\"/content/drive/MyDrive/MD_backup/2H-SiC_10-10_slab_vac5A_relaxed_20261020\"\n65: mkdir -p \"$BACKUP_DIR\"\n66: while true; do\n67:     cp \"$WORK_DIR\"/*.lammpstrj \"$BACKUP_DIR/\" 2>/dev/null || true\n68:     cp \"$WORK_DIR\"/*.xyz \"$BACKUP_DIR/\" 2>/dev/null || true\n69:     cp \"$WORK_DIR\"/*.log \"$BACKUP_DIR/\" 2>/dev/null || true\n70:     cp \"$WORK_DIR\"/*.pwo \"$BACKUP_DIR/\" 2>/dev/null || true\n71:     cp \"$WORK_DIR\"/*.pwi \"$BACKUP_DIR/\" 2>/dev/null || true\n72:     cp \"$WORK_DIR\"/nohup.out \"$BACKUP_DIR/\" 2>/dev/null || true\n73:     sleep 300\n74: done' > backup.log 2>&1 &\n75: \n76: echo \"🚀 真空層 5.0Å スラブモデルの第一原理構造緩和計算がスタートしました！\"\n77: echo \"ログ確認: tail -f $WORK_DIR/nohup.out\"\n78: echo \"QEログ確認: tail -f $WORK_DIR/espresso.pwo\"\n79: echo \"LAMMPSログ確認: tail -f $WORK_DIR/log.lammps\""}
{"step_index":91,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:03Z","content":"Created At: 2026-11-05T14:36:03+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-43 of 43\n1: # ==============================================================================\n2: # 2H-SiC {10-10} 72原子スラブモデル (2周期, 真空層 2.5Å, 合計真空5.0Å)\n3: # 第一原理構造緩和計算 【最適化収束条件版・2回目再検証】\n4: # ==============================================================================\n5: # 【設計思想と収束閾値の物理的根拠】\n6: # 1. DFT (Quantum ESPRESSO) の SCF 収束閾値 conv_thr = 1.0e-5 Ry において、\n7: #    Hellmann-Feynman 力の数値ノイズ限界 (フロア) は ~0.0002 Ry/au (≈ 0.0051 eV/Å)。\n8: # 2. 従来の ftol = 1.0e-3 eV/Å (0.0010 eV/Å) はノイズ限界の 5〜8 倍厳しく、\n9: #    統計的に永遠に満たされず計算が停止しなかった。\n10: # 3. 本設定では、ftol = 1.0e-2 eV/Å (0.010 eV/Å ≈ 0.0004 Ry/au) に最適化し、\n11: #    物理的な構造緩和完了時点で自然に自動正常終了させる。\n12: # 4. さらに etol = 1.0e-6 を併用し、エネルギー底打ちによる安全停止を二重化。\n13: # ==============================================================================\n14: \n15: units metal\n16: boundary p p p\n17: atom_style atomic\n18: atom_modify map yes\n19: \n20: # 1. 初期構造の読み込み (モデル構築は以前と完全に同一の72原子, 真空2.5Å)\n21: read_data 2H-SiC_10-10_slab_3x3x2_vac2.5A.data\n22: \n23: # 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)\n24: mass 1 12.011\n25: mass 2 28.085\n26: \n27: # 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)\n28: fix 1 all mdi/qm elements C Si\n29: \n30: # 3. 出力設定\n31: thermo 1\n32: dump 1 all custom 1 dump.lammpstrj id type x y z\n33: dump_modify 1 append yes\n34: \n35: # 4. 表面構造緩和 (minimize)\n36: # 構文: minimize etol ftol maxiter maxeval\n37: # - etol: 1.0e-6 (相対エネルギー差 <= 10^-6 で収束)\n38: # - ftol: 1.0e-2 eV/Å (最大作用力 <= 0.01 eV/Å で収束、DFTノイズ限界直上)\n39: # - maxiter: 100 (最大CG反復ステップ数)\n40: # - maxeval: 150 (最大力評価回数)\n41: minimize 1.0e-6 1.0e-2 100 150\n42: \n43: undump 1"}
{"step_index":92,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:04Z","content":"Created At: 2026-11-05T14:36:04+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-295 of 295\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: ==============================================================================\n4: Quantum ESPRESSO + MDI 連成コアエンジン (T4 GPU 最適化版)\n5: 【固定コアコード: ユーザー編集不要】\n6: ==============================================================================\n7: ・MDIプロトコルによるLAMMPSとのTCPソケット通信制御\n8: ・T4 GPU (OpenACC / CUDA CC 75) 向けライブラリ環境の自動検出\n9: ・ASE EspressoProfile ラッパー経由での GPU pw.x 呼び出し\n10: ・dft_settings.py からの動的パラメータ読み込み\n11: \"\"\"\n12: import sys\n13: import os\n14: import glob\n15: import time\n16: import numpy as np\n17: import mdi\n18: from ase import Atoms\n19: from ase.calculators.espresso import Espresso, EspressoProfile\n20: import ase.parallel\n21: ase.parallel.world = ase.parallel.DummyMPI()\n22: \n23: ELEMENTS = [\n24:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n25:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n26:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n27:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n28:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n29:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n30:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n31:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n32:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n33:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n34:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n35:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n36: ]\n37: atomic_number_to_symbol = {i+1: symbol for i, symbol in enumerate(ELEMENTS)}\n38: type_to_symbol = {1: 'C', 2: 'Si'}  # ASEアルファベット順 (Type 1: C, Type 2: Si)\n39: \n40: exitflag = False\n41: qm_natoms = 0\n42: qm_elements = None\n43: qm_coords = None\n44: box = np.zeros(9, dtype=np.float64)\n45: flag_box = False\n46: \n47: qm_pe = 0.0\n48: qm_forces = None\n49: last_evaluated_coords = None\n50: \n51: def log(msg):\n52:     print(f\"[QE-MDI Core Engine] {msg}\", flush=True)\n53: \n54: def error(txt):\n55:     log(f\"ERROR: {txt}\")\n56:     sys.exit(1)\n57: \n58: def load_dft_config():\n59:     \"\"\"外部の dft_settings.py からDFT条件を動的に読み込み（なければデフォルト）\"\"\"\n60:     default_config = {\n61:         'ecutwfc': 40.0,\n62:         'ecutrho': 320.0,\n63:         'conv_thr': 1.0e-5,\n64:         'kpts': None,\n65:         'occupations': 'smearing',\n66:         'smearing': 'gaussian',\n67:         'degauss': 0.01,\n68:         'mixing_beta': 0.3,\n69:         'mixing_mode': 'local-TF',\n70:         'electron_maxstep': 200,\n71:         'pseudopotentials': {'Si': 'Si.upf', 'C': 'C.upf'}\n72:     }\n73:     try:\n74:         if os.path.exists(\"dft_settings.py\"):\n75:             import importlib.util\n76:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n77:             mod = importlib.util.module_from_spec(spec)\n78:             spec.loader.exec_module(mod)\n79:             if hasattr(mod, 'DFT_CONFIG'):\n80:                 default_config.update(mod.DFT_CONFIG)\n81:                 log(\"Successfully loaded customized DFT_CONFIG from dft_settings.py\")\n82:     except Exception as e:\n83:         log(f\"Notice: Using default DFT parameters ({e})\")\n84:     return default_config\n85: \n86: def find_nvhpc_and_pw():\n87:     \"\"\"NVHPCライブラリパスおよびGPU版pw.xバイナリの自動検出\"\"\"\n88:     nvhpc_roots = glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\")\n89:     nvhpc_libs = []\n90:     if nvhpc_roots:\n91:         nvhpc_roots.sort(reverse=True)\n92:         root = nvhpc_roots[0]\n93:         nvhpc_libs = [\n94:             f\"{root}/compilers/lib\",\n95:             f\"{root}/math_libs/lib64\",\n96:             f\"{root}/cuda/lib64\",\n97:             f\"{root}/comm_libs/mpi/lib\"\n98:         ]\n99:         hpcx_libs = glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\")\n100:         nvhpc_libs.extend(hpcx_libs)\n101:         log(f\"Detected NVHPC SDK at: {root}\")\n102:     \n103:     cuda_libs = [\n104:         \"/usr/local/cuda/lib64\",\n105:         \"/usr/lib64-nvidia\",\n106:         \"/usr/local/nvidia/lib\",\n107:         \"/usr/local/nvidia/lib64\",\n108:         \"/usr/lib/x86_64-linux-gnu\"\n109:     ]\n110:     all_libs = [p for p in (nvhpc_libs + cuda_libs) if os.path.exists(p)]\n111:     ld_path_str = \":\".join(all_libs)\n112:     \n113:     candidates = [\n114:         \"/content/bin/pw.x.gpu\",\n115:         \"/content/bin/pw.x.serial\",\n116:         \"/content/q-e/build_gpu_serial/bin/pw.x\",\n117:         \"/content/q-e/build/bin/pw.x\",\n118:         \"/content/bin/pw.x\",\n119:         \"/content/drive/MyDrive/mdi_binaries/pw.x\",\n120:         \"pw.x\"\n121:     ]\n122:     pw_bin = None\n123:     for cand in candidates:\n124:         if os.path.exists(cand) and os.access(cand, os.X_OK):\n125:             pw_bin = cand\n126:             break\n127:     if not pw_bin:\n128:         pw_bin = \"/content/bin/pw.x\"\n129:     log(f\"Using Quantum ESPRESSO binary: {pw_bin}\")\n130:     return pw_bin, ld_path_str\n131: \n132: def allocate_qm():\n133:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n134:     n = qm_natoms\n135:     qm_elements = np.empty(n, dtype=np.int32)\n136:     qm_coords = np.empty((n, 3), dtype=np.float64)\n137:     qm_forces = np.empty((n, 3), dtype=np.float64)\n138:     last_evaluated_coords = None\n139: \n140: def receive_qm_natoms(mdicomm):\n141:     global qm_natoms\n142:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n143:     log(f\"Received >NATOMS: {qm_natoms}\")\n144:     allocate_qm()\n145: \n146: def receive_box(mdicomm):\n147:     global flag_box\n148:     flag_box = True\n149:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n150:     if ierr: error(\"MDI: >CELL reception failed\")\n151: \n152: def receive_qm_coords(mdicomm):\n153:     if not qm_natoms: error(\"Cannot receive >COORDS if # atoms = 0\")\n154:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n155:     if ierr: error(\"MDI: >COORDS reception failed\")\n156: \n157: def receive_qm_elements(mdicomm):\n158:     if not qm_natoms: error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n159:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n160:     if ierr: error(\"MDI: >ELEMENTS reception failed\")\n161: \n162: def receive_qm_types(mdicomm):\n163:     if not qm_natoms: error(\"Cannot receive >TYPES if # atoms = 0\")\n164:     types = np.empty(qm_natoms, dtype=np.int32)\n165:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n166:     if ierr: error(\"MDI: >TYPES reception failed\")\n167:     for i, t in enumerate(types):\n168:         sym = type_to_symbol.get(int(t), 'C')\n169:         qm_elements[i] = ELEMENTS.index(sym) + 1\n170: \n171: def evaluate():\n172:     global qm_pe, qm_forces, last_evaluated_coords\n173:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n174:         error(\"System atoms, elements, or coordinates not fully specified\")\n175: \n176:     # 座標キャッシュ: 同一ステップでの重複SCF計算を防止\n177:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n178:         return\n179: \n180:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n181:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n182:     force_conv = ev_to_hartree * bohr_to_angstrom\n183: \n184:     coords_angstrom = qm_coords * bohr_to_angstrom\n185:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n186:     \n187:     if flag_box and np.linalg.norm(box) > 1e-6:\n188:         cell_matrix_bohr = box.reshape(3, 3)\n189:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n190:     else:\n191:         cell_matrix_angstrom = np.eye(3) * 10.0\n192: \n193:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n194:     pw_bin, _ = find_nvhpc_and_pw()\n195:     cfg = load_dft_config()\n196:     \n197:     input_data = {\n198:         'control': {\n199:             'calculation': 'scf',\n200:             'pseudo_dir': './',\n201:             'outdir': './tmp',\n202:             'tprnfor': True,\n203:             'tstress': True,\n204:             'disk_io': 'minimal'\n205:         },\n206:         'system': {\n207:             'ecutwfc': cfg['ecutwfc'],\n208:             'ecutrho': cfg['ecutrho'],\n209:             'occupations': cfg['occupations'],\n210:             'smearing': cfg['smearing'],\n211:             'degauss': cfg['degauss']\n212:         },\n213:         'electrons': {\n214:             'conv_thr': cfg['conv_thr'],\n215:             'mixing_beta': cfg['mixing_beta'],\n216:             'mixing_mode': cfg['mixing_mode'],\n217:             'electron_maxstep': cfg['electron_maxstep']\n218:         }\n219:     }\n220: \n221:     command_str = f\"{pw_bin} -ndiag 1\"\n222:     log(f\"--- Running GPU SCF calculation with QE ({len(atoms)} atoms) ---\")\n223:     \n224:     t0 = time.time()\n225:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n226:     calc = Espresso(profile=profile, pseudopotentials=cfg['pseudopotentials'], input_data=input_data, kpts=cfg['kpts'])\n227:     atoms.calc = calc\n228:     \n229:     pe_ev = atoms.get_potential_energy()\n230:     forces_ev_angstrom = atoms.get_forces()\n231:     elapsed = time.time() - t0\n232:     \n233:     qm_pe = pe_ev * ev_to_hartree\n234:     qm_forces = forces_ev_angstrom * force_conv\n235:     \n236:     log(f\"--- Step Done in {elapsed:.2f}s! Total Energy: {pe_ev:.4f} eV ({qm_pe:.6f} Hartree) ---\")\n237:     last_evaluated_coords = np.copy(qm_coords)\n238: \n239: def execute_command(command, mdicomm, object_ptr):\n240:     global exitflag\n241:     if command == \"EXIT\":\n242:         log(\"Received EXIT command from driver.\")\n243:         exitflag = True\n244:     elif command == \">NATOMS\":\n245:         receive_qm_natoms(mdicomm)\n246:     elif command == \">CELL\":\n247:         receive_box(mdicomm)\n248:     elif command == \">ELEMENTS\":\n249:         receive_qm_elements(mdicomm)\n250:     elif command == \">TYPES\":\n251:         receive_qm_types(mdicomm)\n252:     elif command == \">COORDS\":\n253:         receive_qm_coords(mdicomm)\n254:     elif command in [\"<ENERGY\", \"<PE\"]:\n255:         evaluate()\n256:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n257:         if ierr: error(\"MDI: <ENERGY send failed\")\n258:     elif command == \"<FORCES\":\n259:         evaluate()\n260:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n261:         if ierr: error(\"MDI: <FORCES send failed\")\n262:     else:\n263:         error(f\"Unrecognized MDI command: {command}\")\n264:     return 0\n265: \n266: if __name__ == \"__main__\":\n267:     args = sys.argv\n268:     mdi_option = \"\"\n269:     iarg = 1\n270:     while iarg < len(args):\n271:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n272:             if iarg + 1 < len(args):\n273:                 mdi_option = args[iarg + 1]\n274:                 break\n275:         iarg += 1\n276: \n277:     if not mdi_option:\n278:         error(\"Missing -mdi argument on command line\")\n279: \n280:     log(f\"Initializing MDI Core Engine with options: {mdi_option}\")\n281:     mdi.MDI_Init(mdi_option)\n282:     \n283:     mdi.MDI_Register_Node(\"@DEFAULT\")\n284:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n285:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n286: \n287:     log(\"Waiting for MDI driver connection...\")\n288:     mdicomm = mdi.MDI_Accept_Communicator()\n289:     log(\"Connected to MDI driver! Entering communication loop...\")\n290: \n291:     while not exitflag:\n292:         command = mdi.MDI_Recv_Command(mdicomm)\n293:         execute_command(command, mdicomm, None)\n294:         \n295:     log(\"MDI Core Engine execution terminated cleanly.\")"}
{"step_index":93,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:04Z","content":"Created At: 2026-11-05T14:36:04+09:00\nCompleted At: 2026-11-05T14:36:04+09:00\nShowing lines 1-41 of 41\n1: #!/bin/bash\n2: # ==============================================================================\n3: # Colab 上で T4 GPU を用いて LAMMPS + QE MDI結合計算を実行するスクリプト\n4: # 【固定コアコード: ユーザー編集不要】\n5: # ==============================================================================\n6: \n7: rm -rf tmp qe.out qe_mdi.pwo qe_mdi.pwi dump.lammpstrj qe_engine.log nohup.out\n8: \n9: echo \"==========================================\"\n10: echo \" Starting LAMMPS + QE MDI Simulation (GPU)\"\n11: echo \"==========================================\"\n12: \n13: # OpenMPI / 環境変数の最適化\n14: export OMPI_ALLOW_RUN_AS_ROOT=1\n15: export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1\n16: \n17: # 1. LAMMPS を MDI DRIVER としてバックグラウンド起動\n18: echo \"1. Starting LAMMPS MDI driver...\"\n19: /content/bin/lmp -mdi \"-role DRIVER -name LAMMPS -method TCP -port 8021\" -in in.lammps > lmp.log 2>&1 &\n20: LMP_PID=$!\n21: \n22: sleep 1\n23: \n24: # 2. Python QE MDI Engine (GPU) を起動\n25: echo \"2. Starting Python QE MDI engine (T4 GPU)...\"\n26: python3 qe_mdi_engine_core.py -mdi \"-role ENGINE -name QE -method TCP -port 8021 -hostname localhost\" > qe_engine.log 2>&1\n27: \n28: # 3. 完了待機\n29: wait $LMP_PID\n30: \n31: echo \"==========================================\"\n32: echo \" Calculation Completed Successfully!\"\n33: echo \" Converting trajectory to XYZ format...\"\n34: python3 make_xyz.py dump.lammpstrj md_animation.xyz 2>/dev/null || true\n35: \n36: # 4. 指示書に基づく3種推移グラフの自動生成とバックアップ保存\n37: echo \" Generating progression graphs according to protocol...\"\n38: python3 auto_generate_progression_graphs.py || true\n39: echo \" All progression graphs generated and saved!\"\n40: echo \" Done!\"\n41: echo \"==========================================\""}
