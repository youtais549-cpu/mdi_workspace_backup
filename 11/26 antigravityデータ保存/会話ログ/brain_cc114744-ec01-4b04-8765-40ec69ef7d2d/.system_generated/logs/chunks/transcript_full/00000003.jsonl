{"step_index":108,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:36:49Z","content":"Created At: 2026-11-05T14:36:49+09:00\nCompleted At: 2026-11-05T14:36:50+09:00\nShowing lines 1-114 of 114\n1: #!/usr/bin/env python3\n2: import os\n3: import json\n4: import numpy as np\n5: import ase.io\n6: from ase.build import surface\n7: from ase.io.lammpsdata import write_lammps_data\n8: \n9: def build_4periods_natural_cleavage_slab():\n10:     out_dir = \"/home/yamazaki/mdi_workspace_backup/calc_2H-SiC_10-10_4periods_vac5A_natural_cleavage\"\n11:     os.makedirs(out_dir, exist_ok=True)\n12:     cif_input = \"/home/yamazaki/mdi_workspace_backup/research_simulations/2H-SiC.cif\"\n13:     \n14:     print(f\"Loading 2H-SiC crystal from {cif_input}...\")\n15:     bulk_cif = ase.io.read(cif_input)\n16:     \n17:     # 2. {10-10} 面スラブの構築 (layers=4: 1周期2層なので合計8層, 4周期)\n18:     # 2周期モデル (create_10-10_slab_3x3x2.py) と全く同一の自然へき開面 (粗結合 1.78Å 切断)\n19:     slab_unit = surface(bulk_cif, indices=(1, 0, 0), layers=4, vacuum=None)\n20:     \n21:     # 3. 3x3x1 スーパーセル (面内 3x3, 144原子)\n22:     slab_3x3 = slab_unit * (3, 3, 1)\n23:     \n24:     # 4. z方向の座標調整と真空層の追加 (上下に各 5.0 Å, 合計 10.0 Å)\n25:     pos = slab_3x3.positions.copy()\n26:     z_min = float(np.min(pos[:, 2]))\n27:     z_max = float(np.max(pos[:, 2]))\n28:     thickness = z_max - z_min\n29:     \n30:     # 最下層の原子が z = 5.0 Å になるようにシフト\n31:     pos[:, 2] = pos[:, 2] - z_min + 5.0\n32:     slab_3x3.positions = pos\n33:     \n34:     # セルの z 軸長さを (厚み + 10.0 Å) に設定 (下端に5Å、上端に5Åの真空)\n35:     cell = slab_3x3.cell.copy()\n36:     cell[2, 2] = thickness + 10.0\n37:     slab_3x3.cell = cell\n38:     slab_3x3.pbc = [True, True, True]\n39:     slab_3x3.wrap()\n40:     \n41:     # 層間距離と原子数の確認\n42:     z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 3))\n43:     diffs = [round(z_unique[i+1] - z_unique[i], 3) for i in range(len(z_unique)-1)]\n44:     n_si = sum(s == 'Si' for s in slab_3x3.get_chemical_symbols())\n45:     n_c = sum(s == 'C' for s in slab_3x3.get_chemical_symbols())\n46:     \n47:     print(f\"\\n==========================================\")\n48:     print(f\"4-Periods Natural Cleavage Slab Model Generated:\")\n49:     print(f\"  - Total Atoms: {len(slab_3x3)} (Si: {n_si}, C: {n_c})\")\n50:     print(f\"  - Cell: Lx={slab_3x3.cell[0,0]:.4f} Å, Ly={slab_3x3.cell[1,1]:.4f} Å, Lz={slab_3x3.cell[2,2]:.4f} Å\")\n51:     print(f\"  - Thickness: {thickness:.4f} Å\")\n52:     print(f\"  - Atomic Layers ({len(z_unique)} layers): {z_unique} Å\")\n53:     print(f\"  - Interlayer Spacings: {diffs} Å\")\n54:     print(f\"  - Bottom vacuum: {np.min(slab_3x3.positions[:, 2]):.4f} Å (Target: 5.0 Å)\")\n55:     print(f\"  - Top vacuum: {slab_3x3.cell[2,2] - np.max(slab_3x3.positions[:, 2]):.4f} Å (Target: 5.0 Å)\")\n56:     \n57:     syms = np.array(slab_3x3.get_chemical_symbols())\n58:     mask_b = np.isclose(slab_3x3.positions[:, 2], z_unique[0], atol=0.01)\n59:     mask_t = np.isclose(slab_3x3.positions[:, 2], z_unique[-1], atol=0.01)\n60:     print(f\"  - Bottom layer: {sum(mask_b)} atoms (C: {sum(syms[mask_b]=='C')}, Si: {sum(syms[mask_b]=='Si')}) [Nonpolar]\")\n61:     print(f\"  - Top layer:    {sum(mask_t)} atoms (C: {sum(syms[mask_t]=='C')}, Si: {sum(syms[mask_t]=='Si')}) [Nonpolar]\")\n62:     print(f\"==========================================\\n\")\n63:     \n64:     # 5. スラブファイル保存\n65:     prefix_slab = os.path.join(out_dir, \"slab_10-10_144atoms\")\n66:     ase.io.write(f\"{prefix_slab}.cif\", slab_3x3)\n67:     ase.io.write(f\"{prefix_slab}.xyz\", slab_3x3)\n68:     write_lammps_data(f\"{prefix_slab}.data\", slab_3x3, atom_style='atomic', masses=True)\n69:     \n70:     # 6. バルクモデルの構築 (真空 0 Å, 真の結晶格子長 10.6556 Å)\n71:     bulk_pos = slab_3x3.positions.copy()\n72:     bulk_pos[:, 2] = bulk_pos[:, 2] - 5.0 # シフト戻し (0.0 からスタート)\n73:     bulk_cell = slab_3x3.cell.copy()\n74:     # 粗結合 1.7758 Å を足したものが真の周期長\n75:     bulk_cell[2, 2] = thickness + (diffs[1]) # 8.8798 + 1.7758 = 10.6556 Å\n76:     bulk_atoms = ase.Atoms(symbols=slab_3x3.get_chemical_symbols(), positions=bulk_pos, cell=bulk_cell, pbc=[True, True, True])\n77:     bulk_atoms.wrap()\n78:     \n79:     prefix_bulk = os.path.join(out_dir, \"bulk_10-10_144atoms\")\n80:     ase.io.write(f\"{prefix_bulk}.cif\", bulk_atoms)\n81:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk_atoms)\n82:     write_lammps_data(f\"{prefix_bulk}.data\", bulk_atoms, atom_style='atomic', masses=True)\n83:     \n84:     # 7. メタデータ JSON 出力\n85:     area_A = float(slab_3x3.cell[0,0] * slab_3x3.cell[1,1])\n86:     area_2A = 2.0 * area_A\n87:     conv_factor = 16.021766\n88:     \n89:     meta = {\n90:         'cleavage_plane': '10-10',\n91:         'cleavage_type': 'natural_cleavage_sparse_bond',\n92:         'n_periods': 4,\n93:         'n_layers': 8,\n94:         'natoms': len(slab_3x3),\n95:         'vacuum_thickness_angstrom': 5.0,\n96:         'supercell_xy': [3, 3],\n97:         'cell_slab': [float(slab_3x3.cell[0,0]), float(slab_3x3.cell[1,1]), float(slab_3x3.cell[2,2])],\n98:         'cell_bulk': [float(bulk_atoms.cell[0,0]), float(bulk_atoms.cell[1,1]), float(bulk_atoms.cell[2,2])],\n99:         'area_A_angstrom2': area_A,\n100:         'total_area_2A_angstrom2': area_2A,\n101:         'unit_conversion_eV_A2_to_J_m2': conv_factor,\n102:         'effective_denominator': float(area_2A / conv_factor),\n103:         'true_bulk_scf_energy_eV': -63863.3059,\n104:         'true_bulk_scf_energy_Ry': -4693.86470519,\n105:         'slab_data_file': \"slab_10-10_144atoms.data\",\n106:         'bulk_data_file': \"bulk_10-10_144atoms.data\"\n107:     }\n108:     with open(os.path.join(out_dir, \"fracture_metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n109:         json.dump(meta, f, indent=4)\n110:         \n111:     print(f\"Saved all 4-period natural cleavage files to {out_dir}\")\n112: \n113: if __name__ == \"__main__\":\n114:     build_4periods_natural_cleavage_slab()"}
