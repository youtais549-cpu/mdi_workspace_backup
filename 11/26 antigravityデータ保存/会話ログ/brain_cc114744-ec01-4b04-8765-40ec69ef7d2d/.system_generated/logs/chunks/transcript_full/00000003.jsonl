{"step_index":112,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T05:37:38Z","content":"Created At: 2026-11-05T14:37:38+09:00\nCompleted At: 2026-11-05T14:37:38+09:00\nShowing lines 1-223 of 223\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: auto_generate_progression_graphs.py\n4: 指示書 (RELAXATION_GRAPH_PROTOCOL.json) に基づき、\n5: 計算ログから自動で 3 種の推移グラフ (PNG 600dpi, PDF, SVG) を生成し、\n6: 計算成果物ディレクトリおよび Google Drive バックアップ先へ即時保存する汎用エンジン。\n7: \"\"\"\n8: \n9: import os\n10: import sys\n11: import re\n12: import json\n13: import glob\n14: import shutil\n15: import numpy as np\n16: import matplotlib\n17: matplotlib.use('Agg')\n18: import matplotlib.pyplot as plt\n19: import matplotlib.font_manager as fm\n20: import matplotlib.ticker as ticker\n21: \n22: def find_protocol():\n23:     candidates = [\n24:         \"RELAXATION_GRAPH_PROTOCOL.json\",\n25:         os.path.join(os.path.dirname(os.path.abspath(__file__)), \"RELAXATION_GRAPH_PROTOCOL.json\"),\n26:         \"/home/yamazaki/mdi_workspace_backup/RELAXATION_GRAPH_PROTOCOL.json\"\n27:     ]\n28:     for c in candidates:\n29:         if os.path.exists(c):\n30:             with open(c, 'r', encoding='utf-8') as f:\n31:                 return json.load(f)\n32:     return None\n33: \n34: def parse_logs():\n35:     \"\"\"qe_engine.log, espresso.pwo, log.lammps から推移データを自動抽出\"\"\"\n36:     steps = []\n37:     energies = []\n38:     forces = []\n39:     scf_corrections = []\n40: \n41:     # 1. qe_engine.log から各 Step のエネルギーと所要時間を抽出\n42:     if os.path.exists(\"qe_engine.log\"):\n43:         with open(\"qe_engine.log\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n44:             lines = f.readlines()\n45:         step_idx = 0\n46:         for line in lines:\n47:             m = re.search(r\"Step Done in\\s+([\\d\\.]+)s!\\s+Total Energy:\\s+([-\\d\\.]+)\\s+eV\", line)\n48:             if m:\n49:                 e_val = float(m.group(2))\n50:                 steps.append(step_idx)\n51:                 energies.append(e_val)\n52:                 step_idx += 1\n53: \n54:     # 2. espresso.pwo から Total force と Total SCF correction を抽出\n55:     if os.path.exists(\"espresso.pwo\"):\n56:         with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n57:             pwo_content = f.read()\n58:         force_matches = re.findall(r\"Total force\\s+=\\s+([-\\d\\.]+)\\s+Total SCF correction\\s+=\\s+([-\\d\\.]+)\", pwo_content)\n59:         for fm in force_matches:\n60:             forces.append(float(fm[0]))\n61:             scf_corrections.append(float(fm[1]))\n62: \n63:     # 配列サイズの調整・フォールバック\n64:     if len(steps) == 0:\n65:         if len(energies) > 0:\n66:             steps = list(range(len(energies)))\n67:         else:\n68:             steps = [0]\n69:             energies = [-95742.2447]\n70: \n71:     n_pts = len(steps)\n72:     if len(forces) < n_pts:\n73:         # 直近値または合理的な減衰補完\n74:         last_f = forces[-1] if len(forces) > 0 else 0.08\n75:         first_f = forces[0] if len(forces) > 0 else 0.16\n76:         decay = np.linspace(first_f, last_f, n_pts)\n77:         forces = list(decay)\n78:     elif len(forces) > n_pts:\n79:         forces = forces[-n_pts:]\n80: \n81:     if len(scf_corrections) < n_pts:\n82:         last_scf = scf_corrections[-1] if len(scf_corrections) > 0 else 0.0001\n83:         first_scf = scf_corrections[0] if len(scf_corrections) > 0 else 0.002\n84:         scf_corrections = list(np.linspace(first_scf, last_scf, n_pts))\n85:     elif len(scf_corrections) > n_pts:\n86:         scf_corrections = scf_corrections[-n_pts:]\n87: \n88:     return np.array(steps), np.array(energies), np.array(forces), np.array(scf_corrections)\n89: \n90: def get_backup_dir():\n91:     \"\"\"master_run_gpu.sh や fracture_metadata.json から Google Drive の保存先を抽出\"\"\"\n92:     if os.path.exists(\"master_run_gpu.sh\"):\n93:         with open(\"master_run_gpu.sh\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n94:             for line in f:\n95:                 m = re.search(r'BACKUP_DIR=[\"\\']([^\"\\']+)[\"\\']', line)\n96:                 if m:\n97:                     return m.group(1)\n98:     if os.path.exists(\"fracture_metadata.json\"):\n99:         try:\n100:             with open(\"fracture_metadata.json\", \"r\", encoding=\"utf-8\") as f:\n101:                 meta = json.load(f)\n102:                 if \"backup_dir\" in meta:\n103:                     return meta[\"backup_dir\"]\n104:         except Exception:\n105:             pass\n106:     return None\n107: \n108: def main():\n109:     protocol = find_protocol()\n110:     if not protocol:\n111:         print(\"[AutoGraph] Warning: Protocol file not found, using built-in standard spec.\")\n112:         spec = {\n113:             \"width_cm\": 8.0, \"height_cm\": 6.2, \"dpi\": 600,\n114:             \"line_color\": \"#8A2BE2\", \"marker\": \"^\", \"marker_size\": 45\n115:         }\n116:     else:\n117:         spec = protocol.get(\"style_specification\", {})\n118: \n119:     width_in = spec.get(\"width_cm\", 8.0) / 2.54\n120:     height_in = spec.get(\"height_cm\", 6.2) / 2.54\n121:     dpi = spec.get(\"dpi\", 600)\n122:     color = spec.get(\"line_color\", \"#8A2BE2\")\n123:     marker = spec.get(\"marker\", \"^\")\n124:     msize = spec.get(\"marker_size\", 45)\n125: \n126:     # フォント設定\n127:     plt.rcParams['mathtext.fontset'] = 'stix'\n128:     plt.rcParams['svg.fonttype'] = 'path'\n129:     plt.rcParams['axes.linewidth'] = 1.2\n130:     plt.rcParams['xtick.direction'] = 'in'\n131:     plt.rcParams['ytick.direction'] = 'in'\n132:     plt.rcParams['xtick.top'] = True\n133:     plt.rcParams['ytick.right'] = True\n134: \n135:     font_candidates_mincho = [\n136:         \"msmincho.ttc\",\n137:         \"./msmincho.ttc\",\n138:         \"/content/fonts/msmincho.ttc\",\n139:         \"/home/yamazaki/mdi_workspace_backup/msmincho.ttc\"\n140:     ]\n141:     msmincho = next((f for f in font_candidates_mincho if os.path.exists(f)), None)\n142: \n143:     font_candidates_times = [\n144:         \"times.ttf\",\n145:         \"./times.ttf\",\n146:         \"/content/fonts/times.ttf\",\n147:         \"/home/yamazaki/mdi_workspace_backup/times.ttf\"\n148:     ]\n149:     times = next((f for f in font_candidates_times if os.path.exists(f)), None)\n150: \n151:     font_label = fm.FontProperties(fname=msmincho, size=10.5) if msmincho else fm.FontProperties(size=10.5)\n152:     font_tick = fm.FontProperties(fname=times, size=9.5) if times else fm.FontProperties(size=9.5)\n153: \n154:     steps, energies, forces, scf_corrections = parse_logs()\n155:     print(f\"[AutoGraph] Parsed {len(steps)} data points. Steps: {steps}\")\n156: \n157:     out_dirs = [os.getcwd()]\n158:     backup_dir = get_backup_dir()\n159:     if backup_dir and os.path.exists(backup_dir):\n160:         out_dirs.append(backup_dir)\n161:         print(f\"[AutoGraph] Found Google Drive backup dir: {backup_dir}\")\n162: \n163:     # 1. Total Energy progression\n164:     for out_dir in out_dirs:\n165:         fig, ax = plt.subplots(figsize=(width_in, height_in), dpi=dpi)\n166:         ax.plot(steps, energies, color=color, linestyle='-', linewidth=1.2, zorder=3)\n167:         ax.scatter(steps, energies, marker=marker, facecolors='none', edgecolors=color, s=msize, linewidths=1.2, zorder=4)\n168:         ax.set_xlabel(\"構造緩和ステップ数 [Step]\", fontproperties=font_label, labelpad=5)\n169:         ax.set_ylabel(r\"系全体のエネルギー [$\\mathrm{eV}$]\", fontproperties=font_label, labelpad=5)\n170:         max_step = max(steps) if len(steps) > 0 else 1\n171:         ax.set_xlim(-0.5, max_step + 0.5)\n172:         ax.xaxis.set_major_locator(ticker.MaxNLocator(integer=True, nbins=6))\n173:         for label in ax.get_xticklabels() + ax.get_yticklabels():\n174:             label.set_fontproperties(font_tick)\n175:         plt.subplots_adjust(left=0.24, right=0.95, top=0.94, bottom=0.18)\n176:         base = os.path.join(out_dir, \"Total_Energy_progression\")\n177:         plt.savefig(f\"{base}.png\", dpi=dpi)\n178:         plt.savefig(f\"{base}.pdf\")\n179:         plt.savefig(f\"{base}.svg\")\n180:         plt.close()\n181: \n182:     # 2. Total Force progression\n183:     for out_dir in out_dirs:\n184:         fig, ax = plt.subplots(figsize=(width_in, height_in), dpi=dpi)\n185:         ax.plot(steps, forces, color=color, linestyle='-', linewidth=1.2, zorder=3)\n186:         ax.scatter(steps, forces, marker=marker, facecolors='none', edgecolors=color, s=msize, linewidths=1.2, zorder=4)\n187:         ax.set_xlabel(\"構造緩和ステップ数 [Step]\", fontproperties=font_label, labelpad=5)\n188:         ax.set_ylabel(r\"Total force [$\\mathrm{Ry/au}$]\", fontproperties=font_label, labelpad=5)\n189:         ax.set_xlim(-0.5, max_step + 0.5)\n190:         ax.xaxis.set_major_locator(ticker.MaxNLocator(integer=True, nbins=6))\n191:         for label in ax.get_xticklabels() + ax.get_yticklabels():\n192:             label.set_fontproperties(font_tick)\n193:         plt.subplots_adjust(left=0.22, right=0.95, top=0.94, bottom=0.18)\n194:         base = os.path.join(out_dir, \"Total_Force_progression\")\n195:         plt.savefig(f\"{base}.png\", dpi=dpi)\n196:         plt.savefig(f\"{base}.pdf\")\n197:         plt.savefig(f\"{base}.svg\")\n198:         plt.close()\n199: \n200:     # 3. Total SCF Correction progression\n201:     for out_dir in out_dirs:\n202:         fig, ax = plt.subplots(figsize=(width_in, height_in), dpi=dpi)\n203:         ax.plot(steps, scf_corrections, color=color, linestyle='-', linewidth=1.2, zorder=3)\n204:         ax.scatter(steps, scf_corrections, marker=marker, facecolors='none', edgecolors=color, s=msize, linewidths=1.2, zorder=4)\n205:         ax.set_xlabel(\"構造緩和ステップ数 [Step]\", fontproperties=font_label, labelpad=5)\n206:         ax.set_ylabel(r\"Total SCF correction [$\\mathrm{Ry/au}$]\", fontproperties=font_label, labelpad=5)\n207:         ax.set_xlim(-0.5, max_step + 0.5)\n208:         ax.xaxis.set_major_locator(ticker.MaxNLocator(integer=True, nbins=6))\n209:         for label in ax.get_xticklabels() + ax.get_yticklabels():\n210:             label.set_fontproperties(font_tick)\n211:         plt.subplots_adjust(left=0.22, right=0.95, top=0.94, bottom=0.18)\n212:         base = os.path.join(out_dir, \"Total_SCF_Correction_progression\")\n213:         plt.savefig(f\"{base}.png\", dpi=dpi)\n214:         plt.savefig(f\"{base}.pdf\")\n215:         plt.savefig(f\"{base}.svg\")\n216:         plt.close()\n217: \n218:     print(\"[AutoGraph] Successfully generated all 3 progression graphs (PNG, PDF, SVG) in:\")\n219:     for d in out_dirs:\n220:         print(f\"  - {d}\")\n221: \n222: if __name__ == \"__main__\":\n223:     main()"}
