{"step_index":585,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-06T09:17:18Z","content":"Created At: 2026-11-06T18:17:18+09:00\nCompleted At: 2026-11-06T18:17:18+09:00\nShowing lines 1-150 of 270\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: generate_final_graph.py\n4: 2H-SiC {10-10} 表面破壊エネルギーの真空層厚さ依存性 最終グラフ生成スクリプト\n5: (研究概要 Word 文書・横幅 8.0 cm 配置用 最適化版)\n6: \n7: 【修正の目的と設計仕様】\n8: 1. Word 文書 (本文: MS明朝 10.5 pt、Fig. 1 と横並び配置、掲載幅約 8.0 cm) に完全対応。\n9: 2. 物理寸法: 横 8.0 cm × 縦 6.2 cm (Word 上で 100% 表示・拡大縮小不要)。\n10:    ※ 自動余白調整 (bbox_inches='tight') を無効化し、指定物理寸法 (8.0 cm × 6.2 cm) を厳格に保持。\n11: 3. フォント仕様:\n12:    - 軸ラベル: MS明朝 10.5 pt\n13:    - 目盛り数字: Times New Roman 9.5 pt (整数表示)\n14:    - 文献値日本語: MS明朝 Bold 9.5 pt\n15:    - 文献値英数字・単位: Times New Roman Bold 9.5 pt\n16:    - 数式部分: STIX (Times New Roman 互換)\n17: 4. 出力形式 (全 3 形式):\n18:    - SVG: 文字アウトライン化 (svg.fonttype = 'path') により Word 貼付時のフォント置換・文字化けを完全防止\n19:    - PNG: 600 dpi の高解像度ラスター画像\n20:    - PDF: 学術出版対応ベクター形式\n21: 5. 表示範囲とバリエーション:\n22:    - 16 Å 版 (標準): 横軸 0～16 Å, 縦軸 0～5 J/m²\n23:    - 12 Å 版 (比較検討案): 横軸 0～12 Å, 縦軸 0～5 J/m² (データ点間隔を広げ視認性を向上)\n24: \"\"\"\n25: \n26: import os\n27: import sys\n28: import csv\n29: import shutil\n30: import matplotlib\n31: matplotlib.use('Agg')\n32: import matplotlib.pyplot as plt\n33: import matplotlib.font_manager as fm\n34: from matplotlib.offsetbox import AnchoredOffsetbox, HPacker, TextArea\n35: \n36: # 数式フォントに STIX (Times New Roman 互換) を適用\n37: plt.rcParams['mathtext.fontset'] = 'stix'\n38: # SVG 出力時に文字をパス (アウトライン) 化して Word での文字化け・フォント置換を防止\n39: plt.rcParams['svg.fonttype'] = 'path'\n40: \n41: CSV_PATH = \"/home/yamazaki/mdi_workspace_backup/surface_energy_results.csv\"\n42: PLOT_DATA_CSV = \"/home/yamazaki/mdi_workspace_backup/surface_energy_vs_vacuum_plot_data.csv\"\n43: DESKTOP_DIR = \"/mnt/c/Users/S015/OneDrive - YNU(ynu.jp)/デスクトップ\"\n44: POSTER_DIR = \"/mnt/c/Users/S015/OneDrive - YNU(ynu.jp)/4/研究室/ポスター発表\"\n45: \n46: def get_font_properties():\n47:     \"\"\"Windows フォント (MS明朝, Times New Roman) のパスを解決\"\"\"\n48:     win_fonts = \"/mnt/c/Windows/Fonts\"\n49:     msmincho_path = os.path.join(win_fonts, \"msmincho.ttc\")\n50:     times_path = os.path.join(win_fonts, \"times.ttf\")\n51:     timesbd_path = os.path.join(win_fonts, \"timesbd.ttf\")\n52: \n53:     if not os.path.exists(msmincho_path):\n54:         msmincho_path = None\n55:     if not os.path.exists(times_path):\n56:         times_path = None\n57:     if not os.path.exists(timesbd_path):\n58:         timesbd_path = None\n59: \n60:     font_mincho_label = fm.FontProperties(fname=msmincho_path, size=10.5)\n61:     font_mincho_lit = fm.FontProperties(fname=msmincho_path, weight=\"bold\", size=9.5)\n62:     font_times_tick = fm.FontProperties(fname=times_path, size=9.5)\n63:     font_times_lit = fm.FontProperties(fname=timesbd_path, weight=\"bold\", size=9.5)\n64: \n65:     return font_mincho_label, font_mincho_lit, font_times_tick, font_times_lit\n66: \n67: def load_data():\n68:     \"\"\"CSV から計算値を取得 (取得できない場合は確定した厳密な第一原理計算値をフォールバック使用)\"\"\"\n69:     gamma_2_5 = 2.4703\n70:     gamma_5_0 = 2.4485\n71:     gamma_10_0 = 2.4488\n72: \n73:     # 1. 専用プロット CSV から読み込み試行\n74:     if os.path.exists(PLOT_DATA_CSV):\n75:         try:\n76:             with open(PLOT_DATA_CSV, 'r', encoding='utf-8-sig') as f:\n77:                 reader = csv.DictReader(f)\n78:                 for row in reader:\n79:                     vac = float(row['Vacuum_Thickness_Angstrom'])\n80:                     g = float(row['Surface_Fracture_Energy_J_m2'])\n81:                     if abs(vac - 2.5) < 0.1: gamma_2_5 = g\n82:                     elif abs(vac - 5.0) < 0.1: gamma_5_0 = g\n83:                     elif abs(vac - 10.0) < 0.1: gamma_10_0 = g\n84:             return gamma_2_5, gamma_5_0, gamma_10_0\n85:         except Exception as e:\n86:             print(f\"Notice: Failed to read from {PLOT_DATA_CSV}: {e}\")\n87: \n88:     # 2. 総合計算 CSV から読み込み試行\n89:     if os.path.exists(CSV_PATH):\n90:         try:\n91:             with open(CSV_PATH, 'r', encoding='utf-8-sig') as f:\n92:                 reader = csv.DictReader(f)\n93:                 for row in reader:\n94:                     if '10-10' in row.get('Plane', ''):\n95:                         vac = float(row['Vacuum_Angstrom'])\n96:                         g = float(row['Gamma_J_m2'])\n97:                         if abs(vac - 2.5) < 0.1: gamma_2_5 = g\n98:                         elif abs(vac - 5.0) < 0.1: gamma_5_0 = g\n99:                         elif abs(vac - 10.0) < 0.1: gamma_10_0 = g\n100:         except Exception as e:\n101:             print(f\"Notice: Failed to read from {CSV_PATH}: {e}\")\n102: \n103:     return gamma_2_5, gamma_5_0, gamma_10_0\n104: \n105: def generate_single_plot(x_max=16.0, suffix=\"16A\", copy_desktop=True):\n106:     \"\"\"\n107:     指定された横軸最大値 (x_max) で Word 最適化グラフを生成\n108:     - x_max = 16.0: 基本の 0～16 Å 表示\n109:     - x_max = 12.0: 比較検討案の 0～12 Å 表示\n110:     \"\"\"\n111:     gamma_2_5, gamma_5_0, gamma_10_0 = load_data()\n112:     font_mincho_label, font_mincho_lit, font_times_tick, font_times_lit = get_font_properties()\n113: \n114:     # 1. 物理寸法の厳格設定 (横 8.0 cm × 縦 6.2 cm)\n115:     width_cm = 8.0\n116:     height_cm = 6.2\n117:     w_in = width_cm / 2.54\n118:     h_in = height_cm / 2.54\n119: \n120:     fig, ax = plt.subplots(figsize=(w_in, h_in), dpi=600)\n121:     # プロット領域を最大化しつつ、軸ラベルや単位の端切れを防止する精密余白配分\n122:     fig.subplots_adjust(left=0.21, right=0.94, bottom=0.20, top=0.96)\n123: \n124:     # 2. データ点のプロット (紫色中抜き三角マーカー, 線なし)\n125:     vac_thickness = [2.5, 5.0, 10.0]\n126:     gamma_values = [gamma_2_5, gamma_5_0, gamma_10_0]\n127: \n128:     ax.scatter(\n129:         vac_thickness, \n130:         gamma_values, \n131:         color=\"#8A2BE2\", \n132:         marker=\"^\", \n133:         s=45, \n134:         linewidths=1.3, \n135:         facecolors=\"none\", \n136:         zorder=4\n137:     )\n138: \n139:     # 3. 文献値の水平破線 (3.03 J/m²)\n140:     lit_value = 3.03\n141:     ax.axhline(y=lit_value, color=\"#222222\", linestyle=\"--\", linewidth=1.0, zorder=3)\n142: \n143:     # 文献値テキスト (MS明朝 9.5 pt + Times New Roman Bold 9.5 pt を横並び配置)\n144:     area_jp = TextArea(\"文献値\", textprops=dict(fontproperties=font_mincho_lit, color=\"#111111\"))\n145:     area_en = TextArea(\"(3.03 J/m²)\", textprops=dict(fontproperties=font_times_lit, color=\"#111111\"))\n146:     packer = HPacker(children=[area_jp, area_en], align=\"baseline\", pad=0, sep=2)\n147: \n148:     # y=3.03 の破線直上に配置 (ylim 0～5 に対する正規化座標)\n149:     y_norm = (lit_value / 5.0) + 0.026\n150:     anchored_box = AnchoredOffsetbox("}
