{"step_index":780,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:07:59Z","content":"Created At: 2026-11-08T23:07:59+09:00\nCompleted At: 2026-11-08T23:07:59+09:00\nShowing lines 400-550 of 654\n400:     energies_qe = []\n401:     with open(os.path.join(calc_dir, \"qe_engine.log\"), \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n402:         for line in f:\n403:             m = re.search(r\"Total Energy:\\s+([-\\d\\.]+)\\s+eV\", line)\n404:             if m:\n405:                 energies_qe.append(float(m.group(1)))\n406: \n407:     energies_lmp = []\n408:     with open(os.path.join(calc_dir, \"log.lammps\"), \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n409:         text = f.read()\n410:     m_fin = re.search(r\"Energy initial, next-to-last, final =\\s*\\n\\s*([-\\d\\.]+)\\s+([-\\d\\.]+)\\s+([-\\d\\.]+)\", text)\n411:     if m_fin:\n412:         energies_lmp.append(float(m_fin.group(3)))\n413: \n414:     e_slab = energies_lmp[-1] if energies_lmp else energies_qe[-1]\n415:     delta_e = e_slab - e_bulk_ev\n416:     gamma = delta_e / EFFECTIVE_DENOM\n417:     diff_pct = ((gamma - 2.27) / 2.27) * 100.0\n418: \n419:     meta[\"relaxed_slab_energy_eV\"] = round(e_slab, 4)\n420:     meta[\"delta_energy_eV\"] = round(delta_e, 4)\n421:     meta[\"surface_fracture_energy_J_m2\"] = round(gamma, 4)\n422:     meta[\"diff_percent\"] = round(diff_pct, 1)\n423:     meta[\"bulk_elapsed_seconds\"] = round(bulk_elapsed, 1)\n424:     meta[\"slab_elapsed_seconds\"] = round(slab_elapsed, 1)\n425:     meta[\"total_elapsed_seconds\"] = round(bulk_elapsed + slab_elapsed, 1)\n426:     meta[\"n_scf_steps\"] = len(energies_qe)\n427: \n428:     with open(os.path.join(calc_dir, \"fracture_metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n429:         json.dump(meta, f, indent=4, ensure_ascii=False)\n430: \n431:     log(\n432:         f\"✅ [Period {N}] Complete! Natoms={natoms} | Bulk: {bulk_elapsed:.1f}s | \"\n433:         f\"Slab: {slab_elapsed/60.0:.1f} min ({len(energies_qe)} evals) | \"\n434:         f\"E_slab={e_slab:.4f} eV | ΔE={delta_e:.4f} eV | γ={gamma:.4f} J/m²\"\n435:     )\n436: \n437:     # 5. 【Phase 4】ローカルアーカイブ退避 & NASステージング\n438:     archive_root = os.path.join(WORKSPACE_DIR, \"各条件の計算ディレクトリ\")\n439:     os.makedirs(archive_root, exist_ok=True)\n440:     shutil.copytree(calc_dir, os.path.join(archive_root, os.path.basename(calc_dir)), dirs_exist_ok=True)\n441: \n442:     stage_to_nas_local(calc_dir, nas_folder_name)\n443: \n444:     # 6. 【Phase 5】総合台帳更新 & 周期数依存性グラフ自動更新\n445:     append_to_master_csv_and_md(N, natoms, e_slab, e_bulk_ev, delta_e, gamma, diff_pct, calc_dir_name)\n446:     update_periods_summary_and_graphs()\n447: \n448:     return calc_dir\n449: \n450: \n451: def stage_to_nas_local(calc_dir, nas_folder_name):\n452:     \"\"\"nas_staging_periods/{nas_folder_name} へローカル完全ステージング (バルクデータ同梱)\"\"\"\n453:     os.makedirs(NAS_STAGING_ROOT, exist_ok=True)\n454:     local_nas_dir = os.path.join(NAS_STAGING_ROOT, nas_folder_name)\n455:     if os.path.exists(local_nas_dir):\n456:         shutil.rmtree(local_nas_dir)\n457:     shutil.copytree(calc_dir, local_nas_dir)\n458:     log(f\"  -> Staged locally at: {local_nas_dir} (includes bulk & slab calculation data)\")\n459: \n460: \n461: def append_to_master_csv_and_md(N, natoms, e_slab, e_bulk, delta_e, gamma, diff_pct, calc_dir_name):\n462:     \"\"\"surface_energy_results.csv と SURFACE_ENERGY_RESULTS.md に自動追記\"\"\"\n463:     csv_path = os.path.join(WORKSPACE_DIR, \"surface_energy_results.csv\")\n464:     md_path = os.path.join(WORKSPACE_DIR, \"SURFACE_ENERGY_RESULTS.md\")\n465:     date_str = datetime.date.today().strftime(\"%Y-%m-%d\")\n466: \n467:     next_no = 1\n468:     if os.path.exists(csv_path):\n469:         with open(csv_path, \"r\", encoding=\"utf-8\") as f:\n470:             lines = [ln.strip() for ln in f if ln.strip()]\n471:         if calc_dir_name in \"\\n\".join(lines):\n472:             return\n473:         if len(lines) > 1:\n474:             try:\n475:                 next_no = int(lines[-1].split(\",\")[0]) + 1\n476:             except ValueError:\n477:                 next_no = len(lines)\n478: \n479:     csv_row = (\n480:         f'{next_no},{date_str},10-10,{N},{2*N},{natoms},5.0,3x3,'\n481:         f'\"CG_minimize (minimize 1.0e-6 1.0e-2 100 150)\",40.0,320.0,gamma,'\n482:         f'{e_slab:.4f},{e_bulk:.4f},{delta_e:.4f},{AREA_2A:.4f},{gamma:.4f},'\n483:         f'2.27,2.44,{diff_pct:+.1f},\"{calc_dir_name}\",\"true_bulk_scf\"\\n'\n484:     )\n485:     with open(csv_path, \"a\", encoding=\"utf-8\") as f:\n486:         f.write(csv_row)\n487: \n488:     if os.path.exists(md_path):\n489:         with open(md_path, \"r\", encoding=\"utf-8\") as f:\n490:             md_lines = f.read().splitlines()\n491: \n492:         md_row = (\n493:             f\"| **#{next_no}** | {date_str} | `{{101_0}}` | {N} ({2*N}層) | {natoms} | 5.0 Å | \"\n494:             f\"`minimize 1.0e-6 1.0e-2 100 150` | {e_slab:.4f} | {e_bulk:.4f} | {delta_e:.4f} | \"\n495:             f\"**{gamma:.4f}** | 2.27〜2.44 | {diff_pct:+.1f}% | \"\n496:             f\"`{calc_dir_name}` |\"\n497:         )\n498:         last_idx = -1\n499:         for i, line in enumerate(md_lines):\n500:             if line.strip().startswith(\"| **#\"):\n501:                 last_idx = i\n502:         if last_idx != -1:\n503:             md_lines.insert(last_idx + 1, md_row)\n504:             with open(md_path, \"w\", encoding=\"utf-8\") as f:\n505:                 f.write(\"\\n\".join(md_lines) + \"\\n\")\n506: \n507: \n508: def update_periods_summary_and_graphs():\n509:     \"\"\"完了済みの全周期数条件 (1〜10周期) を集計し、CSVおよび周期数依存性比較グラフを出力\"\"\"\n510:     collected = []\n511:     # 既存の計算ディレクトリと新規ディレクトリの両方を探索\n512:     for N in ALL_PERIODS:\n513:         # パス候補\n514:         candidates = [\n515:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A_natural_cleavage\"),\n516:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A_local_RTX5080\"),\n517:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A\"),\n518:             os.path.join(WORKSPACE_DIR, f\"results_2H-SiC_10-10_slab_{N}periods_vac5A_relaxed_20261022\"),\n519:         ]\n520:         if N == 2:\n521:             candidates.insert(0, os.path.join(WORKSPACE_DIR, \"calc_2H-SiC_10-10_2periods_vac5.0A_rtx5080\"))\n522: \n523:         found_meta = None\n524:         for c in candidates:\n525:             m_path = os.path.join(c, \"fracture_metadata.json\")\n526:             if os.path.exists(m_path):\n527:                 try:\n528:                     with open(m_path, \"r\", encoding=\"utf-8\") as f:\n529:                         meta = json.load(f)\n530:                     if \"surface_fracture_energy_J_m2\" in meta:\n531:                         found_meta = meta\n532:                         break\n533:                 except Exception:\n534:                     pass\n535: \n536:         if found_meta:\n537:             natoms = found_meta.get(\"n_atoms\", found_meta.get(\"natoms\", 36 * N))\n538:             e_slab = found_meta.get(\"relaxed_slab_energy_eV\", 0.0)\n539:             e_bulk = found_meta.get(\"true_bulk_scf_energy_eV\", 0.0)\n540:             de = found_meta.get(\"delta_energy_eV\", e_slab - e_bulk)\n541:             gamma = found_meta.get(\"surface_fracture_energy_J_m2\", 0.0)\n542:             collected.append((N, natoms, e_slab, e_bulk, de, gamma))\n543: \n544:     if not collected:\n545:         return\n546: \n547:     collected.sort(key=lambda x: x[0])\n548: \n549:     # 1. CSV更新\n550:     csv_path = os.path.join(WORKSPACE_DIR, \"surface_energy_vs_periods_plot_data.csv\")"}
