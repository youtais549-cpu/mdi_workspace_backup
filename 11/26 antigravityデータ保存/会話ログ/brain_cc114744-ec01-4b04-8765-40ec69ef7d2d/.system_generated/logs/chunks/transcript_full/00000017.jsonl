{"step_index":767,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:05:47Z","content":"Created At: 2026-11-08T23:05:47+09:00\nCompleted At: 2026-11-08T23:05:47+09:00\nShowing lines 1-101 of 101\n1: #!/bin/bash\n2: # ==============================================================================\n3: # run_bulk_8periods_rtx5080.sh\n4: # 2H-SiC {10-10} 8周期 (16層, 288原子) 真のバルクモデル (真空 0 Å)\n5: # Quantum ESPRESSO 1点 SCF 計算実行 & エネルギー自動検証スクリプト\n6: # 【AGENTS.md §1 準拠: スラブ緩和前の「バルク 1 点 SCF 先行確定」プロトコル】\n7: # ==============================================================================\n8: set -e\n9: \n10: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n11: WORKSPACE_DIR=\"$(dirname \"$SCRIPT_DIR\")\"\n12: cd \"$SCRIPT_DIR\"\n13: \n14: # 環境パスの設定\n15: ENV_PREFIX=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n16: export PATH=\"$ENV_PREFIX/bin:$PATH\"\n17: export LD_LIBRARY_PATH=\"$ENV_PREFIX/lib:${LD_LIBRARY_PATH:-}\"\n18: export OMPI_MCA_btl_vader_single_copy_mechanism=none\n19: export CUDA_VISIBLE_DEVICES=0\n20: export CUDA_CACHE_MAXSIZE=2147483648\n21: \n22: # 擬ポテンシャルファイルの配置確認\n23: if [ ! -f \"C.upf\" ]; then\n24:     cp \"$WORKSPACE_DIR/calc_2H-SiC_10-10_6periods_true_bulk_scf/C.upf\" ./\n25: fi\n26: if [ ! -f \"Si.upf\" ]; then\n27:     cp \"$WORKSPACE_DIR/calc_2H-SiC_10-10_6periods_true_bulk_scf/Si.upf\" ./\n28: fi\n29: \n30: # モデルと入力ファイルが未生成なら自動生成\n31: if [ ! -f \"espresso.pwi\" ]; then\n32:     python3 create_8periods_bulk_and_slab_models.py\n33: fi\n34: \n35: PW_BIN=\"$ENV_PREFIX/bin/pw.x\"\n36: MPI_NP=${QE_MPI_NP:-12}\n37: export OMP_NUM_THREADS=${QE_OMP_THREADS:-2}\n38: \n39: echo \"============================================================\"\n40: echo \" Starting 8-Periods (288 atoms) True Bulk 1-Point SCF\"\n41: echo \" Hardware : Core Ultra 9 285K (24 cores) / RAM 64GB / RTX 5080 16GB\"\n42: echo \" Parallel : MPI_NP=$MPI_NP x OMP_NUM_THREADS=$OMP_NUM_THREADS (Total 24 threads)\"\n43: echo \"============================================================\"\n44: nvidia-smi --query-gpu=name,driver_version,memory.total,temperature.gpu,power.draw --format=csv || true\n45: \n46: mkdir -p tmp\n47: T0=$(date +%s)\n48: \n49: mpirun --oversubscribe -np \"$MPI_NP\" \"$PW_BIN\" -ndiag 1 < espresso.pwi > espresso.pwo 2>&1\n50: \n51: T1=$(date +%s)\n52: ELAPSED=$((T1 - T0))\n53: \n54: echo \"============================================================\"\n55: echo \" 8-Periods (288 atoms) True Bulk SCF Finished in ${ELAPSED}s!\"\n56: grep -E \"(!    total energy|Total force)\" espresso.pwo || true\n57: echo \"============================================================\"\n58: \n59: # fracture_metadata.json への自動記録と 1原子あたりエネルギーの整合性検証 (AGENTS.md §1)\n60: python3 - << 'PY_EOF'\n61: import json, re\n62: \n63: with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n64:     text = f.read()\n65: \n66: m_e = re.findall(r\"!\\s+total energy\\s+=\\s+([-\\d\\.]+)\\s+Ry\", text)\n67: m_f = re.findall(r\"Total force\\s+=\\s+([-\\d\\.]+)\\s+Total SCF correction\\s+=\\s+([-\\d\\.]+)\", text)\n68: \n69: if m_e:\n70:     e_ry = float(m_e[-1])\n71:     # QE -> eV 換算 (1 Ry = 13.605693122994 eV, 6周期と同基準の 13.6056980659 も併記)\n72:     # 過去台帳 (72原子: -2347.20460935 Ry -> -31935.3562 eV => 換算係数 13.60569758)\n73:     conv_ry_to_ev = 13.605693122994\n74:     e_ev = e_ry * conv_ry_to_ev\n75:     e_per_atom = e_ev / 288.0\n76: \n77:     with open(\"fracture_metadata.json\", \"r\", encoding=\"utf-8\") as f:\n78:         meta = json.load(f)\n79: \n80:     meta[\"true_bulk_scf_energy_Ry\"] = round(e_ry, 8)\n81:     meta[\"true_bulk_scf_energy_eV\"] = round(e_ev, 4)\n82:     meta[\"energy_per_atom_eV\"] = round(e_per_atom, 6)\n83:     if m_f:\n84:         meta[\"total_force_Ry_au\"] = float(m_f[-1][0])\n85:         meta[\"total_scf_correction_Ry_au\"] = float(m_f[-1][1])\n86: \n87:     with open(\"fracture_metadata.json\", \"w\", encoding=\"utf-8\") as f:\n88:         json.dump(meta, f, indent=4, ensure_ascii=False)\n89: \n90:     print(\"------------------------------------------------------------\")\n91:     print(\" [8周期 (288原子) 真のバルク SCF 検証結果]\")\n92:     print(f\"  - 全エネルギー E_bulk (Ry) : {e_ry:.8f} Ry\")\n93:     print(f\"  - 全エネルギー E_bulk (eV) : {e_ev:.4f} eV\")\n94:     print(f\"  - 1原子あたりエネルギー    : {e_per_atom:.4f} eV/atom (基準: -443.55 eV/atom)\")\n95:     print(f\"  - 2周期 (72原子) の4倍比   : {-2347.20460730 * 4:.8f} Ry (差分: {e_ry - (-2347.20460730 * 4):.6f} Ry)\")\n96:     if m_f:\n97:         print(f\"  - Total force              : {m_f[-1][0]} Ry/au\")\n98:     print(\"  -> fracture_metadata.json に確定値を記録しました。\")\n99:     print(\"------------------------------------------------------------\")\n100: PY_EOF\n101: "}
