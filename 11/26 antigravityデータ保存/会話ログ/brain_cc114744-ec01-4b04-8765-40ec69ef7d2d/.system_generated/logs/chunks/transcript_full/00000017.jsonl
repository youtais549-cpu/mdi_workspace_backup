{"step_index":778,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:07:56Z","content":"Created At: 2026-11-08T23:07:56+09:00\nCompleted At: 2026-11-08T23:07:56+09:00\nShowing lines 195-300 of 654\n195:     conv_ry_to_ev = 13.605693122994\n196:     e_bulk_ev = e_bulk_ry * conv_ry_to_ev\n197:     e_per_atom = e_bulk_ev / float(natoms)\n198: \n199:     log(\n200:         f\"--- [Period {N}] Bulk SCF Done in {elapsed:.1f}s | \"\n201:         f\"E_bulk={e_bulk_ev:.4f} eV ({e_bulk_ry:.8f} Ry) | {e_per_atom:.4f} eV/atom (Target: -443.5 eV/atom) ---\"\n202:     )\n203: \n204:     # 構造ファイルも保存\n205:     prefix_bulk = os.path.join(calc_dir, f\"bulk_10-10_{natoms}atoms_true_bulk\")\n206:     ase.io.write(f\"{prefix_bulk}.cif\", bulk_atoms)\n207:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk_atoms)\n208:     write_lammps_data(f\"{prefix_bulk}.data\", bulk_atoms, atom_style=\"atomic\", masses=True)\n209: \n210:     return e_bulk_ev, e_bulk_ry, elapsed\n211: \n212: \n213: def prepare_slab_directory(N, calc_dir, slab_3x3, e_bulk_ev, e_bulk_ry, port):\n214:     \"\"\"スラブ緩和計算用の入力ファイル一式を配備\"\"\"\n215:     natoms = len(slab_3x3)\n216:     slab_prefix = f\"slab_10-10_{natoms}atoms_vac5A\"\n217: \n218:     # 1. 共通アセット配備\n219:     for asset in [\n220:         \"C.upf\",\n221:         \"Si.upf\",\n222:         \"RELAXATION_GRAPH_PROTOCOL.json\",\n223:         \"dft_settings.py\",\n224:         \"make_xyz.py\",\n225:         \"msmincho.ttc\",\n226:         \"times.ttf\",\n227:         \"auto_generate_progression_graphs.py\",\n228:         \"qe_mdi_engine_rtx5080.py\",\n229:     ]:\n230:         src = os.path.join(TEMPLATE_DIR, asset)\n231:         dst = os.path.join(calc_dir, asset)\n232:         if not os.path.exists(dst):\n233:             shutil.copyfile(src, dst)\n234: \n235:     # 2. スラブ構造ファイル保存\n236:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.cif\"), slab_3x3)\n237:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.xyz\"), slab_3x3)\n238:     write_lammps_data(os.path.join(calc_dir, f\"{slab_prefix}.data\"), slab_3x3, atom_style=\"atomic\", masses=True)\n239: \n240:     # 3. in.lammps 作成 (AGENTS.md §9 恒久標準)\n241:     in_lammps_content = f\"\"\"# 2H-SiC {{10-10}} {N}周期 ({2*N}層, {natoms}原子) 真空層 5.0 Å スラブ構造緩和入力スクリプト\n242: # 【最適化収束条件標準: minimize 1.0e-6 1.0e-2 100 150 (AGENTS.md §9)】\n243: units metal\n244: boundary p p p\n245: atom_style atomic\n246: atom_modify map yes\n247: \n248: read_data {slab_prefix}.data\n249: \n250: # Type 1: C (12.011), Type 2: Si (28.085) (AGENTS.md §2)\n251: mass 1 12.011\n252: mass 2 28.085\n253: \n254: fix 1 all mdi/qm elements C Si\n255: \n256: thermo 1\n257: thermo_modify flush yes\n258: dump 1 all custom 1 dump.lammpstrj id type x y z\n259: dump_modify 1 append yes flush yes\n260: \n261: minimize 1.0e-6 1.0e-2 100 150\n262: \n263: undump 1\n264: write_data {slab_prefix}_relaxed.data\n265: \"\"\"\n266:     with open(os.path.join(calc_dir, \"in.lammps\"), \"w\") as f:\n267:         f.write(in_lammps_content)\n268:     with open(os.path.join(calc_dir, \"in.lammps.optimized_conv\"), \"w\") as f:\n269:         f.write(in_lammps_content)\n270: \n271:     # 4. fracture_metadata.json 初期化\n272:     meta_init = {\n273:         \"model_name\": f\"2H-SiC_10-10_{N}periods_vac5A\",\n274:         \"plane\": \"{10-10}\",\n275:         \"n_periods\": N,\n276:         \"n_layers\": 2 * N,\n277:         \"n_atoms\": natoms,\n278:         \"vacuum_thickness_angstrom\": 5.0,\n279:         \"box_lx_ly_lz_A\": [\n280:             round(float(slab_3x3.cell[0, 0]), 4),\n281:             round(float(slab_3x3.cell[1, 1]), 4),\n282:             round(float(slab_3x3.cell[2, 2]), 4),\n283:         ],\n284:         \"cross_sectional_area_2A_A2\": round(AREA_2A, 6),\n285:         \"true_bulk_scf_energy_Ry\": round(e_bulk_ry, 8),\n286:         \"true_bulk_scf_energy_eV\": round(e_bulk_ev, 4),\n287:         \"convergence_settings\": \"minimize 1.0e-6 1.0e-2 100 150\",\n288:         \"dft_settings\": {\n289:             \"ecutwfc_Ry\": 40.0,\n290:             \"ecutrho_Ry\": 320.0,\n291:             \"conv_thr_Ry\": 1.0e-5,\n292:             \"k_points\": \"gamma\",\n293:             \"mixing_beta\": 0.3,\n294:         },\n295:         \"target_nas_folder\": f\"{{101_0}}{N}周期5Å\",\n296:         \"created_at\": datetime.datetime.now().isoformat(),\n297:     }\n298:     with open(os.path.join(calc_dir, \"fracture_metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n299:         json.dump(meta_init, f, indent=4, ensure_ascii=False)\n300: "}
