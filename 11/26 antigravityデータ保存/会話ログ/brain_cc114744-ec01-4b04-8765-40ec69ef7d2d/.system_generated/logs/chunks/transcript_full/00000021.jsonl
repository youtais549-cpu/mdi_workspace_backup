{"step_index":1000,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T07:20:54Z","content":"Created At: 2026-11-10T16:20:54+09:00\nCompleted At: 2026-11-10T16:20:54+09:00\nShowing lines 1-115 of 115\n1: import os\n2: import numpy as np\n3: import ase.io\n4: from ase.build import surface\n5: from ase.io.lammpsdata import write_lammps_data\n6: import matplotlib.pyplot as plt\n7: \n8: def build_10_10_slab_3x3x2():\n9:     # 1. 2H-SiC CIFファイルの読み込み\n10:     cif_input = \"/home/yamazaki/mdi_workspace_backup/research_simulations/2H-SiC.cif\"\n11:     out_dir = \"/home/yamazaki/mdi_workspace_backup/research_simulations\"\n12:     os.makedirs(out_dir, exist_ok=True)\n13:     \n14:     print(f\"Loading 2H-SiC crystal from {cif_input}...\")\n15:     bulk = ase.io.read(cif_input)\n16:     \n17:     # 2. {10-10} 面スラブの構築 (layers=2: 1周期2層なので合計4層)\n18:     # indices=(1, 0, 0) は六方晶の (1 0 -1 0) 面に対応\n19:     slab_unit = surface(bulk, indices=(1, 0, 0), layers=2, vacuum=None)\n20:     \n21:     # 3. 3x3x1 スーパーセルの作成 (面内 3x3、z方向は2周期4層のまま維持)\n22:     slab_3x3 = slab_unit * (3, 3, 1)\n23:     \n24:     # 4. z方向の座標調整と真空層の追加 (上下に各10Å)\n25:     pos = slab_3x3.positions\n26:     z_min = np.min(pos[:, 2])\n27:     z_max = np.max(pos[:, 2])\n28:     thickness = z_max - z_min\n29:     \n30:     # 最下層の原子が z = 10.0 Å になるようにシフト\n31:     pos[:, 2] = pos[:, 2] - z_min + 10.0\n32:     slab_3x3.positions = pos\n33:     \n34:     # セルの z 軸長さを (厚み + 20.0 Å) に設定 (下端に10Å、上端に10Åの真空)\n35:     cell = slab_3x3.cell.copy()\n36:     cell[2, 2] = thickness + 20.0\n37:     slab_3x3.cell = cell\n38:     slab_3x3.pbc = [True, True, True]\n39:     \n40:     # x, y をセル内に収める\n41:     slab_3x3.wrap()\n42:     \n43:     # 各層の z 座標を確認\n44:     z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 3))\n45:     n_si = sum(s == 'Si' for s in slab_3x3.get_chemical_symbols())\n46:     n_c = sum(s == 'C' for s in slab_3x3.get_chemical_symbols())\n47:     \n48:     print(f\"\\n==========================================\")\n49:     print(f\"3x3x2 Slab Model generated successfully:\")\n50:     print(f\"  - Total Atoms: {len(slab_3x3)} (Si: {n_si}, C: {n_c})\")\n51:     print(f\"  - Cell dimensions: a={slab_3x3.cell[0,0]:.4f} Å, b={slab_3x3.cell[1,1]:.4f} Å, c={slab_3x3.cell[2,2]:.4f} Å\")\n52:     print(f\"  - Cell angles: alpha={slab_3x3.cell.angles()[0]:.1f}°, beta={slab_3x3.cell.angles()[1]:.1f}°, gamma={slab_3x3.cell.angles()[2]:.1f}°\")\n53:     print(f\"  - Atomic layers (z levels): {z_unique} Å\")\n54:     for idx, z_val in enumerate(z_unique, 1):\n55:         count = sum(np.isclose(slab_3x3.positions[:, 2], z_val, atol=0.01))\n56:         print(f\"      Layer {idx}: z={z_val:.3f} Å ({count} atoms)\")\n57:     print(f\"  - Bottom vacuum: {np.min(slab_3x3.positions[:, 2]):.4f} Å (Target: 10.0 Å)\")\n58:     print(f\"  - Top vacuum: {slab_3x3.cell[2,2] - np.max(slab_3x3.positions[:, 2]):.4f} Å (Target: 10.0 Å)\")\n59:     print(f\"==========================================\\n\")\n60:     \n61:     # 5. ファイル保存 (3x3x2 モデル)\n62:     base_prefix = os.path.join(out_dir, \"2H-SiC_10-10_slab_3x3x2_4layers_vacuum\")\n63:     ase.io.write(f\"{base_prefix}.cif\", slab_3x3)\n64:     ase.io.write(f\"{base_prefix}.xyz\", slab_3x3)\n65:     write_lammps_data(f\"{base_prefix}.data\", slab_3x3, atom_style='atomic', masses=True)\n66:     print(f\"Saved 3x3x2 slab files to:\\n  - {base_prefix}.cif\\n  - {base_prefix}.xyz\\n  - {base_prefix}.data\")\n67:     \n68:     # 6. 構造の断面図プロット作成\n69:     fig, axes = plt.subplots(1, 2, figsize=(15, 7))\n70:     \n71:     pos = slab_3x3.positions\n72:     syms = slab_3x3.get_chemical_symbols()\n73:     colors = {'Si': '#1f77b4', 'C': '#ff7f0e'}\n74:     sizes = {'Si': 150, 'C': 80}\n75:     cell = slab_3x3.cell\n76:     \n77:     # (a) x-z 断面図\n78:     ax1 = axes[0]\n79:     for s in ['Si', 'C']:\n80:         mask = [sym == s for sym in syms]\n81:         ax1.scatter(pos[mask, 0], pos[mask, 2], c=colors[s], s=sizes[s], label=s, edgecolors='black', zorder=3)\n82:     ax1.plot([0, cell[0,0], cell[0,0], 0, 0], [0, 0, cell[2,2], cell[2,2], 0], 'k--', label='Periodic Cell')\n83:     ax1.axhline(10.0, color='r', linestyle=':', label='Bottom Fracture Surface (z=10Å)')\n84:     ax1.axhline(10.0 + thickness, color='r', linestyle=':', label=f'Top Fracture Surface (z={10.0+thickness:.2f}Å)')\n85:     ax1.set_xlim(-1, cell[0,0] + 1)\n86:     ax1.set_ylim(-1, cell[2,2] + 1)\n87:     ax1.set_xlabel('x [Å] ([11-20] direction, 3x size)')\n88:     ax1.set_ylabel('z [Å] (Cleavage normal {10-10})')\n89:     ax1.set_title('Side View (x-z plane, 3x3x2 model, 72 atoms)\\nShowing 4 layers & 10Å Vacuums', fontweight='bold')\n90:     ax1.legend(loc='upper right')\n91:     ax1.grid(True, linestyle='--', alpha=0.3)\n92:     \n93:     # (b) y-z 断面図\n94:     ax2 = axes[1]\n95:     for s in ['Si', 'C']:\n96:         mask = [sym == s for sym in syms]\n97:         ax2.scatter(pos[mask, 1], pos[mask, 2], c=colors[s], s=sizes[s], label=s, edgecolors='black', zorder=3)\n98:     ax2.plot([0, cell[1,1], cell[1,1], 0, 0], [0, 0, cell[2,2], cell[2,2], 0], 'k--', label='Periodic Cell')\n99:     ax2.axhline(10.0, color='r', linestyle=':', label='Bottom Fracture Surface (z=10Å)')\n100:     ax2.axhline(10.0 + thickness, color='r', linestyle=':', label=f'Top Fracture Surface (z={10.0+thickness:.2f}Å)')\n101:     ax2.set_xlim(-1, cell[1,1] + 1)\n102:     ax2.set_ylim(-1, cell[2,2] + 1)\n103:     ax2.set_xlabel('y [Å] (c-axis [0001] direction, 3x size)')\n104:     ax2.set_ylabel('z [Å] (Cleavage normal {10-10})')\n105:     ax2.set_title('Side View (y-z plane, 3x3x2 model, 72 atoms)\\nShowing 4 layers & 10Å Vacuums', fontweight='bold')\n106:     ax2.legend(loc='upper right')\n107:     ax2.grid(True, linestyle='--', alpha=0.3)\n108:     \n109:     plt.tight_layout()\n110:     plot_path = os.path.join(out_dir, \"2H-SiC_10-10_slab_3x3x2_structure.png\")\n111:     plt.savefig(plot_path, dpi=200)\n112:     print(f\"Saved structure plot to {plot_path}\")\n113: \n114: if __name__ == \"__main__\":\n115:     build_10_10_slab_3x3x2()"}
