{"step_index":990,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T07:20:00Z","content":"Created At: 2026-11-10T16:20:00+09:00\nCompleted At: 2026-11-10T16:20:00+09:00\nShowing lines 1-114 of 114\n1: #!/bin/bash\n2: # ==============================================================================\n3: # run_slab_rtx5080.sh\n4: # ローカル新環境 (Core Ultra 9 285K / RAM 64GB / RTX 5080 16GB) 上で\n5: # LAMMPS (DRIVER) + Quantum ESPRESSO (MDI ENGINE) 連成構造緩和を実行するスクリプト\n6: # ==============================================================================\n7: set -e\n8: \n9: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n10: cd \"$SCRIPT_DIR\"\n11: \n12: # ローカル Python 仮想環境があれば有効化\n13: ENV_PREFIX=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n14: if [ -d \"$ENV_PREFIX/bin\" ]; then\n15:     export PATH=\"$SCRIPT_DIR/bin:$ENV_PREFIX/bin:$PATH\"\n16:     export LD_LIBRARY_PATH=\"$ENV_PREFIX/lib:${LD_LIBRARY_PATH:-}\"\n17: elif [ -f \"$HOME/.venvs/mdi_rtx5080/bin/activate\" ]; then\n18:     source \"$HOME/.venvs/mdi_rtx5080/bin/activate\"\n19: fi\n20: \n21: # 実行前の新規出力ファイル初期化 (既存フォルダのファイルは一切触らない)\n22: rm -rf tmp espresso.pwo espresso_all_steps.pwo dump.lammpstrj qe_engine.log lmp.log log.lammps\n23: \n24: # LAMMPS バイナリの自動検出\n25: LMP_BIN=\"\"\n26: for cand in \"$SCRIPT_DIR/bin/lmp\" \"$HOME/.local/bin/lmp\" \"/usr/local/bin/lmp\" \"$(which lmp 2>/dev/null || true)\" \"$(which lmp_mpi 2>/dev/null || true)\"; do\n27:     if [ -n \"$cand\" ] && [ -x \"$cand\" ]; then\n28:         LMP_BIN=\"$cand\"\n29:         break\n30:     fi\n31: done\n32: \n33: if [ -z \"$LMP_BIN\" ]; then\n34:     echo \"❌ エラー: LAMMPS (lmp) が見つかりません。先に 'bash setup_local_rtx5080_env.sh' を実行してください。\"\n35:     exit 1\n36: fi\n37: \n38: MDI_PORT=${MDI_PORT:-8021}\n39: \n40: echo \"============================================================\"\n41: echo \" Starting LAMMPS + QE MDI Slab Relaxation (RTX 5080 / Ultra 9 285K)\"\n42: echo \" Model: 2H-SiC {10-10} 2-Periods (72 atoms), Vacuum 5.0 Å\"\n43: echo \" Convergence Standard: minimize 1.0e-6 1.0e-2 100 150\"\n44: echo \" LAMMPS Binary: $LMP_BIN | TCP Port: $MDI_PORT\"\n45: echo \"============================================================\"\n46: \n47: # 1. LAMMPS を MDI DRIVER としてバックグラウンド起動\n48: echo \"1. Starting LAMMPS MDI driver...\"\n49: \"$LMP_BIN\" -mdi \"-role DRIVER -name LAMMPS -method TCP -port $MDI_PORT\" -in in.lammps > lmp.log 2>&1 &\n50: LMP_PID=$!\n51: \n52: sleep 1\n53: \n54: # 2. Python QE MDI Engine (RTX 5080 / Ultra 9 285K 対応版) を起動\n55: echo \"2. Starting Python QE MDI engine (RTX 5080)...\"\n56: python3 qe_mdi_engine_rtx5080.py -mdi \"-role ENGINE -name QE -method TCP -port $MDI_PORT -hostname localhost\" > qe_engine.log 2>&1\n57: \n58: # 3. LAMMPS 完了待機\n59: wait $LMP_PID\n60: \n61: echo \"============================================================\"\n62: echo \" Calculation Completed Successfully!\"\n63: echo \" 3. Converting trajectory to Winmostar XYZ format (sorted by Atom ID)...\"\n64: python3 make_xyz.py dump.lammpstrj md_animation.xyz\n65: \n66: # 4. 指示書 (RELAXATION_GRAPH_PROTOCOL.json) に基づく3種推移グラフの自動生成 (AGENTS.md §8)\n67: echo \" 4. Generating 3 progression graphs according to protocol...\"\n68: python3 auto_generate_progression_graphs.py\n69: \n70: # 5. 表面破壊エネルギー γ の自動算出と T4 GPU 結果との整合性検証\n71: echo \" 5. Evaluating Surface Fracture Energy γ...\"\n72: python3 - << 'PY_EOF'\n73: import json, re, os\n74: \n75: with open(\"fracture_metadata.json\", \"r\", encoding=\"utf-8\") as f:\n76:     meta = json.load(f)\n77: \n78: e_bulk = meta[\"true_bulk_scf_energy_eV\"]\n79: denom = meta[\"effective_denominator\"]\n80: ref_t4_gamma = meta[\"reference_t4_surface_fracture_energy_J_m2\"]\n81: ref_lit_gamma = meta[\"reference_rauls_dimer_J_m2\"]\n82: \n83: energies = []\n84: if os.path.exists(\"qe_engine.log\"):\n85:     with open(\"qe_engine.log\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n86:         for line in f:\n87:             m = re.search(r\"Total Energy:\\s+([-\\d\\.]+)\\s+eV\", line)\n88:             if m:\n89:                 energies.append(float(m.group(1)))\n90: \n91: if energies:\n92:     e_slab = energies[-1]\n93:     delta_e = e_slab - e_bulk\n94:     gamma = delta_e / denom\n95:     diff_t4 = abs(gamma - ref_t4_gamma)\n96:     meta[\"rtx5080_relaxed_slab_energy_eV\"] = round(e_slab, 4)\n97:     meta[\"rtx5080_delta_energy_eV\"] = round(delta_e, 4)\n98:     meta[\"rtx5080_surface_fracture_energy_J_m2\"] = round(gamma, 4)\n99:     with open(\"fracture_metadata.json\", \"w\", encoding=\"utf-8\") as f:\n100:         json.dump(meta, f, indent=4, ensure_ascii=False)\n101:     print(\"------------------------------------------------------------\")\n102:     print(f\"  [RTX 5080 計算結果検証サマリー]\")\n103:     print(f\"  - E_bulk (72 atoms) : {e_bulk:.4f} eV\")\n104:     print(f\"  - E_slab (relaxed)  : {e_slab:.4f} eV\")\n105:     print(f\"  - ΔE = E_slab-E_bulk: {delta_e:.4f} eV\")\n106:     print(f\"  - 表面破壊エネルギー γ: {gamma:.4f} J/m²\")\n107:     print(f\"  - 旧環境 (T4 GPU) 値 : {ref_t4_gamma:.4f} J/m² (差分: {diff_t4:.4f} J/m²)\")\n108:     print(f\"  - 文献値 (Rauls 1999): {ref_lit_gamma:.2f} J/m²\")\n109:     print(\"------------------------------------------------------------\")\n110: PY_EOF\n111: \n112: echo \" Done!\"\n113: echo \"============================================================\"\n114: "}
