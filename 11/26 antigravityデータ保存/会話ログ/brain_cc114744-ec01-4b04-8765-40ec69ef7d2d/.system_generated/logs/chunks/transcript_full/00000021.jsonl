{"step_index":986,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T07:19:36Z","content":"Created At: 2026-11-10T16:19:36+09:00\nCompleted At: 2026-11-10T16:19:37+09:00\nShowing lines 100-160 of 551\n100:         dst_asset = os.path.join(calc_dir, asset)\n101:         if not os.path.exists(dst_asset):\n102:             shutil.copyfile(src_asset, dst_asset)\n103: \n104:     # 2周期バルクSCFログも同梱\n105:     for bulk_file in [\"2H-SiC_10-10_bulk_3x3x2_72atoms.data\", \"espresso_bulk_scf.pwi\", \"espresso_bulk_scf.pwo\"]:\n106:         src_bf = os.path.join(BULK_2P_DIR, bulk_file)\n107:         if os.path.exists(src_bf):\n108:             shutil.copyfile(src_bf, os.path.join(calc_dir, bulk_file))\n109: \n110:     # 2. ASE surface() による 2周期 (4層, 72原子) 自然へき開面スラブモデルの構築\n111:     bulk_cif = ase.io.read(CIF_INPUT)\n112:     slab_unit = surface(bulk_cif, indices=(1, 0, 0), layers=2, vacuum=None)\n113:     slab_3x3 = slab_unit * (3, 3, 1)\n114: \n115:     pos = slab_3x3.positions.copy()\n116:     z_min = float(np.min(pos[:, 2]))\n117:     z_max = float(np.max(pos[:, 2]))\n118:     thickness = z_max - z_min\n119: \n120:     # 下部真空層 = vac_val [Å], 上部真空層 = vac_val [Å] (合計 2 * vac_val [Å])\n121:     pos[:, 2] = pos[:, 2] - z_min + vac_val\n122:     slab_3x3.positions = pos\n123: \n124:     cell = slab_3x3.cell.copy()\n125:     cell[2, 2] = thickness + 2.0 * vac_val\n126:     slab_3x3.cell = cell\n127:     slab_3x3.pbc = [True, True, True]\n128: \n129:     # 層間間隔プロファイルの厳格検証 ([0.8881, 1.7758, 0.8881])\n130:     z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 4))\n131:     diffs = [round(float(z_unique[i + 1] - z_unique[i]), 4) for i in range(len(z_unique) - 1)]\n132:     if len(diffs) != 3 or abs(diffs[0] - 0.8881) > 0.005 or abs(diffs[1] - 1.7758) > 0.005:\n133:         raise RuntimeError(f\"Invalid interlayer spacing profile for vac={vac_val}A: {diffs}\")\n134: \n135:     slab_prefix = f\"2H-SiC_10-10_slab_3x3x2_vac{vac_str}A\"\n136:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.cif\"), slab_3x3)\n137:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.xyz\"), slab_3x3)\n138:     write_lammps_data(os.path.join(calc_dir, f\"{slab_prefix}.data\"), slab_3x3, atom_style=\"atomic\", masses=True)\n139: \n140:     # 3. in.lammps & in.lammps.optimized_conv の作成 (AGENTS.md §9 恒久標準)\n141:     in_lammps_content = f\"\"\"# 2H-SiC {{10-10}} 2周期 (4層, 72原子) 真空層 {vac_str} Å スラブ構造緩和入力スクリプト\n142: # 【最適化収束条件標準: minimize 1.0e-6 1.0e-2 100 150 (AGENTS.md §9)】\n143: units metal\n144: boundary p p p\n145: atom_style atomic\n146: atom_modify map yes\n147: \n148: read_data {slab_prefix}.data\n149: \n150: # Type 1: C (12.011), Type 2: Si (28.085) (AGENTS.md §2)\n151: mass 1 12.011\n152: mass 2 28.085\n153: \n154: fix 1 all mdi/qm elements C Si\n155: \n156: thermo 1\n157: thermo_modify flush yes\n158: dump 1 all custom 1 dump.lammpstrj id type x y z\n159: dump_modify 1 append yes flush yes\n160: "}
