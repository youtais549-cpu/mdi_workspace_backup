{"step_index":1033,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-11T04:02:22Z","content":"Created At: 2026-11-11T13:02:22+09:00\nCompleted At: 2026-11-11T13:02:22+09:00\nCreated At: 2026-11-11T13:02:22+09:00\nCompleted At: 2026-11-11T13:02:22+09:00\nShowing lines 201-413 of 413\n201:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n202:             mod = importlib.util.module_from_spec(spec)\n203:             spec.loader.exec_module(mod)\n204:             if hasattr(mod, 'DFT_CONFIG'):\n205:                 default_config.update(mod.DFT_CONFIG)\n206:                 log(\"Loaded DFT_CONFIG from dft_settings.py\")\n207:     except Exception as e:\n208:         log(f\"Notice: Using default DFT parameters ({e})\")\n209:     return default_config\n210: \n211: \n212: def allocate_qm():\n213:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n214:     n = qm_natoms\n215:     qm_elements = np.empty(n, dtype=np.int32)\n216:     qm_coords = np.empty((n, 3), dtype=np.float64)\n217:     qm_forces = np.empty((n, 3), dtype=np.float64)\n218:     last_evaluated_coords = None\n219: \n220: \n221: def receive_qm_natoms(mdicomm):\n222:     global qm_natoms\n223:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n224:     log(f\"Received >NATOMS: {qm_natoms}\")\n225:     allocate_qm()\n226: \n227: \n228: def receive_box(mdicomm):\n229:     global flag_box\n230:     flag_box = True\n231:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n232:     if ierr:\n233:         error(\"MDI: >CELL reception failed\")\n234: \n235: \n236: def receive_qm_coords(mdicomm):\n237:     if not qm_natoms:\n238:         error(\"Cannot receive >COORDS if # atoms = 0\")\n239:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n240:     if ierr:\n241:         error(\"MDI: >COORDS reception failed\")\n242: \n243: \n244: def receive_qm_elements(mdicomm):\n245:     if not qm_natoms:\n246:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n247:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n248:     if ierr:\n249:         error(\"MDI: >ELEMENTS reception failed\")\n250: \n251: \n252: def receive_qm_types(mdicomm):\n253:     if not qm_natoms:\n254:         error(\"Cannot receive >TYPES if # atoms = 0\")\n255:     types = np.empty(qm_natoms, dtype=np.int32)\n256:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n257:     if ierr:\n258:         error(\"MDI: >TYPES reception failed\")\n259:     for i, t in enumerate(types):\n260:         sym = type_to_symbol.get(int(t), 'C')\n261:         qm_elements[i] = ELEMENTS.index(sym) + 1\n262: \n263: \n264: def evaluate():\n265:     global qm_pe, qm_forces, last_evaluated_coords, step_counter\n266:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n267:         error(\"System atoms, elements, or coordinates not fully specified\")\n268: \n269:     # 座標キャッシュ: 同一ステップでの重複 SCF 計算を防止\n270:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n271:         return\n272: \n273:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n274:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n275:     force_conv = ev_to_hartree * bohr_to_angstrom\n276: \n277:     coords_angstrom = qm_coords * bohr_to_angstrom\n278:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n279: \n280:     if flag_box and np.linalg.norm(box) > 1e-6:\n281:         cell_matrix_bohr = box.reshape(3, 3)\n282:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n283:     else:\n284:         cell_matrix_angstrom = np.eye(3) * 10.0\n285: \n286:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n287:     command_str = detect_pw_command()\n288:     cfg = load_dft_config()\n289: \n290:     input_data = {\n291:         'control': {\n292:             'calculation': 'scf',\n293:             'pseudo_dir': './',\n294:             'outdir': './tmp',\n295:             'tprnfor': True,\n296:             'tstress': True,\n297:             'disk_io': 'minimal',\n298:         },\n299:         'system': {\n300:             'ecutwfc': cfg['ecutwfc'],\n301:             'ecutrho': cfg['ecutrho'],\n302:             'occupations': cfg['occupations'],\n303:             'smearing': cfg['smearing'],\n304:             'degauss': cfg['degauss'],\n305:         },\n306:         'electrons': {\n307:             'conv_thr': cfg['conv_thr'],\n308:             'mixing_beta': cfg['mixing_beta'],\n309:             'mixing_mode': cfg['mixing_mode'],\n310:             'electron_maxstep': cfg['electron_maxstep'],\n311:         },\n312:     }\n313: \n314:     log(f\"--- [Step {step_counter}] Running SCF with QE ({len(atoms)} atoms) | {query_rtx5080_status()} ---\")\n315: \n316:     t0 = time.time()\n317:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n318:     calc = Espresso(profile=profile, pseudopotentials=cfg['pseudopotentials'], input_data=input_data, kpts=cfg['kpts'])\n319:     atoms.calc = calc\n320: \n321:     pe_ev = atoms.get_potential_energy()\n322:     forces_ev_angstrom = atoms.get_forces()\n323:     elapsed = time.time() - t0\n324: \n325:     # 各ステップの espresso.pwo を履歴ファイルにも追記保存（全ステップの Total force / SCF correction 追跡用）\n326:     if os.path.exists(\"espresso.pwo\"):\n327:         with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f_in:\n328:             pwo_text = f_in.read()\n329:         with open(\"espresso_all_steps.pwo\", \"a\", encoding=\"utf-8\") as f_out:\n330:             f_out.write(f\"\\n=== STEP {step_counter} ===\\n\")\n331:             f_out.write(pwo_text)\n332: \n333:     fmax_ev_ang = float(np.max(np.linalg.norm(forces_ev_angstrom, axis=1)))\n334:     qm_pe = pe_ev * ev_to_hartree\n335:     qm_forces = forces_ev_angstrom * force_conv\n336: \n337:     # auto_generate_progression_graphs.py 互換フォーマットでログ出力\n338:     log(\n339:         f\"--- Step Done in {elapsed:.2f}s! Total Energy: {pe_ev:.4f} eV \"\n340:         f\"({qm_pe:.6f} Hartree) | Fmax: {fmax_ev_ang:.5f} eV/A | {query_rtx5080_status()} ---\"\n341:     )\n342:     last_evaluated_coords = np.copy(qm_coords)\n343:     step_counter += 1\n344: \n345: \n346: def execute_command(command, mdicomm, object_ptr):\n347:     global exitflag\n348:     if command == \"EXIT\":\n349:         log(\"Received EXIT command from driver.\")\n350:         exitflag = True\n351:     elif command == \">NATOMS\":\n352:         receive_qm_natoms(mdicomm)\n353:     elif command == \">CELL\":\n354:         receive_box(mdicomm)\n355:     elif command == \">ELEMENTS\":\n356:         receive_qm_elements(mdicomm)\n357:     elif command == \">TYPES\":\n358:         receive_qm_types(mdicomm)\n359:     elif command == \">COORDS\":\n360:         receive_qm_coords(mdicomm)\n361:     elif command in [\"<ENERGY\", \"<PE\"]:\n362:         evaluate()\n363:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n364:         if ierr:\n365:             error(\"MDI: <ENERGY send failed\")\n366:     elif command == \"<FORCES\":\n367:         evaluate()\n368:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n369:         if ierr:\n370:             error(\"MDI: <FORCES send failed\")\n371:     else:\n372:         error(f\"Unrecognized MDI command: {command}\")\n373:     return 0\n374: \n375: \n376: if __name__ == \"__main__\":\n377:     configure_rtx5080_environment()\n378: \n379:     args = sys.argv\n380:     mdi_option = \"\"\n381:     iarg = 1\n382:     while iarg < len(args):\n383:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n384:             if iarg + 1 < len(args):\n385:                 mdi_option = args[iarg + 1]\n386:                 break\n387:         iarg += 1\n388: \n389:     if not mdi_option:\n390:         error(\"Missing -mdi argument on command line\")\n391: \n392:     log(f\"Initializing MDI Engine (RTX 5080 / Ultra 9 285K) with options: {mdi_option}\")\n393:     log(query_rtx5080_status())\n394:     mdi.MDI_Init(mdi_option)\n395: \n396:     mdi.MDI_Register_Node(\"@DEFAULT\")\n397:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n398:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n399: \n400:     log(\"Waiting for MDI driver connection...\")\n401:     mdicomm = mdi.MDI_Accept_Communicator()\n402:     log(\"Connected to MDI driver! Entering communication loop...\")\n403: \n404:     while not exitflag:\n405:         command = mdi.MDI_Recv_Command(mdicomm)\n406:         execute_command(command, mdicomm, None)\n407: \n408:     # 全ステップ履歴があれば espresso.pwo に統合して auto_generate_progression_graphs.py が全点読めるようにする\n409:     if os.path.exists(\"espresso_all_steps.pwo\"):\n410:         shutil.copyfile(\"espresso_all_steps.pwo\", \"espresso.pwo\")\n411: \n412:     log(\"MDI Engine execution terminated cleanly.\")\n413: "}
