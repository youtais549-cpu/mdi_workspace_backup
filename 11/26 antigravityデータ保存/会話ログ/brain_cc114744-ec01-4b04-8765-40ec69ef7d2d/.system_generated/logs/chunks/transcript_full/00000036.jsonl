{"step_index":1473,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-22T17:45:41Z","content":"Created At: 2026-11-23T02:45:41+09:00\nCompleted At: 2026-11-23T02:45:41+09:00\nCreated At: 2026-11-23T02:45:41+09:00\nCompleted At: 2026-11-23T02:45:41+09:00\nShowing lines 1-300 of 942\n1: #!/usr/bin/env python3\n2: r\"\"\"\n3: run_8periods_bulk_aimd_continue_to_900steps.py\n4: ==============================================================================\n5: 2H-SiC {10-10} 8周期相当 (16層, 288原子) 真のバルクモデル (真空層 0 Å)\n6: Step 600 終了時点の全データ (位置座標、速度、Nosé-Hoover熱浴内部状態、収束済み波動関数、電子密度、エネルギー・原子力)\n7: を 100% 完全引き継ぎし、追加 300 ステップ (Step 601 ～ 900, 通算 900 steps = 900 fs = 0.9 ps) を実行するスクリプト。\n8: \n9: ・引き継ぎ機構 (AGENTS.md §12 完全準拠):\n10:   1. Step 0 ～ 600: 前回完了した `espresso_all_steps.pwo` から全 601 ステップの DFT エネルギーと\n11:      Hellmann-Feynman 力を ASE パーサーで完全復元し、LAMMPS にキャッシュリプレイ (約 40 秒)。\n12:      これにより Step 600 時点の位置座標・速度・Nosé-Hoover 熱浴チェイン変数 (η, η_dot) が\n13:      1 ビットの誤差もなく 100% 完全一致する状態で復元される (`Files are identical` 検証)。\n14:   2. Step 601 ～ 900: `./tmp/pwscf.save/` に保持された Step 600 の収束済み波動関数 (`wfc1.hdf5`) と\n15:      電子密度 (`charge-density.hdf5`) を `startingwfc = 'file'`, `startingpot = 'file'` で引き継ぎ、\n16:      実機 Quantum ESPRESSO (GPU) による SCF 計算へシームレスに移行して追加 300 ステップを実行する。\n17: ・保存先:\n18:   - ローカル: aimd_2H-SiC_10-10_8periods_bulk_300K_900steps_rtx5080/\n19:   - NAS (ユーザー特例承認による上書き保存先):\n20:     \\\\192.168.12.69\\Results\\yamazaki\\research\\第一原理分子動力学法\\{101_0}8周期3.0Å構造最適化なしtest run\\バルクモデル2\n21: ==============================================================================\n22: \"\"\"\n23: \n24: import os\n25: import sys\n26: import re\n27: import csv\n28: import json\n29: import time\n30: import shutil\n31: import datetime\n32: import subprocess\n33: import numpy as np\n34: \n35: os.environ[\"MPLCONFIGDIR\"] = \"/tmp/matplotlib_cache_sic\"\n36: os.makedirs(\"/tmp/matplotlib_cache_sic\", exist_ok=True)\n37: import matplotlib\n38: matplotlib.use(\"Agg\")\n39: import matplotlib.pyplot as plt\n40: import matplotlib.font_manager as fm\n41: import matplotlib.ticker as ticker\n42: \n43: WORKSPACE_DIR = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_workspace_backup\"\n44: ENV_PREFIX = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n45: PREV_BULK600_DIR = os.path.join(WORKSPACE_DIR, \"aimd_2H-SiC_10-10_8periods_bulk_300K_600steps_rtx5080\")\n46: BULK900_AIMD_DIR = os.path.join(WORKSPACE_DIR, \"aimd_2H-SiC_10-10_8periods_bulk_300K_900steps_rtx5080\")\n47: \n48: LOG_FILE = os.path.join(WORKSPACE_DIR, \"aimd_8periods_bulk_900steps_run.log\")\n49: \n50: \n51: def log(msg):\n52:     now = datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n53:     line = f\"[{now}] {msg}\"\n54:     print(line, flush=True)\n55:     with open(LOG_FILE, \"a\", encoding=\"utf-8\") as f:\n56:         f.write(line + \"\\n\")\n57: \n58: \n59: def sync_to_nas():\n60:     sync_script = os.path.join(WORKSPACE_DIR, \"sync_bulk_900steps_to_nas_bulk2.py\")\n61:     if os.path.exists(sync_script):\n62:         try:\n63:             subprocess.run([\"python3\", sync_script], cwd=WORKSPACE_DIR, timeout=180, check=False)\n64:             log(\"Synced current files to NAS (バルクモデル2).\")\n65:         except Exception as e:\n66:             log(f\"NAS sync notice: {e}\")\n67: \n68: \n69: QE_ENGINE_CONTINUE_900_CODE = r'''#!/usr/bin/env python3\n70: \"\"\"\n71: ==============================================================================\n72: Quantum ESPRESSO + MDI 連成エンジン (Step 0..600 完全キャッシュ復元 & Step 601..900 波動関数・電荷密度引き継ぎ版)\n73: ==============================================================================\n74: ・Step 0 ～ 600 は prev_600steps_espresso_all_steps.pwo から ASE パーサーで完全復元して即座に返却\n75: ・Step 601 以降は ./tmp/pwscf.save 内の Step 600 収束済み波動関数 (wfc1.hdf5) と\n76:   電荷密度 (charge-density.hdf5) を startingpot='file', startingwfc='file' で引き継いで実機 QE GPU SCF を実行\n77: \"\"\"\n78: import sys\n79: import os\n80: import re\n81: import io\n82: import glob\n83: import shutil\n84: import time\n85: import numpy as np\n86: import mdi\n87: from ase import Atoms\n88: from ase.calculators.espresso import Espresso, EspressoProfile\n89: from ase.io.espresso import read_espresso_out\n90: import ase.parallel\n91: \n92: # Rule 3: ASE + MDI の DummyMPI 必須化 (SIGABRT 防止)\n93: ase.parallel.world = ase.parallel.DummyMPI()\n94: \n95: ELEMENTS = [\n96:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n97:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n98:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n99:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n100:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n101:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n102:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n103:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n104:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n105:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n106:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n107:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n108: ]\n109: atomic_number_to_symbol = {i + 1: symbol for i, symbol in enumerate(ELEMENTS)}\n110: type_to_symbol = {1: 'C', 2: 'Si'}\n111: \n112: exitflag = False\n113: qm_natoms = 0\n114: qm_elements = None\n115: qm_coords = None\n116: box = np.zeros(9, dtype=np.float64)\n117: flag_box = False\n118: \n119: qm_pe = 0.0\n120: qm_forces = None\n121: last_evaluated_coords = None\n122: step_counter = 0\n123: cached_steps = {}\n124: \n125: \n126: def log(msg):\n127:     print(f\"[QE-MDI Engine] {msg}\", flush=True)\n128: \n129: \n130: def error(txt):\n131:     log(f\"ERROR: {txt}\")\n132:     sys.exit(1)\n133: \n134: \n135: def load_cached_600_steps():\n136:     global cached_steps\n137:     cache_file = \"prev_600steps_espresso_all_steps.pwo\"\n138:     if not os.path.exists(cache_file):\n139:         log(\"No previous cache file found; running all steps from scratch.\")\n140:         return\n141:     t0 = time.time()\n142:     with open(cache_file, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n143:         text = f.read()\n144:     chunks = re.split(r\"\\n?=== STEP (\\d+) ===\\n\", text)\n145:     for i in range(1, len(chunks), 2):\n146:         st = int(chunks[i])\n147:         content = chunks[i + 1]\n148:         atoms_list = list(read_espresso_out(io.StringIO(content), index=slice(None)))\n149:         atoms_obj = atoms_list[-1]\n150:         pe_ev = float(atoms_obj.get_potential_energy())\n151:         forces_ev_ang = np.array(atoms_obj.get_forces(), dtype=np.float64)\n152:         m_it = re.search(r\"convergence has been achieved in\\s+(\\d+)\\s+iterations\", content)\n153:         n_it = int(m_it.group(1)) if m_it else 16\n154:         cached_steps[st] = (pe_ev, forces_ev_ang, n_it, content)\n155:     log(f\"Loaded {len(cached_steps)} cached steps (Step 0..{max(cached_steps.keys())}) in {time.time()-t0:.2f}s.\")\n156: \n157: \n158: def configure_environment():\n159:     os.environ.setdefault(\"CUDA_VISIBLE_DEVICES\", \"0\")\n160:     os.environ.setdefault(\"OMPI_MCA_btl_vader_single_copy_mechanism\", \"none\")\n161:     os.environ.setdefault(\"CUDA_CACHE_MAXSIZE\", \"2147483648\")\n162:     os.environ.setdefault(\"CUDA_CACHE_DISABLE\", \"0\")\n163:     os.environ.setdefault(\"NVCOMPILER_ACC_SYNCHRONOUS\", \"0\")\n164: \n165:     nvhpc_roots = sorted(glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\"), reverse=True)\n166:     extra_libs = []\n167:     if nvhpc_roots:\n168:         root = nvhpc_roots[0]\n169:         extra_libs.extend([\n170:             f\"{root}/compilers/lib\",\n171:             f\"{root}/math_libs/lib64\",\n172:             f\"{root}/cuda/lib64\",\n173:             f\"{root}/comm_libs/mpi/lib\",\n174:         ])\n175:         extra_libs.extend(glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\"))\n176: \n177:     cuda_libs = [\n178:         \"/usr/local/cuda/lib64\",\n179:         \"/usr/lib/wsl/lib\",\n180:         \"/usr/lib/x86_64-linux-gnu\",\n181:     ]\n182:     existing_libs = [p for p in (extra_libs + cuda_libs) if os.path.exists(p)]\n183:     current_ld = os.environ.get(\"LD_LIBRARY_PATH\", \"\")\n184:     os.environ[\"LD_LIBRARY_PATH\"] = \":\".join(existing_libs + ([current_ld] if current_ld else []))\n185: \n186: \n187: def detect_pw_command():\n188:     env_pw = os.environ.get(\"QE_PW_COMMAND\")\n189:     if env_pw:\n190:         return env_pw\n191: \n192:     pw_bin = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/pw.x\"\n193:     mpirun_bin = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/mpirun\"\n194:     mpi_np = int(os.environ.get(\"QE_MPI_NP\", \"12\"))\n195:     omp_threads = os.environ.get(\"QE_OMP_THREADS\", \"2\")\n196:     os.environ[\"OMP_NUM_THREADS\"] = omp_threads\n197:     return f\"{mpirun_bin} --oversubscribe -np {mpi_np} {pw_bin} -ndiag 1\"\n198: \n199: \n200: def load_dft_config():\n201:     default_config = {\n202:         'ecutwfc': 40.0,\n203:         'ecutrho': 320.0,\n204:         'conv_thr': 1.0e-5,\n205:         'kpts': None,\n206:         'occupations': 'smearing',\n207:         'smearing': 'gaussian',\n208:         'degauss': 0.01,\n209:         'mixing_beta': 0.3,\n210:         'mixing_mode': 'local-TF',\n211:         'electron_maxstep': 200,\n212:         'pseudopotentials': {'Si': 'Si.upf', 'C': 'C.upf'},\n213:     }\n214:     try:\n215:         if os.path.exists(\"dft_settings.py\"):\n216:             import importlib.util\n217:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n218:             mod = importlib.util.module_from_spec(spec)\n219:             spec.loader.exec_module(mod)\n220:             if hasattr(mod, 'DFT_CONFIG'):\n221:                 default_config.update(mod.DFT_CONFIG)\n222:     except Exception as e:\n223:         log(f\"Notice: Using default DFT parameters ({e})\")\n224:     return default_config\n225: \n226: \n227: def has_saved_wfc_and_pot():\n228:     save_dir = os.path.join(\"./tmp\", \"pwscf.save\")\n229:     if not os.path.isdir(save_dir):\n230:         return False\n231:     has_chg = (\n232:         os.path.exists(os.path.join(save_dir, \"charge-density.hdf5\"))\n233:         or os.path.exists(os.path.join(save_dir, \"charge-density.dat\"))\n234:     )\n235:     has_wfc = (\n236:         os.path.exists(os.path.join(save_dir, \"wfc1.hdf5\"))\n237:         or os.path.exists(os.path.join(save_dir, \"wfc1.dat\"))\n238:     )\n239:     return has_chg and has_wfc\n240: \n241: \n242: def allocate_qm():\n243:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n244:     n = qm_natoms\n245:     qm_elements = np.empty(n, dtype=np.int32)\n246:     qm_coords = np.empty((n, 3), dtype=np.float64)\n247:     qm_forces = np.empty((n, 3), dtype=np.float64)\n248:     last_evaluated_coords = None\n249: \n250: \n251: def receive_qm_natoms(mdicomm):\n252:     global qm_natoms\n253:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n254:     log(f\"Received >NATOMS: {qm_natoms}\")\n255:     allocate_qm()\n256: \n257: \n258: def receive_box(mdicomm):\n259:     global flag_box\n260:     flag_box = True\n261:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n262:     if ierr:\n263:         error(\"MDI: >CELL reception failed\")\n264: \n265: \n266: def receive_qm_coords(mdicomm):\n267:     if not qm_natoms:\n268:         error(\"Cannot receive >COORDS if # atoms = 0\")\n269:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n270:     if ierr:\n271:         error(\"MDI: >COORDS reception failed\")\n272: \n273: \n274: def receive_qm_elements(mdicomm):\n275:     if not qm_natoms:\n276:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n277:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n278:     if