27:         receive_qm_elements(mdicomm)\n428:     elif command == \">TYPES\":\n429:         receive_qm_types(mdicomm)\n430:     elif command == \">COORDS\":\n431:         receive_qm_coords(mdicomm)\n432:     elif command in [\"<ENERGY\", \"<PE\"]:\n433:         evaluate()\n434:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n435:         if ierr:\n436:             error(\"MDI: <ENERGY send failed\")\n437:     elif command == \"<FORCES\":\n438:         evaluate()\n439:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n440:         if ierr:\n441:             error(\"MDI: <FORCES send failed\")\n442:     else:\n443:         error(f\"Unrecognized MDI command: {command}\")\n444:     return 0\n445: \n446: \n447: def main():\n448:     configure_environment()\n449:     load_cached_600_steps()\n450:     mdi_options = None\n451:     for i, arg in enumerate(sys.argv):\n452:         if arg in [\"-mdi\", \"--mdi\"] and i + 1 < len(sys.argv):\n453:             mdi_options = sys.argv[i + 1]\n454:             break\n455:     if not mdi_options:\n456:         error(\"MDI options not provided.\")\n457: \n458:     log(f\"Initializing MDI Engine with options: {mdi_options}\")\n459:     mdi.MDI_Init(mdi_options)\n460:     mdi.MDI_Register_Node(\"@DEFAULT\")\n461:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n462:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n463:     mdi.MDI_Set_Execute_Command_Func(execute_command, None)\n464: \n465:     log(\"Waiting for MDI driver connection...\")\n466:     mdicomm = mdi.MDI_Accept_Communicator()\n467:     log(\"Connected to MDI driver! Entering communication loop...\")\n468: \n469:     while not exitflag:\n470:         command = mdi.MDI_Recv_Command(mdicomm)\n471:         execute_command(command, mdicomm, None)\n472: \n473:     log(\"MDI Engine execution terminated cleanly.\")\n474: \n475: \n476: if __name__ == \"__main__\":\n477:     main()\n478: '''\n479: \n480: \n481: def prepare_bulk900_aimd():\n482:     log(\"==============================================================================\")\n483:     log(\"Preparing Continuation of 300 K NVT AIMD (Step 601..900, total 900 steps = 900 fs)\")\n484:     log(\"Inheriting 100% of Step 600 state (coords, velocities, Nosé-Hoover bath, wfc, charge density, energy/forces)\")\n485:     log(\"==============================================================================\")\n486: \n487:     os.makedirs(BULK900_AIMD_DIR, exist_ok=True)\n488: \n489:     # Copy common assets from PREV_BULK600_DIR\n490:     for asset in [\n491:         \"C.upf\",\n492:         \"Si.upf\",\n493:         \"RELAXATION_GRAPH_PROTOCOL.json\",\n494:         \"dft_settings.py\",\n495:         \"make_xyz.py\",\n496:         \"msmincho.ttc\",\n497:         \"times.ttf\",\n498:         \"auto_generate_progression_graphs.py\",\n499:         \"bulk_10-10_288atoms_true_bulk.data\",\n500:         \"bulk_10-10_288atoms_true_bulk.cif\",\n501:         \"bulk_10-10_288atoms_true_bulk.xyz\",\n502:         \"bulk_10-10_288atoms_aimd_300steps_final.data\",\n503:         \"bulk_10-10_288atoms_aimd_600steps_final.data\",\n504:     ]:\n505:         src = os.path.join(PREV_BULK600_DIR, asset)\n506:         if os.path.exists(src):\n507:             dst = os.path.join(BULK900_AIMD_DIR, asset)\n508:             shutil.copyfile(src, dst)\n509:             if asset.endswith(\".py\"):\n510:                 os.chmod(dst, 0o755)\n511: \n512:     # Copy Step 0..600 full QE outputs for exact cache replay\n513:     src_pwo_all = os.path.join(PREV_BULK600_DIR, \"espresso_all_steps.pwo\")\n514:     dst_pwo_cache = os.path.join(BULK900_AIMD_DIR, \"prev_600steps_espresso_all_steps.pwo\")\n515:     shutil.copyfile(src_pwo_all, dst_pwo_cache)\n516: \n517:     # Copy Step 600 converged wavefunction (wfc1.hdf5) and charge density (charge-density.hdf5) in ./tmp\n518:     src_tmp = os.path.join(PREV_BULK600_DIR, \"tmp\")\n519:     dst_tmp = os.path.join(BULK900_AIMD_DIR, \"tmp\")\n520:     if os.path.exists(dst_tmp):\n521:         shutil.rmtree(dst_tmp)\n522:     shutil.copytree(src_tmp, dst_tmp)\n523:     log(\"Copied Step 600 converged wavefunction (wfc1.hdf5) and electron density (charge-density.hdf5) to ./tmp/pwscf.save/\")\n524: \n525:     # Write continuation QE-MDI engine\n526:     engine_path = os.path.join(BULK900_AIMD_DIR, \"qe_mdi_engine_rtx5080.py\")\n527:     with open(engine_path, \"w\", encoding=\"utf-8\") as f:\n528:         f.write(QE_ENGINE_CONTINUE_900_CODE)\n529:     os.chmod(engine_path, 0o755)\n530: \n531:     # Write in.lammps (runs 600 steps via cache replay in ~40s to restore exact bath state, then continues 300 more steps to 900)\n532:     in_lammps_content = \"\"\"# ==============================================================================\n533: # 2H-SiC {10-10} 8周期相当 (16層, 288原子) 真のバルクモデル (真空層 0 Å)\n534: # 300K NVT 第一原理分子動力学: Step 600 からの完全引き継ぎ追加 300 steps (通算 900 steps = 900 fs)\n535: # ==============================================================================\n536: units           metal\n537: dimension       3\n538: boundary        p p p\n539: atom_style      atomic\n540: atom_modify     map yes\n541: \n542: # 1. 初期構造の読み込み\n543: read_data       bulk_10-10_288atoms_true_bulk.data\n544: \n545: # 原子質量設定 (Rule 2: Type 1: C = 12.011, Type 2: Si = 28.085)\n546: mass            1 12.011\n547: mass            2 28.085\n548: \n549: pair_style      none\n550: \n551: # 2. MDI 通信設定 (Quantum ESPRESSO を第一原理 QM エンジンとして連成)\n552: fix             1 all mdi/qm elements C Si\n553: \n554: # 3. 初期熱運動速度の付与 (Maxwell-Boltzmann 分布 @ 300K, 同一乱数シード 87654)\n555: velocity        all create 300.0 87654 mom yes rot yes dist gaussian\n556: \n557: # 4. 運動方程式の数値積分 & サーモスタット設定 (NVT アンサンブル @ 300K)\n558: timestep        0.001\n559: fix             2 all nvt temp 300.0 300.0 0.1\n560: \n561: # 5. 重心ドリフト防止 (50ステップごとに全並進運動量をゼロにリセット)\n562: fix             3 all mome