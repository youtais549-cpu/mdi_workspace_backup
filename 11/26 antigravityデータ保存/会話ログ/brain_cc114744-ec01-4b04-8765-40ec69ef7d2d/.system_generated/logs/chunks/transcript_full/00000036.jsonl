rom, axis=1))\n334:         log(\n335:             f\"--- [Step {step_counter}] Done in 0.00s ({n_scf_iters} SCF iters) [RESTORED CACHE] | \"\n336:             f\"E_pot: {pe_ev:.4f} eV | Fmax: {fmax:.5f} eV/A | gap: {current_gap:.4f} A ---\"\n337:         )\n338:         last_evaluated_coords = np.copy(qm_coords)\n339:         step_counter += 1\n340:         return\n341: \n342:     # Step 601..900: Live Quantum ESPRESSO GPU SCF calculation inheriting wfc1.hdf5 & charge-density.hdf5\n343:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n344:     command_str = detect_pw_command()\n345:     cfg = load_dft_config()\n346: \n347:     reuse_prev_wfc = has_saved_wfc_and_pot()\n348: \n349:     electrons_dict = {\n350:         'conv_thr': cfg['conv_thr'],\n351:         'mixing_beta': cfg['mixing_beta'],\n352:         'mixing_mode': cfg['mixing_mode'],\n353:         'electron_maxstep': cfg['electron_maxstep'],\n354:     }\n355:     if reuse_prev_wfc:\n356:         electrons_dict['startingpot'] = 'file'\n357:         electrons_dict['startingwfc'] = 'file'\n358: \n359:     input_data = {\n360:         'control': {\n361:             'calculation': 'scf',\n362:             'pseudo_dir': './',\n363:             'outdir': './tmp',\n364:             'tprnfor': True,\n365:             'tstress': True,\n366:             'disk_io': 'medium',\n367:         },\n368:         'system': {\n369:             'ecutwfc': cfg['ecutwfc'],\n370:             'ecutrho': cfg['ecutrho'],\n371:             'occupations': cfg['occupations'],\n372:             'smearing': cfg['smearing'],\n373:             'degauss': cfg['degauss'],\n374:         },\n375:         'electrons': electrons_dict,\n376:     }\n377: \n378:     log(\n379:         f\"--- [Step {step_counter}] Starting SCF ({len(atoms)} atoms, \"\n380:         f\"startingpot/wfc={'file' if reuse_prev_wfc else 'atomic'}, \"\n381:         f\"z_min={z_min:.4f}A, z_max={z_max:.4f}A, gap={