&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   tstress          = .false.
   tprnfor          = .true.
   outdir           = './tmp_bulk'
   prefix           = 'sic_bulk'
   pseudo_dir       = './'
   disk_io          = 'minimal'
/
&SYSTEM
   ibrav            = 0
   ecutwfc          = 40.0
   ecutrho          = 320.0
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gaussian'
   ntyp             = 2
   nat              = 36
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-05
   mixing_mode      = 'local-TF'
   mixing_beta      = 0.3
/
