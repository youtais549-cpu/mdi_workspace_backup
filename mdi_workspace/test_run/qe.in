&CONTROL
calculation = 'scf',
pseudo_dir = './',
outdir = './tmp',
/
&SYSTEM
ibrav = 1, celldm(1) = 18.89726,
nat = 2, ntyp = 2,
ecutwfc = 40.0,
/
&ELECTRONS
conv_thr = 1.0e-5,
/
ATOMIC_SPECIES
Si 28.085 Si.upf
C  12.011 C.upf
ATOMIC_POSITIONS (angstrom)
Si 4.0 5.0 5.0
C  6.0 5.0 5.0
K_POINTS (gamma)