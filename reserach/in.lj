# --- LAMMPSテスト用スクリプト (Lennard-Jones fluid) ---
units           lj
atom_style      atomic

# 原子を配置する箱のサイズと原子の定義
lattice         fcc 0.8442
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box
mass            1 1.0

# 原子間の相互作用（ポテンシャル）の定義
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

# シミュレーションの条件設定
velocity        all create 1.0 87287
fix             1 all nve
thermo          100        # 100ステップごとに結果を表示

# 計算実行
run             1000