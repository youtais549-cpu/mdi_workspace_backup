\n200:     # 背景色設定\n201:     fig.patch.set_facecolor(\"white\")\n202:     ax.set_facecolor(\"white\")\n203: \n204:     # 8. ファイル出力 (SVG, PNG 600dpi, PDF)\n205:     # ※ bbox_inches=\"tight\" を使わずに出力することで、Word で 100% 貼付時に指定寸法 (8.0 cm × 6.2 cm) を保持\n206:     base_name = f\"surface_energy_vs_vacuum_word_{suffix}\"\n207:     out_png = f\"/home/yamazaki/mdi_workspace_backup/{base_name}.png\"\n208:     out_svg = f\"/home/yamazaki/mdi_workspace_backup/{base_name}.svg\"\n209:     out_pdf = f\"/home/yamazaki/mdi_workspace_backup/{base_name}.pdf\"\n210: \n211:     plt.savefig(out_png, dpi=600)\n212:     plt.savefig(out_svg)\n213:     plt.savefig(out_pdf)\n214: \n215:     # 16A の場合は標準ファイル名 (surface_energy_vs_vacuum_final.*) にも保存\n216:     if suffix == \"16A\":\n217:         final_png = \"/home/yamazaki/mdi_workspace_backup/surface_energy_vs_vacuum_final.png\"\n218:         final_svg = \"/home/yamazaki/mdi_workspace_backup/surface_energy_vs_vacuum_final.svg\"\n219:         final_pdf = \"/home/yamazaki/mdi_workspace_backup/surface_energy_vs_vacuum_final.pdf\"\n220:         plt.savefig(final_png, dpi=600)\n221:         plt.savefig(final_svg)\n222:         plt.savefig(final_pdf)\n223: \n224:     plt.close()\n225: \n226:     print(f\"✅ [{suffix}] 生成完了:\")\n227:     print(f\"   PNG (600 dpi) : {out_png}\")\n228:     print(f\"   SVG (アウトライン): {out_svg}\")\n229:     print(f\"   PDF (ベクター) : {out_pdf}\")\n230: "}
