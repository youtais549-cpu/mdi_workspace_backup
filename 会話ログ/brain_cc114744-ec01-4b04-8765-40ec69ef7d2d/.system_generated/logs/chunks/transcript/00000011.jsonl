:\\temp_sic_sync\\sweep_2periods_all'\n47: $dstParent = '\\\\192.168.12.69\\Results\\yamazaki\\research'\n48: \n49: Get-ChildItem -LiteralPath $srcRoot -Directory | ForEach-Object {\n50:     $folderName = $_.Name\n51:     $srcDir = $_.FullName\n52:     $dstDir = Join-Path $dstParent $folderName\n53:     if (!(Test-Path -LiteralPath $dstDir)) {\n54:         New-Item -ItemType Directory -Path $dstDir -Force | Out-Null\n55:     }\n56:     Get-ChildItem -LiteralPath $srcDir | ForEach-Object {\n57:         Copy-Item -LiteralPath $_.FullName -Destination $dstDir -Recurse -Force\n58:     }\n59:     $count = (Get-ChildItem -LiteralPath $dstDir -File).Count\n60:     Write-Output (\"SYNCED: \" + $dstDir + \" (\" + $count + \" files)\")\n61: }\n62: \"\"\"\n63:     encoded_cmd = base64.b64encode(ps_script.encode(\"utf-16-le\")).decode(\"ascii\")\n64:     res = subprocess.run(\n65:         [ps_bin, \"-NoProfile\", \"-NonInteractive\", \"-EncodedCommand\", encoded_cmd],\n66:         text=True,\n67:         capture_output=True,\n68:         encoding=\"utf-8\",\n69:         errors=\"replace\",\n70:     )\n71:     print(res.stdout)\n72:     if res.returncode == 0 and \"SYNCED:\" in res.stdout:\n73:         print(f\"✅ All {len(folders)} folders synced to NAS successfully!\")\n74:         return True\n75:     else:\n76:         print(f\"❌ NAS sync failed (code={res.returncode}): {res.stderr}\")\n77:         return False\n78: \n79: \n80: if __name__ == \"__main__\":\n81:     if sync_all_to_nas():\n82:         sys.exit(0)\n83:     sys.exit(1)\n84: "}
