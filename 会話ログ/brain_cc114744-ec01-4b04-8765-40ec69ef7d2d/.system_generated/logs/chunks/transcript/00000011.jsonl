{"step_index":757,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:04:56Z","content":"Created At: 2026-11-08T23:04:56+09:00\nCompleted At: 2026-11-08T23:04:56+09:00\nShowing lines 1-179 of 179\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: create_8periods_bulk_and_slab_models.py\n4: 2H-SiC {10-10} 8周期 (16層, 288原子) 真のバルク基準モデル & 自然へき開スラブモデル (真空 5.0 Å) 生成スクリプト\n5: 【準拠ルール】\n6: - AGENTS.md §1: スラブ緩和前の「同一原子数 (288原子) 真のバルクモデル (真空 0 Å) 1点SCF先行確定」\n7: - AGENTS.md §2: Type 1 = C (12.011), Type 2 = Si (28.085)\n8: - AGENTS.md §10: ASE surface(bulk, indices=(1, 0, 0), layers=8) による統一生成 (粗結合 1.776 Å 切断)\n9: \"\"\"\n10: import os\n11: import json\n12: import numpy as np\n13: import ase.io\n14: from ase.build import surface\n15: from ase.io.lammpsdata import write_lammps_data\n16: \n17: \n18: def build_8periods_models():\n19:     out_dir = os.path.dirname(os.path.abspath(__file__))\n20:     workspace_dir = os.path.dirname(out_dir)\n21:     cif_input = os.path.join(workspace_dir, \"research_simulations\", \"2H-SiC.cif\")\n22: \n23:     print(f\"Loading 2H-SiC unit cell from {cif_input}...\")\n24:     bulk_cif = ase.io.read(cif_input)\n25: \n26:     # 1. {10-10} 面 8周期モデルの構築 (layers=8 -> 1周期2層なので合計16層)\n27:     slab_unit = surface(bulk_cif, indices=(1, 0, 0), layers=8, vacuum=None)\n28: \n29:     # 2. 面内 3x3 スーパーセル拡張 (合計 288 原子: Si 144, C 144)\n30:     slab_3x3 = slab_unit * (3, 3, 1)\n31: \n32:     # 3. スラブモデル座標調整 (上下に各 5.0 Å、合計 10.0 Å の真空層)\n33:     pos = slab_3x3.positions.copy()\n34:     z_min = float(np.min(pos[:, 2]))\n35:     z_max = float(np.max(pos[:, 2]))\n36:     thickness = z_max - z_min\n37: \n38:     pos[:, 2] = pos[:, 2] - z_min + 5.0\n39:     slab_3x3.positions = pos\n40: \n41:     cell_slab = slab_3x3.cell.copy()\n42:     cell_slab[2, 2] = thickness + 10.0\n43:     slab_3x3.cell = cell_slab\n44:     slab_3x3.pbc = [True, True, True]\n45:     slab_3x3.wrap()\n46: \n47:     # 層間距\n<truncated 4382 bytes>\n000000000000 {bulk_atoms.cell[1,1]:.14f} 0.00000000000000\",\n137:         f\"0.00000000000000 0.00000000000000 {bulk_atoms.cell[2,2]:.14f}\",\n138:         \"\",\n139:         \"ATOMIC_POSITIONS angstrom\",\n140:     ]\n141:     for sym, p in zip(bulk_atoms.get_chemical_symbols(), bulk_atoms.positions):\n142:         pwi_lines.append(f\"{sym} {p[0]:.10f} {p[1]:.10f} {p[2]:.10f}\")\n143: \n144:     pwi_path = os.path.join(out_dir, \"espresso.pwi\")\n145:     with open(pwi_path, \"w\", encoding=\"utf-8\") as f:\n146:         f.write(\"\\n\".join(pwi_lines) + \"\\n\")\n147: \n148:     # 8. メタデータ JSON の保存\n149:     area_A = float(slab_3x3.cell[0, 0] * slab_3x3.cell[1, 1])\n150:     area_2A = 2.0 * area_A\n151:     conv_factor = 16.021766\n152: \n153:     meta = {\n154:         \"cleavage_plane\": \"10-10\",\n155:         \"cleavage_type\": \"natural_cleavage_sparse_bond\",\n156:         \"n_periods\": 8,\n157:         \"n_layers\": 16,\n158:         \"natoms\": len(bulk_atoms),\n159:         \"vacuum_thickness_angstrom\": 5.0,\n160:         \"supercell_xy\": [3, 3],\n161:         \"cell_slab\": [float(slab_3x3.cell[0, 0]), float(slab_3x3.cell[1, 1]), float(slab_3x3.cell[2, 2])],\n162:         \"cell_bulk\": [float(bulk_atoms.cell[0, 0]), float(bulk_atoms.cell[1, 1]), float(bulk_atoms.cell[2, 2])],\n163:         \"area_A_angstrom2\": area_A,\n164:         \"total_area_2A_angstrom2\": area_2A,\n165:         \"unit_conversion_eV_A2_to_J_m2\": conv_factor,\n166:         \"effective_denominator\": float(area_2A / conv_factor),\n167:         \"expected_bulk_energy_eV_approx\": round(-31935.3562 * 4, 4),\n168:         \"slab_data_file\": \"slab_10-10_288atoms_vac5A.data\",\n169:         \"bulk_data_file\": \"bulk_10-10_288atoms_true_bulk.data\",\n170:     }\n171:     meta_path = os.path.join(out_dir, \"fracture_metadata.json\")\n172:     with open(meta_path, \"w\", encoding=\"utf-8\") as f:\n173:         json.dump(meta, f, indent=4, ensure_ascii=False)\n174: \n175:     print(f\"✅ Generated all 8-period (288 atoms) files in {out_dir}\")\n176: \n177: \n178: if __name__ == \"__main__\":\n179:     build_8periods_models()","truncated_fields":["content"]}
