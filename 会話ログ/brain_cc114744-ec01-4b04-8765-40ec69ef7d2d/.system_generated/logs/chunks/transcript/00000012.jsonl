 indices=(1, 0, 0), layers=2*N, vacuum=None)\\n    slab_3x3 = slab_unit * (3, 3, 1)\\n    \\n    pos = slab_3x3.positions.copy()\\n    z_min = float(np.min(pos[:, 2]))\\n    z_max = float(np.max(pos[:, 2]))\\n    thickness = z_max - z_min\\n\\n    z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 4))\\n    diffs = [round(float(z_unique[i + 1] - z_unique[i]), 4) for i in range(len(z_unique) - 1)]\\n    \\n    exact_d_period = (np.sqrt(3.0) / 2.0) * 3.076\\n    bulk_lz = N * exact_d_period\\n    slab_lz = thickness + 10.0\\n    \\n    print(f'N={N:2d} (layers={2*N:2d}, natoms={len(slab_3x3):3d}): bulk_Lz={bulk_lz:8.4f} A, slab_Lz={slab_lz:8.4f} A | ends: {diffs[0]:.4f} ... {diffs[-1]:.4f}')\\n\\\"\"","WaitMsBeforeAsync":"5000","toolSummary":"\"Test multi-period slab geometry\""}}]}
