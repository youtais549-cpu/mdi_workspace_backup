 collected.append((N, natoms, e_slab, e_bulk, de, gamma))\n543: \n544:     if not collected:\n545:         return\n546: \n547:     collected.sort(key=lambda x: x[0])\n548: \n549:     # 1. CSV更新\n550:     csv_path = os.path.join(WORKSPACE_DIR, \"surface_energy_vs_periods_plot_data.csv\")","truncated_fields":["content"]}
