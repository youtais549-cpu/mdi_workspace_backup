rom, axis=1))\n334:         log(\n335:             f\"--- [Step {step_counter}] Done in 0.00s ({n_scf_iters} SCF iters) [RESTORED CACHE] | \"\n336:             f\"E_pot: {pe_ev:.4f} eV | Fmax: {fmax:.5f} eV/A | gap: {current_gap:.4f} \n<truncated 9283 bytes>\ny        all create 300.0 87654 mom yes rot yes dist gaussian\n556: \n557: # 4. 運動方程式の数値積分 & サーモスタット設定 (NVT アンサンブル @ 300K)\n558: timestep        0.001\n559: fix             2 all nvt temp 300.0 300.0 0.1\n560: \n561: # 5. 重心ドリフト防止 (50ステップごとに全並進運動量をゼロにリセット)\n562: fix             3 all momentum 50 linear 1 1 1\n563: \n564: # 6. 出力設定 & ログ記録\n565: thermo_style    custom step temp epair emol ke pe etotal press fmax fnorm\n566: thermo          1\n567: thermo_modify   flush yes\n568: \n569: dump            1 all custom 1 dump.lammpstrj id type x y z vx vy vz fx fy fz\n570: dump_modify     1 sort id flush yes\n571: \n572: # 7. Step 0..600 をキャッシュリプレイして位置・速度・熱浴内部変数を100%完全復元し、チェックポイントを出力\n573: run             600\n574: write_restart   restart.bulk_600steps_restored\n575: write_data      bulk_10-10_288atoms_aimd_600steps_restored_check.data\n576: \n577: # 8. Step 601..900 の追加 300 ステップを実機 QE GPU SCF (Step 600 の波動関数・電荷密度引き継ぎ) で連続実行\n578: restart         50 restart.bulk_step\n579: run             300\n580: \n581: write_restart   restart.bulk_900steps_final\n582: write_data      bulk_10-10_288atoms_aimd_900steps_final.data\n583: undump          1\n584: \"\"\"\n585:     with open(os.path.join(BULK900_AIMD_DIR, \"in.lammps\"), \"w\", encoding=\"utf-8\") as f:\n586:         f.write(in_lammps_content)\n587: \n588:     for fn in [\"dump.lammpstrj\", \"log.lammps\", \"lmp.log\", \"qe_engine.log\", \"espresso.pwo\", \"espresso_all_steps.pwo\"]:\n589:         p = os.path.join(BULK900_AIMD_DIR, fn)\n590:         if os.path.exists(p):\n591:             os.remove(p)\n592: \n593:     log(\"Prepared bulk 900-step AIMD continuation directory and input files.\")\n594:     sync_to_nas()\n595: \n596: \n597: def run_bulk900_aimd():\n598:     port = 8049\n599:     env = os.environ.copy()\n600:     env[\"PATH\"] = f\"{ENV_PREFIX}/bin:\" + env.get(\"PATH\", \"\")","truncated_fields":["content"]}
