n258: def receive_box(mdicomm):\n259:     global flag_box\n260:     flag_box = True\n261:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n262:     if ierr:\n263:         error(\"MDI: >CELL reception failed\")\n264: \n265: \n266: def receive_qm_coords(mdicomm):\n267:     if not qm_natoms:\n268:         error(\"Cannot receive >COORDS if # atoms = 0\")\n269:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n270:     if ierr:\n271:         error(\"MDI: >COORDS reception failed\")\n272: \n273: \n274: def receive_qm_elements(mdicomm):\n275:     if not qm_natoms:\n276:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n277:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n278:     if ierr:\n279:         error(\"MDI: >ELEMENTS reception failed\")\n280: \n281: \n282: def receive_qm_types(mdicomm):\n283:     if not qm_natoms:\n284:         error(\"Cannot receive >TYPES if # atoms = 0\")\n285:     types = np.empty(qm_natoms, dtype=np.int32)\n286:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n287:     if ierr:\n288:         error(\"MDI: >TYPES reception failed\")\n289:     for i, t in enumerate(types):\n290:         sym = type_to_symbol.get(int(t), 'C')\n291:         qm_elements[i] = ELEMENTS.index(sym) + 1\n292: \n293: \n294: def evaluate():\n295:     global qm_pe, qm_forces, last_evaluated_coords, step_counter\n296:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n297:         error(\"System atoms, elements, or coordinates not fully specified\")\n298: \n299:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n300:         return","truncated_fields":["content"]}
