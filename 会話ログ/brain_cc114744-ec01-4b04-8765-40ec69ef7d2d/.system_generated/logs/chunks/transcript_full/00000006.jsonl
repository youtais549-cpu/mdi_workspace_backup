{"step_index":248,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T10:28:23Z","content":"Created At: 2026-11-05T19:28:23+09:00\nCompleted At: 2026-11-05T19:28:23+09:00\nShowing lines 1-349 of 349\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: 表面破壊エネルギー (へき開エネルギー) 自動算出・統合データベース記録ツール\n4: 【ユーザー実行コマンド】\n5: 1. 完全自動モード (最新の計算結果から自動抽出・記録):\n6:    python3 calc_surface_energy.py --auto\n7:    または\n8:    python3 calc_surface_energy.py --auto <slab_dir> <bulk_dir>\n9: \n10: 2. 手動数値指定モード:\n11:    python3 calc_surface_energy.py <E_slab> <E_bulk> [slab_dir] [bulk_dir] [note]\n12: \n13: fracture_metadata.json, model_settings.py, dft_settings.py から解析条件を自動取得し、\n14: γ [J/m²] を算出して文献値 (Rauls et al. 1999) と比較した上で、\n15: SURFACE_ENERGY_RESULTS.md および surface_energy_results.csv に自動追記します。\n16: \"\"\"\n17: import os\n18: import sys\n19: import glob\n20: import json\n21: import datetime\n22: import importlib.util\n23: \n24: RY_TO_EV = 13.6056980659\n25: \n26: def load_settings():\n27:     \"\"\"解析条件 (DFT & Model) を自動ロード\"\"\"\n28:     curr_dir = os.path.dirname(os.path.abspath(__file__))\n29:     model_settings_path = os.path.join(curr_dir, \"model_settings.py\")\n30:     dft_settings_path = os.path.join(curr_dir, \"dft_settings.py\")\n31:     meta_path = os.path.join(curr_dir, \"fracture_metadata.json\")\n32: \n33:     settings = {\n34:         'plane': '10-10',\n35:         'n_periods': 2,\n36:         'n_layers': 4,\n37:         'natoms': 72,\n38:         'vacuum': 10.0,\n39:         'supercell_xy': [3, 3],\n40:         'ecutwfc': 40.0,\n41:         'ecutrho': 320.0,\n42:         'kpts': 'gamma',\n43:         'mode': 'CG_minimize (F <= 1.0e-3 eV/Å)',\n44:         'area_2a': 279.4977\n45:     }\n46: \n47:     if os.path.exists(meta_path):\n48:         try:\n49:             with open(meta_path, \"r\", encoding=\"utf-8\") as f:\n50:                 meta = json.load(f)\n51:             settings['area_2a'] = meta.get('total_area_2A_angstrom2', settings['area_2a'])\n52:             settings['plane'] = meta.get('cleavage_plane', settings['plane'])\n53:             settings['natoms'] = meta.get('natoms', settings['natoms'])\n54:             settings['n_periods'] = meta.get('n_periods', settings['n_periods'])\n55:             settings['n_layers'] = meta.get('n_layers', settings['n_layers'])\n56:             settings['vacuum'] = meta.get('vacuum_thickness_angstrom', settings['vacuum'])\n57:             settings['supercell_xy'] = meta.get('supercell_xy', settings['supercell_xy'])\n58:         except Exception:\n59:             pass\n60: \n61:     if os.path.exists(dft_settings_path):\n62:         try:\n63:             spec = importlib.util.spec_from_file_location(\"dft_settings\", dft_settings_path)\n64:             mod = importlib.util.module_from_spec(spec)\n65:             spec.loader.exec_module(mod)\n66:             cfg = getattr(mod, 'DFT_CONFIG', {})\n67:             settings['ecutwfc'] = cfg.get('ecutwfc', settings['ecutwfc'])\n68:             settings['ecutrho'] = cfg.get('ecutrho', settings['ecutrho'])\n69:             k = cfg.get('kpts', None)\n70:             settings['kpts'] = 'gamma' if k is None else str(k)\n71:         except Exception:\n72:             pass\n73: \n74:     return settings\n75: \n76: def extract_energy_from_dir(target_dir):\n77:     \"\"\"指定ディレクトリの出力ファイル (espresso.pwo または log.lammps) から全エネルギー [eV] を自動抽出\"\"\"\n78:     if not os.path.exists(target_dir):\n79:         raise FileNotFoundError(f\"ディレクトリが見つかりません: {target_dir}\")\n80: \n81:     # 1. log.lammps の検索 (LAMMPS minimize ログ: eV単位)\n82:     log_path = os.path.join(target_dir, \"log.lammps\")\n83:     if os.path.exists(log_path):\n84:         with open(log_path, 'r', encoding='utf-8', errors='ignore') as f:\n85:             lines = f.readlines()\n86:         in_thermo = False\n87:         toteng_col = -1\n88:         last_toteng = None\n89:         for line in lines:\n90:             parts = line.split()\n91:             if 'TotEng' in parts:\n92:                 toteng_col = parts.index('TotEng')\n93:                 in_thermo = True\n94:                 continue\n95:             if in_thermo:\n96:                 if len(parts) > toteng_col and parts[0].isdigit():\n97:                     try:\n98:                         last_toteng = float(parts[toteng_col])\n99:                     except ValueError:\n100:                         pass\n101:                 elif 'Loop time' in line or 'ERROR' in line or 'minimize' in line:\n102:                     in_thermo = False\n103:         if last_toteng is not None:\n104:             return last_toteng\n105: \n106:     # 2. espresso.pwo の検索 (Quantum ESPRESSO ログ: Ry単位 -> eV換算)\n107:     pwo_path = os.path.join(target_dir, \"espresso.pwo\")\n108:     if os.path.exists(pwo_path):\n109:         with open(pwo_path, 'r', encoding='utf-8', errors='ignore') as f:\n110:             lines = f.readlines()\n111:         for line in reversed(lines):\n112:             if '!    total energy' in line:\n113:                 parts = line.split('=')[1].split()\n114:                 ry = float(parts[0])\n115:                 ev = ry * RY_TO_EV\n116:                 return ev\n117: \n118:     raise ValueError(f\"{target_dir} 内に有効な espresso.pwo または log.lammps が見つかりませんでした。\")\n119: \n120: def find_latest_calculation_dirs():\n121:     \"\"\"ワークスペース内の最新のスラブディレクトリとバルクディレクトリを自動検出\"\"\"\n122:     base_dirs = [\n123:         \"/home/yamazaki/mdi_workspace_backup\",\n124:         os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\")),\n125:         \"/content/drive/MyDrive/MD_backup\"\n126:     ]\n127:     \n128:     slab_dirs = []\n129:     bulk_dirs = []\n130:     for b in base_dirs:\n131:         if os.path.exists(b):\n132:             for d in glob.glob(os.path.join(b, \"*slab*\")):\n133:                 if os.path.isdir(d): slab_dirs.append(d)\n134:             for d in glob.glob(os.path.join(b, \"*bulk*\")):\n135:                 if os.path.isdir(d): bulk_dirs.append(d)\n136: \n137:     if not slab_dirs:\n138:         raise FileNotFoundError(\"スラブ計算結果ディレクトリが見つかりませんでした。\")\n139:     if not bulk_dirs:\n140:         raise FileNotFoundError(\"バルク計算結果ディレクトリが見つかりませんでした。\")\n141: \n142:     # 更新時刻順にソートして最新を取得\n143:     slab_dirs.sort(key=os.path.getmtime, reverse=True)\n144:     bulk_dirs.sort(key=os.path.getmtime, reverse=True)\n145:     return slab_dirs[0], bulk_dirs[0]\n146: \n147: def append_to_database(record):\n148:     \"\"\"SURFACE_ENERGY_RESULTS.md および surface_energy_results.csv に結果を追記\"\"\"\n149:     root_dirs = [\n150:         \"/home/yamazaki/mdi_workspace_backup\",\n151:         os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\")),\n152:         \"/content/drive/MyDrive/MD_backup\"  # Colab環境\n153:     ]\n154:     \n155:     target_root = None\n156:     for r in root_dirs:\n157:         if os.path.exists(r) and os.path.isdir(r):\n158:             target_root = r\n159:             break\n160:             \n161:     if not target_root:\n162:         target_root = os.path.dirname(os.path.abspath(__file__))\n163: \n164:     md_path = os.path.join(target_root, \"SURFACE_ENERGY_RESULTS.md\")\n165:     csv_path = os.path.join(target_root, \"surface_energy_results.csv\")\n166: \n167:     # 1. CSV に追記\n168:     next_no = 1\n169:     if os.path.exists(csv_path):\n170:         with open(csv_path, \"r\", encoding=\"utf-8\") as f:\n171:             lines = [line.strip() for line in f if line.strip()]\n172:             if len(lines) > 1:\n173:                 try:\n174:                     last_line = lines[-1]\n175:                     next_no = int(last_line.split(\",\")[0]) + 1\n176:                 except ValueError:\n177:                     next_no = len(lines)\n178:     else:\n179:         header = \"No,Date,Plane,Periods,Layers,Natoms,Vacuum_Angstrom,Supercell_XY,Mode,Ecutwfc_Ry,Ecutrho_Ry,Kpoints,E_slab_eV,E_bulk_eV,Delta_E_eV,Area_2A_Angstrom2,Gamma_J_m2,Ref_Relaxed_J_m2,Ref_Unrelaxed_J_m2,Diff_Relaxed_Percent,Archive_Slab,Archive_Bulk\\n\"\n180:         with open(csv_path, \"w\", encoding=\"utf-8\") as f:\n181:             f.write(header)\n182: \n183:     already_exists = False\n184:     if os.path.exists(csv_path):\n185:         with open(csv_path, \"r\", encoding=\"utf-8\") as f:\n186:             content = f.read()\n187:             es_str = f\"{record['e_slab']:.4f}\"\n188:             eb_str = f\"{record['e_bulk']:.4f}\"\n189:             if es_str in content and eb_str in content:\n190:                 already_exists = True\n191: \n192:     if already_exists:\n193:         print(f\"ℹ️ 本計算データ (E_slab={record['e_slab']:.4f}, E_bulk={record['e_bulk']:.4f}) は既にデータベースに登録されています。\")\n194:         return\n195: \n196:     record['no'] = next_no\n197:     date_str = datetime.date.today().strftime(\"%Y-%m-%d\")\n198: \n199:     csv_row = (\n200:         f\"{next_no},{date_str},{record['plane']},{record['n_periods']},{record['n_layers']},\"\n201:         f\"{record['natoms']},{record['vacuum']},{record['supercell_xy'][0]}x{record['supercell_xy'][1]},\"\n202:         f\"\\\"{record['mode']}\\\",{record['ecutwfc']},{record['ecutrho']},{record['kpts']},\"\n203:         f\"{record['e_slab']:.4f},{record['e_bulk']:.4f},{record['delta_e']:.4f},{record['area_2a']:.4f},\"\n204:         f\"{record['gamma']:.4f},{record['ref_relaxed']},{record['ref_unrelaxed']},{record['diff_percent']:+.1f},\"\n205:         f\"\\\"{record['archive_slab']}\\\",\\\"{record['archive_bulk']}\\\"\\n\"\n206:     )\n207:     with open(csv_path, \"a\", encoding=\"utf-8\") as f:\n208:         f.write(csv_row)\n209: \n210:     # 2. Markdown 表に追記\n211:     if os.path.exists(md_path):\n212:         with open(md_path, \"r\", encoding=\"utf-8\") as f:\n213:             md_content = f.read()\n214: \n215:         md_row = (\n216:             f\"| **#{next_no:02d}** | {date_str} | {{{record['plane']}}} | {record['n_periods']}周期 ({record['n_layers']}層) | \"\n217:             f\"{record['natoms']} | {record['vacuum']} | {record['supercell_xy'][0]}x{record['supercell_xy'][1]} | \"\n218:             f\"{record['mode']} | {record['ecutwfc']} / {record['ecutrho']} | {record['kpts']} | \"\n219:             f\"{record['e_slab']:,.4f} | {record['e_bulk']:,.4f} | {record['delta_e']:.4f} | \"\n220:             f\"{record['area_2a']:.4f} | **{record['gamma']:.4f}** | \"\n221:             f\"緩和後 {record['ref_relaxed']} ({record['diff_percent']:+.1f}%) | `{record['archive_slab']}`<br>`{record['archive_bulk']}` |\\n\"\n222:         )\n223: \n224:         if \"| **#\" in md_content:\n225:             lines = md_content.splitlines()\n226:             last_table_idx = -1\n227:             for idx, line in enumerate(lines):\n228:                 if line.strip().startswith(\"| **#\"):\n229:                     last_table_idx = idx\n230:             if last_table_idx != -1:\n231:                 lines.insert(last_table_idx + 1, md_row.strip())\n232:                 new_md_content = \"\\n\".join(lines)\n233:                 with open(md_path, \"w\", encoding=\"utf-8\") as f:\n234:                     f.write(new_md_content)\n235:         else:\n236:             with open(md_path, \"a\", encoding=\"utf-8\") as f:\n237:                 f.write(\"\\n\" + md_row)\n238: \n239:     print(f\"✅ 総合データベースへの自動追記が完了しました:\")\n240:     print(f\"  - Markdown: {md_path}\")\n241:     print(f\"  - CSV     : {csv_path}\")\n242: \n243: def calculate_gamma(e_slab, e_bulk, slab_dir=\"\", bulk_dir=\"\", note=\"\"):\n244:     settings = load_settings()\n245:     area_2a = settings['area_2a']\n246:     plane = settings['plane']\n247:     natoms = settings['natoms']\n248: \n249:     conv = 16.021766  # 1 eV/Å² -> J/m²\n250:     delta_e = e_slab - e_bulk\n251:     gamma = (delta_e / area_2a) * conv\n252: \n253:     ref_relaxed = 2.27\n254:     ref_unrelaxed = 2.44\n255:     diff_percent = ((gamma - ref_relaxed) / ref_relaxed) * 100.0\n256: \n257:     print(\"\\n==================================================\")\n258:     print(\" 表面破壊エネルギー (γ) 算出結果レポート\")\n259:     print(\"==================================================\")\n260:     print(f\"対象モデル        : 2H-SiC {{{plane}}} 面 ({natoms} 原子)\")\n261:     print(f\"スラブ全エネルギー E_slab : {e_slab:.6f} eV\")\n262:     print(f\"バルク全エネルギー E_bulk : {e_bulk:.6f} eV\")\n263:     print(f\"過剰エネルギー     ΔE     : {delta_e:.6f} eV\")\n264:     print(f\"全破面表面積       2A     : {area_2a:.4f} Å²\")\n265:     print(\"--------------------------------------------------\")\n266:     print(f\"表面破壊エネルギー γ     : {gamma:.4f} J/m²\")\n267:     print(\"--------------------------------------------------\")\n268: \n269:     if plane == '10-10':\n270:         print(\"【文献値との比較 (Rauls et al., Solid State Commun. 1999)】\")\n271:         print(f\"  ・非緩和 (切断直後)   : {ref_unrelaxed} J/m²\")\n272:         print(f\"  ・表面構造緩和後     : {ref_relaxed} J/m² (差分: {diff_percent:+.1f}%)\")\n273:         diff = abs(gamma - ref_relaxed)\n274:         if diff < 0.2:\n275:             print(\"  ✅ 判定: 緩和後の文献値と極めて高い一致度を示しています！\")\n276:         elif diff < 0.5:\n277:             print(\"  良好: 文献値の許容範囲内に収まっています。\")\n278:         else:\n279:             print(\"  ⚠️ 注意: 文献値から乖離があります。スラブ層数や収束度を確認してください。\")\n280:     print(\"==================================================\\n\")\n281: \n282:     record = {\n283:         'e_slab': e_slab,\n284:         'e_bulk': e_bulk,\n285:         'delta_e': delta_e,\n286:         'area_2a': area_2a,\n287:         'gamma': gamma,\n288:         'plane': plane,\n289:         'natoms': natoms,\n290:         'n_periods': settings['n_periods'],\n291:         'n_layers': settings['n_layers'],\n292:         'vacuum': settings['vacuum'],\n293:         'supercell_xy': settings['supercell_xy'],\n294:         'ecutwfc': settings['ecutwfc'],\n295:         'ecutrho': settings['ecutrho'],\n296:         'kpts': settings['kpts'],\n297:         'mode': settings['mode'],\n298:         'ref_relaxed': ref_relaxed,\n299:         'ref_unrelaxed': ref_unrelaxed,\n300:         'diff_percent': diff_percent,\n301:         'archive_slab': os.path.basename(slab_dir) if slab_dir else \"results_2H-SiC_10-10_slab_relaxed_20261020\",\n302:         'archive_bulk': os.path.basename(bulk_dir) if bulk_dir else \"2H-SiC_10-10_bulk_scf_20261020\",\n303:         'note': note\n304:     }\n305: \n306:     append_to_database(record)\n307:     return gamma\n308: \n309: def auto_evaluate(slab_dir=None, bulk_dir=None):\n310:     \"\"\"ディレクトリからエネルギーを自動抽出して評価\"\"\"\n311:     if not slab_dir or not bulk_dir:\n312:         slab_dir, bulk_dir = find_latest_calculation_dirs()\n313: \n314:     print(f\"🔍 自動評価モードを実行中...\")\n315:     print(f\"  スラブディレクトリ: {slab_dir}\")\n316:     print(f\"  バルクディレクトリ: {bulk_dir}\")\n317: \n318:     e_slab = extract_energy_from_dir(slab_dir)\n319:     e_bulk = extract_energy_from_dir(bulk_dir)\n320:     return calculate_gamma(e_slab, e_bulk, slab_dir, bulk_dir, note=\"Auto evaluated\")\n321: \n322: if __name__ == \"__main__\":\n323:     if len(sys.argv) > 1 and sys.argv[1] == \"--auto\":\n324:         s_dir = sys.argv[2] if len(sys.argv) >= 3 else None\n325:         b_dir = sys.argv[3] if len(sys.argv) >= 4 else None\n326:         auto_evaluate(s_dir, b_dir)\n327:     elif len(sys.argv) >= 3:\n328:         try:\n329:             es = float(sys.argv[1])\n330:             eb = float(sys.argv[2])\n331:             s_dir = sys.argv[3] if len(sys.argv) >= 4 else \"\"\n332:             b_dir = sys.argv[4] if len(sys.argv) >= 5 else \"\"\n333:             n = sys.argv[5] if len(sys.argv) >= 6 else \"\"\n334:             calculate_gamma(es, eb, s_dir, b_dir, n)\n335:         except ValueError:\n336:             print(\"引数エラー: エネルギー数値を指定してください。\")\n337:     else:\n338:         # デフォルトで最新結果の自動検出・評価を実行\n339:         try:\n340:             auto_evaluate()\n341:         except Exception as e:\n342:             print(f\"自動検出エラー: {e}\")\n343:             print(\"手動で数値を入力してください:\")\n344:             try:\n345:                 es = float(input(\"スラブ全エネルギー E_slab [eV] を入力してください: \"))\n346:                 eb = float(input(\"バルク全エネルギー E_bulk [eV] を入力してください: \"))\n347:                 calculate_gamma(es, eb)\n348:             except (ValueError, KeyboardInterrupt):\n349:                 print(\"\\n入力をキャンセルしました。\")"}
