{"step_index":243,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T10:28:14Z","content":"Created At: 2026-11-05T19:28:14+09:00\nCompleted At: 2026-11-05T19:28:15+09:00\nShowing lines 1-41 of 41\n1: # 2H-SiC {10-10} 6周期 (216原子) スラブ構造緩和計算入力スクリプト 【最適化収束条件版】\n2: # ==============================================================================\n3: # 【設計思想と収束閾値の物理的根拠】\n4: # 1. DFT (Quantum ESPRESSO) の SCF 収束閾値 conv_thr = 1.0e-5 Ry において、\n5: #    Hellmann-Feynman 力の数値ノイズ限界 (フロア) は ~0.0002 Ry/au (≈ 0.0051 eV/Å)。\n6: # 2. 従来の ftol = 1.0e-3 eV/Å (0.0010 eV/Å) はノイズ限界の 5〜8 倍厳しく、\n7: #    原子数が増大した系（144原子、216原子以上）では統計的に永遠に満たされない。\n8: # 3. 本設定では、ftol = 1.0e-2 eV/Å (0.010 eV/Å ≈ 0.0004 Ry/au) に設定し、\n9: #    物理的な構造緩和完了時点で自然に自動正常終了するように最適化。\n10: # 4. さらに etol = 1.0e-6 を併用し、エネルギー底打ちによる安全停止を二重化。\n11: # ==============================================================================\n12: \n13: units metal\n14: boundary p p p\n15: atom_style atomic\n16: atom_modify map yes\n17: \n18: # 1. 構造ファイルの読み込み (216原子 6周期 自然へき開面スラブ)\n19: read_data slab_10-10_216atoms.data\n20: \n21: # 原子質量 (Type 1: C, Type 2: Si - ASEの英名昇順ソートと完全一致)\n22: mass 1 12.011\n23: mass 2 28.085\n24: \n25: # 2. MDI 通信設定 (Quantum ESPRESSO を QM エンジンとして連成)\n26: fix 1 all mdi/qm elements C Si\n27: \n28: # 3. 出力設定\n29: thermo 1\n30: dump 1 all custom 1 dump.lammpstrj id type x y z\n31: dump_modify 1 append yes\n32: \n33: # 4. 表面構造緩和 (minimize)\n34: # 構文: minimize etol ftol maxiter maxeval\n35: # - etol: 1.0e-6 (相対エネルギー差 <= 10^-6 で収束)\n36: # - ftol: 1.0e-2 eV/Å (最大作用力 <= 0.01 eV/Å で収束、DFTノイズ限界直上)\n37: # - maxiter: 100 (最大CG反復ステップ数)\n38: # - maxeval: 150 (最大力評価回数)\n39: minimize 1.0e-6 1.0e-2 100 150\n40: \n41: undump 1"}
{"step_index":244,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T10:28:15Z","content":"Created At: 2026-11-05T19:28:15+09:00\nCompleted At: 2026-11-05T19:28:15+09:00\nShowing lines 1-114 of 114\n1: #!/bin/bash\n2: # ==============================================================================\n3: # run_slab_rtx5080.sh\n4: # ローカル新環境 (Core Ultra 9 285K / RAM 64GB / RTX 5080 16GB) 上で\n5: # LAMMPS (DRIVER) + Quantum ESPRESSO (MDI ENGINE) 連成構造緩和を実行するスクリプト\n6: # ==============================================================================\n7: set -e\n8: \n9: SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n10: cd \"$SCRIPT_DIR\"\n11: \n12: # ローカル Python 仮想環境があれば有効化\n13: ENV_PREFIX=\"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n14: if [ -d \"$ENV_PREFIX/bin\" ]; then\n15:     export PATH=\"$SCRIPT_DIR/bin:$ENV_PREFIX/bin:$PATH\"\n16:     export LD_LIBRARY_PATH=\"$ENV_PREFIX/lib:${LD_LIBRARY_PATH:-}\"\n17: elif [ -f \"$HOME/.venvs/mdi_rtx5080/bin/activate\" ]; then\n18:     source \"$HOME/.venvs/mdi_rtx5080/bin/activate\"\n19: fi\n20: \n21: # 実行前の新規出力ファイル初期化 (既存フォルダのファイルは一切触らない)\n22: rm -rf tmp espresso.pwo espresso_all_steps.pwo dump.lammpstrj qe_engine.log lmp.log log.lammps\n23: \n24: # LAMMPS バイナリの自動検出\n25: LMP_BIN=\"\"\n26: for cand in \"$SCRIPT_DIR/bin/lmp\" \"$HOME/.local/bin/lmp\" \"/usr/local/bin/lmp\" \"$(which lmp 2>/dev/null || true)\" \"$(which lmp_mpi 2>/dev/null || true)\"; do\n27:     if [ -n \"$cand\" ] && [ -x \"$cand\" ]; then\n28:         LMP_BIN=\"$cand\"\n29:         break\n30:     fi\n31: done\n32: \n33: if [ -z \"$LMP_BIN\" ]; then\n34:     echo \"❌ エラー: LAMMPS (lmp) が見つかりません。先に 'bash setup_local_rtx5080_env.sh' を実行してください。\"\n35:     exit 1\n36: fi\n37: \n38: MDI_PORT=${MDI_PORT:-8021}\n39: \n40: echo \"============================================================\"\n41: echo \" Starting LAMMPS + QE MDI Slab Relaxation (RTX 5080 / Ultra 9 285K)\"\n42: echo \" Model: 2H-SiC {10-10} 2-Periods (72 atoms), Vacuum 5.0 Å\"\n43: echo \" Convergence Standard: minimize 1.0e-6 1.0e-2 100 150\"\n44: echo \" LAMMPS Binary: $LMP_BIN | TCP Port: $MDI_PORT\"\n45: echo \"============================================================\"\n46: \n47: # 1. LAMMPS を MDI DRIVER としてバックグラウンド起動\n48: echo \"1. Starting LAMMPS MDI driver...\"\n49: \"$LMP_BIN\" -mdi \"-role DRIVER -name LAMMPS -method TCP -port $MDI_PORT\" -in in.lammps > lmp.log 2>&1 &\n50: LMP_PID=$!\n51: \n52: sleep 1\n53: \n54: # 2. Python QE MDI Engine (RTX 5080 / Ultra 9 285K 対応版) を起動\n55: echo \"2. Starting Python QE MDI engine (RTX 5080)...\"\n56: python3 qe_mdi_engine_rtx5080.py -mdi \"-role ENGINE -name QE -method TCP -port $MDI_PORT -hostname localhost\" > qe_engine.log 2>&1\n57: \n58: # 3. LAMMPS 完了待機\n59: wait $LMP_PID\n60: \n61: echo \"============================================================\"\n62: echo \" Calculation Completed Successfully!\"\n63: echo \" 3. Converting trajectory to Winmostar XYZ format (sorted by Atom ID)...\"\n64: python3 make_xyz.py dump.lammpstrj md_animation.xyz\n65: \n66: # 4. 指示書 (RELAXATION_GRAPH_PROTOCOL.json) に基づく3種推移グラフの自動生成 (AGENTS.md §8)\n67: echo \" 4. Generating 3 progression graphs according to protocol...\"\n68: python3 auto_generate_progression_graphs.py\n69: \n70: # 5. 表面破壊エネルギー γ の自動算出と T4 GPU 結果との整合性検証\n71: echo \" 5. Evaluating Surface Fracture Energy γ...\"\n72: python3 - << 'PY_EOF'\n73: import json, re, os\n74: \n75: with open(\"fracture_metadata.json\", \"r\", encoding=\"utf-8\") as f:\n76:     meta = json.load(f)\n77: \n78: e_bulk = meta[\"true_bulk_scf_energy_eV\"]\n79: denom = meta[\"effective_denominator\"]\n80: ref_t4_gamma = meta[\"reference_t4_surface_fracture_energy_J_m2\"]\n81: ref_lit_gamma = meta[\"reference_rauls_dimer_J_m2\"]\n82: \n83: energies = []\n84: if os.path.exists(\"qe_engine.log\"):\n85:     with open(\"qe_engine.log\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n86:         for line in f:\n87:             m = re.search(r\"Total Energy:\\s+([-\\d\\.]+)\\s+eV\", line)\n88:             if m:\n89:                 energies.append(float(m.group(1)))\n90: \n91: if energies:\n92:     e_slab = energies[-1]\n93:     delta_e = e_slab - e_bulk\n94:     gamma = delta_e / denom\n95:     diff_t4 = abs(gamma - ref_t4_gamma)\n96:     meta[\"rtx5080_relaxed_slab_energy_eV\"] = round(e_slab, 4)\n97:     meta[\"rtx5080_delta_energy_eV\"] = round(delta_e, 4)\n98:     meta[\"rtx5080_surface_fracture_energy_J_m2\"] = round(gamma, 4)\n99:     with open(\"fracture_metadata.json\", \"w\", encoding=\"utf-8\") as f:\n100:         json.dump(meta, f, indent=4, ensure_ascii=False)\n101:     print(\"------------------------------------------------------------\")\n102:     print(f\"  [RTX 5080 計算結果検証サマリー]\")\n103:     print(f\"  - E_bulk (72 atoms) : {e_bulk:.4f} eV\")\n104:     print(f\"  - E_slab (relaxed)  : {e_slab:.4f} eV\")\n105:     print(f\"  - ΔE = E_slab-E_bulk: {delta_e:.4f} eV\")\n106:     print(f\"  - 表面破壊エネルギー γ: {gamma:.4f} J/m²\")\n107:     print(f\"  - 旧環境 (T4 GPU) 値 : {ref_t4_gamma:.4f} J/m² (差分: {diff_t4:.4f} J/m²)\")\n108:     print(f\"  - 文献値 (Rauls 1999): {ref_lit_gamma:.2f} J/m²\")\n109:     print(\"------------------------------------------------------------\")\n110: PY_EOF\n111: \n112: echo \" Done!\"\n113: echo \"============================================================\"\n114: "}
{"step_index":245,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T10:28:15Z","content":"Created At: 2026-11-05T19:28:15+09:00\nCompleted At: 2026-11-05T19:28:15+09:00\nShowing lines 1-427 of 427\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: ==============================================================================\n4: Quantum ESPRESSO + MDI 連成エンジン (RTX 5080 16GB + Core Ultra 9 285K 最適化版)\n5: ==============================================================================\n6: 【改良ポイント (Colab T4 版からの変更点)】\n7: 1. Colab 固有のハードコードパス (/content/bin/..., root 専用 MPI フラグ) を完全撤廃。\n8: 2. NVIDIA GeForce RTX 5080 (Blackwell アーキテクチャ, Compute Capability 12.0 / sm_120,\n9:    16GB GDDR7 VRAM, CUDA 13.2) 向けに環境変数・PTX JIT キャッシュ (2GB) を自動最適化。\n10: 3. Intel Core Ultra 9 285K (24コア / 64GB RAM) のマルチコア性能を活かすため、\n11:    - GPU版 pw.x (NVHPC OpenACC/CUDA) 検出時: GPU オフロード + Pコア OpenMP 並列 (-ndiag 1)\n12:    - CPU/MPI版 pw.x 検出時: OpenMPI 並列 (mpirun) + OpenMP ハイブリッド実行\n13:    を自動判別して最適コマンドを構成。\n14: 4. 各ステップごとに GPU VRAM 使用量・温度・電力 (nvidia-smi) と SCF 計算時間を記録。\n15: \"\"\"\n16: import sys\n17: import os\n18: import glob\n19: import shutil\n20: import subprocess\n21: import time\n22: import numpy as np\n23: import mdi\n24: from ase import Atoms\n25: from ase.calculators.espresso import Espresso, EspressoProfile\n26: import ase.parallel\n27: \n28: # Rule 3: ASE + MDI の DummyMPI 必須化 (SIGABRT 防止)\n29: ase.parallel.world = ase.parallel.DummyMPI()\n30: \n31: ELEMENTS = [\n32:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n33:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n34:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n35:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n36:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n37:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n38:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n39:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n40:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n41:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n42:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n43:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n44: ]\n45: atomic_number_to_symbol = {i + 1: symbol for i, symbol in enumerate(ELEMENTS)}\n46: # Rule 2: Type 1 = C (12.011), Type 2 = Si (28.085)\n47: type_to_symbol = {1: 'C', 2: 'Si'}\n48: \n49: exitflag = False\n50: qm_natoms = 0\n51: qm_elements = None\n52: qm_coords = None\n53: box = np.zeros(9, dtype=np.float64)\n54: flag_box = False\n55: \n56: qm_pe = 0.0\n57: qm_forces = None\n58: last_evaluated_coords = None\n59: step_counter = 0\n60: \n61: \n62: def log(msg):\n63:     print(f\"[QE-MDI RTX5080 Engine] {msg}\", flush=True)\n64: \n65: \n66: def error(txt):\n67:     log(f\"ERROR: {txt}\")\n68:     sys.exit(1)\n69: \n70: \n71: def configure_rtx5080_environment():\n72:     \"\"\"\n73:     RTX 5080 (Blackwell sm_120, 16GB VRAM) & Core Ultra 9 285K (24コア) 用環境変数の設定\n74:     \"\"\"\n75:     os.environ.setdefault(\"CUDA_VISIBLE_DEVICES\", \"0\")\n76:     os.environ.setdefault(\"OMPI_MCA_btl_vader_single_copy_mechanism\", \"none\")\n77:     # Blackwell (sm_120) での PTX JIT コンパイル高速化用キャッシュ (2 GB)\n78:     os.environ.setdefault(\"CUDA_CACHE_MAXSIZE\", \"2147483648\")\n79:     os.environ.setdefault(\"CUDA_CACHE_DISABLE\", \"0\")\n80:     os.environ.setdefault(\"NVCOMPILER_ACC_SYNCHRONOUS\", \"0\")\n81: \n82:     # NVHPC SDK ライブラリの自動検出と LD_LIBRARY_PATH への追加\n83:     nvhpc_roots = sorted(glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\"), reverse=True)\n84:     extra_libs = []\n85:     if nvhpc_roots:\n86:         root = nvhpc_roots[0]\n87:         extra_libs.extend([\n88:             f\"{root}/compilers/lib\",\n89:             f\"{root}/math_libs/lib64\",\n90:             f\"{root}/cuda/lib64\",\n91:             f\"{root}/comm_libs/mpi/lib\",\n92:         ])\n93:         extra_libs.extend(glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\"))\n94:         log(f\"Detected NVHPC SDK at: {root}\")\n95: \n96:     cuda_libs = [\n97:         \"/usr/local/cuda/lib64\",\n98:         \"/usr/lib/wsl/lib\",\n99:         \"/usr/lib/x86_64-linux-gnu\",\n100:     ]\n101:     existing_libs = [p for p in (extra_libs + cuda_libs) if os.path.exists(p)]\n102:     current_ld = os.environ.get(\"LD_LIBRARY_PATH\", \"\")\n103:     os.environ[\"LD_LIBRARY_PATH\"] = \":\".join(existing_libs + ([current_ld] if current_ld else []))\n104: \n105: \n106: def query_rtx5080_status():\n107:     \"\"\"nvidia-smi から RTX 5080 の現在の VRAM 使用量・温度・消費電力を取得\"\"\"\n108:     try:\n109:         out = subprocess.check_output(\n110:             [\n111:                 \"nvidia-smi\",\n112:                 \"--query-gpu=name,memory.used,memory.total,utilization.gpu,temperature.gpu,power.draw\",\n113:                 \"--format=csv,noheader,nounits\",\n114:             ],\n115:             text=True,\n116:             stderr=subprocess.DEVNULL,\n117:             timeout=3,\n118:         ).strip()\n119:         if out:\n120:             parts = [p.strip() for p in out.split(\",\")]\n121:             if len(parts) >= 6:\n122:                 return (\n123:                     f\"GPU: {parts[0]} | VRAM: {parts[1]}/{parts[2]} MiB | \"\n124:                     f\"Util: {parts[3]}% | Temp: {parts[4]}C | Power: {parts[5]}W\"\n125:                 )\n126:     except Exception:\n127:         pass\n128:     return \"GPU status unavailable\"\n129: \n130: \n131: def detect_pw_command():\n132:     \"\"\"\n133:     ローカル環境 (WSL2 Ubuntu) の pw.x バイナリを検出し、\n134:     GPU ビルド (NVHPC/CUDA) か CPU/MPI ビルドかを自動判定して最適な起動コマンドを返す。\n135:     \"\"\"\n136:     env_pw = os.environ.get(\"QE_PW_COMMAND\")\n137:     if env_pw:\n138:         log(f\"Using user-specified QE_PW_COMMAND: {env_pw}\")\n139:         return env_pw\n140: \n141:     script_dir = os.path.dirname(os.path.abspath(__file__))\n142:     workspace_dir = os.path.dirname(script_dir)\n143:     home_dir = os.path.expanduser(\"~\")\n144: \n145:     candidates = [\n146:         os.path.join(script_dir, \"bin\", \"pw.x\"),\n147:         \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/pw.x\",\n148:         os.path.join(workspace_dir, \"bin\", \"pw.x\"),\n149:         os.path.join(home_dir, \".local\", \"bin\", \"pw.x\"),\n150:         os.path.join(home_dir, \"q-e-gpu\", \"build\", \"bin\", \"pw.x\"),\n151:         os.path.join(home_dir, \"q-e\", \"build_gpu\", \"bin\", \"pw.x\"),\n152:         os.path.join(home_dir, \"q-e\", \"build\", \"bin\", \"pw.x\"),\n153:         \"/usr/local/bin/pw.x\",\n154:         shutil.which(\"pw.x\"),\n155:     ]\n156:     pw_bin = None\n157:     for cand in candidates:\n158:         if cand and os.path.exists(cand) and os.access(cand, os.X_OK):\n159:             pw_bin = cand\n160:             break\n161: \n162:     if not pw_bin:\n163:         error(\n164:             \"pw.x binary not found! Please run 'bash setup_local_rtx5080_env.sh' first \"\n165:             \"to install/build Quantum ESPRESSO and LAMMPS for this PC.\"\n166:         )\n167: \n168:     # ldd で NVHPC / CUDA (OpenACC) リンク有無を判定\n169:     is_gpu_binary = False\n170:     try:\n171:         ldd_out = subprocess.check_output([\"ldd\", pw_bin], text=True, stderr=subprocess.DEVNULL)\n172:         if any(k in ldd_out for k in [\"libcuda\", \"libcudart\", \"libacc\", \"libnvf\", \"libcufft\", \"libcublas\"]):\n173:             is_gpu_binary = True\n174:     except Exception:\n175:         pass\n176: \n177:     if is_gpu_binary:\n178:         # RTX 5080 (1 GPU) + Core Ultra 9 285K P-cores (8 threads)\n179:         os.environ.setdefault(\"OMP_NUM_THREADS\", os.environ.get(\"QE_OMP_THREADS\", \"8\"))\n180:         cmd = f\"{pw_bin} -ndiag 1\"\n181:         log(f\"Detected GPU-accelerated pw.x: {cmd} (OMP_NUM_THREADS={os.environ['OMP_NUM_THREADS']})\")\n182:         return cmd\n183:     else:\n184:         # MPI マルチコア実行 (Core Ultra 9 285K の Pコア8基または指定プロセス数)\n185:         mpi_np = int(os.environ.get(\"QE_MPI_NP\", \"8\"))\n186:         omp_threads = os.environ.get(\"QE_OMP_THREADS\", \"2\")\n187:         os.environ[\"OMP_NUM_THREADS\"] = omp_threads\n188:         mpirun_bin = shutil.which(\"mpirun\")\n189:         if mpirun_bin and mpi_np > 1:\n190:             cmd = f\"{mpirun_bin} -np {mpi_np} {pw_bin} -ndiag 1\"\n191:         else:\n192:             cmd = f\"{pw_bin} -ndiag 1\"\n193:         log(f\"Detected CPU/MPI pw.x: {cmd} (MPI_NP={mpi_np}, OMP_NUM_THREADS={omp_threads})\")\n194:         return cmd\n195: \n196: \n197: def load_dft_config():\n198:     \"\"\"外部の dft_settings.py から DFT 条件を動的に読み込み\"\"\"\n199:     default_config = {\n200:         'ecutwfc': 40.0,\n201:         'ecutrho': 320.0,\n202:         'conv_thr': 1.0e-5,\n203:         'kpts': None,\n204:         'occupations': 'smearing',\n205:         'smearing': 'gaussian',\n206:         'degauss': 0.01,\n207:         'mixing_beta': 0.3,\n208:         'mixing_mode': 'local-TF',\n209:         'electron_maxstep': 200,\n210:         'pseudopotentials': {'Si': 'Si.upf', 'C': 'C.upf'},\n211:     }\n212:     try:\n213:         if os.path.exists(\"dft_settings.py\"):\n214:             import importlib.util\n215:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n216:             mod = importlib.util.module_from_spec(spec)\n217:             spec.loader.exec_module(mod)\n218:             if hasattr(mod, 'DFT_CONFIG'):\n219:                 default_config.update(mod.DFT_CONFIG)\n220:                 log(\"Loaded DFT_CONFIG from dft_settings.py\")\n221:     except Exception as e:\n222:         log(f\"Notice: Using default DFT parameters ({e})\")\n223:     return default_config\n224: \n225: \n226: def allocate_qm():\n227:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n228:     n = qm_natoms\n229:     qm_elements = np.empty(n, dtype=np.int32)\n230:     qm_coords = np.empty((n, 3), dtype=np.float64)\n231:     qm_forces = np.empty((n, 3), dtype=np.float64)\n232:     last_evaluated_coords = None\n233: \n234: \n235: def receive_qm_natoms(mdicomm):\n236:     global qm_natoms\n237:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n238:     log(f\"Received >NATOMS: {qm_natoms}\")\n239:     allocate_qm()\n240: \n241: \n242: def receive_box(mdicomm):\n243:     global flag_box\n244:     flag_box = True\n245:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n246:     if ierr:\n247:         error(\"MDI: >CELL reception failed\")\n248: \n249: \n250: def receive_qm_coords(mdicomm):\n251:     if not qm_natoms:\n252:         error(\"Cannot receive >COORDS if # atoms = 0\")\n253:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n254:     if ierr:\n255:         error(\"MDI: >COORDS reception failed\")\n256: \n257: \n258: def receive_qm_elements(mdicomm):\n259:     if not qm_natoms:\n260:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n261:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n262:     if ierr:\n263:         error(\"MDI: >ELEMENTS reception failed\")\n264: \n265: \n266: def receive_qm_types(mdicomm):\n267:     if not qm_natoms:\n268:         error(\"Cannot receive >TYPES if # atoms = 0\")\n269:     types = np.empty(qm_natoms, dtype=np.int32)\n270:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n271:     if ierr:\n272:         error(\"MDI: >TYPES reception failed\")\n273:     for i, t in enumerate(types):\n274:         sym = type_to_symbol.get(int(t), 'C')\n275:         qm_elements[i] = ELEMENTS.index(sym) + 1\n276: \n277: \n278: def evaluate():\n279:     global qm_pe, qm_forces, last_evaluated_coords, step_counter\n280:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n281:         error(\"System atoms, elements, or coordinates not fully specified\")\n282: \n283:     # 座標キャッシュ: 同一ステップでの重複 SCF 計算を防止\n284:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n285:         return\n286: \n287:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n288:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n289:     force_conv = ev_to_hartree * bohr_to_angstrom\n290: \n291:     coords_angstrom = qm_coords * bohr_to_angstrom\n292:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n293: \n294:     if flag_box and np.linalg.norm(box) > 1e-6:\n295:         cell_matrix_bohr = box.reshape(3, 3)\n296:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n297:     else:\n298:         cell_matrix_angstrom = np.eye(3) * 10.0\n299: \n300:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n301:     command_str = detect_pw_command()\n302:     cfg = load_dft_config()\n303: \n304:     input_data = {\n305:         'control': {\n306:             'calculation': 'scf',\n307:             'pseudo_dir': './',\n308:             'outdir': './tmp',\n309:             'tprnfor': True,\n310:             'tstress': True,\n311:             'disk_io': 'minimal',\n312:         },\n313:         'system': {\n314:             'ecutwfc': cfg['ecutwfc'],\n315:             'ecutrho': cfg['ecutrho'],\n316:             'occupations': cfg['occupations'],\n317:             'smearing': cfg['smearing'],\n318:             'degauss': cfg['degauss'],\n319:         },\n320:         'electrons': {\n321:             'conv_thr': cfg['conv_thr'],\n322:             'mixing_beta': cfg['mixing_beta'],\n323:             'mixing_mode': cfg['mixing_mode'],\n324:             'electron_maxstep': cfg['electron_maxstep'],\n325:         },\n326:     }\n327: \n328:     log(f\"--- [Step {step_counter}] Running SCF with QE ({len(atoms)} atoms) | {query_rtx5080_status()} ---\")\n329: \n330:     t0 = time.time()\n331:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n332:     calc = Espresso(profile=profile, pseudopotentials=cfg['pseudopotentials'], input_data=input_data, kpts=cfg['kpts'])\n333:     atoms.calc = calc\n334: \n335:     pe_ev = atoms.get_potential_energy()\n336:     forces_ev_angstrom = atoms.get_forces()\n337:     elapsed = time.time() - t0\n338: \n339:     # 各ステップの espresso.pwo を履歴ファイルにも追記保存（全ステップの Total force / SCF correction 追跡用）\n340:     if os.path.exists(\"espresso.pwo\"):\n341:         with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f_in:\n342:             pwo_text = f_in.read()\n343:         with open(\"espresso_all_steps.pwo\", \"a\", encoding=\"utf-8\") as f_out:\n344:             f_out.write(f\"\\n=== STEP {step_counter} ===\\n\")\n345:             f_out.write(pwo_text)\n346: \n347:     fmax_ev_ang = float(np.max(np.linalg.norm(forces_ev_angstrom, axis=1)))\n348:     qm_pe = pe_ev * ev_to_hartree\n349:     qm_forces = forces_ev_angstrom * force_conv\n350: \n351:     # auto_generate_progression_graphs.py 互換フォーマットでログ出力\n352:     log(\n353:         f\"--- Step Done in {elapsed:.2f}s! Total Energy: {pe_ev:.4f} eV \"\n354:         f\"({qm_pe:.6f} Hartree) | Fmax: {fmax_ev_ang:.5f} eV/A | {query_rtx5080_status()} ---\"\n355:     )\n356:     last_evaluated_coords = np.copy(qm_coords)\n357:     step_counter += 1\n358: \n359: \n360: def execute_command(command, mdicomm, object_ptr):\n361:     global exitflag\n362:     if command == \"EXIT\":\n363:         log(\"Received EXIT command from driver.\")\n364:         exitflag = True\n365:     elif command == \">NATOMS\":\n366:         receive_qm_natoms(mdicomm)\n367:     elif command == \">CELL\":\n368:         receive_box(mdicomm)\n369:     elif command == \">ELEMENTS\":\n370:         receive_qm_elements(mdicomm)\n371:     elif command == \">TYPES\":\n372:         receive_qm_types(mdicomm)\n373:     elif command == \">COORDS\":\n374:         receive_qm_coords(mdicomm)\n375:     elif command in [\"<ENERGY\", \"<PE\"]:\n376:         evaluate()\n377:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n378:         if ierr:\n379:             error(\"MDI: <ENERGY send failed\")\n380:     elif command == \"<FORCES\":\n381:         evaluate()\n382:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n383:         if ierr:\n384:             error(\"MDI: <FORCES send failed\")\n385:     else:\n386:         error(f\"Unrecognized MDI command: {command}\")\n387:     return 0\n388: \n389: \n390: if __name__ == \"__main__\":\n391:     configure_rtx5080_environment()\n392: \n393:     args = sys.argv\n394:     mdi_option = \"\"\n395:     iarg = 1\n396:     while iarg < len(args):\n397:         if args[iarg] in [\"-mdi\", \"--mdi\"]:\n398:             if iarg + 1 < len(args):\n399:                 mdi_option = args[iarg + 1]\n400:                 break\n401:         iarg += 1\n402: \n403:     if not mdi_option:\n404:         error(\"Missing -mdi argument on command line\")\n405: \n406:     log(f\"Initializing MDI Engine (RTX 5080 / Ultra 9 285K) with options: {mdi_option}\")\n407:     log(query_rtx5080_status())\n408:     mdi.MDI_Init(mdi_option)\n409: \n410:     mdi.MDI_Register_Node(\"@DEFAULT\")\n411:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n412:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n413: \n414:     log(\"Waiting for MDI driver connection...\")\n415:     mdicomm = mdi.MDI_Accept_Communicator()\n416:     log(\"Connected to MDI driver! Entering communication loop...\")\n417: \n418:     while not exitflag:\n419:         command = mdi.MDI_Recv_Command(mdicomm)\n420:         execute_command(command, mdicomm, None)\n421: \n422:     # 全ステップ履歴があれば espresso.pwo に統合して auto_generate_progression_graphs.py が全点読めるようにする\n423:     if os.path.exists(\"espresso_all_steps.pwo\"):\n424:         shutil.copyfile(\"espresso_all_steps.pwo\", \"espresso.pwo\")\n425: \n426:     log(\"MDI Engine execution terminated cleanly.\")\n427: "}
