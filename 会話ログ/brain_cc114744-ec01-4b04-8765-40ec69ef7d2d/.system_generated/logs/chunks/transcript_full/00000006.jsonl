 \"converged (144 atoms, natural cleavage vac 5A)\"),\n55: ]\n56: \n57: rows = []\n58: for n, es, eb, note in data:\n59:     de = es - eb\n60:     g = de / AREA_2A * CONV\n61:     rows.append((n, es, eb, de, g, note))\n62:     print(f\"{n} periods: E_slab={es:.4f}  E_bulk={eb:.4f}  dE={de:.4f} eV  gamma={g:.4f} J/m2  [{note}]\")\n63: \n64: csv_path = os.path.join(ROOT, \"surface_energy_vs_periods_plot_data.csv\")\n65: with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8-sig\") as f:\n66:     w = csv.writer(f)\n67:     w.writerow([\"Periods\", \"Vacuum_A\", \"E_slab_eV\", \"E_bulk_eV\", \"Delta_E_eV\", \"Area_2A_A2\", \"Gamma_J_m2\", \"Note\"])\n68:     for n, es, eb, de, g, note in rows:\n69:         w.writerow([n, 5.0, es, eb, round(de, 4), AREA_2A, round(g, 4), note])\n70: \n71: # フォント\n72: mincho = \"/home/yamazaki/mdi_workspace_backup/msmincho.ttc\"\n73: times = \"/home/yamazaki/mdi_workspace_backup/times.ttf\"\n74: \n75: fp = lambda path, **kw: fm.FontProperties(fname=path, **kw) if os.path.exists(path) else fm.FontProperties(**kw)\n76: f_label = fp(mincho, size=10.5)\n77: f_lit_jp = fp(mincho, weight=\"bold\", size=9.5)\n78: f_tick = fp(times, size=9.5)\n79: f_lit_en = fp(times, weight=\"bold\", size=9.5)\n80: \n81: WIDTH_IN = 8.0 / 2.54\n82: HEIGHT_IN = 6.2 / 2.54\n83: \n84: fig, ax = plt.subplots(figsize=(WIDTH_IN, HEIGHT_IN), dpi=600)\n85: \n86: # プロット点\n87: x_pts = [r[0] for r in rows]\n88: y_pts = [r[4] for r in rows]\n89: ax.scatter(x_pts, y_pts, marker='^', facecolors='none', edgecolors='#8A2BE2', s=55, linewidths=1.3, zorder=5)\n90: \n91: # 文献値線 (3.03 J/m^2)\n92: LIT_VAL = 3.03\n93: ax.axhline(LIT_VAL, color='#222222', linestyle='--', linewidth=1.1, zorder=2)\n94: \n95: # 文献値ラベル\n96: t_jp = TextArea(\"文献値 \", textprops=dict(fontproperties=f_lit_jp, color='#222222'))\n97: t_en = TextArea(f\"({LIT_VAL:.2f} J/m²)\", textprops=dict(fontproperties=f_lit_en, color='#222222'))\n98: box = HPacker(children=[t_jp, t_en], align=\"baseline\", pad=0, sep=0)\n99: anchored = AnchoredOffsetbox(\n100:     loc=\"lower right\",\n101:     child=box,\n102:     pad=0.0,\n103:     borderpad=0.3,\n104:     frameon=False,\n105:     bbox_to_anchor=(0.95, (LIT_VAL - 2.2) / (3.2 - 2.2) + 0.02),\n106:     bbox_transform=ax.transAxes,\n107: )\n108: ax.add_artist(anchored)\n109: \n110: # Rauls et al. 1999 の緩和後文献値基準線 (2.27 J/m^2) も追加\n111: LIT_RELAXED = 2.27\n112: ax.axhline(LIT_RELAXED, color='#008080', linestyle=':', linewidth=1.0, zorder=2)\n113: t_r_jp = TextArea(\"Rauls緩和値 \", textprops=dict(fontproperties=fp(mincho, size=8.5), color='#008080'))\n114: t_r_en = TextArea(\"(2.27 J/m²)\", textprops=dict(fontproperties=fp(times, size=8.5), color='#008080'))\n115: box_r = HPacker(children=[t_r_jp, t_r_en], align=\"baseline\", pad=0, sep=0)\n116: anchored_r = AnchoredOffsetbox(\n117:     loc=\"lower right\",\n118:     child=box_r,\n119:     pad=0.0,\n120:     borderpad=0.3,\n121:     frameon=False,\n122:     bbox_to_anchor=(0.95, (LIT_RELAXED - 2.2) / (3.2 - 2.2) + 0.02),\n123:     bbox_transform=ax.transAxes,\n124: )\n125: ax.add_artist(anchored_r)\n126: \n127: # 軸範囲と目盛り\n128: ax.set_xlim(0.0, 6.0)\n129: ax.set_ylim(2.2, 3.2)\n130: \n131: ax.set_xlabel(\"周期数 [Period]\", fontproperties=f_label, labelpad=5)\n132: ax.set_ylabel(r\"表面破壊エネルギー [$\\mathrm{J/m^2}$]\", fontproperties=f_label, labelpad=5)\n133: \n134: ax.xaxis.set_major_locator(ticker.MultipleLocator(1.0))\n135: ax.yaxis.set_major_locator(ticker.MultipleLocator(0.1))\n136: ax.yaxis.set_minor_locator(ticker.MultipleLocator(0.05))\n137: \n138: for label in ax.get_xticklabels() + ax.get_yticklabels():\n139:     label.set_fontproperties(f_tick)\n140: \n141: plt.subplots_adjust(left=0.20, right=0.95, top=0.94, bottom=0.18)\n142: \n143: out_destinations = [\n144:     ROOT,\n145:     \"/home/yamazaki/.gemini/antigravity-ide/brain/1362d290-ff57-4721-b6d6-522994f3eca9\",\n146:     \"/home/yamazaki/mdi_workspace_backup/calc_2H-SiC_10-10_4periods_vac5A_natural_cleavage/restart\"\n147: ]\n148: 