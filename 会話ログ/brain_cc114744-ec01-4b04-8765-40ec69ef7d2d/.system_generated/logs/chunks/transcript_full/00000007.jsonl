{"step_index":274,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-05T10:30:19Z","content":"Created At: 2026-11-05T19:30:19+09:00\nCompleted At: 2026-11-05T19:30:19+09:00\nShowing lines 1-133 of 133\n1: #!/usr/bin/env python3\n2: import os\n3: import json\n4: import numpy as np\n5: import ase.io\n6: from ase.build import surface\n7: from ase.io.lammpsdata import write_lammps_data\n8: \n9: def build_6periods_natural_cleavage_models():\n10:     base_dir = \"/home/yamazaki/mdi_workspace_backup\"\n11:     cif_input = os.path.join(base_dir, \"research_simulations/2H-SiC.cif\")\n12:     \n13:     dir_slab = os.path.join(base_dir, \"calc_2H-SiC_10-10_6periods_vac5A_natural_cleavage\")\n14:     dir_bulk = os.path.join(base_dir, \"calc_2H-SiC_10-10_6periods_true_bulk_scf\")\n15:     os.makedirs(dir_slab, exist_ok=True)\n16:     os.makedirs(dir_bulk, exist_ok=True)\n17:     \n18:     print(f\"Loading 2H-SiC crystal from {cif_input}...\")\n19:     bulk_cif = ase.io.read(cif_input)\n20:     \n21:     # 1. 6周期 {10-10} 面スラブの構築 (layers=6: 6周期 12層)\n22:     # 2周期・4周期と完全に同一の ASE surface ロジック (粗結合 1.776Å 切断, 密結合ペア保持)\n23:     slab_unit = surface(bulk_cif, indices=(1, 0, 0), layers=6, vacuum=None)\n24:     slab_3x3 = slab_unit * (3, 3, 1)\n25:     \n26:     pos = slab_3x3.positions.copy()\n27:     z_min = float(np.min(pos[:, 2]))\n28:     z_max = float(np.max(pos[:, 2]))\n29:     thickness = z_max - z_min\n30:     \n31:     # 最下層を z = 5.0 Å にシフト\n32:     pos[:, 2] = pos[:, 2] - z_min + 5.0\n33:     slab_3x3.positions = pos\n34:     \n35:     # セル Z 軸長 = 厚み + 10.0 Å (真空 下5Å + 上5Å)\n36:     cell = slab_3x3.cell.copy()\n37:     cell[2, 2] = thickness + 10.0\n38:     slab_3x3.cell = cell\n39:     slab_3x3.pbc = [True, True, True]\n40:     slab_3x3.wrap()\n41:     \n42:     z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 3))\n43:     diffs = [round(z_unique[i+1] - z_unique[i], 3) for i in range(len(z_unique)-1)]\n44:     n_si = sum(s == 'Si' for s in slab_3x3.get_chemical_symbols())\n45:     n_c = sum(s == 'C' for s in slab_3x3.get_chemical_symbols())\n46:     \n47:     print(f\"\\n==========================================\")\n48:     print(f\"6-Periods Natural Cleavage Slab Model Generated:\")\n49:     print(f\"  - Total Atoms: {len(slab_3x3)} (Si: {n_si}, C: {n_c})\")\n50:     print(f\"  - Cell: Lx={slab_3x3.cell[0,0]:.4f} Å, Ly={slab_3x3.cell[1,1]:.4f} Å, Lz={slab_3x3.cell[2,2]:.4f} Å\")\n51:     print(f\"  - Thickness: {thickness:.4f} Å\")\n52:     print(f\"  - Atomic Layers ({len(z_unique)} layers): {z_unique} Å\")\n53:     print(f\"  - Interlayer Spacings: {diffs} Å\")\n54:     print(f\"  - Bottom vacuum: {np.min(slab_3x3.positions[:, 2]):.4f} Å (Target: 5.0 Å)\")\n55:     print(f\"  - Top vacuum: {slab_3x3.cell[2,2] - np.max(slab_3x3.positions[:, 2]):.4f} Å (Target: 5.0 Å)\")\n56:     \n57:     syms = np.array(slab_3x3.get_chemical_symbols())\n58:     mask_b = np.isclose(slab_3x3.positions[:, 2], z_unique[0], atol=0.01)\n59:     mask_t = np.isclose(slab_3x3.positions[:, 2], z_unique[-1], atol=0.01)\n60:     print(f\"  - Bottom layer: {sum(mask_b)} atoms (C: {sum(syms[mask_b]=='C')}, Si: {sum(syms[mask_b]=='Si')}) [Nonpolar]\")\n61:     print(f\"  - Top layer:    {sum(mask_t)} atoms (C: {sum(syms[mask_t]=='C')}, Si: {sum(syms[mask_t]=='Si')}) [Nonpolar]\")\n62:     print(f\"==========================================\\n\")\n63:     \n64:     # 2. 6周期真のバルクモデルの構築 (真空 0 Å, 完全周期的結晶)\n65:     bulk_pos = slab_3x3.positions.copy()\n66:     bulk_pos[:, 2] = bulk_pos[:, 2] - 5.0 # シフト戻し (0.0 からスタート)\n67:     bulk_cell = slab_3x3.cell.copy()\n68:     # 粗結合 1.7760 Å を足したものが真の周期長\n69:     bulk_cell[2, 2] = thickness + diffs[1] # 14.2076 + 1.7760 = 15.9836 Å\n70:     bulk_atoms = ase.Atoms(symbols=slab_3x3.get_chemical_symbols(), positions=bulk_pos, cell=bulk_cell, pbc=[True, True, True])\n71:     bulk_atoms.wrap()\n72:     \n73:     z_b_unique = np.unique(np.round(bulk_atoms.positions[:, 2], 3))\n74:     diffs_b = [round(z_b_unique[i+1] - z_b_unique[i], 3) for i in range(len(z_b_unique)-1)]\n75:     boundary_spacing = round(bulk_cell[2, 2] - z_b_unique[-1] + z_b_unique[0], 3)\n76:     \n77:     print(f\"==========================================\")\n78:     print(f\"6-Periods True Bulk Model Generated:\")\n79:     print(f\"  - Total Atoms: {len(bulk_atoms)} (Si: {n_si}, C: {n_c})\")\n80:     print(f\"  - Bulk Cell: Lx={bulk_atoms.cell[0,0]:.4f} Å, Ly={bulk_atoms.cell[1,1]:.4f} Å, Lz={bulk_atoms.cell[2,2]:.4f} Å\")\n81:     print(f\"  - Bulk Spacings: {diffs_b} Å\")\n82:     print(f\"  - Periodic boundary spacing across cell: {boundary_spacing:.4f} Å (Target: 1.776 Å)\")\n83:     print(f\"==========================================\\n\")\n84:     \n85:     # 3. ファイル保存 (スラブ用)\n86:     prefix_slab = os.path.join(dir_slab, \"slab_10-10_216atoms\")\n87:     ase.io.write(f\"{prefix_slab}.cif\", slab_3x3)\n88:     ase.io.write(f\"{prefix_slab}.xyz\", slab_3x3)\n89:     write_lammps_data(f\"{prefix_slab}.data\", slab_3x3, atom_style='atomic', masses=True)\n90:     \n91:     # バルク用もスラブディレクトリ内に配置\n92:     prefix_bulk_in_slab = os.path.join(dir_slab, \"bulk_10-10_216atoms\")\n93:     ase.io.write(f\"{prefix_bulk_in_slab}.cif\", bulk_atoms)\n94:     ase.io.write(f\"{prefix_bulk_in_slab}.xyz\", bulk_atoms)\n95:     write_lammps_data(f\"{prefix_bulk_in_slab}.data\", bulk_atoms, atom_style='atomic', masses=True)\n96:     \n97:     # 4. ファイル保存 (バルク専用ディレクトリ)\n98:     prefix_bulk_only = os.path.join(dir_bulk, \"bulk_10-10_216atoms_true_bulk\")\n99:     ase.io.write(f\"{prefix_bulk_only}.cif\", bulk_atoms)\n100:     ase.io.write(f\"{prefix_bulk_only}.xyz\", bulk_atoms)\n101:     write_lammps_data(f\"{prefix_bulk_only}.data\", bulk_atoms, atom_style='atomic', masses=True)\n102:     \n103:     # 5. メタデータ JSON 出力\n104:     area_A = float(slab_3x3.cell[0,0] * slab_3x3.cell[1,1])\n105:     area_2A = 2.0 * area_A\n106:     conv_factor = 16.021766\n107:     \n108:     meta = {\n109:         'cleavage_plane': '10-10',\n110:         'cleavage_type': 'natural_cleavage_sparse_bond',\n111:         'n_periods': 6,\n112:         'n_layers': 12,\n113:         'natoms': len(slab_3x3),\n114:         'vacuum_thickness_angstrom': 5.0,\n115:         'supercell_xy': [3, 3],\n116:         'cell_slab': [float(slab_3x3.cell[0,0]), float(slab_3x3.cell[1,1]), float(slab_3x3.cell[2,2])],\n117:         'cell_bulk': [float(bulk_atoms.cell[0,0]), float(bulk_atoms.cell[1,1]), float(bulk_atoms.cell[2,2])],\n118:         'area_A_angstrom2': area_A,\n119:         'total_area_2A_angstrom2': area_2A,\n120:         'unit_conversion_eV_A2_to_J_m2': conv_factor,\n121:         'effective_denominator': float(area_2A / conv_factor),\n122:         'slab_data_file': \"slab_10-10_216atoms.data\",\n123:         'bulk_data_file': \"bulk_10-10_216atoms.data\"\n124:     }\n125:     with open(os.path.join(dir_slab, \"fracture_metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n126:         json.dump(meta, f, indent=4)\n127:     with open(os.path.join(dir_bulk, \"fracture_metadata.json\"), \"w\", encoding=\"utf-8\") as f:\n128:         json.dump(meta, f, indent=4)\n129:         \n130:     print(f\"Successfully generated 6-period slab and bulk files!\")\n131: \n132: if __name__ == \"__main__\":\n133:     build_6periods_natural_cleavage_models()"}
