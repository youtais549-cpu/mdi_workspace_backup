{"step_index":786,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:08:24Z","content":"Created At: 2026-11-08T23:08:24+09:00\nCompleted At: 2026-11-08T23:08:25+09:00\nShowing lines 300-400 of 654\n300: \n301:     return slab_prefix\n302: \n303: \n304: def run_single_period(N, port):\n305:     \"\"\"周期数 N のバルク先行計算、スラブ緩和、解析、NASステージングを一括実行\"\"\"\n306:     calc_dir_name = f\"calc_2H-SiC_10-10_{N}periods_vac5A_natural_cleavage\"\n307:     calc_dir = os.path.join(WORKSPACE_DIR, calc_dir_name)\n308:     os.makedirs(calc_dir, exist_ok=True)\n309:     nas_folder_name = f\"{{101_0}}{N}周期5Å\"\n310: \n311:     # 既に完了しているか判定\n312:     meta_path = os.path.join(calc_dir, \"fracture_metadata.json\")\n313:     log_path = os.path.join(calc_dir, \"log.lammps\")\n314:     graph_path = os.path.join(calc_dir, \"Total_Energy_progression.png\")\n315:     if os.path.exists(meta_path) and os.path.exists(log_path) and os.path.exists(graph_path):\n316:         try:\n317:             with open(meta_path, \"r\", encoding=\"utf-8\") as f:\n318:                 m = json.load(f)\n319:             if \"surface_fracture_energy_J_m2\" in m and \"relaxed_slab_energy_eV\" in m:\n320:                 with open(log_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as lf:\n321:                     if \"Minimization stats:\" in lf.read():\n322:                         log(f\"[Skip] N={N} periods ({calc_dir}) is already converged.\")\n323:                         stage_to_nas_local(calc_dir, nas_folder_name)\n324:                         return calc_dir\n325:         except Exception:\n326:             pass\n327: \n328:     log(f\"============================================================\")\n329:     log(f\"🚀 Starting Period {N} Calculation Flow (Target NAS: {nas_folder_name})\")\n330:     log(f\"============================================================\")\n331: \n332:     # 1. 構造構築\n333:     slab_3x3, bulk_atoms, thickness, diffs = build_models(N)\n334:     natoms = len(slab_3x3)\n335: \n336:     # 2. 【Phase 1】真のバルク 1点 SCF 先行確定\n337:     e_bulk_ev, e_bulk_ry, bulk_elapsed = run_bulk_scf(N, calc_dir, bulk_atoms)\n338: \n339:     # 3. 【Phase 2】スラブ緩和入力配備\n340:     slab_prefix = prepare_slab_directory(N, calc_dir, slab_3x3, e_bulk_ev, e_bulk_ry, port)\n341: \n342:     # 以前の残骸をクリーンアップ\n343:     for fn in [\"tmp\", \"espresso.pwo\", \"espresso_all_steps.pwo\", \"dump.lammpstrj\", \"qe_engine.log\", \"lmp.log\", \"log.lammps\"]:\n344:         p = os.path.join(calc_dir, fn)\n345:         if os.path.isdir(p):\n346:             shutil.rmtree(p, ignore_errors=True)\n347:         elif os.path.exists(p):\n348:             os.remove(p)\n349: \n350:     env = os.environ.copy()\n351:     env[\"PATH\"] = f\"{ENV_PREFIX}/bin:\" + env.get(\"PATH\", \"\")\n352:     env[\"LD_LIBRARY_PATH\"] = f\"{ENV_PREFIX}/lib:\" + env.get(\"LD_LIBRARY_PATH\", \"\")\n353:     env[\"OMPI_MCA_btl_vader_single_copy_mechanism\"] = \"none\"\n354:     env[\"QE_MPI_NP\"] = \"12\"\n355:     env[\"QE_OMP_THREADS\"] = \"2\"\n356:     env[\"MPLCONFIGDIR\"] = \"/tmp/matplotlib_cache_sic\"\n357: \n358:     lmp_bin = os.path.join(ENV_PREFIX, \"bin\", \"lmp\")\n359:     py_bin = os.path.join(ENV_PREFIX, \"bin\", \"python3\")\n360: \n361:     log(f\"--- [Period {N}] Step 2: Running MDI Slab Relaxation ({natoms} atoms, vacuum 5.0 Å) ---\")\n362:     t0 = time.time()\n363:     with open(os.path.join(calc_dir, \"lmp.log\"), \"w\") as lmp_out, open(\n364:         os.path.join(calc_dir, \"qe_engine.log\"), \"w\"\n365:     ) as qe_out:\n366:         lmp_proc = subprocess.Popen(\n367:             [lmp_bin, \"-mdi\", f\"-role DRIVER -name LAMMPS -method TCP -port {port}\", \"-in\", \"in.lammps\"],\n368:             cwd=calc_dir,\n369:             env=env,\n370:             stdout=lmp_out,\n371:             stderr=subprocess.STDOUT,\n372:         )\n373:         time.sleep(1.0)\n374:         qe_proc = subprocess.Popen(\n375:             [\n376:                 py_bin,\n377:                 \"qe_mdi_engine_rtx5080.py\",\n378:                 \"-mdi\",\n379:                 f\"-role ENGINE -name QE -method TCP -port {port} -hostname localhost\",\n380:             ],\n381:             cwd=calc_dir,\n382:             env=env,\n383:             stdout=qe_out,\n384:             stderr=subprocess.STDOUT,\n385:         )\n386:         qe_rc = qe_proc.wait()\n387:         lmp_rc = lmp_proc.wait()\n388: \n389:     slab_elapsed = time.time() - t0\n390:     if qe_rc != 0 or lmp_rc != 0:\n391:         raise RuntimeError(f\"MDI calculation failed for N={N} (qe_rc={qe_rc}, lmp_rc={lmp_rc})\")\n392: \n393:     # 4. 【Phase 3】ポスト処理 (Winmostar XYZ, 3種推移グラフ, γ算出)\n394:     subprocess.run([py_bin, \"make_xyz.py\", \"dump.lammpstrj\", \"md_animation.xyz\"], cwd=calc_dir, env=env, check=True)\n395:     subprocess.run([py_bin, \"auto_generate_progression_graphs.py\"], cwd=calc_dir, env=env, check=True)\n396: \n397:     with open(os.path.join(calc_dir, \"fracture_metadata.json\"), \"r\", encoding=\"utf-8\") as f:\n398:         meta = json.load(f)\n399: \n400:     energies_qe = []"}
