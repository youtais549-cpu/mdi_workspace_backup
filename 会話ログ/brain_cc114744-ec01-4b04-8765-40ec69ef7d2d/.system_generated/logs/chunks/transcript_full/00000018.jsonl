{"step_index":788,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T14:08:28Z","content":"Created At: 2026-11-08T23:08:28+09:00\nCompleted At: 2026-11-08T23:08:28+09:00\nShowing lines 116-195 of 654\n116: def run_bulk_scf(N, calc_dir, bulk_atoms):\n117:     \"\"\"【AGENTS.md §1 必須プロトコル】真のバルクモデル (36*N 原子) による 1 点 SCF 先行確定\"\"\"\n118:     natoms = len(bulk_atoms)\n119:     log(f\"--- [Period {N}] Step 1: Running True Bulk 1-Point SCF ({natoms} atoms, Lz={bulk_atoms.cell[2,2]:.4f} Å) ---\")\n120: \n121:     pwi_lines = [\n122:         \"&CONTROL\",\n123:         \"   calculation      = 'scf'\",\n124:         \"   restart_mode     = 'from_scratch'\",\n125:         \"   tstress          = .false.\",\n126:         \"   tprnfor          = .true.\",\n127:         \"   outdir           = './tmp_bulk'\",\n128:         \"   prefix           = 'sic_bulk'\",\n129:         \"   pseudo_dir       = './'\",\n130:         \"   disk_io          = 'minimal'\",\n131:         \"/\",\n132:         \"&SYSTEM\",\n133:         \"   ibrav            = 0\",\n134:         \"   ecutwfc          = 40.0\",\n135:         \"   ecutrho          = 320.0\",\n136:         \"   occupations      = 'smearing'\",\n137:         \"   degauss          = 0.01\",\n138:         \"   smearing         = 'gaussian'\",\n139:         \"   ntyp             = 2\",\n140:         f\"   nat              = {natoms}\",\n141:         \"/\",\n142:         \"&ELECTRONS\",\n143:         \"   electron_maxstep = 200\",\n144:         \"   conv_thr         = 1e-05\",\n145:         \"   mixing_mode      = 'local-TF'\",\n146:         \"   mixing_beta      = 0.3\",\n147:         \"/\",\n148:         \"ATOMIC_SPECIES\",\n149:         \"Si 28.085 Si.upf\",\n150:         \"C 12.011 C.upf\",\n151:         \"\",\n152:         \"K_POINTS gamma\",\n153:         \"\",\n154:         \"CELL_PARAMETERS angstrom\",\n155:         f\"{bulk_atoms.cell[0,0]:.14f} 0.00000000000000 0.00000000000000\",\n156:         f\"0.00000000000000 {bulk_atoms.cell[1,1]:.14f} 0.00000000000000\",\n157:         f\"0.00000000000000 0.00000000000000 {bulk_atoms.cell[2,2]:.14f}\",\n158:         \"\",\n159:         \"ATOMIC_POSITIONS angstrom\",\n160:     ]\n161:     for sym, p in zip(bulk_atoms.get_chemical_symbols(), bulk_atoms.positions):\n162:         pwi_lines.append(f\"{sym} {p[0]:.10f} {p[1]:.10f} {p[2]:.10f}\")\n163: \n164:     pwi_path = os.path.join(calc_dir, \"espresso_bulk_scf.pwi\")\n165:     pwo_path = os.path.join(calc_dir, \"espresso_bulk_scf.pwo\")\n166:     with open(pwi_path, \"w\", encoding=\"utf-8\") as f:\n167:         f.write(\"\\n\".join(pwi_lines) + \"\\n\")\n168: \n169:     env = os.environ.copy()\n170:     env[\"PATH\"] = f\"{ENV_PREFIX}/bin:\" + env.get(\"PATH\", \"\")\n171:     env[\"LD_LIBRARY_PATH\"] = f\"{ENV_PREFIX}/lib:\" + env.get(\"LD_LIBRARY_PATH\", \"\")\n172:     env[\"OMPI_MCA_btl_vader_single_copy_mechanism\"] = \"none\"\n173:     env[\"OMP_NUM_THREADS\"] = \"2\"\n174: \n175:     pw_bin = os.path.join(ENV_PREFIX, \"bin\", \"pw.x\")\n176:     mpirun_bin = os.path.join(ENV_PREFIX, \"bin\", \"mpirun\")\n177: \n178:     t0 = time.time()\n179:     cmd = [mpirun_bin, \"--oversubscribe\", \"-np\", \"12\", pw_bin, \"-ndiag\", \"1\", \"-in\", \"espresso_bulk_scf.pwi\"]\n180:     with open(pwo_path, \"w\") as out_f:\n181:         res = subprocess.run(cmd, cwd=calc_dir, env=env, stdout=out_f, stderr=subprocess.STDOUT)\n182:     elapsed = time.time() - t0\n183: \n184:     if res.returncode != 0:\n185:         raise RuntimeError(f\"Bulk SCF calculation failed for N={N} (code={res.returncode})\")\n186: \n187:     with open(pwo_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n188:         text = f.read()\n189: \n190:     m_e = re.findall(r\"!\\s+total energy\\s+=\\s+([-\\d\\.]+)\\s+Ry\", text)\n191:     if not m_e:\n192:         raise RuntimeError(f\"Could not parse bulk SCF energy for N={N} from {pwo_path}\")\n193: \n194:     e_bulk_ry = float(m_e[-1])\n195:     conv_ry_to_ev = 13.605693122994"}
