{"step_index":858,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-08T19:41:32Z","content":"Created At: 2026-11-09T04:41:32+09:00\nCompleted At: 2026-11-09T04:41:32+09:00\nShowing lines 1-100 of 179\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: create_8periods_bulk_and_slab_models.py\n4: 2H-SiC {10-10} 8周期 (16層, 288原子) 真のバルク基準モデル & 自然へき開スラブモデル (真空 5.0 Å) 生成スクリプト\n5: 【準拠ルール】\n6: - AGENTS.md §1: スラブ緩和前の「同一原子数 (288原子) 真のバルクモデル (真空 0 Å) 1点SCF先行確定」\n7: - AGENTS.md §2: Type 1 = C (12.011), Type 2 = Si (28.085)\n8: - AGENTS.md §10: ASE surface(bulk, indices=(1, 0, 0), layers=8) による統一生成 (粗結合 1.776 Å 切断)\n9: \"\"\"\n10: import os\n11: import json\n12: import numpy as np\n13: import ase.io\n14: from ase.build import surface\n15: from ase.io.lammpsdata import write_lammps_data\n16: \n17: \n18: def build_8periods_models():\n19:     out_dir = os.path.dirname(os.path.abspath(__file__))\n20:     workspace_dir = os.path.dirname(out_dir)\n21:     cif_input = os.path.join(workspace_dir, \"research_simulations\", \"2H-SiC.cif\")\n22: \n23:     print(f\"Loading 2H-SiC unit cell from {cif_input}...\")\n24:     bulk_cif = ase.io.read(cif_input)\n25: \n26:     # 1. {10-10} 面 8周期モデルの構築 (layers=8 -> 1周期2層なので合計16層)\n27:     slab_unit = surface(bulk_cif, indices=(1, 0, 0), layers=8, vacuum=None)\n28: \n29:     # 2. 面内 3x3 スーパーセル拡張 (合計 288 原子: Si 144, C 144)\n30:     slab_3x3 = slab_unit * (3, 3, 1)\n31: \n32:     # 3. スラブモデル座標調整 (上下に各 5.0 Å、合計 10.0 Å の真空層)\n33:     pos = slab_3x3.positions.copy()\n34:     z_min = float(np.min(pos[:, 2]))\n35:     z_max = float(np.max(pos[:, 2]))\n36:     thickness = z_max - z_min\n37: \n38:     pos[:, 2] = pos[:, 2] - z_min + 5.0\n39:     slab_3x3.positions = pos\n40: \n41:     cell_slab = slab_3x3.cell.copy()\n42:     cell_slab[2, 2] = thickness + 10.0\n43:     slab_3x3.cell = cell_slab\n44:     slab_3x3.pbc = [True, True, True]\n45:     slab_3x3.wrap()\n46: \n47:     # 層間距離プロファイルの検証\n48:     z_unique = np.unique(np.round(slab_3x3.positions[:, 2], 4))\n49:     diffs = [round(float(z_unique[i + 1] - z_unique[i]), 4) for i in range(len(z_unique) - 1)]\n50:     n_si = sum(s == 'Si' for s in slab_3x3.get_chemical_symbols())\n51:     n_c = sum(s == 'C' for s in slab_3x3.get_chemical_symbols())\n52: \n53:     # 4. 真のバルク基準モデル (真空 0 Å, 周期境界で粗結合 1.7757518 Å が繋がる真の結晶格子長)\n54:     # 1周期長 d_{10-10} = (sqrt(3)/2) * a = 2.6638941420409297 Å -> 8周期 = 21.311153136327437 Å\n55:     bulk_pos = slab_3x3.positions.copy()\n56:     bulk_pos[:, 2] = bulk_pos[:, 2] - 5.0  # z = 0.0 Å から開始\n57:     bulk_cell = slab_3x3.cell.copy()\n58:     exact_d_period = (np.sqrt(3.0) / 2.0) * 3.076\n59:     bulk_cell[2, 2] = 8.0 * exact_d_period\n60:     bulk_atoms = ase.Atoms(\n61:         symbols=slab_3x3.get_chemical_symbols(),\n62:         positions=bulk_pos,\n63:         cell=bulk_cell,\n64:         pbc=[True, True, True],\n65:     )\n66:     bulk_atoms.wrap()\n67: \n68:     print(\"\\n============================================================\")\n69:     print(\" 8-Periods (16 layers, 288 atoms) True Bulk & Slab Models\")\n70:     print(\"============================================================\")\n71:     print(f\"  - Total Atoms       : {len(bulk_atoms)} (Si: {n_si}, C: {n_c})\")\n72:     print(f\"  - Bulk Cell (0 Å)   : Lx={bulk_atoms.cell[0,0]:.4f} Å, Ly={bulk_atoms.cell[1,1]:.4f} Å, Lz={bulk_atoms.cell[2,2]:.6f} Å\")\n73:     print(f\"  - Slab Cell (vac 5Å): Lx={slab_3x3.cell[0,0]:.4f} Å, Ly={slab_3x3.cell[1,1]:.4f} Å, Lz={slab_3x3.cell[2,2]:.6f} Å\")\n74:     print(f\"  - Number of Layers  : {len(z_unique)} layers\")\n75:     print(f\"  - Interlayer dz     : {diffs[:4]} ... {diffs[-2:]} Å\")\n76:     print(f\"    (Both ends dense ~0.8881 Å preserved, outer cleavage sparse ~1.7758 Å)\")\n77:     print(\"============================================================\\n\")\n78: \n79:     # 5. バルク構造ファイルの出力 (.cif, .xyz, .data)\n80:     prefix_bulk = os.path.join(out_dir, \"bulk_10-10_288atoms_true_bulk\")\n81:     ase.io.write(f\"{prefix_bulk}.cif\", bulk_atoms)\n82:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk_atoms)\n83:     write_lammps_data(f\"{prefix_bulk}.data\", bulk_atoms, atom_style='atomic', masses=True)\n84: \n85:     # 6. スラブ構造ファイルの出力 (.cif, .xyz, .data)\n86:     prefix_slab = os.path.join(out_dir, \"slab_10-10_288atoms_vac5A\")\n87:     ase.io.write(f\"{prefix_slab}.cif\", slab_3x3)\n88:     ase.io.write(f\"{prefix_slab}.xyz\", slab_3x3)\n89:     write_lammps_data(f\"{prefix_slab}.data\", slab_3x3, atom_style='atomic', masses=True)\n90: \n91:     # 7. Quantum ESPRESSO 1点SCF入力ファイル (espresso.pwi) の生成\n92:     # 6周期 (calc_2H-SiC_10-10_6periods_true_bulk_scf/espresso.pwi) と完全同一のDFT条件\n93:     pwi_lines = [\n94:         \"&CONTROL\",\n95:         \"   calculation      = 'scf'\",\n96:         \"   restart_mode     = 'from_scratch'\",\n97:         \"   tstress          = .true.\",\n98:         \"   tprnfor          = .true.\",\n99:         \"   outdir           = './tmp'\",\n100:         \"   prefix           = 'sic'\","}
