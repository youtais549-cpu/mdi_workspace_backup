1f},\"{calc_dir_name}\",\"true_bulk_scf\"\\n'\n492:     )\n493:     with open(csv_path, \"a\", encoding=\"utf-8\") as f:\n494:         f.write(csv_row)\n495: \n496:     if os.path.exists(md_path):\n497:         with open(md_path, \"r\", encoding=\"utf-8\") as f:\n498:             md_lines = f.read().splitlines()\n499: \n500:         md_row = (\n501:             f\"| **#{next_no}** | {date_str} | `{{101_0}}` | {N} ({2*N}層) | {natoms} | 5.0 Å | \"\n502:             f\"`minimize 1.0e-6 1.0e-2 100 150` | {e_slab:.4f} | {e_bulk:.4f} | {delta_e:.4f} | \"\n503:             f\"**{gamma:.4f}** | 2.27〜2.44 | {diff_pct:+.1f}% | \"\n504:             f\"`{calc_dir_name}` |\"\n505:         )\n506:         last_idx = -1\n507:         for i, line in enumerate(md_lines):\n508:             if line.strip().startswith(\"| **#\"):\n509:                 last_idx = i\n510:         if last_idx != -1:\n511:             md_lines.insert(last_idx + 1, md_row)\n512:             with open(md_path, \"w\", encoding=\"utf-8\") as f:\n513:                 f.write(\"\\n\".join(md_lines) + \"\\n\")\n514: \n515: \n516: def update_periods_summary_and_graphs():\n517:     \"\"\"完了済みの全周期数条件 (1〜10周期) を集計し、CSVおよび周期数依存性比較グラフを出力\"\"\"\n518:     collected = []\n519:     # 既存の計算ディレクトリと新規ディレクトリの両方を探索\n520:     for N in ALL_PERIODS:\n521:         # パス候補\n522:         candidates = [\n523:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A_natural_cleavage\"),\n524:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A_local_RTX5080\"),\n525:             os.path.join(WORKSPACE_DIR, f\"calc_2H-SiC_10-10_{N}periods_vac5A\"),\n526:             os.path.join(WORKSPACE_DIR, f\"results_2H-SiC_10-10_slab_{N}periods_vac5A_relaxed_20261022\"),\n527:         ]\n528:         if N == 2:\n529:             candidates.insert(0, os.path.join(WORKSPACE_DIR, \"calc_2H-SiC_10-10_2periods_vac5.0A_rtx5080\"))\n530: \n531:         found_meta = None\n532:         for c in candidates:\n533:             m_path = os.path.join(c, \"fracture_metadata.json\")\n534:             if os.path.exists(m_path):\n535:                 try:\n536:                     with open(m_path, \"r\", encoding=\"utf-8\") as f:\n537:                         meta = json.load(f)\n538:                     if \"surface_fracture_energy_J_m2\" in meta:\n539:                         found_meta = meta\n540:                         break\n541:                 except Exception:\n542:                     pass\n543: \n544:         if found_meta:\n545:             natoms = found_meta.get(\"n_atoms\", found_meta.get(\"natoms\", 36 * N))\n546:             e_slab = found_meta.get(\"relaxed_slab_energy_eV\", 0.0)\n547:             e_bulk = found_meta.get(\"true_bulk_scf_energy_eV\", 0.0)\n548:             de = found_meta.get(\"delta_energy_eV\", e_slab - e_bulk)\n549:             gamma = found_meta.get(\"surface_fracture_energy_J_m2\", 0.0)\n550:             collected.append((N, natoms, e_slab, e_bulk, de, gamma))\n551: \n552:     if not collected:\n553:         return\n554: \n555:     collected.sort(key=lambda x: x[0])\n556: \n557:     # 1. CSV更新\n558:     csv_path = os.path.join(WORKSPACE_DIR, \"surface_energy_vs_periods_plot_data.csv\")\n559:     with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8-sig\") as f:\n560:         w = csv.writer(f)\n561:         w.writerow([\"Periods\", \"Natoms\", \"Vacuum_A\", \"E_slab_eV\", \"E_bulk_eV\", \"Delta_E_eV\", \"Area_2A_A2\", \"Gamma_J_m2\"])\n562:         for n, na, es, eb, de, g in collected:\n563:             w.writerow([n, na, 5.0, es, eb, round(de, 4), AREA_2A, round(g, 4)])\n564: \n565:     # 2. グラフ描画 (AGENTS.md §7 準拠: 周期数依存性仕様)\n566:     mincho = os.path.join(WORKSPACE_DIR, \"msmincho.ttc\")\n567:     times = os.path.join(WORKSPACE_DIR, \"times.ttf\")\n568:     timesbd = os.path.join(WORKSPACE_DIR, \"timesbd.ttf\")\n569: \n570:     font_label = fm.FontProperties(fname=mincho, size=14.5)\n571:     font_tick = fm.FontProperties(fname=times, size=11.5)\n572:     font_lit_jp = fm.FontProperties(fname=mincho, weight=\"bold\", size=12.0)\n573:     font_lit_en = fm.FontProperties(fname=timesbd, weight=\"bold\", size=12.5)\n574: \n575:     fig, ax = plt.subplots(figsize=(5.6, 4.4), dpi=300)\n576: \n577:     x_pts = [c[0] for c in collected]\n578:     y_pts = [c[5] for c in collected]\n579: \n580:     ax.scatter(x_pts, y_pts, marker=\"^\", facecolors=\"none\", edgecolors=\"#8A2BE2\", s=70, linewidths=1.6, zorder=5)\n581: \n582:     # 文献値 (3.03 J/m²) 水平破線\n583:     LIT_VAL = 3.03\n584:     ax.axhline(LIT_VAL, color=\"#222222\", linestyle=\"--\", linewidth=1.2, zorder=3)\n585: \n586:     area_jp = TextArea(\"文献値\", textprops=dict(fontproperties=font_lit_jp, color=\"#111111\"))\n587:     area_en = TextArea(\"(3.03 J/m²)\", textprops=dict(fontproperties=font_lit_en, color=\"#111111\"))\n588:     packer = HPacker(children=[area_jp, area_en], align=\"baseline\", pad=0, sep=3)\n589: \n590:     y_norm = (LIT_VAL - 2.2) / (3.2 - 2.2) + 0.024\n591:     anchored = AnchoredOffsetbox(\n592:         loc=\"lower right\",\n593:         child=packer,\n594:         pad=0.0,\n595:         frameon=False,\n596:         bbox_to_anchor=(0.95, y_norm),\n597:         bbox_transform=ax.transAxes,\n598:     )\n599:     ax.add_artist(anchored)\n600: \n601:     # 軸範囲と目盛り (AGENTS.md §7: 縦軸 2.2〜3.2 J/m², 横軸 0〜11)\n602:     ax.set_xlim(0.0, 11.0)\n603:     ax.set_ylim(2.2, 3.2)\n604: \n605:     ax.set_xlabel(r\"周期数  $\\mathrm{[periods]}$\", fontproperties=font_label, labelpad=10)\n606:     ax.set_ylabel(r\"表面破壊エネルギー  $\\mathrm{[J/m^2]}$\", fontproperties=font_label, labelpad=10)\n607: \n608:     x_ticks = [0, 2, 4, 6, 8, 10]\n609:     ax.set_xticks(x_ticks)\n610:     ax.set_xticklabels([str(x) for x in x_ticks], fontproperties=font_tick)\n611: \n612:     y_ticks = [2.2, 2.3, 2.4, 2.5, 2.6, 2.7, 2.8, 2.9, 3.0, 3.1, 3.2]\n613:     ax.set_yticks(y_ticks)\n614:     ax.set_yticklabels([f\"{y:.1f}\" for y in y_ticks], fontproperties=font_tick)\n6