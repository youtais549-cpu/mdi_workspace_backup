 = np.mean(z_rel[idx4][syms[idx4] == 'Si'])\n    buckle_L4 = z4_C - z4_Si\n\n    # Minimum Si-C distance across the vacuum gap (between Layer 4 and Layer 1 + [0,0,Lz])\n    idx1 = layer_indices[0]\n    idx2 = layer_indices[1]\n    pos1_ini_shifted = pos_init[idx1].copy()\n    pos1_ini_shifted[:, 2] = z_ini[idx1] + Lz\n    pos4_ini = pos_init[idx4].copy()\n    pos4_ini[:, 2] = z_ini[idx4]\n\n    pos1_rel_shifted = pos_rel[idx1].copy()\n    pos1_rel_shifted[:, 2] = z_rel[idx1] + Lz\n    pos4_rel = pos_rel[idx4].copy()\n    pos4_rel[:, 2] = z_rel[idx4]\n\n    d_sic_ini_list = []\n    d_sic_rel_list = []\n    for i4, a4 in enumerate(idx4):\n        for i1, a1 in enumerate(idx1):\n            if syms[a4] != syms[a1]:\n                for nx in [-1, 0, 1]:\n                    for ny in [-1, 0, 1]:\n                        shift_xy = nx * cell[0] + ny * cell[1]\n                        dist_ini = np.linalg.norm(pos1_ini_shifted[i1] + shift_xy - pos4_ini[i4])\n                        dist_rel = np.linalg.norm(pos1_rel_shifted[i1] + shift_xy - pos4_rel[i4])\n                        d_sic_ini_list.append(dist_ini)\n                        d_sic_rel_list.append(dist_rel)\n    d_sic_ini = np.min(d_sic_ini_list)\n    d_sic_rel = np.min(d_sic_rel_list)\n\n    # Also check Si-C bond length inside Layer 1-2 (dense bilayer) after relaxation\n    pos1_rel = pos_rel[idx1].copy(); pos1_rel[:, 2] = z_rel[idx1]\n    pos2_rel = pos_rel[idx2].copy(); pos2_rel[:, 2] = z_rel[idx2]\n    d_12_list = []\n    for i1, a1 in enumerate(idx1):\n        for i2, a2 in enumerate(idx2):\n            if syms[a1] != syms[a2]:\n                for nx in [-1, 0, 1]:\n                    for ny in [-1, 0, 1]:\n                        shift_xy = nx * cell[0] + ny * cell[1]\n                        d_12_list.append(np.linalg.norm(pos2_rel[i2] + shift_xy - pos1_rel[i1]))\n    d_sic_12 = np.min(d_12_list)\n\n    print(f'{v:>6} | {Lz:7.4f} | {gap_ini:7.4f} | {gap_rel:7.4f} | {dgap:+7.4f} | {d_sic_ini:9.4f} | {d_