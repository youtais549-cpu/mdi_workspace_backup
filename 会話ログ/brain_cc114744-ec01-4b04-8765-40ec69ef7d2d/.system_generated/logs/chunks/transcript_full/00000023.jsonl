en(os.path.join(d, 'md_animation.xyz')) as f:\n        lines = [l.strip() for l in f if l.strip()]\n    first_72 = lines[2:74]\n    last_72 = lines[-72:]\n    pos_init, syms_init = [], []\n    for l in first_72:\n        p = l.split()\n        syms_init.append(p[0])\n        pos_init.append([float(p[1]), float(p[2]), float(p[3])])\n    pos_fin = []\n    for l in last_72:\n        p = l.split()\n        pos_fin.append([float(p[1]), float(p[2]), float(p[3])])\n\n    Lz = meta['box_lx_ly_lz_A'][2]\n    atoms_init = ase.Atoms(symbols=syms_init, positions=pos_init, cell=meta['box_lx_ly_lz_A'], pbc=True)\n    atoms_final = ase.Atoms(symbols=syms_init, positions=pos_fin, cell=meta['box_lx_ly_lz_A'], pbc=True)\n\n    z_init = atoms_init.positions[:, 2]\n    z_final = atoms_final.positions[:, 2]\n    syms = np.array(syms_init)\n\n    z_levels_init = np.unique(np.round(z_init, 3))\n    print(f'=== Vacuum = {v} A (total gap 2*vac = {2*float(v):.2f} A, Lz = {Lz:.4f} A, gamma = {meta[\\\"surface_fracture_energy_J_m2\\\"]:.4f} J/m2, n_steps = {meta.get(\\\"n_scf_steps\\\")}) ===')\n    for idx, zl in enumerate(z_levels_init):\n        mask = np.abs(z_init - zl) < 0.1\n        zf_si = np.mean(z_final[mask & (syms == 'Si')])\n        zf_c  = np.mean(z_final[mask & (syms == 'C')])\n        print(f'  Layer {idx+1} (init z={zl:.4f}): final z_Si={zf_si:.4f}, z_C={zf_c:.4f}, mean_z={0.5*(zf_si+zf_c):.4f}, buckling(z_C-z_Si)={zf_c-zf_si:+.4f} A')\n    \n    m1 = np.abs(z_init - z_levels_init[0]) < 0.1\n    m2 = np.abs(z_init - z_levels_init[1]) < 0.1\n    m3 = np.abs(z_init - z_levels_init[2]) < 0.1\n    m4 = np.abs(z_init - z_levels_init[3]) < 0.1\n    dz_12_init = z_levels_init[1] - z_levels_init[0]\n    dz_23_init = z_levels_init[2] - z_levels_init[1]\n    dz_34_init = z_levels_init[3] - z_levels_init[2]\n    dz_41_init = (z_levels_init[0] + Lz) - z_levels_init[3]\n\n    dz_12_fin = np.mean(z_final[m2]) - np.mean(z_final[m1])\n    dz_23_fin = np.mean(z_final[m3]) - np.mean(z_final[m2])\n    dz_34_fin = np.mean(z_final[m4]) - np.mean(z_final[m3])\n    dz_41_fin = (np.mean(z_final[m1]) + Lz) - np.mean(z_final[m4])\n    print(f'  Interlayer dz (init -> final):')\n    print(f'    L1-L2 (dense):       {dz_12_init:.4f} -> {dz_12_fin:.4f} A (bulk: 0.8881 A)')\n    print(f'    L2-L3 (inner cleave):{dz_23_init:.4f} -> {dz_23_fin:.4f} A (bulk: 1.7758 A)')\n    print(f'    L3-L4 (dense):       {dz_34_init:.4f} -> {dz_34_fin:.4f} A (bulk: 0.8881 A)')\n    print(f'    L4-L1_pbc (vacuum):  {dz_41_init:.4f} -> {dz_41_fin:.4f} A (bulk: 1.7758 A)')\n\n    idx_l1 = np.where(m1)[0]\n    idx_l4 = np.where(m4)[0]\n    min_sic_gap_init = 999.0\n    min_sic_gap_fin = 999.0\n    for i in idx_l4:\n        for j in idx_l1:\n            if syms[i] != syms[j]:\n                d_init = atoms_init.get_distance(i, j, mic=True)\n                d_fin = atoms_final.get_distance(i, j, mic=True)\n                if d_init < min_sic_gap_init: min_sic_gap_init = d_init\n                if d_fin < min_sic_gap_fin: min_sic_gap_fin = d_fin\n    idx_l2 = np.where(m2)[0]\n    idx_l3 = np.where(m3)[0]\n    min_sic_inner_fin = 999.0\n    for i in idx_l2:\n        for j in idx_l3:\n            if syms[i] != syms[j]:\n                d_fin = atoms_final.get_distance(i, j, mic=True)\n                if d_fin < min_sic_inner_fin: min_sic_inner_fin = d_fin\n    print(f'  Shortest Si-C across vacuum gap (L4-L1): {min_sic_gap_init:.4f} -> {min_sic_gap_fin:.4f} A (bulk Si-C bond = 1.8845 A)')\n    print(f'  Shortest Si-C across inner L2-L3 plane:  1.8845 -> {min_sic_inner_fin:.4f} A')\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Analyze relaxed slab structures from md_animation.xyz"}}]}
