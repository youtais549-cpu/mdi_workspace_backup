{"step_index":1075,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:19:27Z","content":"Created At: 2026-11-13T14:19:27+09:00\nCompleted At: 2026-11-13T14:19:27+09:00\nCreated At: 2026-11-13T14:19:27+09:00\nCompleted At: 2026-11-13T14:19:27+09:00\nShowing lines 1-80 of 268\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: T4 GPU 対応 Quantum ESPRESSO MDI エンジン\n4: LAMMPS (DRIVER) から MDI 経由で座標を受信し、GPU版 pw.x で SCF 計算を行い、力とエネルギーを返信する。\n5: \"\"\"\n6: import sys\n7: import os\n8: import glob\n9: import time\n10: import numpy as np\n11: import mdi\n12: from ase import Atoms\n13: from ase.calculators.espresso import Espresso, EspressoProfile\n14: import ase.parallel\n15: ase.parallel.world = ase.parallel.DummyMPI()\n16: \n17: ELEMENTS = [\n18:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n19:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n20:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n21:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n22:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n23:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n24:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n25:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n26:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n27:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n28:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n29:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n30: ]\n31: atomic_number_to_symbol = {i+1: symbol for i, symbol in enumerate(ELEMENTS)}\n32: type_to_symbol = {1: 'C', 2: 'Si'}\n33: \n34: exitflag = False\n35: qm_natoms = 0\n36: qm_elements = None\n37: qm_coords = None\n38: box = np.zeros(9, dtype=np.float64)\n39: flag_box = False\n40: \n41: qm_pe = 0.0\n42: qm_forces = None\n43: last_evaluated_coords = None\n44: \n45: def log(msg):\n46:     print(f\"[QE-MDI GPU Engine] {msg}\", flush=True)\n47: \n48: def error(txt):\n49:     log(f\"ERROR: {txt}\")\n50:     sys.exit(1)\n51: \n52: def find_nvhpc_and_pw():\n53:     \"\"\"NVHPCライブラリパスおよびGPU版pw.xバイナリの自動検出\"\"\"\n54:     # 1. NVHPCパスの検索\n55:     nvhpc_roots = glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\")\n56:     nvhpc_libs = []\n57:     if nvhpc_roots:\n58:         # 最新バージョンを優先\n59:         nvhpc_roots.sort(reverse=True)\n60:         root = nvhpc_roots[0]\n61:         nvhpc_libs = [\n62:             f\"{root}/compilers/lib\",\n63:             f\"{root}/math_libs/lib64\",\n64:             f\"{root}/cuda/lib64\",\n65:             f\"{root}/comm_libs/mpi/lib\"\n66:         ]\n67:         # 追加のcomm_libs/hpcxパス\n68:         hpcx_libs = glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\")\n69:         nvhpc_libs.extend(hpcx_libs)\n70:         log(f\"Detected NVHPC SDK at: {root}\")\n71:     \n72:     cuda_libs = [\n73:         \"/usr/local/cuda/lib64\",\n74:         \"/usr/lib64-nvidia\",\n75:         \"/usr/local/nvidia/lib\",\n76:         \"/usr/local/nvidia/lib64\",\n77:         \"/usr/lib/x86_64-linux-gnu\"\n78:     ]\n79:     all_libs = [p for p in (nvhpc_libs + cuda_libs) if os.path.exists(p)]\n80:     ld_path_str = \":\".join(all_libs)"}
