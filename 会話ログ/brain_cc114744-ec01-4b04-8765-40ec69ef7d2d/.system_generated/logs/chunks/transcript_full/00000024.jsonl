{"step_index":1093,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:41:23Z","content":"Created At: 2026-11-13T14:41:23+09:00\nCompleted At: 2026-11-13T14:41:24+09:00\nCreated At: 2026-11-13T14:41:23+09:00\nCompleted At: 2026-11-13T14:41:24+09:00\nShowing lines 220-330 of 413\n220: \n221: def receive_qm_natoms(mdicomm):\n222:     global qm_natoms\n223:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n224:     log(f\"Received >NATOMS: {qm_natoms}\")\n225:     allocate_qm()\n226: \n227: \n228: def receive_box(mdicomm):\n229:     global flag_box\n230:     flag_box = True\n231:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n232:     if ierr:\n233:         error(\"MDI: >CELL reception failed\")\n234: \n235: \n236: def receive_qm_coords(mdicomm):\n237:     if not qm_natoms:\n238:         error(\"Cannot receive >COORDS if # atoms = 0\")\n239:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n240:     if ierr:\n241:         error(\"MDI: >COORDS reception failed\")\n242: \n243: \n244: def receive_qm_elements(mdicomm):\n245:     if not qm_natoms:\n246:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n247:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n248:     if ierr:\n249:         error(\"MDI: >ELEMENTS reception failed\")\n250: \n251: \n252: def receive_qm_types(mdicomm):\n253:     if not qm_natoms:\n254:         error(\"Cannot receive >TYPES if # atoms = 0\")\n255:     types = np.empty(qm_natoms, dtype=np.int32)\n256:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n257:     if ierr:\n258:         error(\"MDI: >TYPES reception failed\")\n259:     for i, t in enumerate(types):\n260:         sym = type_to_symbol.get(int(t), 'C')\n261:         qm_elements[i] = ELEMENTS.index(sym) + 1\n262: \n263: \n264: def evaluate():\n265:     global qm_pe, qm_forces, last_evaluated_coords, step_counter\n266:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n267:         error(\"System atoms, elements, or coordinates not fully specified\")\n268: \n269:     # 座標キャッシュ: 同一ステップでの重複 SCF 計算を防止\n270:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n271:         return\n272: \n273:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n274:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n275:     force_conv = ev_to_hartree * bohr_to_angstrom\n276: \n277:     coords_angstrom = qm_coords * bohr_to_angstrom\n278:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n279: \n280:     if flag_box and np.linalg.norm(box) > 1e-6:\n281:         cell_matrix_bohr = box.reshape(3, 3)\n282:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n283:     else:\n284:         cell_matrix_angstrom = np.eye(3) * 10.0\n285: \n286:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n287:     command_str = detect_pw_command()\n288:     cfg = load_dft_config()\n289: \n290:     input_data = {\n291:         'control': {\n292:             'calculation': 'scf',\n293:             'pseudo_dir': './',\n294:             'outdir': './tmp',\n295:             'tprnfor': True,\n296:             'tstress': True,\n297:             'disk_io': 'minimal',\n298:         },\n299:         'system': {\n300:             'ecutwfc': cfg['ecutwfc'],\n301:             'ecutrho': cfg['ecutrho'],\n302:             'occupations': cfg['occupations'],\n303:             'smearing': cfg['smearing'],\n304:             'degauss': cfg['degauss'],\n305:         },\n306:         'electrons': {\n307:             'conv_thr': cfg['conv_thr'],\n308:             'mixing_beta': cfg['mixing_beta'],\n309:             'mixing_mode': cfg['mixing_mode'],\n310:             'electron_maxstep': cfg['electron_maxstep'],\n311:         },\n312:     }\n313: \n314:     log(f\"--- [Step {step_counter}] Running SCF with QE ({len(atoms)} atoms) | {query_rtx5080_status()} ---\")\n315: \n316:     t0 = time.time()\n317:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n318:     calc = Espresso(profile=profile, pseudopotentials=cfg['pseudopotentials'], input_data=input_data, kpts=cfg['kpts'])\n319:     atoms.calc = calc\n320: \n321:     pe_ev = atoms.get_potential_energy()\n322:     forces_ev_angstrom = atoms.get_forces()\n323:     elapsed = time.time() - t0\n324: \n325:     # 各ステップの espresso.pwo を履歴ファイルにも追記保存（全ステップの Total force / SCF correction 追跡用）\n326:     if os.path.exists(\"espresso.pwo\"):\n327:         with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f_in:\n328:             pwo_text = f_in.read()\n329:         with open(\"espresso_all_steps.pwo\", \"a\", encoding=\"utf-8\") as f_out:\n330:             f_out.write(f\"\\n=== STEP {step_counter} ===\\n\")"}
{"step_index":1094,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:41:23Z","content":"Created At: 2026-11-13T14:41:23+09:00\nCompleted At: 2026-11-13T14:41:24+09:00\nCreated At: 2026-11-13T14:41:23+09:00\nCompleted At: 2026-11-13T14:41:24+09:00\nShowing lines 1-42 of 42\n1: \"\"\"\n2: 第一原理電子状態計算 (DFT / Quantum ESPRESSO) のパラメータ設定ファイル\n3: 【ユーザー編集対象 (必要な場合のみ)】\n4: 通常はデフォルト設定のままで高精度かつ安定に収束します。\n5: カットオフエネルギーの収束性テストや k点メッシュの変更を行う場合はここを編集します。\n6: \"\"\"\n7: \n8: DFT_CONFIG = {\n9:     # 波動関数カットオフエネルギー (Ry)\n10:     # 推奨値: 40.0 Ry (PAW擬ポテンシャル下で結合エネルギーが十分収束)\n11:     'ecutwfc': 40.0,\n12: \n13:     # 電荷密度カットオフエネルギー (Ry)\n14:     # 推奨値: 320.0 Ry (PAWでは通常 ecutwfc の 8〜10倍を設定)\n15:     'ecutrho': 320.0,\n16: \n17:     # SCF電子状態収束閾値 (Ry)\n18:     # 推奨値: 1.0e-5 (力・エネルギーの精度として十分)\n19:     'conv_thr': 1.0e-5,\n20: \n21:     # k点サンプリング\n22:     # None: Γ点のみ (K_POINTS gamma)\n23:     # スーパーセル (3x3以上, 9Å以上) では逆格子空間が狭いため None (Γ点) で十分収束します。\n24:     # 単位胞や小さめのセルの場合は (2, 2, 1) などのタプルを指定可能\n25:     'kpts': None,\n26: \n27:     # 電子占有・スメアリング設定\n28:     'occupations': 'smearing',\n29:     'smearing': 'gaussian',\n30:     'degauss': 0.01,  # Ry\n31: \n32:     # 電子密度ミキシング設定 (SCF収束の安定化)\n33:     'mixing_beta': 0.3,\n34:     'mixing_mode': 'local-TF',  # 表面スラブ特有の電荷振動を抑える局所Thomas-Fermi法\n35:     'electron_maxstep': 200,\n36: \n37:     # 擬ポテンシャルファイル名\n38:     'pseudopotentials': {\n39:         'Si': 'Si.upf',\n40:         'C': 'C.upf'\n41:     }\n42: }"}
