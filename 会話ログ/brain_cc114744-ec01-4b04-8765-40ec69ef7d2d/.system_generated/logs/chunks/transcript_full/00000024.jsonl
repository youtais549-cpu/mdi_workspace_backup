LL_PARAMETERS angstrom\",\n161:         f\"{bulk_atoms.cell[0,0]:.14f} {bulk_atoms.cell[0,1]:.14f} {bulk_atoms.cell[0,2]:.14f}\",\n162:         f\"{bulk_atoms.cell[1,0]:.14f} {bulk_atoms.cell[1,1]:.14f} {bulk_atoms.cell[1,2]:.14f}\",\n163:         f\"{bulk_atoms.cell[2,0]:.14f} {bulk_atoms.cell[2,1]:.14f} {bulk_atoms.cell[2,2]:.14f}\",\n164:         \"\",\n165:         \"ATOMIC_POSITIONS angstrom\",\n166:     ]\n167:     for sym, p in zip(bulk_atoms.get_chemical_symbols(), bulk_atoms.positions):\n168:         pwi_lines.append(f\"{sym} {p[0]:.10f} {p[1]:.10f} {p[2]:.10f}\")\n169: \n170:     pwi_path = os.path.join(calc_dir, \"espresso_bulk_scf.pwi\")\n171:     pwo_path = os.path.join(calc_dir, \"espresso_bulk_scf.pwo\")\n172:     with open(pwi_path, \"w\", encoding=\"utf-8\") as f:\n173:         f.write(\"\\n\".join(pwi_lines) + \"\\n\")\n174: \n175:     env = os.environ.copy()\n176:     env[\"PATH\"] = f\"{ENV_PREFIX}/bin:\" + env.get(\"PATH\", \"\")\n177:     env[\"LD_LIBRARY_PATH\"] = f\"{ENV_PREFIX}/lib:\" + env.get(\"LD_LIBRARY_PATH\", \"\")\n178:     env[\"OMPI_MCA_btl_vader_single_copy_mechanism\"] = \"none\"\n179:     env[\"OMP_NUM_THREADS\"] = \"2\"\n180: \n181:     pw_bin = os.path.join(ENV_PREFIX, \"bin\", \"pw.x\")\n182:     mpirun_bin = os.path.join(ENV_PREFIX, \"bin\", \"mpirun\")\n183: \n184:     t0 = time.time()\n185:     cmd = [mpirun_bin, \"--oversubscribe\", \"-np\", \"12\", pw_bin, \"-ndiag\", \"1\", \"-in\", \"espresso_bulk_scf.pwi\"]\n186:     with open(pwo_path, \"w\") as out_f:\n187:         res = subprocess.run(cmd, cwd=calc_dir, env=env, stdout=out_f, stderr=subprocess.STDOUT)\n188:     elapsed = time.time() - t0\n189: \n190:     if res.returncode != 0:\n191:         raise RuntimeError(f\"Bulk SCF calculation failed for N={N} (code={res.returncode})\")\n192: \n193:     with open(pwo_path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f:\n194:         text = f.read()\n195: \n196:     m_e = re.findall(r\"!\\s+total energy\\s+=\\s+([-\\d\\.]+)\\s+Ry\", text)\n197:     if not m_e:\n198:         raise RuntimeError(f\"Could not parse bulk SCF energy for N={N} from {pwo_path}\")\n199: \n200:     e_bulk_ry = float(m_e[-1])\n201:     conv_ry_to_ev = 13.605693122994\n202:     e_bulk_ev = e_bulk_ry * conv_ry_to_ev\n203:     e_per_atom = e_bulk_ev / float(natoms)\n204: \n205:     log(\n206:         f\"--- [Period {N}] Bulk SCF Done in {elapsed:.1f}s | \"\n207:         f\"E_bulk={e_bulk_ev:.4f} eV ({e_bulk_ry:.8f} Ry) | {e_per_atom:.4f} eV/atom (Target: -443.5 eV/atom) ---\"\n208:     )\n209: \n210:     # 構造ファイルも保存\n211:     prefix_bulk = os.path.join(calc_dir, f\"bulk_10-10_{natoms}atoms_true_bulk\")\n212:     ase.io.write(f\"{prefix_bulk}.cif\", bulk_atoms)\n213:     ase.io.write(f\"{prefix_bulk}.xyz\", bulk_atoms)\n214:     write_lammps_data(f\"{prefix_bulk}.data\", bulk_atoms, atom_style=\"atomic\", masses=True)\n215: \n216:     return e_bulk_ev, e_bulk_ry, elapsed\n217: \n218: \n219: def deploy_common_assets(calc_dir):\n220:     \"\"\"共通アセット (UPF擬ポテンシャル, グラフ指示書, スクリプト等) を配備\"\"\"\n221:     for asset in [\n222:         \"C.upf\",\n223:         \"Si.upf\",\n224:         \"RELAXATION_GRAPH_PROTOCOL.json\",\n225:         \"dft_settings.py\",\n226:         \"make_xyz.py\",\n227:         \"msmincho.ttc\",\n228:         \"times.ttf\",\n229:         \"auto_generate_progression_graphs.py\",\n230:         \"qe_mdi_engine_rtx5080.py\",\n231:     ]:\n232:         src = os.path.join(TEMPLATE_DIR, asset)\n233:         dst = os.path.join(calc_dir, asset)\n234:         if not os.path.exists(dst):\n235:             shutil.copyfile(src, dst)\n236: \n237: \n238: def prepare_slab_directory(N, calc_dir, slab_3x3, e_bulk_ev, e_bulk_ry, port):\n239:     \"\"\"スラブ緩和計算用の入力ファイル一式を配備\"\"\"\n240:     natoms = len(slab_3x3)\n241:     slab_prefix = f\"slab_10-10_{natoms}atoms_vac5A\"\n242: \n243:     # 1. 共通アセット配備 (念のため再確認)\n244:     deploy_common_assets(calc_dir)\n245: \n246:     # 2. スラブ構造ファイル保存\n247:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.cif\"), slab_3x3)\n248:     ase.io.write(os.path.join(calc_dir, f\"{slab_prefix}.xyz\"), slab_3x3)\n249:     write_lammps_data(os.path.join(calc_dir, f\"{slab_prefix}.data\"), slab_3x3, atom_style=\"atomic\", masses=True)\n250: "}
{"step_index":1091,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-13T05:41:14Z","content":"Created At: 2026-11-13T14:41:14+09:00\nCompleted At: 2026-11-13T14:41:14+09:00\nCreated At: 2026-11-13T14:41:14+09:00\nCompleted At: 2026-11-13T14:41:14+09:00\nShowing lines 1-220 of 413\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: ==============================================================================\n4: Quantum ESPRESSO + MDI 連成エンジン (RTX 5080 16GB + Core Ultra 9 285K 24コア最適化版)\n5: ==============================================================================\n6: ・2H-SiC {10-10} 8周期 (16層, 288原子) 真空層 5.0 Å スラブ構造緩和用\n7: ・Core Ultra 9 285K (24コア / 64GB RAM) + RTX 5080 (16GB VRAM) 環境向け\n8: ・ASE + MDI DummyMPI 適用 (AGENTS.md §3)\n9: ・Type 1 = C (12.011), Type 2 = Si (28.085) 厳格一致 (AGENTS.md §2)\n10: \"\"\"\n11: import sys\n12: import os\n13: import glob\n14: import shutil\n15: import subprocess\n16: import time\n17: import numpy as np\n18: import mdi\n19: from ase import Atoms\n20: from ase.calculators.espresso import Espresso, EspressoProfile\n21: import ase.parallel\n22: \n23: # Rule 3: ASE + MDI の DummyMPI 必須化 (SIGABRT 防止)\n24: ase.parallel.world = ase.parallel.DummyMPI()\n25: \n26: ELEMENTS = [\n27:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n28:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n29:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n30:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n31:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n32:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n33:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n34:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n35:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n36:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n37:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n38:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n39: ]\n40: atomic_number_to_symbol = {i + 1: symbol for i, symbol in enumerate(ELEMENTS)}\n41: # Rule 2: Type 1 = C (12.011), Type 2 = Si (28.085)\n42: type_to_symbol = {1: 'C', 2: 'Si'}\n43: \n44: exitflag = False\n45: qm_natoms = 0\n46: qm_elements = None\n47: qm_coords = None\n48: box = np.zeros(9, dtype=np.float64)\n49: flag_box = False\n50: \n51: qm_pe = 0.0\n52: qm_forces = None\n53: last_evaluated_coords = None\n54: step_counter = 0\n55: \n56: \n57: def log(msg):\n58:     print(f\"[QE-MDI RTX5080 Engine] {msg}\", flush=True)\n59: \n60: \n61: def error(txt):\n62:     log(f\"ERROR: {txt}\")\n63:     sys.exit(1)\n64: \n65: \n66: def configure_rtx5080_environment():\n67:     \"\"\"\n68:     RTX 5080 (Blackwell sm_120, 16GB VRAM) & Core Ultra 9 285K (24コア) 用環境変数の設定\n69:     \"\"\"\n70:     os.environ.setdefault(\"CUDA_VISIBLE_DEVICES\", \"0\")\n71:     os.environ.setdefault(\"OMPI_MCA_btl_vader_single_copy_mechanism\", \"none\")\n72:     os.environ.setdefault(\"CUDA_CACHE_MAXSIZE\", \"2147483648\")\n73:     os.environ.setdefault(\"CUDA_CACHE_DISABLE\", \"0\")\n74:     os.environ.setdefault(\"NVCOMPILER_ACC_SYNCHRONOUS\", \"0\")\n75: \n76:     nvhpc_roots = sorted(glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\"), reverse=True)\n77:     extra_libs = []\n78:     if nvhpc_roots:\n79:         root = nvhpc_roots[0]\n80:         extra_libs.extend([\n81:             f\"{root}/compilers/lib\",\n82:             f\"{root}/math_libs/lib64\",\n83:             f\"{root}/cuda/lib64\",\n84:             f\"{root}/comm_libs/mpi/lib\",\n85:         ])\n86:         extra_libs.extend(glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\"))\n87:         log(f\"Detected NVHPC SDK at: {root}\")\n88: \n89:     cuda_libs = [\n90:         \"/usr/local/cuda/lib64\",\n91:         \"/usr/lib/wsl/lib\",\n92:         \"/usr/lib/x86_64-linux-gnu\",\n93:     ]\n94:     existing_libs = [p for p in (extra_libs + cuda_libs) if os.path.exists(p)]\n95:     current_ld = os.environ.get(\"LD_LIBRARY_PATH\", \"\")\n96:     os.environ[\"LD_LIBRARY_PATH\"] = \":\".join(existing_libs + ([current_ld] if current_ld else []))\n97: \n98: \n99: def query_rtx5080_status():\n100:     \"\"\"nvidia-smi から RTX 5080 の現在の VRAM 使用量・温度・消費電力を取得\"\"\"\n101:     try:\n102:         out = subprocess.check_output(\n103:             [\n104:                 \"nvidia-smi\",\n105:                 \"--query-gpu=name,memory.used,memory.total,utilization.gpu,temperature.gpu,power.draw\",\n106:                 \"--format=csv,noheader,nounits\",\n107:             ],\n108:             text=True,\n109:             stderr=subprocess.DEVNULL,\n110:             timeout=3,\n111:         ).strip()\n112:         if out:\n113:             parts = [p.strip() for p in out.split(\",\")]\n114:             if len(parts) >= 6:\n115:                 return (\n116:                     f\"GPU: {parts[0]} | VRAM: {parts[1]}/{parts[2]} MiB | \"\n117:                     f\"Util: {parts[3]}% | Temp: {parts[4]}C | Power: {parts[5]}W\"\n118:                 )\n119:     except Exception:\n120:         pass\n121:     return \"GPU status unavailable\"\n122: \n123: \n124: def detect_pw_command():\n125:     \"\"\"\n126:     ローカル環境 (WSL2 Ubuntu) の pw.x バイナリを検出し、\n127:     GPU ビルドか CPU/MPI ビルドかを自動判定して最適な起動コマンドを返す。\n128:     \"\"\"\n129:     env_pw = os.environ.get(\"QE_PW_COMMAND\")\n130:     if env_pw:\n131:         log(f\"Using user-specified QE_PW_COMMAND: {env_pw}\")\n132:         return env_pw\n133: \n134:     script_dir = os.path.dirname(os.path.abspath(__file__))\n135:     workspace_dir = os.path.dirname(script_dir)\n136:     home_dir = os.path.expanduser(\"~\")\n137: \n138:     candidates = [\n139:         os.path.join(script_dir, \"bin\", \"pw.x\"),\n140:         \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/pw.x\",\n141:         os.path.join(workspace_dir, \"calc_2H-SiC_10-10_2periods_vac5A_local_RTX5080\", \"bin\", \"pw.x\"),\n142:         os.path.join(workspace_dir, \"bin\", \"pw.x\"),\n143:         os.path.join(home_dir, \".local\", \"bin\", \"pw.x\"),\n144:         \"/usr/local/bin/pw.x\",\n145:         shutil.which(\"pw.x\"),\n146:     ]\n147:     pw_bin = None\n148:     for cand in candidates:\n149:         if cand and os.path.exists(cand) and os.access(cand, os.X_OK):\n150:             pw_bin = cand\n151:             break\n152: \n153:     if not pw_bin:\n154:         error(\"pw.x binary not found!\")\n155: \n156:     is_gpu_binary = False\n157:     try:\n158:         ldd_out = subprocess.check_output([\"ldd\", pw_bin], text=True, stderr=subprocess.DEVNULL)\n159:         if any(k in ldd_out for k in [\"libcuda\", \"libcudart\", \"libacc\", \"libnvf\", \"libcufft\", \"libcublas\"]):\n160:             is_gpu_binary = True\n161:     except Exception:\n162:         pass\n163: \n164:     if is_gpu_binary:\n165:         os.environ.setdefault(\"OMP_NUM_THREADS\", os.environ.get(\"QE_OMP_THREADS\", \"8\"))\n166:         cmd = f\"{pw_bin} -ndiag 1\"\n167:         log(f\"Detected GPU-accelerated pw.x: {cmd} (OMP_NUM_THREADS={os.environ['OMP_NUM_THREADS']})\")\n168:         return cmd\n169:     else:\n170:         # Core Ultra 9 285K (24コア) を最大限活用: 12 MPI × 2 OpenMP = 24 threads\n171:         mpi_np = int(os.environ.get(\"QE_MPI_NP\", \"12\"))\n172:         omp_threads = os.environ.get(\"QE_OMP_THREADS\", \"2\")\n173:         os.environ[\"OMP_NUM_THREADS\"] = omp_threads\n174:         mpirun_bin = shutil.which(\"mpirun\") or \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/mpirun\"\n175:         if mpirun_bin and os.path.exists(mpirun_bin) and mpi_np > 1:\n176:             cmd = f\"{mpirun_bin} --oversubscribe -np {mpi_np} {pw_bin} -ndiag 1\"\n177:         else:\n178:             cmd = f\"{pw_bin} -ndiag 1\"\n179:         log(f\"Detected CPU/MPI pw.x: {cmd} (MPI_NP={mpi_np}, OMP_NUM_THREADS={omp_threads})\")\n180:         return cmd\n181: \n182: \n183: def load_dft_config():\n184:     \"\"\"外部の dft_settings.py から DFT 条件を動的に読み込み\"\"\"\n185:     default_config = {\n186:         'ecutwfc': 40.0,\n187:         'ecutrho': 320.0,\n188:         'conv_thr': 1.0e-5,\n189:         'kpts': None,\n190:         'occupations': 'smearing',\n191:         'smearing': 'gaussian',\n192:         'degauss': 0.01,\n193:         'mixing_beta': 0.3,\n194:         'mixing_mode': 'local-TF',\n195:         'electron_maxstep': 200,\n196:         'pseudopotentials': {'Si': 'Si.upf', 'C': 'C.upf'},\n197:     }\n198:     try:\n199:         if os.path.exists(\"dft_settings.py\"):\n200:             import importlib.util\n201:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n202:             mod = importlib.util.module_from_spec(spec)\n203:             spec.loader.exec_module(mod)\n204:             if hasattr(mod, 'DFT_CONFIG'):\n205:                 default_config.update(mod.DFT_CONFIG)\n206:                 log(\"Loaded DFT_CONFIG from dft_settings.py\")\n207:     except Exception as e:\n208:         log(f\"Notice: Using default DFT parameters ({e})\")\n209:     return default_config\n210: \n211: \n212: def allocate_qm():\n213:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n214:     n = qm_natoms\n215:     qm_elements = np.empty(n, dtype=np.int32)\n216:     qm_coords = np.empty((n, 3), dtype=np.float64)\n217:     qm_forces = np.empty((n, 3), dtype=np.float64)\n218:     last_evaluated_coords = None\n219: \n220: "}
