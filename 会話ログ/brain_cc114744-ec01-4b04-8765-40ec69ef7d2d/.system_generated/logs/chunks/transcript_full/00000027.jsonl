))\nprint('Z levels (sorted):', z_unique)\n# Bottom surface (Layer 1): z < 4.0\n# Top surface (Layer 16): z > 21.5\nbot_mask = z0 < 4.0\ntop_mask = z0 > 21.5\nsurf_mask = bot_mask | top_mask\n\n# 1. Final frame (step 100) analysis\nfinal_pos = frames[-1][1][:, 2:5]\ndr_final = final_pos - init_pos\ndx_final = dr_final[:, 0]\ndy_final = dr_final[:, 1]\ndz_final = dr_final[:, 2]\ndist_final = np.linalg.norm(dr_final, axis=1)\n\nprint('\\n=== [Step 100 (Final) Displacement Statistics] ===')\nprint(f'All 288 atoms:')\nprint(f'  Max 3D displacement |dr|: {dist_final.max():.4f} A (Atom {atom_ids[dist_final.argmax()]}, Type {\\\"Si\\\" if types[dist_final.argmax()]==2 else \\\"C\\\"})')\nprint(f'  Mean 3D displacement: {dist_final.mean():.4f} A')\nprint(f'  Max |dz|: {np.abs(dz_final).max():.4f} A (Atom {atom_ids[np.abs(dz_final).argmax()]})')\nprint(f'  Max |dx|: {np.abs(dx_final).max():.4f} A, Max |dy|: {np.abs(dy_final).max():.4f} A')\n\nprint(f'\\nTop Surface (Layer 16, 18 atoms):')\ntop_dz = dz_final[top_mask]\ntop_dist = dist_final[top_mask]\ntop_types = types[top_mask]\ntop_ids = atom_ids[top_mask]\nprint(f'  Max |dr|: {top_dist.max():.4f} A')\nprint(f'  Max dz (outward into vacuum): {top_dz.max():+.4f} A (Atom {top_ids[top_dz.argmax()]}, {\\\"Si\\\" if top_types[top_dz.argmax()]==2 else \\\"C\\\"})')\nprint(f'  Min dz (inward into slab): {top_dz.min():+.4f} A (Atom {top_ids[top_dz.argmin()]}, {\\\"Si\\\" if top_types[top_dz.argmin()]==2 else \\\"C\\\"})')\nprint(f'  Mean dz: {top_dz.mean():+.4f} A')\n\nprint(f'\\nBottom Surface (Layer 1, 18 atoms):')\nbot_dz = dz_final[bot_mask]\nbot_dist = dist_final[bot_mask]\nbot_types = types[bot_mask]\nbot_ids = atom_ids[bot_mask]\nprint(f'  Max |dr|: {bot_dist.max():.4f} A')\nprint(f'  Max -dz (outward into vacuum): {-bot_dz.min():+.4f} A (Atom {bot_ids[bot_dz.argmin()]}, {\\\"Si\\\" if bot_types[bot_dz.argmin()]==2 else \\\"C\\\"})')\nprint(f'  Min -dz (inward into slab): {-bot_dz.max():+.4f} A')\nprint(f'  Mean dz: {bot_dz.mean():+.4f} A')\n\n# 2. Trajectory-wide maximum displacements (Steps 0 - 100)\nall_dz = []\nall_dist = []\nfor step, arr in frames:\n    p = arr[:, 2:5]\n    dr = p - init_pos\n    all_dz.append(dr[:, 2])\n    all_dist.append(np.linalg.norm(dr, axis=1))\n\nall_dz = np.array(all_dz) # (101, 288)\nall_dist = np.array(all_dist) # (101, 288)\n\nmax_dist_step, max_dist_atom = np.unravel_index(all_dist.argmax(), all_dist.shape)\nmax_abs_dz_step, max_abs_dz_atom = np.unravel_index(np.abs(all_dz).argmax(), all_dz.shape)\n\nprint('\\n=== [Trajectory-wide Maximum Displacements (Steps 0 - 100)] ===')\nprint(f'Global Max 3D Displacement: {all_dist.max():.4f} A (Step {max_dist_step}, Atom {atom_ids[max_dist_atom]}, Type {\\\"Si\\\" if types[max_dist_atom]==2 else \\\"C\\\"})')\nprint(f'Global Max |dz|: {np.abs(all_dz).max():.4f} A (Step {max_abs_dz_step}, Atom {atom_ids[max_abs_dz_atom]}, Type {\\\"Si\\\" if types[max_abs_dz_atom]==2 else \\\"C\\\"})')\n\ntop_all_dz = all_dz[:, top_mask]\nbot_all_dz = all_dz[:, bot_mask]\nprint(f'Top surface max outward dz into vacuum: {top_all_dz.max():+.4f} A')\nprint(f'Bottom surface max outward -dz into vacuum: {-bot_all_dz.min():+.4f} A')\n\"","WaitMsBeforeAsync":5000,"toolSummary":"Compute detailed displacement metrics from dump.lammpstrj"}}]}
