lse:\n        i += 1\n\nz0 = frames[0][1][:, 4]\n# Outermost surface layers: Layer 1 (z0 == 3.0000, 18 atoms) and Layer 16 (z0 == 22.5354, 18 atoms)\ntop_mask = z0 > 22.0\nbot_mask = z0 < 3.5\nsurf_mask = top_mask | bot_mask\n\nrows = []\nfor step, arr in frames:\n    z = arr[:, 4]\n    vz = arr[:, 5] * 0.001  # A/fs\n    dz = z - z0\n    dz_surf = dz[surf_mask]\n    dz_top = dz[top_mask]\n    dz_bot = dz[bot_mask]\n    z_min = float(z.min())\n    z_max = float(z.max())\n    gap = (z_min + Lz) - z_max\n    th = thermo_data.get(step, {})\n    scf_t, scf_it = scf_data.get(step, (0.0, 0))\n    rows.append({\n        'step': step,\n        'time_fs': float(step),\n        'scf_iters': scf_it,\n        'scf_time_s': scf_t,\n        'temp_K': th.get('temp', 0.0),\n        'ke_eV': th.get('ke', 0.0),\n        'pe_eV': th.get('pe', 0.0),\n        'etotal_eV': th.get('etotal', 0.0),\n        'fmax_eV_A': th.get('fmax', 0.0),\n        'z_min_A': round(z_min, 5),\n        'z_max_A': round(z_max, 5),\n        'gap_A': round(gap, 5),\n        'dz_max_surf_A': round(float(np.max(np.abs(dz_surf))), 5),\n        'dz_rms_surf_A': round(float(np.sqrt(np.mean(dz_surf**2))), 5),\n        'dz_top_outward_max_A': round(float(np.max(dz_top)), 5),\n        'dz_bot_outward_max_A': round(float(np.max(-dz_bot)), 5),\n        'dz_outward_max_A': round(float(max(np.max(dz_top), np.max(-dz_bot))), 5),\n        'dz_inward_max_A': round(float(max(np.max(-dz_top), np.max(dz_bot))), 5),\n        'vz_max_surf_A_fs': round(float(np.max(np.abs(vz[surf_mask]))), 6),\n    })\n\ncsv_path = os.path.join(unrel_dir, 'aimd_unrelaxed_100steps_summary.csv')\nwith open(csv_path, 'w', newline='', encoding='utf-8') as f:\n    writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))\n    writer.writeheader()\n    writer.writerows(rows)\n\nwith open(os.path.join(rel_dir, 'aimd_100steps_summary.csv'), encoding='utf-8') as f:\n    rows_rel = [{k: float(v) for k, v in r.items()} for r in csv.DictReader(f)]\n\nt = [r