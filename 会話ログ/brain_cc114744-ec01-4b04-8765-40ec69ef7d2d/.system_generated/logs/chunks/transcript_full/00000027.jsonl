.0, label='設定温度 (300 K)')\nax1.set_ylabel('温度 T [K]', fontproperties=prop_jp)\nax1.set_ylim(0, 450)\nax1.grid(True, ls=':', alpha=0.5)\nax1.tick_params(direction='in', top=True, right=True)\nif prop_jp:\n    ax1.legend(prop=prop_jp, loc='lower right', frameon=True)\n\nax2.plot(t, etot, color='#8A2BE2', lw=1.6, label='全エネルギー (TotEng = PE + KE)')\nax2.plot(t, pe, color='#4682B4', lw=1.3, ls='--', label='ポテンシャルエネルギー (PotEng)')\nax2.set_xlabel('時間 [fs]', fontproperties=prop_jp)\nax2.set_ylabel('エネルギー [eV]', fontproperties=prop_jp)\nax2.set_xlim(0, 100)\nax2.ticklabel_format(useOffset=False, style='plain', axis='y')\nax2.grid(True, ls=':', alpha=0.5)\nax2.tick_params(direction='in', top=True, right=True)\nif prop_jp:\n    ax2.legend(prop=prop_jp, loc='center right', frameon=True)\n\nplt.tight_layout()\nfor ext in ['png', 'pdf', 'svg']:\n    fig.savefig(os.path.join(unrel_dir, f'AIMD_Temperature_and_Energy_100steps.{ext}'), dpi=300)\nplt.close(fig)\n\n# Plot 3: Direct Comparison (Relaxed vs Unrelaxed Initial Structure)\nt_rel = [r['time_fs'] for r in rows_rel]\ntemp_rel = [r['temp_K'] for r in rows_rel]\ngap_rel = [r['gap_A'] for r in rows_rel]\ndz_rel = [r['dz_max_surf_A'] for r in rows_rel]\n\nfig, (ax1, ax2, ax3) = plt.subplots(3, 1, figsize=(6.4, 7.2), dpi=300, sharex=True)\nax1.plot(t, temp, color='#DC143C', lw=1.6, label='構造最適化なし (未緩和初期構造)')\nax1.plot(t_rel, temp_rel, color='#1E90FF', lw=1.6, ls='--', label='構造最適化あり (0 K 緩和済み初期構造)')\nax1.axhline(300.0, color='#222222', ls=':', lw=1.0)\nax1.set_ylabel('温度 T [K]', fontproperties=prop_jp)\nax1.set_ylim(50, 430)\nax1.grid(True, ls=':', alpha=0.5)\nax1.tick_params(direction='in', top=True, right=True)\nif prop_jp:\n    ax1.legend(prop=prop_jp, loc='upper right', frameon=True)\n\nax2.plot(t, dz_max, color='#DC143C', lw=1.6, label='構造最適化なし: |Δz|_max (主に内部への表面再構成)')\nax2.plot(t, dz_out, color='#FF8C00', lw=1.5, ls='-.', label='構造最適化なし: 真空側への最大突出量 Δz_outward')\nax2.plot(t_rel, dz_rel, color='#1E90FF', lw=1.6, ls='--', label=