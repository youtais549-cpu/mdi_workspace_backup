{"step_index":1314,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-19T03:09:36Z","content":"Created At: 2026-11-19T12:09:36+09:00\nCompleted At: 2026-11-19T12:09:37+09:00\nCreated At: 2026-11-19T12:09:36+09:00\nCompleted At: 2026-11-19T12:09:37+09:00\nShowing lines 1-365 of 365\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: ==============================================================================\n4: Quantum ESPRESSO + MDI 連成エンジン (波動関数・電荷密度引き継ぎ高速化対応版)\n5: ==============================================================================\n6: ・2H-SiC {10-10} 8周期 (16層, 288原子) 真空層 3.0 Å\n7: ・startingpot = 'file', startingwfc = 'file', disk_io = 'medium' を有効化し、\n8:   前のステップで収束した波動関数・電荷密度を次ステップの初期推測として引き継ぐ\n9: ・ASE + MDI DummyMPI 適用 (AGENTS.md §3)\n10: ・Type 1 = C (12.011), Type 2 = Si (28.085) 厳格一致 (AGENTS.md §2)\n11: \"\"\"\n12: import sys\n13: import os\n14: import re\n15: import glob\n16: import shutil\n17: import subprocess\n18: import time\n19: import numpy as np\n20: import mdi\n21: from ase import Atoms\n22: from ase.calculators.espresso import Espresso, EspressoProfile\n23: import ase.parallel\n24: \n25: # Rule 3: ASE + MDI の DummyMPI 必須化 (SIGABRT 防止)\n26: ase.parallel.world = ase.parallel.DummyMPI()\n27: \n28: ELEMENTS = [\n29:     'H' , 'He', 'Li', 'Be', 'B' , 'C' , 'N' , 'O' , 'F' , 'Ne',\n30:     'Na', 'Mg', 'Al', 'Si', 'P' , 'S' , 'Cl', 'Ar', 'K' , 'Ca',\n31:     'Sc', 'Ti', 'V' , 'Cr', 'Mn', 'Fe', 'Co', 'Ni', 'Cu', 'Zn',\n32:     'Ga', 'Ge', 'As', 'Se', 'Br', 'Kr', 'Rb', 'Sr', 'Y' , 'Zr',\n33:     'Nb', 'Mo', 'Tc', 'Ru', 'Rh', 'Pd', 'Ag', 'Cd', 'In', 'Sn',\n34:     'Sb', 'Te', 'I' , 'Xe', 'Cs', 'Ba', 'La', 'Ce', 'Pr', 'Nd',\n35:     'Pm', 'Sm', 'Eu', 'Gd', 'Tb', 'Dy', 'Ho', 'Er', 'Tm', 'Yb',\n36:     'Lu', 'Hf', 'Ta', 'W' , 'Re', 'Os', 'Ir', 'Pt', 'Au', 'Hg',\n37:     'Tl', 'Pb', 'Bi', 'Po', 'At', 'Rn', 'Fr', 'Ra', 'Ac', 'Th',\n38:     'Pa', 'U' , 'Np', 'Pu', 'Am', 'Cm', 'Bk', 'Cf', 'Es', 'Fm',\n39:     'Md', 'No', 'Lr', 'Rf', 'Db', 'Sg', 'Bh', 'Hs', 'Mt', 'Ds',\n40:     'Rg', 'Cn', 'Nh', 'Fl', 'Mc', 'Lv', 'Ts', 'Og',\n41: ]\n42: atomic_number_to_symbol = {i + 1: symbol for i, symbol in enumerate(ELEMENTS)}\n43: # Rule 2: Type 1 = C (12.011), Type 2 = Si (28.085)\n44: type_to_symbol = {1: 'C', 2: 'Si'}\n45: \n46: exitflag = False\n47: qm_natoms = 0\n48: qm_elements = None\n49: qm_coords = None\n50: box = np.zeros(9, dtype=np.float64)\n51: flag_box = False\n52: \n53: qm_pe = 0.0\n54: qm_forces = None\n55: last_evaluated_coords = None\n56: step_counter = 0\n57: \n58: \n59: def log(msg):\n60:     print(f\"[QE-MDI Engine] {msg}\", flush=True)\n61: \n62: \n63: def error(txt):\n64:     log(f\"ERROR: {txt}\")\n65:     sys.exit(1)\n66: \n67: \n68: def configure_environment():\n69:     os.environ.setdefault(\"CUDA_VISIBLE_DEVICES\", \"0\")\n70:     os.environ.setdefault(\"OMPI_MCA_btl_vader_single_copy_mechanism\", \"none\")\n71:     os.environ.setdefault(\"CUDA_CACHE_MAXSIZE\", \"2147483648\")\n72:     os.environ.setdefault(\"CUDA_CACHE_DISABLE\", \"0\")\n73:     os.environ.setdefault(\"NVCOMPILER_ACC_SYNCHRONOUS\", \"0\")\n74: \n75:     nvhpc_roots = sorted(glob.glob(\"/opt/nvidia/hpc_sdk/Linux_x86_64/*\"), reverse=True)\n76:     extra_libs = []\n77:     if nvhpc_roots:\n78:         root = nvhpc_roots[0]\n79:         extra_libs.extend([\n80:             f\"{root}/compilers/lib\",\n81:             f\"{root}/math_libs/lib64\",\n82:             f\"{root}/cuda/lib64\",\n83:             f\"{root}/comm_libs/mpi/lib\",\n84:         ])\n85:         extra_libs.extend(glob.glob(f\"{root}/comm_libs/*/hpcx/*/ompi/lib\"))\n86: \n87:     cuda_libs = [\n88:         \"/usr/local/cuda/lib64\",\n89:         \"/usr/lib/wsl/lib\",\n90:         \"/usr/lib/x86_64-linux-gnu\",\n91:     ]\n92:     existing_libs = [p for p in (extra_libs + cuda_libs) if os.path.exists(p)]\n93:     current_ld = os.environ.get(\"LD_LIBRARY_PATH\", \"\")\n94:     os.environ[\"LD_LIBRARY_PATH\"] = \":\".join(existing_libs + ([current_ld] if current_ld else []))\n95: \n96: \n97: def detect_pw_command():\n98:     env_pw = os.environ.get(\"QE_PW_COMMAND\")\n99:     if env_pw:\n100:         return env_pw\n101: \n102:     pw_bin = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/pw.x\"\n103:     mpirun_bin = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080/bin/mpirun\"\n104:     mpi_np = int(os.environ.get(\"QE_MPI_NP\", \"12\"))\n105:     omp_threads = os.environ.get(\"QE_OMP_THREADS\", \"2\")\n106:     os.environ[\"OMP_NUM_THREADS\"] = omp_threads\n107:     return f\"{mpirun_bin} --oversubscribe -np {mpi_np} {pw_bin} -ndiag 1\"\n108: \n109: \n110: def load_dft_config():\n111:     default_config = {\n112:         'ecutwfc': 40.0,\n113:         'ecutrho': 320.0,\n114:         'conv_thr': 1.0e-5,\n115:         'kpts': None,\n116:         'occupations': 'smearing',\n117:         'smearing': 'gaussian',\n118:         'degauss': 0.01,\n119:         'mixing_beta': 0.3,\n120:         'mixing_mode': 'local-TF',\n121:         'electron_maxstep': 200,\n122:         'pseudopotentials': {'Si': 'Si.upf', 'C': 'C.upf'},\n123:     }\n124:     try:\n125:         if os.path.exists(\"dft_settings.py\"):\n126:             import importlib.util\n127:             spec = importlib.util.spec_from_file_location(\"dft_settings\", \"dft_settings.py\")\n128:             mod = importlib.util.module_from_spec(spec)\n129:             spec.loader.exec_module(mod)\n130:             if hasattr(mod, 'DFT_CONFIG'):\n131:                 default_config.update(mod.DFT_CONFIG)\n132:     except Exception as e:\n133:         log(f\"Notice: Using default DFT parameters ({e})\")\n134:     return default_config\n135: \n136: \n137: def has_saved_wfc_and_pot():\n138:     \"\"\"./tmp/pwscf.save 内に前ステップの電荷密度と波動関数ファイルが存在するか確認\"\"\"\n139:     save_dir = os.path.join(\"./tmp\", \"pwscf.save\")\n140:     if not os.path.isdir(save_dir):\n141:         return False\n142:     has_chg = (\n143:         os.path.exists(os.path.join(save_dir, \"charge-density.hdf5\"))\n144:         or os.path.exists(os.path.join(save_dir, \"charge-density.dat\"))\n145:     )\n146:     has_wfc = (\n147:         os.path.exists(os.path.join(save_dir, \"wfc1.hdf5\"))\n148:         or os.path.exists(os.path.join(save_dir, \"wfc1.dat\"))\n149:     )\n150:     return has_chg and has_wfc\n151: \n152: \n153: def allocate_qm():\n154:     global qm_elements, qm_coords, qm_forces, last_evaluated_coords\n155:     n = qm_natoms\n156:     qm_elements = np.empty(n, dtype=np.int32)\n157:     qm_coords = np.empty((n, 3), dtype=np.float64)\n158:     qm_forces = np.empty((n, 3), dtype=np.float64)\n159:     last_evaluated_coords = None\n160: \n161: \n162: def receive_qm_natoms(mdicomm):\n163:     global qm_natoms\n164:     qm_natoms = mdi.MDI_Recv(1, mdi.MDI_INT, mdicomm)\n165:     log(f\"Received >NATOMS: {qm_natoms}\")\n166:     allocate_qm()\n167: \n168: \n169: def receive_box(mdicomm):\n170:     global flag_box\n171:     flag_box = True\n172:     ierr = mdi.MDI_Recv(9, mdi.MDI_DOUBLE, mdicomm, buf=box)\n173:     if ierr:\n174:         error(\"MDI: >CELL reception failed\")\n175: \n176: \n177: def receive_qm_coords(mdicomm):\n178:     if not qm_natoms:\n179:         error(\"Cannot receive >COORDS if # atoms = 0\")\n180:     ierr = mdi.MDI_Recv(3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm, buf=qm_coords)\n181:     if ierr:\n182:         error(\"MDI: >COORDS reception failed\")\n183: \n184: \n185: def receive_qm_elements(mdicomm):\n186:     if not qm_natoms:\n187:         error(\"Cannot receive >ELEMENTS if # atoms = 0\")\n188:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=qm_elements)\n189:     if ierr:\n190:         error(\"MDI: >ELEMENTS reception failed\")\n191: \n192: \n193: def receive_qm_types(mdicomm):\n194:     if not qm_natoms:\n195:         error(\"Cannot receive >TYPES if # atoms = 0\")\n196:     types = np.empty(qm_natoms, dtype=np.int32)\n197:     ierr = mdi.MDI_Recv(qm_natoms, mdi.MDI_INT, mdicomm, buf=types)\n198:     if ierr:\n199:         error(\"MDI: >TYPES reception failed\")\n200:     for i, t in enumerate(types):\n201:         sym = type_to_symbol.get(int(t), 'C')\n202:         qm_elements[i] = ELEMENTS.index(sym) + 1\n203: \n204: \n205: def evaluate():\n206:     global qm_pe, qm_forces, last_evaluated_coords, step_counter\n207:     if qm_natoms == 0 or qm_elements is None or qm_coords is None:\n208:         error(\"System atoms, elements, or coordinates not fully specified\")\n209: \n210:     # 座標キャッシュ: 同一ステップでの重複 SCF 計算を防止\n211:     if last_evaluated_coords is not None and np.allclose(qm_coords, last_evaluated_coords, atol=1e-8):\n212:         return\n213: \n214:     bohr_to_angstrom = mdi.MDI_Conversion_factor(\"bohr\", \"angstrom\")\n215:     ev_to_hartree = mdi.MDI_Conversion_factor(\"electron_volt\", \"hartree\")\n216:     force_conv = ev_to_hartree * bohr_to_angstrom\n217: \n218:     coords_angstrom = qm_coords * bohr_to_angstrom\n219:     symbols = [atomic_number_to_symbol[int(anum)] for anum in qm_elements]\n220: \n221:     if flag_box and np.linalg.norm(box) > 1e-6:\n222:         cell_matrix_bohr = box.reshape(3, 3)\n223:         cell_matrix_angstrom = cell_matrix_bohr * bohr_to_angstrom\n224:     else:\n225:         cell_matrix_angstrom = np.eye(3) * 10.0\n226: \n227:     atoms = Atoms(symbols=symbols, positions=coords_angstrom, cell=cell_matrix_angstrom, pbc=[True, True, True])\n228:     command_str = detect_pw_command()\n229:     cfg = load_dft_config()\n230: \n231:     reuse_prev_wfc = has_saved_wfc_and_pot()\n232: \n233:     electrons_dict = {\n234:         'conv_thr': cfg['conv_thr'],\n235:         'mixing_beta': cfg['mixing_beta'],\n236:         'mixing_mode': cfg['mixing_mode'],\n237:         'electron_maxstep': cfg['electron_maxstep'],\n238:     }\n239:     if reuse_prev_wfc:\n240:         electrons_dict['startingpot'] = 'file'\n241:         electrons_dict['startingwfc'] = 'file'\n242: \n243:     input_data = {\n244:         'control': {\n245:             'calculation': 'scf',\n246:             'pseudo_dir': './',\n247:             'outdir': './tmp',\n248:             'tprnfor': True,\n249:             'tstress': True,\n250:             'disk_io': 'medium',  # 波動関数 (wfc1.hdf5) と電荷密度 (charge-density.hdf5) を保存して次ステップへ引き継ぐ\n251:         },\n252:         'system': {\n253:             'ecutwfc': cfg['ecutwfc'],\n254:             'ecutrho': cfg['ecutrho'],\n255:             'occupations': cfg['occupations'],\n256:             'smearing': cfg['smearing'],\n257:             'degauss': cfg['degauss'],\n258:         },\n259:         'electrons': electrons_dict,\n260:     }\n261: \n262:     z_coords = coords_angstrom[:, 2]\n263:     Lz = cell_matrix_angstrom[2, 2]\n264:     z_min, z_max = float(np.min(z_coords)), float(np.max(z_coords))\n265:     current_gap = (z_min + Lz) - z_max\n266: \n267:     log(\n268:         f\"--- [Step {step_counter}] Starting SCF ({len(atoms)} atoms, \"\n269:         f\"startingpot/wfc={'file' if reuse_prev_wfc else 'atomic'}, \"\n270:         f\"z_min={z_min:.4f}A, z_max={z_max:.4f}A, gap={current_gap:.4f}A) ---\"\n271:     )\n272: \n273:     t0 = time.time()\n274:     profile = EspressoProfile(command=command_str, pseudo_dir=\"./\")\n275:     calc = Espresso(profile=profile, pseudopotentials=cfg['pseudopotentials'], input_data=input_data, kpts=cfg['kpts'])\n276:     atoms.calc = calc\n277: \n278:     pe_ev = atoms.get_potential_energy()\n279:     forces_ev_angstrom = atoms.get_forces()\n280:     elapsed = time.time() - t0\n281: \n282:     n_scf_iters = -1\n283:     if os.path.exists(\"espresso.pwo\"):\n284:         with open(\"espresso.pwo\", \"r\", encoding=\"utf-8\", errors=\"ignore\") as f_in:\n285:             pwo_text = f_in.read()\n286:         m_it = re.search(r\"convergence has been achieved in\\s+(\\d+)\\s+iterations\", pwo_text)\n287:         if m_it:\n288:             n_scf_iters = int(m_it.group(1))\n289:         with open(\"espresso_all_steps.pwo\", \"a\", encoding=\"utf-8\") as f_out:\n290:             f_out.write(f\"\\n=== STEP {step_counter} ===\\n\")\n291:             f_out.write(pwo_text)\n292:         shutil.copyfile(\"espresso.pwo\", \"live_espresso.pwo\")\n293: \n294:     qm_pe = pe_ev * ev_to_hartree\n295:     qm_forces = forces_ev_angstrom * force_conv\n296:     fmax = np.max(np.linalg.norm(forces_ev_angstrom, axis=1))\n297: \n298:     log(\n299:         f\"--- [Step {step_counter}] Done in {elapsed:.2f}s ({n_scf_iters} SCF iters) | \"\n300:         f\"E_pot: {pe_ev:.4f} eV | Fmax: {fmax:.5f} eV/A | gap: {current_gap:.4f} A ---\"\n301:     )\n302:     last_evaluated_coords = np.copy(qm_coords)\n303:     step_counter += 1\n304: \n305: \n306: def execute_command(command, mdicomm, object_ptr):\n307:     global exitflag\n308:     if command == \"EXIT\":\n309:         log(\"Received EXIT command from driver.\")\n310:         exitflag = True\n311:     elif command == \">NATOMS\":\n312:         receive_qm_natoms(mdicomm)\n313:     elif command == \">CELL\":\n314:         receive_box(mdicomm)\n315:     elif command == \">ELEMENTS\":\n316:         receive_qm_elements(mdicomm)\n317:     elif command == \">TYPES\":\n318:         receive_qm_types(mdicomm)\n319:     elif command == \">COORDS\":\n320:         receive_qm_coords(mdicomm)\n321:     elif command in [\"<ENERGY\", \"<PE\"]:\n322:         evaluate()\n323:         ierr = mdi.MDI_Send(qm_pe, 1, mdi.MDI_DOUBLE, mdicomm)\n324:         if ierr:\n325:             error(\"MDI: <ENERGY send failed\")\n326:     elif command == \"<FORCES\":\n327:         evaluate()\n328:         ierr = mdi.MDI_Send(qm_forces, 3 * qm_natoms, mdi.MDI_DOUBLE, mdicomm)\n329:         if ierr:\n330:             error(\"MDI: <FORCES send failed\")\n331:     else:\n332:         error(f\"Unrecognized MDI command: {command}\")\n333:     return 0\n334: \n335: \n336: def main():\n337:     configure_environment()\n338:     mdi_options = None\n339:     for i, arg in enumerate(sys.argv):\n340:         if arg in [\"-mdi\", \"--mdi\"] and i + 1 < len(sys.argv):\n341:             mdi_options = sys.argv[i + 1]\n342:             break\n343:     if not mdi_options:\n344:         error(\"MDI options not provided. Use -mdi '-role ENGINE -name QE -method TCP -port 8029 -hostname localhost'\")\n345: \n346:     log(f\"Initializing MDI Engine with options: {mdi_options}\")\n347:     mdi.MDI_Init(mdi_options)\n348:     mdi.MDI_Register_Node(\"@DEFAULT\")\n349:     for cmd in [\"EXIT\", \">NATOMS\", \">CELL\", \">ELEMENTS\", \">TYPES\", \">COORDS\", \"<ENERGY\", \"<PE\", \"<FORCES\"]:\n350:         mdi.MDI_Register_Command(\"@DEFAULT\", cmd)\n351:     mdi.MDI_Set_Execute_Command_Func(execute_command, None)\n352: \n353:     log(\"Waiting for MDI driver connection...\")\n354:     mdicomm = mdi.MDI_Accept_Communicator()\n355:     log(\"Connected to MDI driver! Entering communication loop...\")\n356: \n357:     while not exitflag:\n358:         command = mdi.MDI_Recv_Command(mdicomm)\n359:         execute_command(command, mdicomm, None)\n360: \n361:     log(\"MDI Engine execution terminated cleanly.\")\n362: \n363: \n364: if __name__ == \"__main__\":\n365:     main()"}
