{"step_index":1306,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-19T03:08:43Z","content":"Created At: 2026-11-19T12:08:43+09:00\nCompleted At: 2026-11-19T12:08:44+09:00\nCreated At: 2026-11-19T12:08:43+09:00\nCompleted At: 2026-11-19T12:08:44+09:00\nShowing lines 1-412 of 412\n1: #!/usr/bin/env python3\n2: r\"\"\"\n3: run_8periods_vac3.0A_unrelaxed_aimd_100steps.py\n4: ==============================================================================\n5: 2H-SiC {10-10} 8周期 (16層, 288原子) 真空層 3.0 Å (スラブ間ギャップ 6.0 Å)\n6: 【構造最適化なし (未緩和スラブ初期構造)】からの 300 K NVT 第一原理分子動力学 (AIMD 100 steps = 100 fs)\n7: \n8: ・初期構造以外は前回の AIMD (aimd_2H-SiC_10-10_8periods_vac3.0A_300K_100steps_rtx5080) と完全同一条件\n9: ・検証目的:\n10:   ① 0 K 構造最適化を行わない未緩和初期構造から開始した場合に、発散せずに計算が回るか、\n11:      各ステップの SCF 収束性・全エネルギー・温度 T の挙動がどう変化するか (初期熱ショックの有無と大きさ)\n12:   ② 300 K の MD 中における最表面原子の Z 座標の最大変位 (振幅) とスラブ間ギャップがどう推移し、\n13:      真空層 3.0 Å (ギャップ 6.0 Å) で隣接スラブとぶつからないか\n14: ==============================================================================\n15: \"\"\"\n16: \n17: import os\n18: import sys\n19: import re\n20: import csv\n21: import json\n22: import time\n23: import shutil\n24: import datetime\n25: import subprocess\n26: import numpy as np\n27: \n28: os.environ[\"MPLCONFIGDIR\"] = \"/tmp/matplotlib_cache_sic\"\n29: os.makedirs(\"/tmp/matplotlib_cache_sic\", exist_ok=True)\n30: import matplotlib\n31: matplotlib.use(\"Agg\")\n32: import matplotlib.pyplot as plt\n33: import matplotlib.font_manager as fm\n34: \n35: WORKSPACE_DIR = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_workspace_backup\"\n36: ENV_PREFIX = \"/home/WORKSTATION4WSL/.gemini/antigravity/scratch/mdi_env_rtx5080\"\n37: TEMPLATE_DIR = os.path.join(WORKSPACE_DIR, \"calc_2H-SiC_10-10_8periods_vac5A_natural_cleavage\")\n38: PREV_AIMD_DIR = os.path.join(WORKSPACE_DIR, \"aimd_2H-SiC_10-10_8periods_vac3.0A_300K_100steps_rtx5080\")\n39: UNRELAXED_AIMD_DIR = os.path.join(WORKSPACE_DIR, \"aimd_2H-SiC_10-10_8periods_vac3.0A_unrelaxed_300K_100steps_rtx5080\")\n40: \n41: LOG_FILE = os.path.join(WORKSPACE_DIR, \"aimd_8periods_vac3.0A_unrelaxed_run.log\")\n42: \n43: \n44: def log(msg):\n45:     now = datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n46:     line = f\"[{now}] {msg}\"\n47:     print(line, flush=True)\n48:     with open(LOG_FILE, \"a\", encoding=\"utf-8\") as f:\n49:         f.write(line + \"\\n\")\n50: \n51: \n52: def create_unrelaxed_vac3A_data(src_unrelaxed_5A_path, dst_unrelaxed_3A_path):\n53:     \"\"\"\n54:     未緩和の8周期・真空5.0Åスラブ (slab_10-10_288atoms_vac5A.data) から\n55:     真空層部分のみを 5.0 Å → 3.0 Å に詰めた未緩和 LAMMPS データファイルを生成する。\n56:     ・セル高さ Lz: 29.53540130124298 Å → 25.53540130124298 Å (-4.0 Å)\n57:     ・全原子の z 座標: z → z - 2.0 Å (z_min = 3.0000 Å, z_max = 22.53540130124298 Å)\n58:     ・初期スラブ間ギャップ: 6.0000 Å (完全未緩和の理想へき開切断構造)\n59:     \"\"\"\n60:     with open(src_unrelaxed_5A_path, \"r\", encoding=\"utf-8\") as f:\n61:         lines = f.readlines()\n62: \n63:     out_lines = []\n64:     in_atoms = False\n65:     atoms_list = []\n66:     zhi = 25.53540130124298\n67: \n68:     for line in lines:\n69:         stripped = line.strip()\n70:         if \"zlo zhi\" in stripped:\n71:             parts = stripped.split()\n72:             zlo = float(parts[0])\n73:             zhi = float(parts[1]) - 4.0  # 29.53540130124298 -> 25.53540130124298\n74:             out_lines.append(f\"{zlo:.1f} {zhi:.14f} zlo zhi\\n\")\n75:             continue\n76: \n77:         if stripped.startswith(\"Atoms\"):\n78:             in_atoms = True\n79:             out_lines.append(\"Atoms # atomic\\n\\n\")\n80:             continue\n81: \n82:         if in_atoms:\n83:             if not stripped:\n84:                 continue\n85:             parts = stripped.split()\n86:             if len(parts) >= 5 and parts[0].isdigit():\n87:                 aid = int(parts[0])\n88:                 atype = int(parts[1])\n89:                 x = float(parts[2])\n90:                 y = float(parts[3])\n91:                 z = float(parts[4]) - 2.0  # Shift z by -2.0 Å (bottom vac 5.0 -> 3.0 Å)\n92:                 atoms_list.append((aid, atype, x, y, z))\n93:             continue\n94: \n95:         out_lines.append(line)\n96: \n97:     atoms_list.sort(key=lambda item: item[0])\n98:     for aid, atype, x, y, z in atoms_list:\n99:         out_lines.append(f\"{aid:6d} {atype:3d} {x:20.14f} {y:20.14f} {z:20.14f}\\n\")\n100: \n101:     with open(dst_unrelaxed_3A_path, \"w\", encoding=\"utf-8\") as f:\n102:         f.writelines(out_lines)\n103: \n104:     z_arr = np.array([item[4] for item in atoms_list])\n105:     log(\n106:         f\"Created unrelaxed initial structure {os.path.basename(dst_unrelaxed_3A_path)}: \"\n107:         f\"{len(atoms_list)} atoms, z_min={z_arr.min():.4f} Å, z_max={z_arr.max():.4f} Å, Lz={zhi:.6f} Å \"\n108:         f\"(initial inter-slab gap = {(z_arr.min() + zhi) - z_arr.max():.4f} Å)\"\n109:     )\n110: \n111: \n112: def prepare_and_run_unrelaxed_aimd():\n113:     log(\"==============================================================================\")\n114:     log(\"Starting 300 K NVT AIMD (100 steps = 100 fs) from UNRELAXED 8-period Vac 3.0 Å Slab\")\n115:     log(\"==============================================================================\")\n116: \n117:     os.makedirs(UNRELAXED_AIMD_DIR, exist_ok=True)\n118: \n119:     # Copy common assets and identical QE-MDI engine from PREV_AIMD_DIR\n120:     for asset in [\n121:         \"C.upf\",\n122:         \"Si.upf\",\n123:         \"RELAXATION_GRAPH_PROTOCOL.json\",\n124:         \"dft_settings.py\",\n125:         \"make_xyz.py\",\n126:         \"msmincho.ttc\",\n127:         \"times.ttf\",\n128:         \"auto_generate_progression_graphs.py\",\n129:         \"qe_mdi_engine_rtx5080.py\",\n130:     ]:\n131:         src = os.path.join(PREV_AIMD_DIR, asset)\n132:         dst = os.path.join(UNRELAXED_AIMD_DIR, asset)\n133:         shutil.copyfile(src, dst)\n134:         if asset.endswith(\".py\"):\n135:             os.chmod(dst, 0o755)\n136: \n137:     # Create unrelaxed initial structure (8 periods, vac 3.0 Å)\n138:     src_unrelaxed_5A = os.path.join(TEMPLATE_DIR, \"slab_10-10_288atoms_vac5A.data\")\n139:     dst_unrelaxed_3A = os.path.join(UNRELAXED_AIMD_DIR, \"slab_10-10_288atoms_vac3.0A_unrelaxed.data\")\n140:     create_unrelaxed_vac3A_data(src_unrelaxed_5A, dst_unrelaxed_3A)\n141: \n142:     # Remove any old ./tmp so Step 0 starts cleanly from scratch for the unrelaxed geometry,\n143:     # and Steps 1..100 use startingpot='file' and startingwfc='file'\n144:     tmp_dir = os.path.join(UNRELAXED_AIMD_DIR, \"tmp\")\n145:     if os.path.exists(tmp_dir):\n146:         shutil.rmtree(tmp_dir)\n147: \n148:     # Write in.lammps (100% identical to previous AIMD except read_data points to unrelaxed.data)\n149:     in_lammps_content = \"\"\"# ==============================================================================\n150: # 2H-SiC {10-10} 8周期 (16層, 288原子) スラブモデル (真空層 各3.0Å, ギャップ 6.0Å)\n151: # 【構造最適化なし (未緩和初期構造)】からの 300K NVT 第一原理分子動力学 (100 steps = 100 fs)\n152: # ==============================================================================\n153: # 単位系: metal (距離: Å, 時間: ps, エネルギー: eV, 温度: K, 質量: g/mol)\n154: units           metal\n155: dimension       3\n156: boundary        p p p\n157: atom_style      atomic\n158: atom_modify     map yes\n159: \n160: # 1. 初期構造の読み込み (8周期・真空3.0Å の 0K 構造最適化を行っていない理想切断スラブ構造)\n161: read_data       slab_10-10_288atoms_vac3.0A_unrelaxed.data\n162: \n163: # 原子質量設定 (Rule 2: Type 1: C = 12.011, Type 2: Si = 28.085)\n164: mass            1 12.011\n165: mass            2 28.085\n166: \n167: pair_style      none\n168: \n169: # 2. MDI 通信設定 (Quantum ESPRESSO を第一原理 QM エンジンとして連成)\n170: fix             1 all mdi/qm elements C Si\n171: \n172: # 3. 初期熱運動速度の付与 (Maxwell-Boltzmann 分布 @ 300K, 同一乱数シード 87654)\n173: velocity        all create 300.0 87654 mom yes rot yes dist gaussian\n174: \n175: # 4. 運動方程式の数値積分 & サーモスタット設定 (NVT アンサンブル @ 300K)\n176: timestep        0.001\n177: fix             2 all nvt temp 300.0 300.0 0.1\n178: \n179: # 5. スラブ特有の重心ドリフト防止 (50ステップごとに全並進運動量をゼロにリセット)\n180: fix             3 all momentum 50 linear 1 1 1\n181: \n182: # 6. 出力設定 & ログ記録\n183: thermo_style    custom step temp epair emol ke pe etotal press fmax fnorm\n184: thermo          1\n185: thermo_modify   flush yes\n186: \n187: dump            1 all custom 1 dump.lammpstrj id type x y z vx vy vz fx fy fz\n188: dump_modify     1 sort id flush yes\n189: \n190: # 7. AIMD 実行 (100 steps = 100 fs = 0.1 ps)\n191: run             100\n192: \n193: write_data      slab_10-10_288atoms_vac3.0A_unrelaxed_aimd_100steps_final.data\n194: undump          1\n195: \"\"\"\n196:     with open(os.path.join(UNRELAXED_AIMD_DIR, \"in.lammps\"), \"w\", encoding=\"utf-8\") as f:\n197:         f.write(in_lammps_content)\n198: \n199:     for fn in [\"dump.lammpstrj\", \"log.lammps\", \"lmp.log\", \"qe_engine.log\", \"espresso.pwo\", \"espresso_all_steps.pwo\"]:\n200:         p = os.path.join(UNRELAXED_AIMD_DIR, fn)\n201:         if os.path.exists(p):\n202:             os.remove(p)\n203: \n204:     port = 8040\n205:     env = os.environ.copy()\n206:     env[\"PATH\"] = f\"{ENV_PREFIX}/bin:\" + env.get(\"PATH\", \"\")\n207:     env[\"LD_LIBRARY_PATH\"] = f\"{ENV_PREFIX}/lib:\" + env.get(\"LD_LIBRARY_PATH\", \"\")\n208:     env[\"OMPI_MCA_btl_vader_single_copy_mechanism\"] = \"none\"\n209:     env[\"QE_MPI_NP\"] = \"12\"\n210:     env[\"QE_OMP_THREADS\"] = \"2\"\n211: \n212:     lmp_bin = os.path.join(ENV_PREFIX, \"bin\", \"lmp\")\n213:     py_bin = os.path.join(ENV_PREFIX, \"bin\", \"python3\")\n214: \n215:     t0 = time.time()\n216:     lmp_log_f = open(os.path.join(UNRELAXED_AIMD_DIR, \"lmp.log\"), \"w\")\n217:     qe_log_f = open(os.path.join(UNRELAXED_AIMD_DIR, \"qe_engine.log\"), \"w\")\n218: \n219:     lmp_proc = subprocess.Popen(\n220:         [lmp_bin, \"-mdi\", f\"-role DRIVER -name LAMMPS -method TCP -port {port}\", \"-in\", \"in.lammps\", \"-log\", \"log.lammps\"],\n221:         cwd=UNRELAXED_AIMD_DIR,\n222:         env=env,\n223:         stdout=lmp_log_f,\n224:         stderr=subprocess.STDOUT,\n225:     )\n226:     time.sleep(2)\n227:     qe_proc = subprocess.Popen(\n228:         [py_bin, \"qe_mdi_engine_rtx5080.py\", \"-mdi\", f\"-role ENGINE -name QE -method TCP -port {port} -hostname localhost\"],\n229:         cwd=UNRELAXED_AIMD_DIR,\n230:         env=env,\n231:         stdout=qe_log_f,\n232:         stderr=subprocess.STDOUT,\n233:     )\n234: \n235:     lmp_proc.wait()\n236:     try:\n237:         qe_proc.wait(timeout=30)\n238:     except subprocess.TimeoutExpired:\n239:         qe_proc.kill()\n240: \n241:     lmp_log_f.close()\n242:     qe_log_f.close()\n243:     elapsed = time.time() - t0\n244: \n245:     # Winmostar 用アニメーション生成 & 3種推移グラフ自動生成\n246:     subprocess.run([py_bin, \"make_xyz.py\", \"dump.lammpstrj\", \"md_animation.xyz\"], cwd=UNRELAXED_AIMD_DIR, env=env, check=False)\n247:     subprocess.run([py_bin, \"make_xyz.py\", \"dump.lammpstrj\", \"md_nvt_animation.xyz\"], cwd=UNRELAXED_AIMD_DIR, env=env, check=False)\n248:     subprocess.run([py_bin, \"auto_generate_progression_graphs.py\"], cwd=UNRELAXED_AIMD_DIR, env=env, check=False)\n249: \n250:     log(f\"Unrelaxed 300 K AIMD (100 steps) Completed in {elapsed:.1f}s ({elapsed/60.0:.1f} min)!\")\n251: \n252: \n253: def analyze_and_plot_results():\n254:     Lz = 25.53540130124298\n255:     thermo_data = {}\n256:     with open(os.path.join(UNRELAXED_AIMD_DIR, \"log.lammps\")) as f:\n257:         for line in f:\n258:             parts = line.split()\n259:             if len(parts) == 10 and parts[0].isdigit():\n260:                 step = int(parts[0])\n261:                 thermo_data[step] = {\n262:                     \"temp\": float(parts[1]),\n263:                     \"ke\": float(parts[4]),\n264:                     \"pe\": float(parts[5]),\n265:                     \"etotal\": float(parts[6]),\n266:                     \"press\": float(parts[7]),\n267:                     \"fmax\": float(parts[8]),\n268:                     \"fnorm\": float(parts[9]),\n269:                 }\n270: \n271:     scf_data = {}\n272:     with open(os.path.join(UNRELAXED_AIMD_DIR, \"qe_engine.log\")) as f:\n273:         for line in f:\n274:             m = re.search(r\"\\[Step (\\d+)\\] Done in ([\\d\\.]+)s \\((\\d+) SCF iters\\)\", line)\n275:             if m:\n276:                 scf_data[int(m.group(1))] = (float(m.group(2)), int(m.group(3)))\n277: \n278:     with open(os.path.join(UNRELAXED_AIMD_DIR, \"dump.lammpstrj\")) as f:\n279:         lines = f.readlines()\n280: \n281:     frames = []\n282:     i = 0\n283:     while i < len(lines):\n284:         if \"ITEM: TIMESTEP\" in lines[i]:\n285:             step = int(lines[i + 1].strip())\n286:             natoms = int(lines[i + 3].strip())\n287:             data = []\n288:             for l in lines[i + 9 : i + 9 + natoms]:\n289:                 parts = l.split()\n290:                 data.append([int(parts[0]), int(parts[1]), float(parts[2]), float(parts[3]), float(parts[4]), float(parts[7])])\n291:             data.sort(key=lambda x: x[0])\n292:             frames.append((step, np.array(data)))\n293:             i += 9 + natoms\n294:         else:\n295:             i += 1\n296: \n297:     z0 = frames[0][1][:, 4]\n298:     top_mask = z0 > 21.5\n299:     bot_mask = z0 < 4.0\n300:     surf_mask = top_mask | bot_mask\n301: \n302:     rows = []\n303:     for step, arr in frames:\n304:         z = arr[:, 4]\n305:         vz = arr[:, 5] * 0.001  # A/fs\n306:         dz = z - z0\n307:         dz_surf = dz[surf_mask]\n308:         dz_top = dz[top_mask]\n309:         dz_bot = dz[bot_mask]\n310:         z_min = float(z.min())\n311:         z_max = float(z.max())\n312:         gap = (z_min + Lz) - z_max\n313:         th = thermo_data.get(step, {})\n314:         scf_t, scf_it = scf_data.get(step, (0.0, 0))\n315:         rows.append({\n316:             \"step\": step,\n317:             \"time_fs\": float(step),\n318:             \"scf_iters\": scf_it,\n319:             \"scf_time_s\": scf_t,\n320:             \"temp_K\": th.get(\"temp\", 0.0),\n321:             \"ke_eV\": th.get(\"ke\", 0.0),\n322:             \"pe_eV\": th.get(\"pe\", 0.0),\n323:             \"etotal_eV\": th.get(\"etotal\", 0.0),\n324:             \"fmax_eV_A\": th.get(\"fmax\", 0.0),\n325:             \"z_min_A\": round(z_min, 5),\n326:             \"z_max_A\": round(z_max, 5),\n327:             \"gap_A\": round(gap, 5),\n328:             \"dz_max_surf_A\": round(float(np.max(np.abs(dz_surf))), 5),\n329:             \"dz_rms_surf_A\": round(float(np.sqrt(np.mean(dz_surf**2))), 5),\n330:             \"dz_top_outward_max_A\": round(float(np.max(dz_top)), 5),\n331:             \"dz_bot_outward_max_A\": round(float(np.max(-dz_bot)), 5),\n332:             \"vz_max_surf_A_fs\": round(float(np.max(np.abs(vz[surf_mask]))), 6),\n333:         })\n334: \n335:     csv_path = os.path.join(UNRELAXED_AIMD_DIR, \"aimd_unrelaxed_100steps_summary.csv\")\n336:     with open(csv_path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n337:         writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))\n338:         writer.writeheader()\n339:         writer.writerows(rows)\n340: \n341:     t = [r[\"time_fs\"] for r in rows]\n342:     temp = [r[\"temp_K\"] for r in rows]\n343:     etot = [r[\"etotal_eV\"] for r in rows]\n344:     pe = [r[\"pe_eV\"] for r in rows]\n345:     gap = [r[\"gap_A\"] for r in rows]\n346:     dz_max = [r[\"dz_max_surf_A\"] for r in rows]\n347:     dz_rms = [r[\"dz_rms_surf_A\"] for r in rows]\n348: \n349:     mincho_path = os.path.join(UNRELAXED_AIMD_DIR, \"msmincho.ttc\")\n350:     prop_jp = fm.FontProperties(fname=mincho_path, size=11) if os.path.exists(mincho_path) else None\n351: \n352:     # Plot 1: Surface Displacement & Gap\n353:     fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(6.0, 5.2), dpi=300, sharex=True)\n354:     ax1.plot(t, dz_max, color=\"#8A2BE2\", lw=1.6, label=\"最大変位 |Δz|_max (最表面原子)\")\n355:     ax1.plot(t, dz_rms, color=\"#1E90FF\", lw=1.6, ls=\"--\", label=\"二乗平均変位 Δz_rms (最表面36原子)\")\n356:     ax1.set_ylabel(\"表面原子 Z方向変位 [Å]\", fontproperties=prop_jp)\n357:     ax1.grid(True, ls=\":\", alpha=0.5)\n358:     ax1.tick_params(direction=\"in\", top=True, right=True)\n359:     if prop_jp:\n360:         ax1.legend(prop=prop_jp, loc=\"upper left\", frameon=True)\n361: \n362:     ax2.plot(t, gap, color=\"#2E8B57\", lw=1.8, label=\"スラブ間ギャップ d_gap\")\n363:     ax2.axhline(6.0, color=\"#666666\", ls=\":\", lw=1.0, label=\"初期ギャップ (6.00 Å)\")\n364:     ax2.set_xlabel(\"時間 [fs]\", fontproperties=prop_jp)\n365:     ax2.set_ylabel(\"スラブ間ギャップ [Å]\", fontproperties=prop_jp)\n366:     ax2.set_xlim(0, 100)\n367:     ax2.grid(True, ls=\":\", alpha=0.5)\n368:     ax2.tick_params(direction=\"in\", top=True, right=True)\n369:     if prop_jp:\n370:         ax2.legend(prop=prop_jp, loc=\"lower left\", frameon=True)\n371: \n372:     plt.tight_layout()\n373:     for ext in [\"png\", \"pdf\", \"svg\"]:\n374:         fig.savefig(os.path.join(UNRELAXED_AIMD_DIR, f\"AIMD_Surface_Displacement_and_Gap_100steps.{ext}\"), dpi=300)\n375:     plt.close(fig)\n376: \n377:     # Plot 2: Temperature and Total Energy\n378:     fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(6.0, 5.2), dpi=300, sharex=True)\n379:     ax1.plot(t, temp, color=\"#D2691E\", lw=1.6)\n380:     ax1.axhline(300.0, color=\"#222222\", ls=\"--\", lw=1.0)\n381:     ax1.set_ylabel(\"温度 T [K]\", fontproperties=prop_jp)\n382:     ax1.grid(True, ls=\":\", alpha=0.5)\n383:     ax1.tick_params(direction=\"in\", top=True, right=True)\n384: \n385:     ax2.plot(t, etot, color=\"#8A2BE2\", lw=1.6, label=\"全エネルギー (TotEng = PE + KE)\")\n386:     ax2.plot(t, pe, color=\"#4682B4\", lw=1.3, ls=\"--\", label=\"ポテンシャルエネルギー (PotEng)\")\n387:     ax2.set_xlabel(\"時間 [fs]\", fontproperties=prop_jp)\n388:     ax2.set_ylabel(\"エネルギー [eV]\", fontproperties=prop_jp)\n389:     ax2.set_xlim(0, 100)\n390:     ax2.ticklabel_format(useOffset=False, style=\"plain\", axis=\"y\")\n391:     ax2.grid(True, ls=\":\", alpha=0.5)\n392:     ax2.tick_params(direction=\"in\", top=True, right=True)\n393:     if prop_jp:\n394:         ax2.legend(prop=prop_jp, loc=\"best\", frameon=True)\n395: \n396:     plt.tight_layout()\n397:     for ext in [\"png\", \"pdf\", \"svg\"]:\n398:         fig.savefig(os.path.join(UNRELAXED_AIMD_DIR, f\"AIMD_Temperature_and_Energy_100steps.{ext}\"), dpi=300)\n399:     plt.close(fig)\n400: \n401:     log(\"Generated summary CSV and AIMD analysis plots for unrelaxed initial structure.\")\n402: \n403: \n404: if __name__ == \"__main__\":\n405:     try:\n406:         prepare_and_run_unrelaxed_aimd()\n407:         analyze_and_plot_results()\n408:         log(\"ALL UNRELAXED AIMD STEPS COMPLETED SUCCESSFULLY!\")\n409:     except Exception as exc:\n410:         log(f\"FATAL ERROR: {exc}\")\n411:         raise\n412: "}
